        name:name,
        value:(kind:"const", value:value, type:"int"),
        type:"int",
        span:(
            start:(file:file, line:start_line, column:start_column),
            stop:(file:file, line:stop_line, column:stop_column)
        )
    )

typed_tagged_binding(
    module:TypedTaggedModule, index:int
) -> TypedStoreBinding:
    offset: index * 8
