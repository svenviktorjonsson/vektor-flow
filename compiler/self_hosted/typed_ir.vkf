# Self-hosted VKF typed IR seed.
#
# Source-level contract for the native AST-to-IR smoke seam. The executable
# consumes normalized parser AST JSON and emits deterministic typed IR JSON.

# Private facts over a validated private expression arena and declaration spans.
# Type codes: 1 int, 2 num, 3 vector parameter, 4 zero-argument vector length,
# 5 borrowed string parameter.
# Public typed IR schemas and existing manifest-callable helpers are unchanged.
_bootstrap_expression_types(
    source:str, rows:[num], nodes:[num], arguments:[num],
    parameter_starts:[num], parameter_stops:[num],
    type_starts:[num], type_stops:[num]
):
    [num] types: []
    [num] parameters: []
    facts: (valid:false, error_index:0, types:types, parameters:parameters)
    (nodes.length() = 0 \/ nodes.length() % 5 != 0 \/ rows.length() % 6 != 0 \/
        parameter_starts.length() != parameter_stops.length() \/
        parameter_starts.length() != type_starts.length() \/
        parameter_starts.length() != type_stops.length())?
        @: facts
    index: 0
    kind: 0
    token: 0
    parameter: 0
    match: -1
    type: 0
    left: 0
    right: 0
    previous: 0
    (parameter < parameter_starts.length())?>
        .previous: 0
        (previous < parameter)?>
            (vkf_utf8_slice(source, parameter_starts.(parameter), parameter_stops.(parameter)) =
                vkf_utf8_slice(source, parameter_starts.(previous), parameter_stops.(previous)))?
                (token < rows.length() / 6 /\ rows.(token * 6 + 1) < parameter_starts.(parameter))?>
                    .token+: 1
                facts.error_index: token
                @: facts
            .previous+: 1
        .parameter+: 1
    (index < nodes.length() / 5)?>
        .kind: nodes.(index * 5)
        .token: nodes.(index * 5 + 1)
        facts.error_index: token
        (token < 0 \/ token % 1 != 0 \/ token >= rows.length() / 6)?
            @: facts
        .type: 0
        .match: -1
        kind = 1?
            .parameter: 0
            (parameter < parameter_starts.length())?>
                (vkf_utf8_slice(source, rows.(token * 6 + 1), rows.(token * 6 + 2)) =
                    vkf_utf8_slice(source, parameter_starts.(parameter), parameter_stops.(parameter)))?
                    .match: parameter
                .parameter+: 1
            match < 0?
                @: facts
            .type: 3
            vkf_utf8_slice(source, type_starts.(match), type_stops.(match)) = "str"?
                .type: 5
        kind = 2?
            (nodes.(index * 5 + 3) != 0 /\ nodes.(index * 5 + 3) != 1)?
                @: facts
            .type: 2
            nodes.(index * 5 + 3) = 1?
                .type: 1
        (kind = 3 \/ kind = 4 \/ kind = 5 \/ kind = 6)?
            .left: nodes.(index * 5 + 2)
            (left < 0 \/ left % 1 != 0 \/ left >= index)?
                @: facts
        kind = 3?
            (facts.types.(left) != 3 \/
                vkf_utf8_slice(source, rows.(token * 6 + 1), rows.(token * 6 + 2)) != "length")?
                @: facts
            .type: 4
        kind = 4?
            (facts.types.(left) != 4 \/ nodes.(index * 5 + 4) != 0 \/
                nodes.(index * 5 + 3) < 0 \/ nodes.(index * 5 + 3) % 1 != 0 \/
                nodes.(index * 5 + 3) > arguments.length())?
                @: facts
            .type: 1
        kind = 6?
            .type: facts.types.(left)
            .match: facts.parameters.(left)
        kind = 5?
            .right: nodes.(index * 5 + 3)
            (right < 0 \/ right % 1 != 0 \/ right >= index)?
                @: facts
            (rows.(token * 6) != 2 \/
                (facts.types.(left) != 1 /\ facts.types.(left) != 2) \/
                (facts.types.(right) != 1 /\ facts.types.(right) != 2))?
                @: facts
            .type: 1
            (facts.types.(left) = 2 \/ facts.types.(right) = 2)?
                .type: 2
        type = 0?
            @: facts
        facts.types: facts.types & [type]
        facts.parameters: facts.parameters & [match]
        .index+: 1
    facts.valid: true
    facts

TypeName: (name:str)
FunctionSignature: (params:any, return_type:str, type:str)
TypedModule: (kind:str, body:any)
TypedBlock: (kind:str, body:any)
TypedConst: (kind:str, value:any, type:str)
TypedLoad: (kind:str, name:str, type:str)
TypedCall: (kind:str, callee:any, args:any, type:str)
TypedStoreBinding: (kind:str, name:str, value:any, type:str)
TypedFunction: (kind:str, name:str, params:any, return_type:str, signature:FunctionSignature, body:TypedBlock, type:str)
TypedParam: (kind:str, name:str, type:str)
TypedReturn: (kind:str, value:any, type:str)
TypedExprStmt: (kind:str, expr:any)
TypedList: (kind:str, items:any, element_type:str, type:str)
TypedRecord: (kind:str, fields:any, type:str)
TypedFieldAccess: (kind:str, object:any, field:str, object_type:str, type:str)
TypedTaggedModule: (kind:str, source:str, statements:[num], count:int)
TypedTaggedNestedAddition: (kind:str, values:[num:3], type:str)
TypedTaggedDependencyChain: (kind:str, values:[num:4], type:str)
TypedTaggedDynamicArithmetic: (kind:str, values:[num:5], type:str)
TypedTaggedDynamicAddition: (kind:str, values:[num], type:str)
TypedTaggedDynamicMixedArithmetic: (
    kind:str, operators:[num], values:[num], type:str
)
TypedTaggedDynamicGroupedArithmetic: (
    kind:str, tokens:[num], values:[num], type:str
)
TypedTaggedBinaryOp: (
    kind:str,
    left:TypedLoad,
    left_type:str,
    op:str,
    right:TypedConst,
    right_type:str,
    type:str
)
TaggedAstLocation: (file:str, line:num, column:num)
TaggedAstSpan: (start:TaggedAstLocation, stop:TaggedAstLocation)
TypedTaggedCursorModule: (
    kind:str,
    source:str,
    node_rows:[num],
    node_count:int,
    block_rows:[num],
    block_count:int,
    span:TaggedAstSpan
)
TypedTaggedCursorNode: (
    kind:str,
    order:int,
    depth:int,
    parent_order:int,
    type:str,
    span:TaggedAstSpan
)
TypedTaggedIntConst: (kind:str, value:num, type:str)
TypedTaggedAstBinaryOp: (
    kind:str,
    left:TypedLoad,
    left_type:str,
    op:str,
    right:TypedTaggedIntConst,
    right_type:str,
    type:str,
    span:TaggedAstSpan
)
TypedTaggedScalarExpression: (
    kind:str,
    order:int,
    depth:int,
    parent_order:int,
    left_name:str,
    op:str,
    value:num,
    type:str,
    span:TaggedAstSpan
)
TypedTaggedConcreteModule: (
    kind:str,
    source:str,
    token_rows:[num],
    token_count:int,
    node_rows:[num],
    node_count:int,
    block_rows:[num],
    block_count:int,
    payload_rows:[num],
    span:TaggedAstSpan
)
TypedTaggedConcreteNode: (
    kind:str,
    expression_kind:str,
    order:int,
    depth:int,
    parent_order:int,
    identifier_count:num,
    first_text:str,
    second_text:str,
    third_text:str,
    op:str,
    has_number:bit,
    value:num,
    type:str,
    span:TaggedAstSpan
)
TypedTaggedDeclarationTable: (
    module:TypedTaggedConcreteModule,
    rows:[num],
    count:int,
    imports_system:bit
)
TypedTaggedDeclaration: (
    kind:str,
    node_order:int,
    name:str,
    parameter_name:str,
    parameter_type:str,
    return_type:str,
    type:str,
    arity:int
)
TypedTaggedResolvedCall: (
    kind:str,
    node_order:int,
    callee:str,
    callee_type:str,
    argument_count:int,
    result_type:str,
    span:TaggedAstSpan
)
TypedTaggedParameterArena: (
    declarations:TypedTaggedDeclarationTable,
    rows:[int],
    count:int
)
TypedTaggedParameter: (
    kind:str,
    declaration_order:int,
    position:int,
    name:str,
    type:str
)
TypedTaggedArgumentArena: (
    module:TypedTaggedConcreteModule,
    call:TypedTaggedResolvedCall,
    rows:[int],
    count:int
)
TypedTaggedArgument: (
    kind:str,
    call_order:int,
    position:int,
    expression_kind:str,
    name:str,
    op:str,
    type:str,
    has_value:bit,
    value:num,
    values:[num],
    token_start:int,
    token_stop:int
)
TypedTaggedFunctionBodyArena: (
    module:TypedTaggedConcreteModule,
    function_order:int,
    rows:[int],
    count:int
)
TypedTaggedStoreBinding: (
    kind:str,
    name:str,
    value:TypedTaggedIntConst,
    type:str,
    span:TaggedAstSpan
)
FunctionSymbol: (name:str, param_types:any, return_type:str, signature:str)
SymbolicTypeFacts: (symbolic:bit, shape:str, surface:str, scalar_domain:str, base_surface:str, exponent_surface:str, domain_surface:str, codomain_surface:str)
TypedExpressionFacts: (mode:str, value_type:str, symbolic_type:SymbolicTypeFacts, symbolic_node_kind:str, free_variables:any)

type_name(name:str):
    (name: name,)

function_signature(params:any, return_type:str):
    (
        params: params,
        return_type: return_type,
        type: "function signature"
    )

typed_module(body:any):
    (kind: "typed_module", body: body)

typed_empty_module():
    typed_module([])

typed_scalar_binding_output(binding_name:str, value:num):
    binding: (
        kind:"store_binding",
        name:binding_name,
        type:"int",
        update:false,
        value:typed_const(value, "int")
    )
    output: (
        arg_types:["int"],
        args:[typed_load(binding_name, "int")],
        callee:(
            full_name:"io.print",
            kind:"stdlib_function",
            module:"io",
            name:"print",
            type:"fn(any)->any"
        ),
        callee_type:"fn(any)->any",
        kind:"call",
        named_args:[],
        spread_args:[],
        type:"any"
    )
    typed_module([binding, (expr:output, kind:"expr_stmt")])

typed_block(body:any):
    (kind: "block", body: body)

typed_const(value:any, type:str):
    (kind: "const", value: value, type: type)

typed_load(name:str, type:str):
    (kind: "load", name: name, type: type)

typed_call(callee:any, args:any):
    (kind: "call", callee: callee, args: args, arg_types: [], callee_type: callee.type, type: "any")

typed_store_binding(name:str, value:any, type:str):
    (kind: "store_binding", name: name, value: value, type: type)

typed_param(name:str, type:str):
    (kind: "param", name: name, type: type)

typed_function(name:str, params:any, return_type:str, signature:FunctionSignature, body:TypedBlock):
    (
        kind: "function",
        name: name,
        params: params,
        return_type: return_type,
        signature: signature,
        body: body,
        type: signature.type
    )

typed_return(value:any, type:str):
    (kind: "return", value: value, type: type)

typed_expr_stmt(expr:any):
    (kind: "expr_stmt", expr: expr)

typed_list(items:any, element_type:str):
    (kind: "list", items: items, element_type: element_type, type: "list")

typed_record(fields:any, type:str):
    (kind: "record", fields: fields, type: type)

typed_field_access(object:any, field:str, object_type:str, type:str):
    (kind: "field_access", object: object, field: field, object_type: object_type, type: type)

typed_tagged_module(
    source:str, statements:[num], count:int
) -> TypedTaggedModule:
    (
        kind:"typed_module",
        source:source,
        statements:statements,
        count:count
    )

typed_tagged_nested_addition(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "nested_addition")?! "typed nested addition input has the wrong kind"
    (kind:"typed_nested_addition", values:values, type:"int")

typed_tagged_add_multiply(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_multiply")?! "typed mixed arithmetic input has the wrong kind"
    (kind:"typed_add_multiply", values:values, type:"int")

typed_tagged_add_subtract(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_subtract")?! "typed mixed subtraction input has the wrong kind"
    (kind:"typed_add_subtract", values:values, type:"int")

typed_tagged_add_divide(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_divide")?! "typed division input has the wrong kind"
    (kind:"typed_add_divide", values:values, type:"int")

typed_tagged_add_remainder(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_remainder")?! "typed remainder input has the wrong kind"
    (kind:"typed_add_remainder", values:values, type:"int")

typed_tagged_add_power(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_power")?! "typed power input has the wrong kind"
    (kind:"typed_add_power", values:values, type:"int")

typed_tagged_add_floor_divide(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "add_floor_divide")?! "typed floor division input has the wrong kind"
    (kind:"typed_add_floor_divide", values:values, type:"int")

typed_tagged_grouped_add_floor_divide(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "grouped_add_floor_divide")?! "typed grouped addition input has the wrong kind"
    (kind:"typed_grouped_add_floor_divide", values:values, type:"int")

typed_tagged_extended_arithmetic(
    kind:str, values:[num:4]
) -> TypedTaggedDependencyChain:
    (kind = "extended_arithmetic")?! "typed extended arithmetic input has the wrong kind"
    (kind:"typed_extended_arithmetic", values:values, type:"int")

typed_tagged_dynamic_arithmetic(
    kind:str, values:[num:5]
) -> TypedTaggedDynamicArithmetic:
    (kind = "dynamic_arithmetic")?! "typed dynamic arithmetic input has the wrong kind"
    (kind:"typed_dynamic_arithmetic", values:values, type:"int")

typed_tagged_dynamic_addition(
    kind:str, values:[num]
) -> TypedTaggedDynamicAddition:
    (kind = "dynamic_addition")?! "typed dynamic addition input has the wrong kind"
    (values.length() >= 2)?! "typed dynamic addition needs at least two operands"
    (kind:"typed_dynamic_addition", values:values, type:"int")

typed_tagged_dynamic_mixed_arithmetic(
    kind:str, operators:[num], values:[num]
) -> TypedTaggedDynamicMixedArithmetic:
    (kind = "dynamic_mixed_arithmetic")?! "typed dynamic mixed arithmetic input has the wrong kind"
    (values.length() = operators.length() + 1)?! "typed dynamic mixed arithmetic has imbalanced operands"
    (operators.length() >= 1)?! "typed dynamic mixed arithmetic needs an operator"
    (
        kind:"typed_dynamic_mixed_arithmetic",
        operators:operators,
        values:values,
        type:"int"
    )

typed_tagged_dynamic_grouped_arithmetic(
    kind:str, tokens:[num], values:[num]
) -> TypedTaggedDynamicGroupedArithmetic:
    (kind = "dynamic_grouped_arithmetic")?! "typed dynamic grouped arithmetic input has the wrong kind"
    (tokens.length() = values.length())?! "typed dynamic grouped arithmetic has imbalanced tapes"
    (tokens.length() >= 3)?! "typed dynamic grouped arithmetic needs a grouped expression"
    (
        kind:"typed_dynamic_grouped_arithmetic",
        tokens:tokens,
        values:values,
        type:"int"
    )

typed_tagged_derived_binding_addition(
    kind:str, values:[num:3]
) -> TypedTaggedNestedAddition:
    (kind = "derived_binding_addition")?! "typed derived binding input has the wrong kind"
    (kind:"typed_derived_binding_addition", values:values, type:"int")

typed_tagged_two_derived_bindings(
    kind:str, values:[num:4]
) -> TypedTaggedDependencyChain:
    (kind = "two_derived_bindings")?! "typed dependency chain input has the wrong kind"
    (kind:"typed_two_derived_bindings", values:values, type:"int")

typed_tagged_operator(operator_code:num) -> str:
    operator_code??
        1 => "PLUS"
        3 => "MINUS"
        4 => "STAR"
        5 => "SLASH"
        6 => "PERCENT"
        7 => "CARET"
        8 => "FLOORDIV"
        "UNKNOWN"

typed_tagged_module_statement(
    module:TypedTaggedModule, index:int
) -> TypedTaggedBinaryOp:
    offset: index * 8
    (
        kind:"binary_op",
        left:typed_load(
            vkf_utf8_slice(
                module.source,
                module.statements.(offset),
                module.statements.(offset + 1)
            ),
            "any"
        ),
        left_type:"any",
        op:typed_tagged_operator(module.statements.(offset + 2)),
        right:typed_const(module.statements.(offset + 3), "int"),
        right_type:"int",
        type:"any"
    )

typed_tagged_cursor_kind(kind_code:num) -> str:
    kind_code??
        1 => "store_binding"
        2 => "function"
        3 => "expr_stmt"
        4 => "expr_stmt"
        5 => "store_binding"
        6 => "if_stmt"
        7 => "return"
        "unsupported"

typed_tagged_cursor_ast_module(
    source:str, node_rows:[num], node_count:int,
    block_rows:[num], block_count:int, file:str,
    start_line:num, start_column:num, stop_line:num, stop_column:num
) -> TypedTaggedCursorModule:
    (node_rows.length() = node_count * 10)?! "typed tagged AST node arena has an invalid shape"
    (block_rows.length() = block_count * 8)?! "typed tagged AST block arena has an invalid shape"
    (
        kind:"typed_module",
        source:source,
        node_rows:node_rows,
        node_count:node_count,
        block_rows:block_rows,
        block_count:block_count,
        span:(
            start:(file:file, line:start_line, column:start_column),
            stop:(file:file, line:stop_line, column:stop_column)
        )
    )

typed_tagged_cursor_node(
    module:TypedTaggedCursorModule, index:int
) -> TypedTaggedCursorNode:
    (index >= 0 /\ index < module.node_count)?! "typed tagged AST node index is out of bounds"
    offset: index * 10
    kind: typed_tagged_cursor_kind(module.node_rows.(offset + 3))
    (kind != "unsupported")?! "typed tagged AST contains an unsupported statement kind"
    (
        kind:kind,
        order:index,
        depth:module.node_rows.(offset + 4),
        parent_order:module.node_rows.(offset + 5),
        type:"any",
        span:(
            start:(
                file:module.span.start.file,
                line:module.node_rows.(offset + 6),
                column:module.node_rows.(offset + 7)
            ),
            stop:(
                file:module.span.start.file,
                line:module.node_rows.(offset + 8),
                column:module.node_rows.(offset + 9)
            )
        )
    )

typed_tagged_cursor_numeric_expression(
    name:str, operator_kind:str, value:num,
    parameter_name:str, parameter_type:str, file:str,
    start_line:num, start_column:num, stop_line:num, stop_column:num
) -> TypedTaggedAstBinaryOp:
    (name = parameter_name)?! "typed tagged expression identifier is not a declared parameter"
    (parameter_type != "")?! "typed tagged expression parameter type is empty"
    (operator_kind != "UNKNOWN")?! "typed tagged expression operator is unsupported"
    (
        kind:"binary_op",
        left:(kind:"load", name:name, type:parameter_type),
        left_type:parameter_type,
        op:operator_kind,
        right:(kind:"const", value:value, type:"int"),
        right_type:"int",
        type:parameter_type,
        span:(
            start:(file:file, line:start_line, column:start_column),
            stop:(file:file, line:stop_line, column:stop_column)
        )
    )

typed_tagged_scalar_expression_kind(
    identifier_count:num, operator_kind:str
) -> str:
    (identifier_count = 0 /\ operator_kind = "UNKNOWN")?
        @: "const"
    (identifier_count = 1 /\ operator_kind != "UNKNOWN")?
        @: "binary_op"
    false?! "typed tagged scalar expression shape is unsupported"
    "unsupported"

typed_tagged_cursor_scalar_expression(
    statement_kind:str, order:int, depth:int, parent_order:int,
    identifier_count:int, first_text:str, operator_kind:str,
    has_number:bit, value:num, parameter_name:str, parameter_type:str,
    file:str, start_line:num, start_column:num,
    stop_line:num, stop_column:num
) -> TypedTaggedScalarExpression:
    (statement_kind = "expression")?! "typed tagged scalar node is not an expression"
    has_number?! "typed tagged scalar expression has no numeric value"
    (parameter_type != "")?! "typed tagged scalar expression type is empty"
    expression_kind: typed_tagged_scalar_expression_kind(
        identifier_count, operator_kind
    )
    (expression_kind = "binary_op")?
        (first_text = parameter_name)?! "typed tagged expression identifier is not a declared parameter"
    (
        kind:expression_kind,
        order:order,
        depth:depth,
        parent_order:parent_order,
        left_name:first_text,
        op:operator_kind,
        value:value,
        type:parameter_type,
        span:(
            start:(file:file, line:start_line, column:start_column),
            stop:(file:file, line:stop_line, column:stop_column)
        )
    )

typed_tagged_cursor_operator_kind(kind_code:num) -> str:
    kind_code??
        2 => "PLUS"
        7 => "STAR"
        8 => "MINUS"
        9 => "SLASH"
        10 => "PERCENT"
        11 => "CARET"
        12 => "FLOORDIV"
        17 => "GT"
        "UNKNOWN"

typed_tagged_concrete_kind(kind_code:num) -> str:
    kind_code??
        1 => "import"
        2 => "function"
        3 => "expr_stmt"
        4 => "expr_stmt"
        5 => "store_binding"
        6 => "if_stmt"
        7 => "return"
        "unsupported"

typed_tagged_concrete_type(kind_code:num, has_number:num) -> str:
    (kind_code = 5 /\ has_number = 1)?
        @: "int"
    kind_code = 6?
        @: "bit"
    kind_code = 7?
        @: "num"
    kind_code??
        1 => "module"
        2 => "function"
        3 => "num"
        4 => "unresolved"
        5 => "unresolved"
        "unsupported"

typed_tagged_concrete_expression_kind(
    statement_code:num, identifier_count:num, operator_code:num
) -> str:
    statement_code = 3?
        @: typed_tagged_scalar_expression_kind(
            identifier_count,
            typed_tagged_cursor_operator_kind(operator_code)
        )
    statement_code = 4?
        @: "call"
    statement_code = 6?
        @: "binary_op"
    statement_code = 7?
        @: "const"
    "none"

typed_tagged_cursor_concrete_module(
    source:str, token_rows:[num], token_count:int,
    node_rows:[num], node_count:int,
    block_rows:[num], block_count:int, payload_rows:[num],
    file:str, start_line:num, start_column:num,
    stop_line:num, stop_column:num
) -> TypedTaggedConcreteModule:
    (token_rows.length() = token_count * 6)?! "concrete typed token arena has an invalid shape"
    (node_rows.length() = node_count * 10)?! "concrete typed node arena has an invalid shape"
    (block_rows.length() = block_count * 8)?! "concrete typed block arena has an invalid shape"
    (payload_rows.length() = node_count * 7)?! "concrete typed payload arena has an invalid shape"
    (
        kind:"typed_module",
        source:source,
        token_rows:token_rows,
        token_count:token_count,
        node_rows:node_rows,
        node_count:node_count,
        block_rows:block_rows,
        block_count:block_count,
        payload_rows:payload_rows,
        span:(
            start:(file:file, line:start_line, column:start_column),
            stop:(file:file, line:stop_line, column:stop_column)
        )
    )

typed_tagged_concrete_payload_text(
    module:TypedTaggedConcreteModule, token_index:num
) -> str:
    token_index < 0?
        @: vkf_utf8_slice(module.source, 0, 0)
    token_offset: token_index * 6
    vkf_utf8_slice(
        module.source,
        module.token_rows.(token_offset + 1),
        module.token_rows.(token_offset + 2)
    )

typed_tagged_cursor_concrete_node(
    module:TypedTaggedConcreteModule, index:int
) -> TypedTaggedConcreteNode:
    (index >= 0 /\ index < module.node_count)?! "concrete typed node index is out of bounds"
    node_offset: index * 10
    payload_offset: index * 7
    statement_code: module.node_rows.(node_offset + 3)
    kind: typed_tagged_concrete_kind(statement_code)
    type: typed_tagged_concrete_type(
        statement_code, module.payload_rows.(payload_offset + 5)
    )
    (kind != "unsupported" /\ type != "unsupported")?! "concrete typed node has an unsupported statement kind"
    (
        kind:kind,
        expression_kind:typed_tagged_concrete_expression_kind(
            statement_code,
            module.payload_rows.(payload_offset),
            module.payload_rows.(payload_offset + 4)
        ),
        order:index,
        depth:module.node_rows.(node_offset + 4),
        parent_order:module.node_rows.(node_offset + 5),
        identifier_count:module.payload_rows.(payload_offset),
        first_text:typed_tagged_concrete_payload_text(
            module, module.payload_rows.(payload_offset + 1)
        ),
        second_text:typed_tagged_concrete_payload_text(
            module, module.payload_rows.(payload_offset + 2)
        ),
        third_text:typed_tagged_concrete_payload_text(
            module, module.payload_rows.(payload_offset + 3)
        ),
        op:typed_tagged_cursor_operator_kind(
            module.payload_rows.(payload_offset + 4)
        ),
        has_number:module.payload_rows.(payload_offset + 5),
        value:module.payload_rows.(payload_offset + 6),
        type:type,
        span:(
            start:(
                file:module.span.start.file,
                line:module.node_rows.(node_offset + 6),
                column:module.node_rows.(node_offset + 7)
            ),
            stop:(
                file:module.span.start.file,
                line:module.node_rows.(node_offset + 8),
                column:module.node_rows.(node_offset + 9)
            )
        )
    )

typed_tagged_function_returns_num(
    module:TypedTaggedConcreteModule, function_order:int
) -> bit:
    int index: function_order + 1
    bit has_child: false
    (index < module.node_count)?>
        module.node_rows.(index * 10 + 5) = function_order?
            statement_code: module.node_rows.(index * 10 + 3)
            (statement_code = 3 \/ statement_code = 6 \/ statement_code = 7)?! "concrete function body contains an unsupported statement"
            (typed_tagged_concrete_expression_kind(
                statement_code,
                module.payload_rows.(index * 7),
                module.payload_rows.(index * 7 + 4)
            ) != "none")?! "concrete function expression type is unresolved"
            .has_child: true
        .index+: 1
    has_child

typed_tagged_declaration_table(
    module:TypedTaggedConcreteModule
) -> TypedTaggedDeclarationTable:
    [num] rows: []
    int count: 0
    bit imports_system: false
    int index: 0
    num node_offset: 0
    num payload_offset: 0
    num statement_code: 0
    (index < module.node_count)?>
        .node_offset: index * 10
        .payload_offset: index * 7
        .statement_code: module.node_rows.(node_offset + 3)
        statement_code = 1?
            typed_tagged_concrete_payload_text(
                module, module.payload_rows.(payload_offset + 1)
            ) = "system"?
                .imports_system: true
        statement_code = 2?
            (module.payload_rows.(payload_offset) >= 3 /\ module.payload_rows.(payload_offset) % 2 = 1)?! "concrete function declaration shape is unsupported"
            typed_tagged_function_returns_num(module, index)?! "concrete function return type is unresolved"
            .rows: rows & [
                index,
                module.payload_rows.(payload_offset + 1),
                module.payload_rows.(payload_offset + 2),
                module.payload_rows.(payload_offset + 3),
                (module.payload_rows.(payload_offset) - 1) / 2,
                1
            ]
            .count+: 1
        .index+: 1
    (
        module:module,
        rows:rows,
        count:count,
        imports_system:imports_system
    )

typed_tagged_declaration(
    table:TypedTaggedDeclarationTable, index:num
) -> TypedTaggedDeclaration:
    (index >= 0 /\ index < table.count)?! "concrete declaration index is out of bounds"
    offset: index * 6
    parameter_type: typed_tagged_concrete_payload_text(
        table.module, table.rows.(offset + 3)
    )
    (parameter_type = "num")?! "concrete declaration parameter type is unsupported"
    (table.rows.(offset + 5) = 1)?! "concrete declaration return type is unsupported"
    str declaration_type: "fn("
    int signature_index: 0
    (signature_index < table.rows.(offset + 4))?>
        signature_index > 0?
            .declaration_type: declaration_type & ","
        .declaration_type: declaration_type & "num"
        .signature_index+: 1
    .declaration_type: declaration_type & ")->num"
    (
        kind:"function_symbol",
        node_order:table.rows.(offset),
        name:typed_tagged_concrete_payload_text(
            table.module, table.rows.(offset + 1)
        ),
        parameter_name:typed_tagged_concrete_payload_text(
            table.module, table.rows.(offset + 2)
        ),
        parameter_type:parameter_type,
        return_type:"num",
        type:declaration_type,
        arity:table.rows.(offset + 4)
    )

typed_tagged_declaration_name(
    table:TypedTaggedDeclarationTable, index:int
) -> str:
    (index >= 0 /\ index < table.count)?! "concrete declaration index is out of bounds"
    typed_tagged_concrete_payload_text(
        table.module, table.rows.(index * 6 + 1)
    )

_typed_tagged_call_argument_rows(
    module:TypedTaggedConcreteModule, node_index:int
) -> [int]:
    node_offset: node_index * 10
    token_index: module.node_rows.(node_offset)
    token_stop: module.node_rows.(node_offset + 1)
    depth: 0
    bracket_depth: 0
    argument_start: -1
    token_kind: 0
    [int] rows: []
    (token_index <= token_stop)?>
        .token_kind: module.token_rows.(token_index * 6)
        token_kind = 13?
            .depth+: 1
            depth = 1?
                .argument_start: token_index + 1
        token_kind = 22?
            .bracket_depth+: 1
        token_kind = 23?
            .bracket_depth-: 1
        (token_kind = 24 /\ depth = 1 /\ bracket_depth = 0)?
            (argument_start >= 0 /\ token_index > argument_start)?! "concrete call has an empty argument"
            .rows: rows & [argument_start, token_index - 1]
            .argument_start: token_index + 1
        token_kind = 14?
            depth = 1?
                argument_start >= 0 /\ token_index > argument_start?
                    .rows: rows & [argument_start, token_index - 1]
                .argument_start: -1
            .depth-: 1
        .token_index+: 1
    (depth = 0 /\ bracket_depth = 0 /\ argument_start = -1)?! "concrete call argument list is unbalanced"
    rows

_typed_tagged_declaration_signature(
    declarations:TypedTaggedDeclarationTable, declaration_index:int
) -> str:
    declaration: typed_tagged_declaration(declarations, declaration_index)
    parameters: typed_tagged_parameter_arena(declarations)
    str signature: "fn("
    int parameter_index: 0
    int matched_count: 0
    (parameter_index < parameters.count)?>
        parameter: typed_tagged_parameter(parameters, parameter_index)
        parameter.declaration_order = declaration.node_order?
            matched_count > 0?
                .signature: signature & ","
            .signature: signature & parameter.type
            .matched_count+: 1
        .parameter_index+: 1
    (matched_count = declaration.arity)?! "concrete declaration signature lost parameter identity"
    signature & ")->" & declaration.return_type

typed_tagged_resolve_output_call(
    module:TypedTaggedConcreteModule,
    declarations:TypedTaggedDeclarationTable,
    node_index:int
) -> TypedTaggedResolvedCall:
    output: typed_tagged_cursor_concrete_node(module, node_index)
    (output.expression_kind = "call")?! "concrete output node is not a call"
    declarations.imports_system?! "concrete nested system call has no system import"
    int declaration_index: 0
    int resolved_index: -1
    (declaration_index < declarations.count)?>
        typed_tagged_declaration_name(
            declarations, declaration_index
        ) = output.first_text?
            .resolved_index: declaration_index
        .declaration_index+: 1
    (resolved_index >= 0)?! "concrete call target is not declared"
    symbol: typed_tagged_declaration(declarations, resolved_index)
    argument_rows: _typed_tagged_call_argument_rows(module, node_index)
    argument_count: argument_rows.length() / 2
    (symbol.parameter_type = "num" /\ symbol.arity = argument_count)?! "concrete call argument does not match declaration"
    (
        kind:"call",
        node_order:node_index,
        callee:symbol.name,
        callee_type:_typed_tagged_declaration_signature(declarations, resolved_index),
        argument_count:argument_count,
        result_type:symbol.return_type,
        span:output.span
    )

_typed_tagged_parameter_rows(
    declarations:TypedTaggedDeclarationTable,
    declaration_index:int,
    position:int,
    rows:[int]
) -> [int]:
    declaration_index >= declarations.count?
        @: rows
    declaration: typed_tagged_declaration(declarations, declaration_index)
    position < declaration.arity?
        @: _typed_tagged_parameter_rows(
            declarations, declaration_index, position + 1,
            rows & [declaration_index, position]
        )
    _typed_tagged_parameter_rows(
        declarations, declaration_index + 1, 0, rows
    )

typed_tagged_parameter_arena(
    declarations:TypedTaggedDeclarationTable
) -> TypedTaggedParameterArena:
    [int] rows: []
    .rows: _typed_tagged_parameter_rows(declarations, 0, 0, rows)
    (
        declarations:declarations,
        rows:rows,
        count:rows.length() / 2
    )

_typed_tagged_parameter_type(
    module:TypedTaggedConcreteModule, type_token:int
) -> str:
    type_kind: module.token_rows.(type_token * 6)
    type_kind = 1?
        @: typed_tagged_concrete_payload_text(module, type_token)
    type_kind = 22?
        (module.token_rows.((type_token + 1) * 6) = 1 /\ module.token_rows.((type_token + 2) * 6) = 23)?! "concrete vector parameter type is malformed"
        @: vkf_utf8_slice(
            module.source,
            module.token_rows.(type_token * 6 + 1),
            module.token_rows.((type_token + 2) * 6 + 2)
        )
    false?! "concrete parameter type token is missing"
    ""

typed_tagged_parameter(
    arena:TypedTaggedParameterArena, index:int
) -> TypedTaggedParameter:
    (index >= 0 /\ index < arena.count)?! "concrete parameter index is out of bounds"
    offset: index * 2
    declaration: typed_tagged_declaration(
        arena.declarations, arena.rows.(offset)
    )
    position: arena.rows.(offset + 1)
    (position >= 0 /\ position < declaration.arity)?! "concrete parameter position is unsupported"
    node_offset: declaration.node_order * 10
    token_index: arena.declarations.module.node_rows.(node_offset)
    token_stop: arena.declarations.module.node_rows.(node_offset + 1)
    found_position: -1
    parameter_token: -1
    previous_kind: 0
    token_kind: 0
    (token_index <= token_stop /\ parameter_token < 0)?>
        .token_kind: arena.declarations.module.token_rows.(token_index * 6)
        (token_kind = 1 /\ (previous_kind = 13 \/ previous_kind = 24))?
            .found_position+: 1
            found_position = position?
                .parameter_token: token_index
        .previous_kind: token_kind
        .token_index+: 1
    (parameter_token >= 0)?! "concrete parameter token is missing"
    type_token: parameter_token + 2
    parameter_type: _typed_tagged_parameter_type(
        arena.declarations.module, type_token
    )
    (
        kind:"parameter",
        declaration_order:declaration.node_order,
        position:position,
        name:typed_tagged_concrete_payload_text(
            arena.declarations.module, parameter_token
        ),
        type:parameter_type
    )

typed_tagged_argument_arena(
    module:TypedTaggedConcreteModule,
    call:TypedTaggedResolvedCall
) -> TypedTaggedArgumentArena:
    (call.node_order >= 0 /\ call.node_order < module.node_count)?! "concrete argument call order is out of bounds"
    [int] rows: []
    .rows: _typed_tagged_call_argument_rows(module, call.node_order)
    (rows.length() / 2 = call.argument_count)?! "concrete argument arena count does not match resolved call"
    (
        module:module,
        call:call,
        rows:rows,
        count:rows.length() / 2
    )

typed_tagged_argument(
    arena:TypedTaggedArgumentArena, index:int
) -> TypedTaggedArgument:
    (index >= 0 /\ index < arena.count)?! "concrete argument index is out of bounds"
    offset: index * 2
    token_start: arena.rows.(offset)
    token_stop: arena.rows.(offset + 1)
    position: index
    first_kind: arena.module.token_rows.(token_start * 6)
    str expression_kind: "unsupported"
    str name: ""
    str op: "UNKNOWN"
    bit has_value: false
    num value: 0
    [num] values: []
    first_kind = 1?
        .name: typed_tagged_concrete_payload_text(arena.module, token_start)
        (token_start < token_stop /\ arena.module.token_rows.((token_start + 1) * 6) = 13)?
            .expression_kind: "call"
        (token_start < token_stop /\ arena.module.token_rows.((token_start + 1) * 6) != 13)?
            .expression_kind: "binary_op"
    first_kind = 3?
        .expression_kind: "const"
        .has_value: true
        .value: arena.module.token_rows.(token_start * 6 + 3)
    first_kind = 22?
        .expression_kind: "collection"
    int token_index: token_start
    token_kind: 0
    (token_index <= token_stop)?>
        .token_kind: arena.module.token_rows.(token_index * 6)
        token_kind = 3?
            .has_value: true
            .value: arena.module.token_rows.(token_index * 6 + 3)
            .values: values & [value]
        typed_tagged_cursor_operator_kind(token_kind) != "UNKNOWN"?
            .op: typed_tagged_cursor_operator_kind(token_kind)
        .token_index+: 1
    op != "UNKNOWN"?
        .expression_kind: "binary_op"
    (expression_kind != "unsupported")?! "concrete call argument expression is unsupported"
    str argument_type: "num"
    expression_kind = "call"?
        .argument_type: "int"
    expression_kind = "collection"?
        .argument_type: "[num]"
    (
        kind:"argument",
        call_order:arena.call.node_order,
        position:position,
        expression_kind:expression_kind,
        name:name,
        op:op,
        type:argument_type,
        has_value:has_value,
        value:value,
        values:values,
        token_start:token_start,
        token_stop:token_stop
    )

_typed_tagged_function_body_rows(
    module:TypedTaggedConcreteModule,
    index:int,
    function_depth:num,
    rows:[int]
) -> [int]:
    index >= module.node_count?
        @: rows
    module.node_rows.(index * 10 + 4) <= function_depth?
        @: rows
    _typed_tagged_function_body_rows(
        module, index + 1, function_depth, rows & [index]
    )

typed_tagged_function_body_arena(
    module:TypedTaggedConcreteModule, function_order:int
) -> TypedTaggedFunctionBodyArena:
    (function_order >= 0 /\ function_order < module.node_count /\ module.node_rows.(function_order * 10 + 3) = 2)?! "concrete function body owner is invalid"
    rows: _typed_tagged_function_body_rows(
        module, function_order + 1,
        module.node_rows.(function_order * 10 + 4), []
    )
    (module:module, function_order:function_order, rows:rows, count:rows.length())

typed_tagged_function_body_node(
    arena:TypedTaggedFunctionBodyArena, index:int
) -> TypedTaggedConcreteNode:
    (index >= 0 /\ index < arena.count)?! "concrete function body index is out of bounds"
    typed_tagged_cursor_concrete_node(arena.module, arena.rows.(index))

typed_tagged_ast_binary_expression(
    name:str, op:str, value:num, file:str,
    start_line:num, start_column:num, stop_line:num, stop_column:num
) -> TypedTaggedAstBinaryOp:
