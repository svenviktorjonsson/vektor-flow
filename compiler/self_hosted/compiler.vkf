_compile_printed_dynamic_power_expression_x64(
    source:str, template_prefix:str, power_tail:str
) -> str:
    statement: compile_tagged_printed_dynamic_mixed_arithmetic(source)
    (statement.opcodes.length() = 4 /\ statement.opcodes.0 = 1 /\
        statement.opcodes.1 = 1 /\ statement.opcodes.2 = 9 /\
        statement.opcodes.3 = 3)?! "runtime power emitter expects load-load-power-print"
    str left_immediate: vkf_utf8_slice(
        "()*+,-./", statement.values.0 - 40, statement.values.0 - 39
    )
    str right_immediate: vkf_utf8_slice(
        "0123456789", statement.values.1, statement.values.1 + 1
    )
    template_prefix & "j" & left_immediate & "j" & right_immediate & power_tail

_compile_x64_byte(value:num) -> str:
    (value >= 0 /\ value <= 127)?
        @: str(chr(value))
    false?! "x64 tracer byte requires raw-byte construction"
    ""

_compile_x64_positive_immediate(value:num) -> str:
    (value >= 0 /\ value <= 2147483647)?! "x64 tracer positive immediate is outside imm32"
    value <= 127?
        @: "j" & _compile_x64_byte(value)
    byte0: value % 256
    byte1: (value // 256) % 256
    byte2: (value // 65536) % 256
    byte3: (value // 16777216) % 256
    (
        "h" & _compile_x64_byte(byte0) & _compile_x64_byte(byte1) &
        _compile_x64_byte(byte2) & _compile_x64_byte(byte3)
    )

_compile_x64_arena_byte(value:num, high_bytes:[str]) -> str:
    value <= 127?
        @: _compile_x64_byte(value)
    (value <= 255 /\ high_bytes.length() = 128)?! "x64 tracer high-byte arena does not cover one byte"
    high_bytes.(value - 128)

_compile_x64_positive_immediate_from_arena(
    value:num, high_bytes:[str]
) -> str:
    (value >= 0 /\ value <= 9007199254740991)?! "x64 tracer positive immediate is outside exact integer range"
    value <= 127?
        @: "j" & _compile_x64_byte(value)
    byte0: value % 256
    byte1: (value // 256) % 256
    byte2: (value // 65536) % 256
    byte3: (value // 16777216) % 256
    value <= 2147483647?
        @: (
            "h" & _compile_x64_arena_byte(byte0, high_bytes) &
            _compile_x64_arena_byte(byte1, high_bytes) &
            _compile_x64_arena_byte(byte2, high_bytes) &
            _compile_x64_arena_byte(byte3, high_bytes)
        )
    byte4: (value // 4294967296) % 256
    byte5: (value // 1099511627776) % 256
    byte6: (value // 281474976710656) % 256
    (
        "H" & _compile_x64_arena_byte(184, high_bytes) &
        _compile_x64_arena_byte(byte0, high_bytes) &
        _compile_x64_arena_byte(byte1, high_bytes) &
        _compile_x64_arena_byte(byte2, high_bytes) &
        _compile_x64_arena_byte(byte3, high_bytes) &
        _compile_x64_arena_byte(byte4, high_bytes) &
        _compile_x64_arena_byte(byte5, high_bytes) &
        _compile_x64_arena_byte(byte6, high_bytes) & _compile_x64_byte(0) & "P"
    )

_compile_printed_dynamic_mixed_expression_x64(
    source:str,
    template_prefix:str,
    addition_code:str,
    multiplication_code:str,
    print_tail:str
) -> str:
    statement: compile_tagged_printed_dynamic_mixed_arithmetic(source)
    (statement.max_stack = 3)?! "mixed x64 tracer stack maximum changed"
    str body: ""
    index: 0
    code: 0
    (index < statement.opcodes.length())?>
        .code: statement.opcodes.(index)
        code = 1?
            .body: body & _compile_x64_positive_immediate(
                statement.values.(index)
            )
        code = 2?
            .body: body & addition_code
        code = 5?
            .body: body & multiplication_code
        code = 3?
            (index + 1 = statement.opcodes.length())?! "mixed x64 tracer print must terminate the tape"
            .body: body & print_tail
        (code = 1 \/ code = 2 \/ code = 3 \/ code = 5)?! "mixed x64 tracer encountered an unsupported opcode"
        .index+: 1
    template_prefix & body

_compile_dynamic_numeric_statement(source:str, grouped:num):
    (grouped = 0 \/ grouped = 1)?! "numeric x64 tracer grouping selector is invalid"
    grouped = 1?
        @: compile_tagged_printed_dynamic_grouped_arithmetic(source)
    compile_tagged_printed_dynamic_mixed_arithmetic(source)

_compile_printed_dynamic_numeric_tape_x64(
    source:str,
    grouped:num,
    template_prefix:str,
    addition_code:str,
    floating_left_integer_addition_code:str,
    integer_left_floating_addition_code:str,
    floating_addition_code:str,
    multiplication_code:str,
    floating_left_integer_multiplication_code:str,
    integer_left_floating_multiplication_code:str,
    floating_multiplication_code:str,
    subtraction_code:str,
    floating_left_integer_subtraction_code:str,
    integer_left_floating_subtraction_code:str,
    floating_subtraction_code:str,
    division_code:str,
    floating_left_integer_division_code:str,
    integer_left_floating_division_code:str,
    floating_division_code:str,
    power_code:str,
    floor_division_code:str,
    remainder_code:str,
    integer_print_tail:str,
    floating_print_tail:str,
    high_bytes:[str],
    negate_code:str="",
    floating_negate_code:str=""
) -> str:
    statement: _compile_dynamic_numeric_statement(source, grouped)
    (statement.max_stack >= 2 /\ statement.max_stack <= 3)?! "integer x64 tracer stack maximum changed"
    str body: ""
    index: 0
    code: 0
    binary: 0
    representation_depth: 0
    representation0: 0
    representation1: 0
    representation2: 0
    left_representation: 0
    right_representation: 0
    result_representation: 0
    operand_representation: 0
    (index < statement.opcodes.length())?>
        .code: statement.opcodes.(index)
        .binary: code = 2 \/ code = 4 \/ code = 5 \/ code = 6 \/ code = 7 \/ code = 8 \/ code = 9
        .left_representation: 0
        .right_representation: 0
        .result_representation: 0
        .operand_representation: 0
        binary = 1?
            (representation_depth >= 2)?! "numeric x64 tracer representation stack underflow"
            representation_depth = 2?
                .left_representation: representation0
                .right_representation: representation1
            representation_depth = 3?
                .left_representation: representation1
                .right_representation: representation2
        code = 1?
            .body: body & _compile_x64_positive_immediate_from_arena(
                statement.values.(index), high_bytes
            )
            representation_depth = 0?
                .representation0: 0
            representation_depth = 1?
                .representation1: 0
            representation_depth = 2?
                .representation2: 0
            .representation_depth+: 1
        code = 2?
            left_representation = 0 /\ right_representation = 0?
                .body: body & addition_code
            left_representation = 1 /\ right_representation = 0?
                (~(floating_left_integer_addition_code = ""))?! "numeric x64 tracer float-integer addition code is missing"
                .body: body & floating_left_integer_addition_code
                .result_representation: 1
            left_representation = 0 /\ right_representation = 1?
                (~(integer_left_floating_addition_code = ""))?! "numeric x64 tracer integer-float addition code is missing"
                .body: body & integer_left_floating_addition_code
                .result_representation: 1
            left_representation = 1 /\ right_representation = 1?
                (~(floating_addition_code = ""))?! "numeric x64 tracer floating addition code is missing"
                .body: body & floating_addition_code
                .result_representation: 1
            ((left_representation = 0 /\ right_representation = 0) \/
                (left_representation = 1 /\ right_representation = 0) \/
                (left_representation = 0 /\ right_representation = 1) \/
                (left_representation = 1 /\ right_representation = 1))?! "numeric x64 tracer addition representations are unsupported"
        code = 4?
            (left_representation = 0 /\ right_representation = 0)?! "numeric x64 tracer floor division requires integer operands"
            (~(floor_division_code = ""))?! "integer x64 tracer floor-division code is missing"
            .body: body & floor_division_code
        code = 5?
            left_representation = 0 /\ right_representation = 0?
                .body: body & multiplication_code
            left_representation = 1 /\ right_representation = 0?
                (~(floating_left_integer_multiplication_code = ""))?! "numeric x64 tracer float-integer multiplication code is missing"
                .body: body & floating_left_integer_multiplication_code
                .result_representation: 1
            left_representation = 0 /\ right_representation = 1?
                (~(integer_left_floating_multiplication_code = ""))?! "numeric x64 tracer integer-float multiplication code is missing"
                .body: body & integer_left_floating_multiplication_code
                .result_representation: 1
            left_representation = 1 /\ right_representation = 1?
                (~(floating_multiplication_code = ""))?! "numeric x64 tracer floating multiplication code is missing"
                .body: body & floating_multiplication_code
                .result_representation: 1
            ((left_representation = 0 /\ right_representation = 0) \/
                (left_representation = 1 /\ right_representation = 0) \/
                (left_representation = 0 /\ right_representation = 1) \/
                (left_representation = 1 /\ right_representation = 1))?! "numeric x64 tracer multiplication representations are unsupported"
        code = 6?
            left_representation = 0 /\ right_representation = 0?
                .body: body & subtraction_code
            left_representation = 1 /\ right_representation = 0?
                (~(floating_left_integer_subtraction_code = ""))?! "numeric x64 tracer float-integer subtraction code is missing"
                .body: body & floating_left_integer_subtraction_code
                .result_representation: 1
            left_representation = 0 /\ right_representation = 1?
                (~(integer_left_floating_subtraction_code = ""))?! "numeric x64 tracer integer-float subtraction code is missing"
                .body: body & integer_left_floating_subtraction_code
                .result_representation: 1
            left_representation = 1 /\ right_representation = 1?
                (~(floating_subtraction_code = ""))?! "numeric x64 tracer floating subtraction code is missing"
                .body: body & floating_subtraction_code
                .result_representation: 1
            ((left_representation = 0 /\ right_representation = 0) \/
                (left_representation = 1 /\ right_representation = 0) \/
                (left_representation = 0 /\ right_representation = 1) \/
                (left_representation = 1 /\ right_representation = 1))?! "numeric x64 tracer subtraction representations are unsupported"
        code = 7?
            left_representation = 0 /\ right_representation = 0?
                (~(division_code = ""))?! "numeric x64 tracer division code is missing"
                .body: body & division_code
                .result_representation: 1
            left_representation = 1 /\ right_representation = 0?
                (~(floating_left_integer_division_code = ""))?! "numeric x64 tracer float-integer division code is missing"
                .body: body & floating_left_integer_division_code
                .result_representation: 1
            left_representation = 0 /\ right_representation = 1?
                (~(integer_left_floating_division_code = ""))?! "numeric x64 tracer integer-float division code is missing"
                .body: body & integer_left_floating_division_code
                .result_representation: 1
            left_representation = 1 /\ right_representation = 1?
                (~(floating_division_code = ""))?! "numeric x64 tracer floating division code is missing"
                .body: body & floating_division_code
                .result_representation: 1
            ((left_representation = 0 /\ right_representation = 0) \/
                (left_representation = 1 /\ right_representation = 0) \/
                (left_representation = 0 /\ right_representation = 1) \/
                (left_representation = 1 /\ right_representation = 1))?! "numeric x64 tracer division representations are unsupported"
        code = 8?
            (left_representation = 0 /\ right_representation = 0)?! "numeric x64 tracer remainder requires integer operands"
            (~(remainder_code = ""))?! "integer x64 tracer remainder code is missing"
            .body: body & remainder_code
        code = 9?
            (left_representation = 0 /\ right_representation = 0)?! "numeric x64 tracer power requires integer operands"
            (~(power_code = ""))?! "integer x64 tracer power code is missing"
            .body: body & power_code
        code = 10?
            (representation_depth >= 1)?! "numeric x64 tracer negation stack underflow"
            representation_depth = 1?
                .operand_representation: representation0
            representation_depth = 2?
                .operand_representation: representation1
            representation_depth = 3?
                .operand_representation: representation2
            operand_representation = 0?
                (~(negate_code = ""))?! "numeric x64 tracer negation code is missing"
                .body: body & negate_code
            operand_representation = 1?
                (~(floating_negate_code = ""))?! "numeric x64 tracer floating negation code is missing"
                .body: body & floating_negate_code
            (operand_representation = 0 \/ operand_representation = 1)?! "numeric x64 tracer negation representation is unsupported"
        binary = 1?
            .representation_depth-: 1
            representation_depth = 1?
                .representation0: result_representation
            representation_depth = 2?
                .representation1: result_representation
        code = 3?
            (index + 1 = statement.opcodes.length())?! "integer x64 tracer print must terminate the tape"
            (representation_depth = 1)?! "numeric x64 tracer print representation stack is imbalanced"
            representation0 = 1?
                .body: body & floating_print_tail
            representation0 = 0?
                .body: body & integer_print_tail
