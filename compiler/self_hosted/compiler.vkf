compile_tagged_printed_dynamic_arithmetic(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_printed_dynamic_arithmetic(
        tokens.source, tokens.rows, tokens.count
    )
    expression: typed.typed_tagged_dynamic_arithmetic(
        parsed.kind, parsed.values
    )
    statement: mir.mir_tagged_dynamic_arithmetic(expression.values)
    maximum: validation.machine_ir_arithmetic_opcode_tape_stack_maximum(
        statement.opcodes
    )
    (
        name:statement.name,
        opcodes:statement.opcodes,
        values:statement.values,
        max_stack:maximum
    )

compile_tagged_printed_dynamic_addition(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_printed_dynamic_addition(
        tokens.source, tokens.rows, tokens.count
    )
    expression: typed.typed_tagged_dynamic_addition(
        parsed.kind, parsed.values
    )
    statement: mir.mir_tagged_dynamic_addition(expression.values)
    maximum: validation.machine_ir_numeric_opcode_tape_stack_maximum(
        statement.opcodes
    )
    (
        name:statement.name,
        opcodes:statement.opcodes,
        values:statement.values,
        max_stack:maximum
    )

compile_tagged_printed_dynamic_addition_value(source:str) -> num:
    statement: compile_tagged_printed_dynamic_addition(source)
    [num:2] stack: [0, 0]
    depth: 0
    index: 0
    code: 0
    result: 0
    (index < statement.opcodes.length())?>
        .code: statement.opcodes.(index)
        code = 1?
            stack.(depth): statement.values.(index)
            .depth+: 1
        code = 2?
            .depth-: 1
            right: stack.(depth)
            .depth-: 1
            left: stack.(depth)
            stack.(depth): left + right
            .depth+: 1
        code = 3?
            .depth-: 1
            .result: stack.(depth)
        (code >= 1 /\ code <= 3)?! "dynamic addition emitter encountered an unknown opcode"
        .index+: 1
    (depth = 0)?! "dynamic addition emitter leaves an imbalanced stack"
    result

_compile_locked_valid_source_graph(sources:[str]):
    (sources:sources, source_count:sources.length())

_compile_printed_dynamic_addition_x64(
    source:str, template_prefix:str, template_tail:str
) -> str:
    value: compile_tagged_printed_dynamic_addition_value(source)
    str immediate: vkf_utf8_slice("0123456789", value - 48, value - 47)
    template_prefix & "j" & immediate & template_tail

_compile_printed_dynamic_addition_expression_x64(
    source:str, template_prefix:str, addition_tail:str
) -> str:
    statement: compile_tagged_printed_dynamic_addition(source)
    str left_immediate: vkf_utf8_slice(
        "()*+,-./", statement.values.0 - 40, statement.values.0 - 39
    )
    str right_immediate: vkf_utf8_slice(
        "0123456789", statement.values.1 - 48, statement.values.1 - 47
    )
    template_prefix & "j" & left_immediate & "j" & right_immediate & addition_tail

compile_tagged_printed_dynamic_mixed_arithmetic(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_printed_dynamic_mixed_arithmetic(
        tokens.source, tokens.rows, tokens.count
    )

    expression: typed.typed_tagged_dynamic_mixed_arithmetic(
        parsed.kind, parsed.operators, parsed.values
    )
    statement: mir.mir_tagged_dynamic_mixed_arithmetic(
        expression.operators, expression.values
    )
    maximum: validation.machine_ir_arithmetic_opcode_tape_stack_maximum(
        statement.opcodes
    )
    (maximum = statement.max_stack)?! "dynamic mixed arithmetic stack maximum changed"
    (
        name:statement.name,
        opcodes:statement.opcodes,
        values:statement.values,
        max_stack:maximum
    )

compile_tagged_printed_dynamic_grouped_arithmetic(source:str):
