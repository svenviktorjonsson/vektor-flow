compile_tagged_dependency_tape(source:str):
    tokens: lexer.tagged_statement_token_tape(source)
    parsed: parser.parse_tagged_two_derived_bindings(
        tokens.source, tokens.rows, tokens.count
    )
    expression: typed.typed_tagged_two_derived_bindings(
        parsed.kind, parsed.values
    )
    statement: mir.mir_tagged_dynamic_two_derived_bindings(expression.values)
    maximum: validation.machine_ir_numeric_opcode_tape_stack_maximum(
        statement.opcodes
    )
    (
        name:statement.name,
        opcodes:statement.opcodes,
        values:statement.values,
        max_stack:maximum
    )

_browser_token_tape_has_output_marker(rows:[num], count:int) -> bit:
    index: 0
    found: false
    (index + 1 < count /\ ~found)?>
        row: index * 6
        next_row: (index + 1) * 6
        rows.(row) = 15 /\ rows.(next_row) = 15?
            .found: true
        .index+: 1
    found

_browser_token_tape_ends_with_newline(rows:[num], count:int) -> bit:
    count >= 2 /\ rows.((count - 2) * 6) = 4

_browser_token_tape_is_numeric_literal_function(
    rows:[num], count:int
) -> bit:
    (count = 23 \/ count = 24)?
        core_matches: (
            rows.(0) = 1 /\ rows.(6) = 13 /\ rows.(12) = 1 /\
            rows.(18) = 15 /\ rows.(24) = 1 /\ rows.(30) = 14 /\
            rows.(36) = 20 /\ rows.(42) = 17 /\ rows.(48) = 1 /\
            rows.(54) = 15 /\ rows.(60) = 4 /\ rows.(66) = 1 /\
            rows.(72) = 7 /\ rows.(78) = 3 /\ rows.(84) = 4 /\
            rows.(90) = 4 /\ rows.(96) = 15 /\ rows.(102) = 15 /\
            rows.(108) = 1 /\ rows.(114) = 13 /\ rows.(120) = 3 /\
            rows.(126) = 14
        )
        count = 23?
            @: core_matches /\ rows.(132) = 5
        @: core_matches /\ rows.(132) = 4 /\ rows.(138) = 5
    false

_compile_tagged_numeric_literal_function_tape(
    source:str, rows:[num], count:int
):
    _browser_token_tape_is_numeric_literal_function(rows, count)?! "numeric literal function source does not match declaration-call grammar"
    str function_name: vkf_utf8_slice(source, rows.(1), rows.(2))
    str parameter_name: vkf_utf8_slice(source, rows.(13), rows.(14))
    str parameter_type: vkf_utf8_slice(source, rows.(25), rows.(26))
    str return_type: vkf_utf8_slice(source, rows.(49), rows.(50))
    str body_name: vkf_utf8_slice(source, rows.(67), rows.(68))
    str call_name: vkf_utf8_slice(source, rows.(109), rows.(110))
    (parameter_type = "num" /\ return_type = "num")?! "numeric literal function requires num parameter and result"
    (body_name = parameter_name)?! "numeric literal function body must load its parameter"
    (call_name = function_name)?! "numeric literal function call target does not match declaration"
    factor: rows.(81)
    argument: rows.(123)
    [num] opcodes: [1, 1, 5, 3]
    maximum: validation.machine_ir_arithmetic_opcode_tape_stack_maximum(opcodes)
    (
        name:"\$entry",
        opcodes:opcodes,
        values:[argument, factor, 0, 0],
        max_stack:maximum
    )

_compile_tagged_numeric_literal_function_x64(
    source:str,
    template_prefix:str,
    entry_function_gap:str,
    forward_displacement:num,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    artifact_tail:str,
    high_bytes:[str]
) -> str:
    tokens: lexer.tagged_numeric_function_token_tape(source)
    statement: _compile_tagged_numeric_literal_function_tape(
        tokens.source, tokens.rows, tokens.count
    )
    (
        statement.max_stack = 2 /\ statement.opcodes.length() = 4 /\
        statement.opcodes.0 = 1 /\ statement.opcodes.1 = 1 /\
        statement.opcodes.2 = 5 /\ statement.opcodes.3 = 3
    )?! "numeric literal function x64 tape changed"
    relocation: _compile_x64_forward_rel32(forward_displacement, high_bytes)
    (
        template_prefix &
        _compile_x64_positive_immediate_from_arena(statement.values.0, high_bytes) &
        _compile_x64_arena_byte(232, high_bytes) & relocation &
        _compile_x64_arena_byte(195, high_bytes) & entry_function_gap &
        function_prologue &
        _compile_x64_positive_immediate_from_arena(statement.values.1, high_bytes) &
        multiplication_code & function_epilogue & artifact_tail
    )

_compile_tagged_numeric_literal_function_backward_x64(
    source:str,
    template_prefix:str,
    entry_displacement:num,
    backward_displacement:num,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    artifact_tail:str,
    high_bytes:[str]
) -> str:
    (entry_displacement >= 0 /\ entry_displacement <= 127)?! "x64 entry relocation is outside positive rel8"
    tokens: lexer.tagged_numeric_function_token_tape(source)
    statement: _compile_tagged_numeric_literal_function_tape(
        tokens.source, tokens.rows, tokens.count
    )
    (
        statement.max_stack = 2 /\ statement.opcodes.length() = 4 /\
        statement.opcodes.0 = 1 /\ statement.opcodes.1 = 1 /\
        statement.opcodes.2 = 5 /\ statement.opcodes.3 = 3
    )?! "numeric literal function x64 tape changed"
    (
        template_prefix & _compile_x64_arena_byte(235, high_bytes) &
        _compile_x64_byte(entry_displacement) & function_prologue &
        _compile_x64_positive_immediate_from_arena(statement.values.1, high_bytes) &
        multiplication_code & function_epilogue &
        _compile_x64_positive_immediate_from_arena(statement.values.0, high_bytes) &
        _compile_x64_arena_byte(232, high_bytes) &
        _compile_x64_signed_rel32(backward_displacement, high_bytes) &
        _compile_x64_arena_byte(195, high_bytes) & artifact_tail
    )

_compile_tagged_numeric_literal_function_symbols_x64(
    source:str,
    template_prefix:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    artifact_tail:str,
    high_bytes:[str]
) -> str:
    tokens: lexer.tagged_numeric_function_token_tape(source)
    statement: _compile_tagged_numeric_literal_function_tape(
        tokens.source, tokens.rows, tokens.count
    )
    (
        statement.max_stack = 2 /\ statement.opcodes.length() = 4 /\
        statement.opcodes.0 = 1 /\ statement.opcodes.1 = 1 /\
        statement.opcodes.2 = 5 /\ statement.opcodes.3 = 3
    )?! "numeric literal function x64 tape changed"
    argument_size: _compile_x64_positive_immediate_size(statement.values.0)
    factor_size: _compile_x64_positive_immediate_size(statement.values.1)
    entry_relocation_origin: 2
    helper_position: 2
    helper_size: 2 + factor_size + 7 + 9
    entry_position: helper_position + helper_size
    call_relocation_origin: entry_position + argument_size + 5
    entry_displacement: entry_position - entry_relocation_origin
    (entry_displacement >= 0 /\ entry_displacement <= 127)?! "x64 discovered entry relocation is outside positive rel8"
    (
        template_prefix & _compile_x64_arena_byte(235, high_bytes) &
        _compile_x64_byte(entry_displacement) & function_prologue &
        _compile_x64_positive_immediate_from_arena(statement.values.1, high_bytes) &
        multiplication_code & function_epilogue &
        _compile_x64_positive_immediate_from_arena(statement.values.0, high_bytes) &
        _compile_x64_arena_byte(232, high_bytes) &
        _compile_x64_resolved_rel32(
            call_relocation_origin, helper_position, high_bytes
        ) & _compile_x64_arena_byte(195, high_bytes) & artifact_tail
    )

_compile_tagged_numeric_literal_function_pair_symbols_x64(
    first_source:str,
    second_source:str,
    template_prefix:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    artifact_tail:str,
    high_bytes:[str]
) -> str:
    first_tokens: lexer.tagged_numeric_function_token_tape(first_source)
    first: _compile_tagged_numeric_literal_function_tape(
        first_tokens.source, first_tokens.rows, first_tokens.count
    )
    second_tokens: lexer.tagged_numeric_function_token_tape(second_source)
    second: _compile_tagged_numeric_literal_function_tape(
        second_tokens.source, second_tokens.rows, second_tokens.count
    )
    (
        first.max_stack = 2 /\ first.opcodes.length() = 4 /\
        first.opcodes.0 = 1 /\ first.opcodes.1 = 1 /\
        first.opcodes.2 = 5 /\ first.opcodes.3 = 3 /\
        second.max_stack = 2 /\ second.opcodes.length() = 4 /\
        second.opcodes.0 = 1 /\ second.opcodes.1 = 1 /\
        second.opcodes.2 = 5 /\ second.opcodes.3 = 3
    )?! "numeric literal function pair x64 tape changed"
    (first.values.0 * first.values.1 = second.values.0)?! "numeric literal function pair result bridge does not match second argument"
    first_argument_size: _compile_x64_positive_immediate_size(first.values.0)
    first_factor_size: _compile_x64_positive_immediate_size(first.values.1)
    second_factor_size: _compile_x64_positive_immediate_size(second.values.1)
    entry_relocation_origin: 2
    first_helper_position: 2
    first_helper_size: 2 + first_factor_size + 7 + 9
    second_helper_position: first_helper_position + first_helper_size
    second_helper_size: 2 + second_factor_size + 7 + 9
    entry_position: second_helper_position + second_helper_size
    first_call_origin: entry_position + first_argument_size + 5
    second_call_origin: first_call_origin + 6 + 5
    entry_displacement: entry_position - entry_relocation_origin
    (entry_displacement >= 0 /\ entry_displacement <= 127)?! "x64 discovered pair entry relocation is outside positive rel8"
    _compile_x64_apply_resolved_rel32_table(
        [
            (
                template_prefix & _compile_x64_arena_byte(235, high_bytes) &
                _compile_x64_byte(entry_displacement) & function_prologue &
                _compile_x64_positive_immediate_from_arena(first.values.1, high_bytes) &
                multiplication_code & function_epilogue & function_prologue &
                _compile_x64_positive_immediate_from_arena(second.values.1, high_bytes) &
                multiplication_code & function_epilogue &
                _compile_x64_positive_immediate_from_arena(first.values.0, high_bytes) &
                _compile_x64_arena_byte(232, high_bytes)
            ),
            result_bridge & _compile_x64_arena_byte(232, high_bytes),
            _compile_x64_arena_byte(195, high_bytes) & artifact_tail
        ],
        [first_call_origin, second_call_origin],
        [first_helper_position, second_helper_position],
        high_bytes
    )

_compile_tagged_numeric_literal_function_chain_symbols_x64(
    first_source:str,
    second_source:str,
    third_source:str,
    template_prefix:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    artifact_tail:str,
    high_bytes:[str]
) -> str:
    first_tokens: lexer.tagged_numeric_function_token_tape(first_source)
    first: _compile_tagged_numeric_literal_function_tape(
        first_tokens.source, first_tokens.rows, first_tokens.count
    )
    second_tokens: lexer.tagged_numeric_function_token_tape(second_source)
    second: _compile_tagged_numeric_literal_function_tape(
        second_tokens.source, second_tokens.rows, second_tokens.count
    )
    third_tokens: lexer.tagged_numeric_function_token_tape(third_source)
    third: _compile_tagged_numeric_literal_function_tape(
        third_tokens.source, third_tokens.rows, third_tokens.count
    )
    (
        first.max_stack = 2 /\ first.opcodes.length() = 4 /\
        first.opcodes.0 = 1 /\ first.opcodes.1 = 1 /\
        first.opcodes.2 = 5 /\ first.opcodes.3 = 3 /\
        second.max_stack = 2 /\ second.opcodes.length() = 4 /\
        second.opcodes.0 = 1 /\ second.opcodes.1 = 1 /\
        second.opcodes.2 = 5 /\ second.opcodes.3 = 3 /\
        third.max_stack = 2 /\ third.opcodes.length() = 4 /\
        third.opcodes.0 = 1 /\ third.opcodes.1 = 1 /\
        third.opcodes.2 = 5 /\ third.opcodes.3 = 3
    )?! "numeric literal function chain x64 tape changed"
    (first.values.0 * first.values.1 = second.values.0)?! "first numeric function result bridge does not match second argument"
    (second.values.0 * second.values.1 = third.values.0)?! "second numeric function result bridge does not match third argument"
    first_argument_size: _compile_x64_positive_immediate_size(first.values.0)
    first_factor_size: _compile_x64_positive_immediate_size(first.values.1)
    second_factor_size: _compile_x64_positive_immediate_size(second.values.1)
    third_factor_size: _compile_x64_positive_immediate_size(third.values.1)
    entry_relocation_origin: 2
    first_helper_position: 2
    first_helper_size: 2 + first_factor_size + 7 + 9
    second_helper_position: first_helper_position + first_helper_size
    second_helper_size: 2 + second_factor_size + 7 + 9
    third_helper_position: second_helper_position + second_helper_size
    third_helper_size: 2 + third_factor_size + 7 + 9
    entry_position: third_helper_position + third_helper_size
    first_call_origin: entry_position + first_argument_size + 5
    second_call_origin: first_call_origin + 6 + 5
    third_call_origin: second_call_origin + 6 + 5
    entry_displacement: entry_position - entry_relocation_origin
    (entry_displacement >= 0 /\ entry_displacement <= 127)?! "x64 discovered chain entry relocation is outside positive rel8"
    _compile_x64_apply_resolved_rel32_table(
        [
            (
                template_prefix & _compile_x64_arena_byte(235, high_bytes) &
                _compile_x64_byte(entry_displacement) & function_prologue &
                _compile_x64_positive_immediate_from_arena(first.values.1, high_bytes) &
                multiplication_code & function_epilogue & function_prologue &
                _compile_x64_positive_immediate_from_arena(second.values.1, high_bytes) &
                multiplication_code & function_epilogue & function_prologue &
                _compile_x64_positive_immediate_from_arena(third.values.1, high_bytes) &
                multiplication_code & function_epilogue &
                _compile_x64_positive_immediate_from_arena(first.values.0, high_bytes) &
                _compile_x64_arena_byte(232, high_bytes)
            ),
            result_bridge & _compile_x64_arena_byte(232, high_bytes),
            result_bridge & _compile_x64_arena_byte(232, high_bytes),
            _compile_x64_arena_byte(195, high_bytes) & artifact_tail
        ],
        [first_call_origin, second_call_origin, third_call_origin],
        [first_helper_position, second_helper_position, third_helper_position],
        high_bytes
    )

_compile_tagged_numeric_literal_function_chain_bounded_section_x64(
    first_source:str,
    second_source:str,
    third_source:str,
    template_prefix:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    artifact_suffix:str,
    code_capacity:num,
    high_bytes:[str]
) -> str:
    code_size: _compile_tagged_numeric_literal_function_chain_code_size(
        first_source, second_source, third_source
    )
    artifact_tail: _compile_x64_bounded_section_tail(
        code_size, code_capacity, artifact_suffix
    )
    _compile_tagged_numeric_literal_function_chain_symbols_x64(
        first_source,
        second_source,
        third_source,
        template_prefix,
        function_prologue,
        multiplication_code,
        function_epilogue,
        result_bridge,
        artifact_tail,
        high_bytes
    )

_compile_tagged_numeric_literal_function_chain_code_size(
    first_source:str,
    second_source:str,
    third_source:str
) -> num:
    first_tokens: lexer.tagged_numeric_function_token_tape(first_source)
    first: _compile_tagged_numeric_literal_function_tape(
        first_tokens.source, first_tokens.rows, first_tokens.count
    )
    second_tokens: lexer.tagged_numeric_function_token_tape(second_source)
    second: _compile_tagged_numeric_literal_function_tape(
        second_tokens.source, second_tokens.rows, second_tokens.count
    )
    third_tokens: lexer.tagged_numeric_function_token_tape(third_source)
    third: _compile_tagged_numeric_literal_function_tape(
        third_tokens.source, third_tokens.rows, third_tokens.count
    )
    first_argument_size: _compile_x64_positive_immediate_size(first.values.0)
    first_factor_size: _compile_x64_positive_immediate_size(first.values.1)
    second_factor_size: _compile_x64_positive_immediate_size(second.values.1)
    third_factor_size: _compile_x64_positive_immediate_size(third.values.1)
    helper_sizes: (
        (2 + first_factor_size + 7 + 9) +
        (2 + second_factor_size + 7 + 9) +
        (2 + third_factor_size + 7 + 9)
    )
    2 + helper_sizes + first_argument_size + 5 + 6 + 5 + 6 + 5 + 1

_compile_tagged_numeric_literal_function_chain_section_x64(
    first_source:str,
    second_source:str,
    third_source:str,
    template_prefix:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    artifact_suffix:str,
    high_bytes:[str]
) -> str:
    _compile_tagged_numeric_literal_function_chain_bounded_section_x64(
        first_source,
        second_source,
        third_source,
        template_prefix,
        function_prologue,
        multiplication_code,
        function_epilogue,
        result_bridge,
        artifact_suffix,
        32768,
        high_bytes
    )

_compile_tagged_numeric_literal_function_chain_template_x64(
    first_source:str,
    second_source:str,
    third_source:str,
    template:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    high_bytes:[str]
) -> str:
    code_size: _compile_tagged_numeric_literal_function_chain_code_size(
        first_source, second_source, third_source
    )
    section: pe_x64.code_section(template, code_size, high_bytes)
    artifact_template: pe_x64.materialize_code_section(
        template,
        section.existing,
        section.append,
        section.middle,
        section.header_offset,
        section.virtual_size,
        section.virtual_address,
        section.raw_size,
        section.raw_offset,
        section.template_length,
        high_bytes
    )
    template_prefix: pe_x64.slice_bytes(
        artifact_template, 0, section.raw_offset
    )
    artifact_suffix: pe_x64.slice_bytes(
        artifact_template,
        section.raw_offset + section.raw_size,
        section.artifact_length
    )
    _compile_tagged_numeric_literal_function_chain_bounded_section_x64(
        first_source,
        second_source,
        third_source,
        template_prefix,
        function_prologue,
        multiplication_code,
        function_epilogue,
        result_bridge,
        artifact_suffix,
        section.raw_size,
        high_bytes
    )

_compile_tagged_numeric_literal_function_chain_runner_seed_x64(
    first_source:str,
    second_source:str,
    third_source:str,
    runtime_body:str,
    function_prologue:str,
    multiplication_code:str,
    function_epilogue:str,
    result_bridge:str,
    high_bytes:[str]
) -> str:
    _compile_tagged_numeric_literal_function_chain_template_x64(
        first_source,
        second_source,
        third_source,
        pe_x64.runner_seed(runtime_body, high_bytes),
        function_prologue,
        multiplication_code,
        function_epilogue,
        result_bridge,
        high_bytes
    )

_run_tagged_browser_numeric_tape(
    opcodes:[num], values:[num], max_stack:num
) -> num:
    [num] stack: [0:max_stack]
    index: 0
    depth: 0
    result: 0
    returned: false
    (index < opcodes.length() /\ ~returned)?>
        opcode: opcodes.(index)
        opcode = 1?
            (depth < max_stack)?! "browser Machine IR stack overflow"
            stack.(depth): values.(index)
            .depth+: 1
        opcode = 2?
            (depth >= 2)?! "browser Machine IR addition stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left + right
        opcode = 4?
            (depth >= 2)?! "browser Machine IR floor-division stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left // right
        opcode = 5?
            (depth >= 2)?! "browser Machine IR multiplication stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left * right
        opcode = 6?
            (depth >= 2)?! "browser Machine IR subtraction stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left - right
        opcode = 7?
            (depth >= 2)?! "browser Machine IR division stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left / right
        opcode = 8?
            (depth >= 2)?! "browser Machine IR remainder stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left % right
        opcode = 9?
            (depth >= 2)?! "browser Machine IR power stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left ^ right
        opcode = 10?
            (depth >= 1)?! "browser Machine IR negate stack underflow"
            stack.(depth - 1): -stack.(depth - 1)
        opcode = 3?
            (depth = 1)?! "browser Machine IR return needs one result"
            .result: stack.0
            .returned: true
        (opcode >= 1 /\ opcode <= 10)?! "browser Machine IR contains an unsupported opcode"
        .index+: 1
    returned?! "browser Machine IR did not return"
    result

run_tagged_dependency_source(source:str) -> num:
    tokens: lexer.tagged_numeric_function_token_tape(source)
    ~_browser_token_tape_has_output_marker(tokens.rows, tokens.count)?
        statement: compile_tagged_dependency_tape(source)
        @: _run_tagged_browser_numeric_tape(
            statement.opcodes, statement.values, statement.max_stack
        )
    _browser_token_tape_is_numeric_literal_function(tokens.rows, tokens.count)?
        statement: _compile_tagged_numeric_literal_function_tape(
            tokens.source, tokens.rows, tokens.count
        )
        @: _run_tagged_browser_numeric_tape(
            statement.opcodes, statement.values, statement.max_stack
        )
    normalized_source: source
    ~_browser_token_tape_ends_with_newline(tokens.rows, tokens.count)?
        .normalized_source: source & "\n"
    statement: compile_tagged_printed_dynamic_grouped_arithmetic(normalized_source)
    _run_tagged_browser_numeric_tape(
        statement.opcodes, statement.values, statement.max_stack
    )

