compile_tagged_dependency_tape(source:str):
    tokens: lexer.tagged_statement_token_tape(source)
    parsed: parser.parse_tagged_two_derived_bindings(
        tokens.source, tokens.rows, tokens.count
    )
    expression: typed.typed_tagged_two_derived_bindings(
        parsed.kind, parsed.values
    )
    statement: mir.mir_tagged_dynamic_two_derived_bindings(expression.values)
    maximum: validation.machine_ir_numeric_opcode_tape_stack_maximum(
        statement.opcodes
    )
    (
        name:statement.name,
        opcodes:statement.opcodes,
        values:statement.values,
        max_stack:maximum
    )

_browser_token_tape_has_output_marker(rows:[num], count:int) -> bit:
    index: 0
    found: false
    (index + 1 < count /\ ~found)?>
        row: index * 6
        next_row: (index + 1) * 6
        rows.(row) = 15 /\ rows.(next_row) = 15?
            .found: true
        .index+: 1
    found

_browser_token_tape_ends_with_newline(rows:[num], count:int) -> bit:
    count >= 2 /\ rows.((count - 2) * 6) = 4

_browser_token_tape_is_numeric_literal_function(
    rows:[num], count:int
) -> bit:
    (count = 23 \/ count = 24)?
        core_matches: (
            rows.(0) = 1 /\ rows.(6) = 13 /\ rows.(12) = 1 /\
            rows.(18) = 15 /\ rows.(24) = 1 /\ rows.(30) = 14 /\
            rows.(36) = 20 /\ rows.(42) = 17 /\ rows.(48) = 1 /\
            rows.(54) = 15 /\ rows.(60) = 4 /\ rows.(66) = 1 /\
            rows.(72) = 7 /\ rows.(78) = 3 /\ rows.(84) = 4 /\
            rows.(90) = 4 /\ rows.(96) = 15 /\ rows.(102) = 15 /\
            rows.(108) = 1 /\ rows.(114) = 13 /\ rows.(120) = 3 /\
            rows.(126) = 14
        )
        count = 23?
            @: core_matches /\ rows.(132) = 5
        @: core_matches /\ rows.(132) = 4 /\ rows.(138) = 5
    false

_compile_tagged_numeric_literal_function_tape(
    source:str, rows:[num], count:int
):
    _browser_token_tape_is_numeric_literal_function(rows, count)?! "numeric literal function source does not match declaration-call grammar"
    str function_name: vkf_utf8_slice(source, rows.(1), rows.(2))
    str parameter_name: vkf_utf8_slice(source, rows.(13), rows.(14))
    str parameter_type: vkf_utf8_slice(source, rows.(25), rows.(26))
    str return_type: vkf_utf8_slice(source, rows.(49), rows.(50))
    str body_name: vkf_utf8_slice(source, rows.(67), rows.(68))
    str call_name: vkf_utf8_slice(source, rows.(109), rows.(110))
    (parameter_type = "num" /\ return_type = "num")?! "numeric literal function requires num parameter and result"
    (body_name = parameter_name)?! "numeric literal function body must load its parameter"
    (call_name = function_name)?! "numeric literal function call target does not match declaration"
    factor: rows.(81)
    argument: rows.(123)
    [num:4] opcodes: [1, 1, 5, 3]
    maximum: validation.machine_ir_arithmetic_opcode_tape_stack_maximum(opcodes)
    (
        name:"\$entry",
        opcodes:opcodes,
        values:[argument, factor, 0, 0],
        max_stack:maximum
    )

_run_tagged_browser_numeric_tape(
    opcodes:[num], values:[num], max_stack:num
) -> num:
    [num] stack: [0:max_stack]
    index: 0
    depth: 0
    result: 0
    returned: false
    (index < opcodes.length() /\ ~returned)?>
        opcode: opcodes.(index)
        opcode = 1?
            (depth < max_stack)?! "browser Machine IR stack overflow"
            stack.(depth): values.(index)
            .depth+: 1
        opcode = 2?
            (depth >= 2)?! "browser Machine IR addition stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left + right
        opcode = 4?
            (depth >= 2)?! "browser Machine IR floor-division stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left // right
        opcode = 5?
            (depth >= 2)?! "browser Machine IR multiplication stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left * right
        opcode = 6?
            (depth >= 2)?! "browser Machine IR subtraction stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left - right
        opcode = 7?
            (depth >= 2)?! "browser Machine IR division stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left / right
        opcode = 8?
            (depth >= 2)?! "browser Machine IR remainder stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left % right
        opcode = 9?
            (depth >= 2)?! "browser Machine IR power stack underflow"
            right: stack.(depth - 1)
            left: stack.(depth - 2)
            .depth-: 1
            stack.(depth - 1): left ^ right
        opcode = 10?
            (depth >= 1)?! "browser Machine IR negate stack underflow"
            stack.(depth - 1): -stack.(depth - 1)
        opcode = 3?
            (depth = 1)?! "browser Machine IR return needs one result"
            .result: stack.0
            .returned: true
        (opcode >= 1 /\ opcode <= 10)?! "browser Machine IR contains an unsupported opcode"
        .index+: 1
    returned?! "browser Machine IR did not return"
    result

run_tagged_dependency_source(source:str) -> num:
    tokens: lexer.tagged_numeric_function_token_tape(source)
    ~_browser_token_tape_has_output_marker(tokens.rows, tokens.count)?
        statement: compile_tagged_dependency_tape(source)
        @: _run_tagged_browser_numeric_tape(
            statement.opcodes, statement.values, statement.max_stack
        )
    _browser_token_tape_is_numeric_literal_function(tokens.rows, tokens.count)?
        statement: _compile_tagged_numeric_literal_function_tape(
            tokens.source, tokens.rows, tokens.count
        )
        @: _run_tagged_browser_numeric_tape(
            statement.opcodes, statement.values, statement.max_stack
        )
    normalized_source: source
    ~_browser_token_tape_ends_with_newline(tokens.rows, tokens.count)?
        .normalized_source: source & "\n"
    statement: compile_tagged_printed_dynamic_grouped_arithmetic(normalized_source)
    _run_tagged_browser_numeric_tape(
        statement.opcodes, statement.values, statement.max_stack
    )

compile_tagged_numeric_function_call(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_function_call(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_parameter_multiply_application(
        parsed.function_name,
        parsed.parameter_name,
        parsed.factor
    )
    module: mir.mir_lower_numeric_parameter_multiply_typed_module(application)
    maxima: validation.machine_ir_numeric_parameter_multiply_stack_maxima(
        parsed.function_name,
        parsed.parameter_name,
        parsed.factor
    )
    (maxima.0 = 1 /\ maxima.1 = 1 /\ maxima.2 = 2)?! "numeric function Machine IR has unexpected stack maxima"
    module

compile_tagged_numeric_positive_conditional(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_positive_conditional(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_positive_conditional_application(
        parsed.function_name,
        parsed.parameter_name
    )
    module: mir.mir_lower_numeric_positive_conditional_typed_module(application)
    maxima: validation.machine_ir_numeric_positive_conditional_stack_maxima(
        parsed.function_name,
        parsed.parameter_name
    )
    (maxima.0 = 1 /\ maxima.1 = 1 /\ maxima.2 = 2)?! "numeric conditional Machine IR has unexpected stack maxima"
    module

compile_tagged_numeric_count_to_loop(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_count_to_loop(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_count_to_loop_application(
        parsed.function_name,
        parsed.parameter_name,
        parsed.local_name,
        parsed.entry_value
    )
    module: mir.mir_lower_numeric_count_to_loop_typed_module(application)
    maxima: validation.machine_ir_numeric_count_to_loop_stack_maxima(
        parsed.function_name,
        parsed.parameter_name,
        parsed.local_name,
        parsed.entry_value
    )
    (maxima.0 = 1 /\ maxima.1 = 2)?! "numeric loop Machine IR has unexpected stack maxima"
    module

compile_tagged_module_statement(source:str, index:int):
    tokens: lexer.tagged_statement_token_tape(source)
    parsed: parser.parse_tagged_token_tape(
        tokens.source, tokens.rows, tokens.count
    )
    typed_module: typed.typed_tagged_module(
        parsed.module.body.source,
        parsed.module.body.rows,
        parsed.module.body.count
    )
    dynamic_module: mir.mir_tagged_module(
        typed_module.source,
        typed_module.statements,
        typed_module.count
    )
    statement: mir.mir_tagged_module_statement(dynamic_module, index)
    maximum: validation.machine_ir_tagged_statement_stack_maximum(
        statement.instructions.0.kind,
        statement.instructions.1.kind,
        statement.instructions.2.kind,
        statement.instructions.3.kind
    )
    mir.mir_assemble_tagged_statement_module(dynamic_module, index, maximum)

CompilerArtifactManifest: (
    source_path:str,
    source_sha256:str,
    typed_ir_sha256:str,
    compiler_version:str,
    artifact_path:str,
    artifact_content_sha256:str,
    runtime_hash:str,
    manifest_hash:str,
    status:str
)

CompilerArtifactResult: (manifest_path:str, artifact_path:str, status:str)

manifest(
    source_path:str,
    source_sha256:str,
    typed_ir_sha256:str,
    compiler_version:str,
    artifact_path:str,
    artifact_content_sha256:str,
    runtime_hash:str,
    manifest_hash:str,
    status:str
):
    (
        source_path: source_path,
        source_sha256: source_sha256,
        typed_ir_sha256: typed_ir_sha256,
        compiler_version: compiler_version,
        artifact_path: artifact_path,
        artifact_content_sha256: artifact_content_sha256,
        runtime_hash: runtime_hash,
        manifest_hash: manifest_hash,
        status: status
    )

artifact_result(manifest_path:str, artifact_path:str, status:str):
    (manifest_path: manifest_path, artifact_path: artifact_path, status: status)

compiler_artifact_smoke_capability:
    name: "vkf_compiler_artifact_smoke"
    input: [
        "--source file.vkf",
        "--typed-ir file.json"
    ]
    writes: [
        ".vkfbuild/<stem>/manifest.json",
        ".vkfbuild/<stem>/<stem>.cmd"
    ]
    manifest_fields: [
        "source_path",
        "source_sha256",
        "typed_ir_sha256",
        "compiler_version",
        "artifact_path",
        "artifact_content_sha256",
        "runtime_hash",
        "manifest_hash",
        "status"
    ]
    statuses: [
        "compiled when source hash or typed IR hash changed",
        "compiled when artifact missing",
        "current when manifest hash matches and artifact exists"
    ]
    artifact_emission: [
        "store_binding const values into native-owned value table",
        "load from prior store_binding",
        "expr_stmt external print emits script output",
        "manifest hash includes artifact content hash",
        "tampered artifact recompiles"
    ]
    supported_ir_subset: [
        "typed_module",
        "store_binding",
        "const",
        "load",
        "unknown external calls typed any"
    ]
    unsupported: [
        "known calls are hard diagnostic until artifact emission supports call targets",
        "unsupported typed IR writes no successful manifest"
    ]
    ownership: [
        "native smoke owns build directory",
        "no Python startup",
        "no shell fallback",
        "no source lexer fallback inside artifact smoke"
    ]
    percent: 82
    :

wasm_artifact_smoke_capability:
