# Self-hosted VKF compiler artifact seed.
#
# Source-level contract for the first native compiler-artifact seam. The native
# smoke consumes typed IR JSON from the parser/IR pipeline and owns the build
# directory manifest without host fallback hooks.

lexer: .lexer
parser: .parser
typed: .typed_ir
mir: .machine_ir
validation: .machine_ir_validation
pe_x64: .pe_x64

compile_tagged_empty_module(source:str):
    bit comment_only: lexer.tagged_comment_only_source(source)
    comment_only?! "empty module source must contain comments and layout only"
    typed_module: typed.typed_empty_module()
    module: mir.mir_lower_empty_typed_module(typed_module)
    maximum: validation.machine_ir_empty_module_stack_maximum(module)
    (maximum = 0)?!
    module

compile_tagged_import_only_module(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_import_only_module(
        tokens.source, tokens.rows, tokens.count
    )
    parsed.alias_name
    parsed.module_name
    typed_module: typed.typed_empty_module()
    module: mir.mir_lower_empty_typed_module(typed_module)
    maximum: validation.machine_ir_empty_module_stack_maximum(module)
    (maximum = 0)?!
    module

compile_tagged_scalar_binding(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_scalar_binding_output(
        tokens.source, tokens.rows, tokens.count
    )
    typed_module: typed.typed_scalar_binding_output(
        parsed.binding_name, parsed.value
    )
    module: mir.mir_lower_scalar_binding_typed_module(typed_module)
    maximum: validation.machine_ir_scalar_binding_stack_maximum(module)
    (maximum = 1)?!
    module

compile_tagged_closed_binding(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_printed_closed_binding(
        tokens.source, tokens.rows, tokens.count
    )
    typed_module: typed.typed_tagged_module(
        parsed.source, parsed.rows, parsed.count
    )
    binding: typed.typed_tagged_binding(typed_module, 0)
    expression: typed.typed_tagged_bound_statement(typed_module, 1, binding)
    (expression.type = "int")?! "printed expression must load its binding"
    dynamic_module: mir.mir_tagged_module(
        typed_module.source, typed_module.statements, typed_module.count
    )
    closed: mir.mir_tagged_closed_statement(dynamic_module, 0, 1)
    maximum: validation.machine_ir_tagged_statement_stack_maximum(
        closed.instructions.0.kind, closed.instructions.1.kind,
        closed.instructions.2.kind, closed.instructions.3.kind
    )
    mir.mir_assemble_closed_tagged_module(closed, maximum)

compile_tagged_printed_nested_addition(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_printed_nested_addition(
        tokens.source, tokens.rows, tokens.count
    )
    expression: typed.typed_tagged_nested_addition(
        parsed.kind, parsed.values
    )
    statement: mir.mir_tagged_nested_addition(expression.values)
    maximum: validation.machine_ir_nested_addition_stack_maximum(
        statement.instructions.0.kind, statement.instructions.1.kind,
        statement.instructions.2.kind, statement.instructions.3.kind,
        statement.instructions.4.kind, statement.instructions.5.kind
    )
    mir.mir_assemble_closed_nested_module(statement, maximum)

