    (statement.opcodes.length() = 4 /\ statement.opcodes.0 = 1 /\
        statement.opcodes.1 = 1 /\ statement.opcodes.2 = 5 /\
        statement.opcodes.3 = 3)?! "runtime multiplication emitter expects load-load-multiply-print"
    str left_immediate: vkf_utf8_slice(
        "()*+,-./", statement.values.0 - 40, statement.values.0 - 39
    )
    str right_immediate: vkf_utf8_slice(
        "0123456789", statement.values.1 - 48, statement.values.1 - 47
    )
    template_prefix & "j" & left_immediate & "j" & right_immediate & multiplication_tail

