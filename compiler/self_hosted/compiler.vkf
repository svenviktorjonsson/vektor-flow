_browser_lifted_number(tape:any, index:int, factor:num) -> BrowserLiftedParse:
    row: index * 6
    tape.rows.(row) = 3?
        @: (value:tape.rows.(row + 3) * factor, next:index + 1)
    (tape.rows.(row) = 20 /\ _browser_token_kind(tape, index + 1) = 3)?! "lifted vector argument must contain numeric leaves"
    next_row: (index + 1) * 6
    (value:0 - tape.rows.(next_row + 3) * factor, next:index + 2)

_browser_lifted_numeric_vector(
    tape:any, index:int, factor:num, values:any
) -> BrowserLiftedParse:
    row: index * 6
    tape.rows.(row) = 23?
        @: (value:values, next:index + 1)
    parsed: _browser_lifted_number(tape, index, factor)
    value: parsed.value
    next_kind: _browser_token_kind(tape, parsed.next)
    next_kind = 24?
        @: _browser_lifted_numeric_vector(
            tape, parsed.next + 1, factor, values & [value]
        )
    (next_kind = 23)?! "lifted vector argument requires comma or closing bracket"
    (value:values & [value], next:parsed.next + 1)

_browser_lifted_nested_vector(
    tape:any, index:int, factor:num, values:any
) -> BrowserLiftedParse:
    (_browser_token_kind(tape, index) = 23)?
        @: (value:values, next:index + 1)
    (_browser_token_kind(tape, index) = 22)?! "nested lifted vector requires vector rows"
    row: _browser_lifted_numeric_vector(tape, index + 1, factor, [])
    next_kind: _browser_token_kind(tape, row.next)
    next_kind = 24?
        @: _browser_lifted_nested_vector(
            tape, row.next + 1, factor, values & [row.value]
        )
    (next_kind = 23)?! "nested lifted vector requires comma or closing bracket"
    (value:values & [row.value], next:row.next + 1)

_browser_lifted_value(
    tape:any, index:int, factor:num
) -> BrowserLiftedParse:
    row: index * 6
    kind: tape.rows.(row)
    kind = 3?
        @: (value:tape.rows.(row + 3) * factor, next:index + 1)
    (kind = 22)?! "lifted vector argument must contain numeric leaves"
    _browser_token_kind(tape, index + 1) = 22?
        @: _browser_lifted_nested_vector(tape, index + 1, factor, [])
    _browser_lifted_numeric_vector(tape, index + 1, factor, [])

_browser_lifted_complex(
    tape:any, index:int
) -> BrowserLiftedComplex:
    (_browser_token_kind(tape, index) = 1 /\
        _browser_token_text(tape, index) = "num" /\
        _browser_token_kind(tape, index + 1) = 13)?! "browser display complex p leaves require num(real, imaginary)"
    real: _browser_lifted_number(tape, index + 2, 1)
    (_browser_token_kind(tape, real.next) = 24)?! "browser display complex p requires real and imaginary components"
    imaginary: _browser_lifted_number(tape, real.next + 1, 1)
    (_browser_token_kind(tape, imaginary.next) = 14)?! "browser display complex p requires a closing parenthesis"
    (real:real.value, imaginary:imaginary.value, next:imaginary.next + 1)

_browser_lifted_complex_vector(
    tape:any, index:int, x:any, y:any
) -> BrowserLiftedComplexCoordinates:
    (_browser_token_kind(tape, index) != 23)?! "browser display complex p cannot be empty"
    value: _browser_lifted_complex(tape, index)
    next_kind: _browser_token_kind(tape, value.next)
    next_kind = 24?
        @: _browser_lifted_complex_vector(
            tape, value.next + 1,
            x & [value.real], y & [value.imaginary]
        )
    (next_kind = 23)?! "browser display complex p requires comma or closing bracket"
    (
        x:x & [value.real],
        y:y & [value.imaginary],
        next:value.next + 1
    )

_browser_lifted_nested_complex_vector(
    tape:any, index:int, x:any, y:any
) -> BrowserLiftedComplexCoordinates:
    (_browser_token_kind(tape, index) != 23)?! "browser display complex p cannot be empty"
    (_browser_token_kind(tape, index) = 22)?! "browser display complex p nesting must match its axes"
    row: _browser_lifted_complex_vector(tape, index + 1, [], [])
    next_kind: _browser_token_kind(tape, row.next)
    next_kind = 24?
        @: _browser_lifted_nested_complex_vector(
            tape, row.next + 1, x & [row.x], y & [row.y]
        )
    (next_kind = 23)?! "browser display complex p requires comma or closing bracket"
    (x:x & [row.x], y:y & [row.y], next:row.next + 1)

_browser_lifted_complex_coordinates(
    tape:any, rank:int
) -> BrowserLiftedComplexCoordinates:
    (_browser_token_kind(tape, 0) = 22)?! "browser display complex p requires an indexed vector"
    rank = 1?
        @: _browser_lifted_complex_vector(tape, 1, [], [])
    rank = 2?
        @: _browser_lifted_nested_complex_vector(tape, 1, [], [])
    false?! "browser display complex p supports one or two semantic axes"
    (x:[], y:[], next:0)

_browser_axis_term(tape:any, index:int) -> BrowserAxisTerm:
    (_browser_token_kind(tape, index) = 22)?! "named-axis term requires a vector"
    parsed: _browser_lifted_numeric_vector(tape, index + 1, 1, [])
    (_browser_token_kind(tape, parsed.next) = 20 /\
        _browser_token_kind(tape, parsed.next + 1) = 17 /\
        _browser_token_kind(tape, parsed.next + 2) = 1)?! "named-axis term requires ->axis"
    (
        values:parsed.value,
        axis:_browser_token_text(tape, parsed.next + 2),
        next:parsed.next + 3
    )

_browser_axis_elementwise(
    left:any, right:any, index:int, values:any
) -> any:
    (index = left.length())?
        (index = right.length())?! "matching axes require equal lengths"
        @: values
    (index < right.length())?! "matching axes require equal lengths"
    _browser_axis_elementwise(
        left, right, index + 1, values & [left.(index) * right.(index)]
    )

_browser_axis_scaled_row(
    scalar:num, right:any, index:int, values:any
) -> any:
    (index = right.length())?
        @: values
    _browser_axis_scaled_row(
        scalar, right, index + 1, values & [scalar * right.(index)]
    )

_browser_axis_outer(
    left:any, right:any, index:int, rows:any
) -> any:
    (index = left.length())?
        @: rows
    _browser_axis_outer(
        left, right, index + 1,
        rows & [_browser_axis_scaled_row(left.(index), right, 0, [])]
    )

_browser_axis_scale_plane(
    scalar:num, plane:any, row:int, column:int, rows:any, values:any
) -> any:
    (row = plane.length())?
        @: rows
    (column = plane.(row).length())?
        @: _browser_axis_scale_plane(
            scalar, plane, row + 1, 0, rows & [values], []
        )
    _browser_axis_scale_plane(
        scalar, plane, row, column + 1, rows,
        values & [scalar * plane.(row).(column)]
    )

_browser_axis_outer_tensor(
    left:any, plane:any, index:int, planes:any
) -> any:
    (index = left.length())?
        @: planes
    _browser_axis_outer_tensor(
        left, plane, index + 1,
        planes & [_browser_axis_scale_plane(left.(index), plane, 0, 0, [], [])]
    )

_browser_axis_product2(left:BrowserAxisTerm, right:BrowserAxisTerm) -> any:
    left.axis = right.axis?
        @: _browser_axis_elementwise(left.values, right.values, 0, [])
    _browser_axis_outer(left.values, right.values, 0, [])

_browser_axis_product3(
    left:BrowserAxisTerm, middle:BrowserAxisTerm, right:BrowserAxisTerm
) -> any:
    (left.axis = middle.axis /\ middle.axis = right.axis)?
        @: _browser_axis_elementwise(
            _browser_axis_elementwise(left.values, middle.values, 0, []),
            right.values, 0, []
        )
    left.axis = middle.axis?
        @: _browser_axis_outer(
            _browser_axis_elementwise(left.values, middle.values, 0, []),
            right.values, 0, []
        )
    middle.axis = right.axis?
        @: _browser_axis_outer(
            left.values,
            _browser_axis_elementwise(middle.values, right.values, 0, []),
            0, []
        )
    left.axis = right.axis?
        @: _browser_axis_outer(
            _browser_axis_elementwise(left.values, right.values, 0, []),
            middle.values, 0, []
        )
    _browser_axis_outer_tensor(
        left.values, _browser_axis_outer(middle.values, right.values, 0, []),
        0, []
    )

_browser_axis_lookup(
    names:any, values:any, name:str, index:int
) -> any:
    (index < names.length())?! "named-axis output references an unknown binding"
    names.(index) = name?
        @: values.(index)
    _browser_axis_lookup(names, values, name, index + 1)

_browser_display_options_call(tape:any, start:int) -> BrowserDisplayOptions:
    index: start
    parens: 1
    brackets: 0
    background: []
    saw_background: false
    combine_transparent: false
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            (key = "background" \/ key = "unified_renderer" \/
                key = "combine_transparent")?! "browser display does not support this frame option"
            key = "background"?
                parsed: _browser_lifted_value(tape, index + 2, 1)
                .background: parsed.value
                .saw_background: true
                .index: parsed.next
            key = "unified_renderer"?
                (_browser_token_kind(tape, index + 2) = 1 /\
                    _browser_token_text(tape, index + 2) = "true")?! "browser display requires unified rendering"
                .index+: 1
            key = "combine_transparent"?
                (_browser_token_kind(tape, index + 2) = 1 /\
                    _browser_token_text(tape, index + 2) = "true")?! "browser display requires transparent compositing"
                .combine_transparent: true
                .index+: 1
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    saw_background?! "browser display options require a background"
    (background.length() = 4)?! "browser display background must be RGBA"
    (background:background, combine_transparent:combine_transparent, next:index)

_browser_source_starts_with(
    source:str, offset:int, expected:str, expected_offset:int
) -> bit:
    vkf_string_eof(expected, expected_offset)?
        @: true
    vkf_string_eof(source, offset)?
        @: false
    (vkf_string_peek_scalar(source, offset) !=
        vkf_string_peek_scalar(expected, expected_offset))?
        @: false
    _browser_source_starts_with(
        source,
        vkf_utf8_advance(source, offset),
        expected,
        vkf_utf8_advance(expected, expected_offset)
    )

_browser_find_source(source:str, offset:int, expected:str) -> int:
    vkf_string_eof(source, offset)?
        @: -1
    _browser_source_starts_with(source, offset, expected, 0)?
        @: offset
    _browser_find_source(source, vkf_utf8_advance(source, offset), expected)

_browser_world_argument_start(source:str, offset:int) -> int:
    vkf_string_eof(source, offset)?
        @: offset
    ch: vkf_string_peek_scalar(source, offset)
    (ch = 9 \/ ch = 10 \/ ch = 13 \/ ch = 32 \/ ch = 44)?
        @: _browser_world_argument_start(source, vkf_utf8_advance(source, offset))
    offset

_browser_display_raw_source_matches(source:str) -> bit:
    ~_browser_source_starts_with(source, 0, ": .ui.display", 0)?
        @: false
    vkf_string_eof(source, 13)?
        @: true
    (vkf_string_peek_scalar(source, 13) = 10 \/
        vkf_string_peek_scalar(source, 13) = 13)

_browser_display_call_stop(
    source:str, offset:int, depth:int, in_string:bit
) -> int:
    vkf_string_eof(source, offset)?
        false?! "browser display call is unterminated"
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_string?
        ch = 34?
            @: _browser_display_call_stop(source, next, depth, false)
        @: _browser_display_call_stop(source, next, depth, true)
    ch = 34?
        @: _browser_display_call_stop(source, next, depth, true)
    ch = 40?
        @: _browser_display_call_stop(source, next, depth + 1, false)
    ch = 41?
        depth = 1?
            @: next
        @: _browser_display_call_stop(source, next, depth - 1, false)
    _browser_display_call_stop(source, next, depth, false)

_browser_display_value_start(source:str, offset:int) -> int:
    vkf_string_eof(source, offset)?
        @: offset
    ch: vkf_string_peek_scalar(source, offset)
    (ch = 9 \/ ch = 10 \/ ch = 13 \/ ch = 32)?
        @: _browser_display_value_start(
            source, vkf_utf8_advance(source, offset)
        )
    offset

_browser_display_bracket_stop(
    source:str, offset:int, depth:int
) -> int:
    vkf_string_eof(source, offset)?
        false?! "browser display vector is unterminated"
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    ch = 91?
        @: _browser_display_bracket_stop(source, next, depth + 1)
    ch = 93?
        depth = 1?
            @: next
        @: _browser_display_bracket_stop(source, next, depth - 1)
    _browser_display_bracket_stop(source, next, depth)

_browser_ascii_identifier_start(ch:int) -> bit:
    (ch >= 65 /\ ch <= 90) \/ (ch >= 97 /\ ch <= 122) \/ ch = 95

_browser_display_identifier_stop(source:str, offset:int) -> int:
    vkf_string_eof(source, offset)?
        @: offset
    ch: vkf_string_peek_scalar(source, offset)
    (_browser_ascii_identifier_start(ch) \/ (ch >= 48 /\ ch <= 57))?
        @: _browser_display_identifier_stop(
            source, vkf_utf8_advance(source, offset)
        )
    offset

_browser_display_decimal_at(source:str, offset:int) -> BrowserDisplayDecimal:
    start: _browser_display_value_start(source, offset)
    stop: vkf_decimal_scan_end(source, start)
    (stop > start)?! "browser display procedural p requires a decimal literal"
    (value:vkf_decimal_parse(vkf_utf8_slice(source, start, stop)), next:stop)

_browser_procedural_affine_range(
    source:str, offset:int
) -> BrowserProceduralAffineRange:
    cursor: _browser_display_value_start(source, offset)
    _browser_source_starts_with(source, cursor, "[..", 0)?! "browser display procedural p requires a materialized range"
    limit: _browser_display_decimal_at(source, cursor + 3)
    int limit_next: limit.next
    .cursor: _browser_display_value_start(source, limit_next)
    _browser_source_starts_with(source, cursor, "]", 0)?! "browser display procedural p range is unterminated"
    .cursor: _browser_display_value_start(source, cursor + 1)
    _browser_source_starts_with(source, cursor, "/", 0)?! "browser display procedural p range requires a divisor"
    divisor: _browser_display_decimal_at(source, cursor + 1)
    int divisor_next: divisor.next
    .cursor: _browser_display_value_start(source, divisor_next)
    _browser_source_starts_with(source, cursor, "-", 0)?! "browser display procedural p range requires an offset"
    range_offset: _browser_display_decimal_at(source, cursor + 1)
    num range_limit: limit.value
    num range_divisor: divisor.value
    num parsed_offset: range_offset.value
    int range_next: range_offset.next
    (range_limit >= 0 /\ range_limit <= 2048 /\ range_limit // 1 = range_limit)?! "browser display procedural p range limit must be an integer from 0 through 2048"
    (range_divisor != 0)?! "browser display procedural p range divisor cannot be zero"
    (limit:range_limit, divisor:range_divisor, offset:parsed_offset, next:range_next)

_browser_procedural_complex_samples(
    limit:num, first_divisor:num, first_offset:num,
    second_divisor:num, second_offset:num,
    amplitude:num, index:int, x:any, y:any
) -> BrowserLiftedComplexCoordinates:
    index > limit?
        @: (x:x, y:y, next:0)
    real: index / first_divisor - first_offset
    phase: index / second_divisor - second_offset
    _browser_procedural_complex_samples(
        limit, first_divisor, first_offset,
        second_divisor, second_offset, amplitude, index + 1,
        x & [real], y & [amplitude * math.sin(phase * 3.141592653589793)]
    )

_browser_procedural_complex_coordinates(
    source:str
) -> BrowserLiftedComplexCoordinates:
    cursor: _browser_display_value_start(source, 0)
    _browser_source_starts_with(source, cursor, "num(", 0)?! "browser display procedural p requires num(real, imaginary)"
    first: _browser_procedural_affine_range(source, cursor + 4)
    int first_next: first.next
    .cursor: _browser_display_value_start(source, first_next)
    _browser_source_starts_with(source, cursor, ",", 0)?! "browser display procedural p requires real and imaginary components"
    amplitude: _browser_display_decimal_at(source, cursor + 1)
    int amplitude_next: amplitude.next
    .cursor: _browser_display_value_start(source, amplitude_next)
    _browser_source_starts_with(source, cursor, "*", 0)?! "browser display procedural p imaginary component requires a scale"
    .cursor: _browser_display_value_start(source, cursor + 1)
    _browser_source_starts_with(source, cursor, "sin(", 0)?! "browser display procedural p imaginary component requires sin"
    .cursor: _browser_display_value_start(source, cursor + 4)
    _browser_source_starts_with(source, cursor, "(", 0)?! "browser display procedural p sin argument requires grouping"
    second: _browser_procedural_affine_range(source, cursor + 1)
    int second_next: second.next
    .cursor: _browser_display_value_start(source, second_next)
    _browser_source_starts_with(source, cursor, ")", 0)?! "browser display procedural p sin range group is unterminated"
    .cursor: _browser_display_value_start(source, cursor + 1)
    _browser_source_starts_with(source, cursor, "*", 0)?! "browser display procedural p sin argument requires pi scaling"
    .cursor: _browser_display_value_start(source, cursor + 1)
    _browser_source_starts_with(source, cursor, "pi", 0)?! "browser display procedural p sin argument requires pi"
    .cursor: _browser_display_value_start(source, cursor + 2)
    _browser_source_starts_with(source, cursor, ")", 0)?! "browser display procedural p sin expression is unterminated"
    .cursor: _browser_display_value_start(source, cursor + 1)
    _browser_source_starts_with(source, cursor, ")", 0)?! "browser display procedural p num expression is unterminated"
    .cursor: _browser_display_value_start(source, cursor + 1)
    (vkf_string_eof(source, cursor) = true)?! "browser display procedural p has trailing tokens"
    num first_limit: first.limit
    num second_limit: second.limit
    num first_divisor: first.divisor
    num first_offset: first.offset
    num second_divisor: second.divisor
    num second_offset: second.offset
    num scale: amplitude.value
    (first_limit = second_limit)?! "browser display procedural p component lengths disagree"
    _browser_procedural_complex_samples(
        first_limit, first_divisor, first_offset,
        second_divisor, second_offset, scale, 0, [], []
    )

_browser_display_axis_contains(
    axes:[str], axis:str, index:int
) -> bit:
    index >= axes.length()?
        @: false
    axes.(index) = axis?
        @: true
    _browser_display_axis_contains(axes, axis, index + 1)

_browser_display_coordinate_axes(
    source:str, offset:int, stop:int, axes:[str]
) -> [str]:
    offset >= stop?
        @: axes
    next: vkf_utf8_advance(source, offset)
    axis_code: vkf_string_peek_scalar(source, offset)
    axis: ""
    axis_code = 117? .axis: "u"
    axis_code = 118? .axis: "v"
    axis_code = 119? .axis: "w"
    axis_code = 105? .axis: "i"
    axis_code = 106? .axis: "j"
    axis_code = 107? .axis: "k"
    axis_code = 116? .axis: "t"
    (axis != "")?! "browser display coordinate axis is unsupported"
    (~_browser_display_axis_contains(axes, axis, 0))?! "browser display coordinate axis is duplicated"
    _browser_display_coordinate_axes(source, next, stop, axes & [axis])

_browser_display_coordinate_key(
    source:str, offset:int
) -> BrowserDisplayCoordinateKey:
    vkf_string_eof(source, offset)?
        @: (matched:false, coordinate:"", axes:[], value_offset:offset)
    coordinate_stop: vkf_utf8_advance(source, offset)
    coordinate: vkf_utf8_slice(source, offset, coordinate_stop)
    ~(coordinate = "p" \/ coordinate = "x" \/ coordinate = "y" \/ coordinate = "z")?
        @: (matched:false, coordinate:"", axes:[], value_offset:offset)
    vkf_string_eof(source, coordinate_stop)?
        @: (matched:false, coordinate:"", axes:[], value_offset:offset)
    separator: vkf_string_peek_scalar(source, coordinate_stop)
    separator = 58?
        @: (
            matched:true, coordinate:coordinate, axes:[],
            value_offset:vkf_utf8_advance(source, coordinate_stop)
        )
    separator != 95?
        @: (matched:false, coordinate:"", axes:[], value_offset:offset)
    axes_start: vkf_utf8_advance(source, coordinate_stop)
    axes_stop: _browser_display_identifier_stop(source, axes_start)
    (axes_stop > axes_start)?! "browser display coordinate axis is missing"
    (vkf_string_eof(source, axes_stop) = false)?! "browser display coordinate axis requires a colon"
    (vkf_string_peek_scalar(source, axes_stop) = 58)?! "browser display coordinate axis requires a colon"
    (
        matched:true,
        coordinate:coordinate,
        axes:_browser_display_coordinate_axes(
            source, axes_start, axes_stop, []
        ),
        value_offset:vkf_utf8_advance(source, axes_stop)
    )

_browser_display_axes_equal(
    left:[str], right:[str], index:int=0
) -> bit:
    left.length() != right.length()?
        @: false
    index >= left.length()?
        @: true
    left.(index) != right.(index)?
        @: false
    _browser_display_axes_equal(left, right, index + 1)

_browser_display_axes_by_kind(
    axes:[str], kind:str, index:int, selected:[str]
) -> [str]:
    index >= axes.length()?
        @: selected
    axis: axes.(index)
    matches: false
    kind = "topology"?
        .matches: axis = "u" \/ axis = "v" \/ axis = "w"
    kind = "group"?
        .matches: axis = "i" \/ axis = "j" \/ axis = "k"
    next_selected: selected
    matches?
        .next_selected: selected & [axis]
    _browser_display_axes_by_kind(axes, kind, index + 1, next_selected)

_browser_display_string_stop(source:str, offset:int) -> int:
    vkf_string_eof(source, offset)?
        false?! "browser display string is unterminated"
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    ch = 34?
        @: offset
    _browser_display_string_stop(source, next)

_browser_scan_display_texture_fields(
    source:str, offset:int, stop:int, kind:str,
    scale_source:str, color_a_source:str, color_b_source:str,
    roughness:num, blade_length:num, clump_density:num,
    micro_shadow:num, unsupported:bit
) -> BrowserDisplayTextureFields:
    offset >= stop?
        @: (
            kind:kind, scale_source:scale_source,
            color_a_source:color_a_source, color_b_source:color_b_source,
            roughness:roughness, blade_length:blade_length,
            clump_density:clump_density, micro_shadow:micro_shadow,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "kind:", 0)?
        value_start: _browser_display_value_start(source, offset + 5)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser texture kind must be a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_display_texture_fields(
            source, value_stop + 1, stop,
            vkf_utf8_slice(source, value_start + 1, value_stop),
            scale_source, color_a_source, color_b_source,
            roughness, blade_length, clump_density, micro_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "scale:", 0) \/
        _browser_source_starts_with(source, offset, "color_a:", 0) \/
        _browser_source_starts_with(source, offset, "color_b:", 0))?
        colon_width: 6
        _browser_source_starts_with(source, offset, "color_a:", 0)?
            .colon_width: 8
        _browser_source_starts_with(source, offset, "color_b:", 0)?
            .colon_width: 8
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser texture vector field requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        value_source: vkf_utf8_slice(source, value_start, value_stop)
        next_scale: scale_source
        next_color_a: color_a_source
        next_color_b: color_b_source
        _browser_source_starts_with(source, offset, "scale:", 0)?
            .next_scale: value_source
        _browser_source_starts_with(source, offset, "color_a:", 0)?
            .next_color_a: value_source
        _browser_source_starts_with(source, offset, "color_b:", 0)?
            .next_color_b: value_source
        @: _browser_scan_display_texture_fields(
            source, value_stop, stop, kind, next_scale, next_color_a, next_color_b,
            roughness, blade_length, clump_density, micro_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "roughness:", 0) \/
        _browser_source_starts_with(source, offset, "blade_length:", 0) \/
        _browser_source_starts_with(source, offset, "clump_density:", 0) \/
        _browser_source_starts_with(source, offset, "micro_shadow:", 0))?
        colon_width: 10
        _browser_source_starts_with(source, offset, "blade_length:", 0)?
            .colon_width: 13
        _browser_source_starts_with(source, offset, "clump_density:", 0)?
            .colon_width: 14
        _browser_source_starts_with(source, offset, "micro_shadow:", 0)?
            .colon_width: 13
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_roughness: roughness
        next_blade_length: blade_length
        next_clump_density: clump_density
        next_micro_shadow: micro_shadow
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .next_roughness: value
        _browser_source_starts_with(source, offset, "blade_length:", 0)?
            .next_blade_length: value
        _browser_source_starts_with(source, offset, "clump_density:", 0)?
            .next_clump_density: value
        _browser_source_starts_with(source, offset, "micro_shadow:", 0)?
            .next_micro_shadow: value
        @: _browser_scan_display_texture_fields(
            source, value_stop, stop, kind,
            scale_source, color_a_source, color_b_source,
            next_roughness, next_blade_length, next_clump_density,
            next_micro_shadow, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_display_texture_fields(
        source, next, stop, kind, scale_source, color_a_source, color_b_source,
        roughness, blade_length, clump_density, micro_shadow, unknown
    )

_browser_typed_texture_packet(
    fields:BrowserDisplayTextureFields,
    scale:any,
    color_a:any,
    color_b:any
) -> BrowserDisplayTexturePacket:
    (
        magic:1447773770, version:1, kind:fields.kind,
        scale:scale, color_a:color_a, color_b:color_b,
        roughness:fields.roughness, blade_length:fields.blade_length,
        clump_density:fields.clump_density, micro_shadow:fields.micro_shadow
    )

_browser_display_texture_packet(source:str, offset:int, in_string:bit) -> any:
    vkf_string_eof(source, offset)?
        @: []
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_string?
        @: _browser_display_texture_packet(source, next, ch != 34)
    ch = 34?
        @: _browser_display_texture_packet(source, next, true)
    _browser_source_starts_with(source, offset, "texture:", 0)?
        value_start: _browser_display_value_start(source, offset + 8)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser texture must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        fields: _browser_scan_display_texture_fields(
            source, value_start + 1, value_stop,
            "", "", "", "", 1, 0, 0, 0, false
        )
        ~fields.unsupported?! "browser texture contains an unsupported field"
        (fields.kind = "checker" \/ fields.kind = "grass")?! "browser texture kind is unsupported"
        (fields.scale_source != "" /\ fields.color_a_source != "" /\
            fields.color_b_source != "")?! "browser texture requires scale, color_a, and color_b"
        scale_tape: lexer.tagged_numeric_function_token_tape(fields.scale_source)
        scale: _browser_lifted_value(scale_tape, 0, 1).value
        color_a_tape: lexer.tagged_numeric_function_token_tape(fields.color_a_source)
        color_a: _browser_lifted_value(color_a_tape, 0, 1).value
        color_b_tape: lexer.tagged_numeric_function_token_tape(fields.color_b_source)
        color_b: _browser_lifted_value(color_b_tape, 0, 1).value
        (scale.length() = 2 /\ color_a.length() = 4 /\ color_b.length() = 4)?! "browser texture dimensions are invalid"
        fields.kind = "grass"?
            (fields.roughness >= 0 /\ fields.roughness <= 1 /\
                fields.blade_length > 0 /\ fields.clump_density > 0 /\
                fields.micro_shadow >= 0 /\ fields.micro_shadow <= 1)?! "browser grass texture parameters are invalid"
        @: _browser_typed_texture_packet(fields, scale, color_a, color_b)
    _browser_display_texture_packet(source, next, false)

_browser_scan_display_mirror_fields(
    source:str, offset:int, stop:int, frame_id:str, mesh_id:str,
    reflect_eye_only:bit, lock_aperture_camera:bit,
    controls_enabled:bit, unsupported:bit
) -> BrowserDisplayMirrorFields:
    offset >= stop?
        @: (
            frame_id:frame_id, mesh_id:mesh_id,
            reflect_eye_only:reflect_eye_only,
            lock_aperture_camera:lock_aperture_camera,
            controls_enabled:controls_enabled, unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "frame_id:", 0) \/
        _browser_source_starts_with(source, offset, "mesh_id:", 0))?
        colon_width: 8
        _browser_source_starts_with(source, offset, "frame_id:", 0)?
            .colon_width: 9
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser mirror identifiers must be strings"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        value: vkf_utf8_slice(source, value_start + 1, value_stop)
        next_frame_id: frame_id
        next_mesh_id: mesh_id
        _browser_source_starts_with(source, offset, "frame_id:", 0)?
            .next_frame_id: value
        _browser_source_starts_with(source, offset, "mesh_id:", 0)?
            .next_mesh_id: value
        @: _browser_scan_display_mirror_fields(
            source, value_stop + 1, stop, next_frame_id, next_mesh_id,
            reflect_eye_only, lock_aperture_camera,
            controls_enabled, unsupported
        )
    (_browser_source_starts_with(source, offset, "reflect_eye_only:", 0) \/
        _browser_source_starts_with(source, offset, "lock_aperture_camera:", 0) \/
        _browser_source_starts_with(source, offset, "controls_enabled:", 0))?
        colon_width: 17
        _browser_source_starts_with(source, offset, "lock_aperture_camera:", 0)?
            .colon_width: 21
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser mirror flags require booleans"
        next_reflect_eye_only: reflect_eye_only
        next_lock_aperture_camera: lock_aperture_camera
        next_controls_enabled: controls_enabled
        _browser_source_starts_with(source, offset, "reflect_eye_only:", 0)?
            .next_reflect_eye_only: value
        _browser_source_starts_with(source, offset, "lock_aperture_camera:", 0)?
            .next_lock_aperture_camera: value
        _browser_source_starts_with(source, offset, "controls_enabled:", 0)?
            .next_controls_enabled: value
        @: _browser_scan_display_mirror_fields(
            source, value_stop, stop, frame_id, mesh_id,
            next_reflect_eye_only, next_lock_aperture_camera,
            next_controls_enabled, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_display_mirror_fields(
        source, next, stop, frame_id, mesh_id, reflect_eye_only,
        lock_aperture_camera, controls_enabled, unknown
    )

_browser_scan_display_surface_camera_fields(
    source:str, offset:int, stop:int, fov:num, up_source:str,
    mirror_frame_id:str, mirror_mesh_id:str,
    reflect_eye_only:bit, lock_aperture_camera:bit,
    controls_enabled:bit, unsupported:bit
) -> BrowserDisplaySurfaceCameraFields:
    offset >= stop?
        @: (
            fov:fov, up_source:up_source,
            mirror_frame_id:mirror_frame_id, mirror_mesh_id:mirror_mesh_id,
            reflect_eye_only:reflect_eye_only,
            lock_aperture_camera:lock_aperture_camera,
            controls_enabled:controls_enabled, unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "fov:", 0)?
        value_start: _browser_display_value_start(source, offset + 4)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        @: _browser_scan_display_surface_camera_fields(
            source, value_stop, stop, value, up_source,
            mirror_frame_id, mirror_mesh_id, reflect_eye_only,
            lock_aperture_camera, controls_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "up:", 0)?
        value_start: _browser_display_value_start(source, offset + 3)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser mirror camera up must be a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        @: _browser_scan_display_surface_camera_fields(
            source, value_stop, stop, fov,
            vkf_utf8_slice(source, value_start, value_stop),
            mirror_frame_id, mirror_mesh_id, reflect_eye_only,
            lock_aperture_camera, controls_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "mirror_of:", 0)?
        value_start: _browser_display_value_start(source, offset + 10)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser mirror camera mirror_of must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        mirror_fields: _browser_scan_display_mirror_fields(
            source, value_start + 1, value_stop - 1, "", "",
            false, false, false, false
        )
        next_unsupported: unsupported
        mirror_fields.unsupported?
            .next_unsupported: true
        @: _browser_scan_display_surface_camera_fields(
            source, value_stop, stop, fov, up_source,
            mirror_fields.frame_id, mirror_fields.mesh_id,
            mirror_fields.reflect_eye_only,
            mirror_fields.lock_aperture_camera,
            mirror_fields.controls_enabled, next_unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_display_surface_camera_fields(
        source, next, stop, fov, up_source,
        mirror_frame_id, mirror_mesh_id, reflect_eye_only,
        lock_aperture_camera, controls_enabled, unknown
    )

_browser_scan_display_surface_fields(
    source:str, offset:int, stop:int, kind:str, reflectivity:num,
    reverse_facing:bit, flip_y:bit, scale_source:str,
    camera_fov:num, camera_up_source:str,
    mirror_frame_id:str, mirror_mesh_id:str,
    reflect_eye_only:bit, lock_aperture_camera:bit,
    controls_enabled:bit, unsupported:bit
) -> BrowserDisplaySurfaceFields:
    offset >= stop?
        @: (
            kind:kind, reflectivity:reflectivity,
            reverse_facing:reverse_facing, flip_y:flip_y,
            scale_source:scale_source, camera_fov:camera_fov,
            camera_up_source:camera_up_source,
            mirror_frame_id:mirror_frame_id, mirror_mesh_id:mirror_mesh_id,
            reflect_eye_only:reflect_eye_only,
            lock_aperture_camera:lock_aperture_camera,
            controls_enabled:controls_enabled,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "kind:", 0)?
        value_start: _browser_display_value_start(source, offset + 5)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser surface kind must be a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_display_surface_fields(
            source, value_stop + 1, stop,
            vkf_utf8_slice(source, value_start + 1, value_stop),
            reflectivity, reverse_facing, flip_y,
            scale_source, camera_fov, camera_up_source,
            mirror_frame_id, mirror_mesh_id, reflect_eye_only,
            lock_aperture_camera, controls_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "reflectivity:", 0)?
        value_start: _browser_display_value_start(source, offset + 13)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        @: _browser_scan_display_surface_fields(
            source, value_stop, stop, kind, value, reverse_facing,
            flip_y, scale_source, camera_fov, camera_up_source,
            mirror_frame_id, mirror_mesh_id, reflect_eye_only,
            lock_aperture_camera, controls_enabled, unsupported
        )
    (_browser_source_starts_with(source, offset, "reverse_facing:", 0) \/
        _browser_source_starts_with(source, offset, "flip_y:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "reverse_facing:", 0)?
            .colon_width: 15
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser surface flags require booleans"
        next_reverse_facing: reverse_facing
        next_flip_y: flip_y
        _browser_source_starts_with(source, offset, "reverse_facing:", 0)?
            .next_reverse_facing: value
        _browser_source_starts_with(source, offset, "flip_y:", 0)?
            .next_flip_y: value
        @: _browser_scan_display_surface_fields(
            source, value_stop, stop, kind, reflectivity,
            next_reverse_facing, next_flip_y, scale_source,
            camera_fov, camera_up_source, mirror_frame_id,
            mirror_mesh_id, reflect_eye_only, lock_aperture_camera,
            controls_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "scale:", 0)?
        value_start: _browser_display_value_start(source, offset + 6)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser surface scale must be a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        @: _browser_scan_display_surface_fields(
            source, value_stop, stop, kind, reflectivity,
            reverse_facing, flip_y,
            vkf_utf8_slice(source, value_start, value_stop),
            camera_fov, camera_up_source, mirror_frame_id,
            mirror_mesh_id, reflect_eye_only, lock_aperture_camera,
            controls_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "camera:", 0)?
        value_start: _browser_display_value_start(source, offset + 7)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser surface camera must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        camera_fields: _browser_scan_display_surface_camera_fields(
            source, value_start + 1, value_stop - 1,
            0, "", "", "", false, false, false, false
        )
        next_unsupported: unsupported
        camera_fields.unsupported?
            .next_unsupported: true
        @: _browser_scan_display_surface_fields(
            source, value_stop, stop, kind, reflectivity,
            reverse_facing, flip_y, scale_source,
            camera_fields.fov, camera_fields.up_source,
            camera_fields.mirror_frame_id, camera_fields.mirror_mesh_id,
            camera_fields.reflect_eye_only,
            camera_fields.lock_aperture_camera,
            camera_fields.controls_enabled, next_unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_display_surface_fields(
        source, next, stop, kind, reflectivity, reverse_facing,
        flip_y, scale_source, camera_fov, camera_up_source,
        mirror_frame_id, mirror_mesh_id, reflect_eye_only,
        lock_aperture_camera, controls_enabled, unknown
    )

_browser_display_surface_packet(source:str, offset:int, in_string:bit) -> any:
    vkf_string_eof(source, offset)?
        @: []
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_string?
        @: _browser_display_surface_packet(source, next, ch != 34)
    ch = 34?
        @: _browser_display_surface_packet(source, next, true)
    _browser_source_starts_with(source, offset, "surface_system:", 0)?
        value_start: _browser_display_value_start(source, offset + 15)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser surface system must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        fields: _browser_scan_display_surface_fields(
            source, value_start + 1, value_stop - 1,
            "", 1, false, false, "", 0, "", "", "",
            false, false, false, false
        )
        ~fields.unsupported?! "browser surface system contains an unsupported field"
        (fields.kind = "screen")?! "browser surface kind is unsupported"
        (fields.reflectivity >= 0 /\ fields.reflectivity <= 1)?! "browser surface reflectivity is invalid"
        (fields.scale_source != "" /\ fields.camera_fov > 0 /\
            fields.camera_fov < 180 /\ fields.camera_up_source != "" /\
            fields.mirror_frame_id != "" /\
            fields.mirror_mesh_id != "")?! "browser surface camera is incomplete"
        scale_tape: lexer.tagged_numeric_function_token_tape(fields.scale_source)
        scale: _browser_lifted_value(scale_tape, 0, 1).value
        up_tape: lexer.tagged_numeric_function_token_tape(fields.camera_up_source)
        up: _browser_lifted_value(up_tape, 0, 1).value
        (scale.length() = 2 /\ up.length() = 3)?! "browser surface camera dimensions are invalid"
        @: (
            magic:1447773773, version:1, kind:fields.kind,
            reflectivity:fields.reflectivity,
            reverse_facing:fields.reverse_facing, flip_y:fields.flip_y,
            scale:scale, camera_fov:fields.camera_fov, camera_up:up,
            mirror_frame_id:fields.mirror_frame_id,
            mirror_mesh_id:fields.mirror_mesh_id,
            reflect_eye_only:fields.reflect_eye_only,
            lock_aperture_camera:fields.lock_aperture_camera,
            controls_enabled:fields.controls_enabled
        )
    _browser_display_surface_packet(source, next, false)

_browser_scan_display_optical_fields(
    source:str, offset:int, alpha:num, transparent:bit,
    depth_write:bit, reflectivity:num, present:bit, in_string:bit
) -> BrowserDisplayOpticalFields:
    vkf_string_eof(source, offset)?
        @: (
            alpha:alpha, transparent:transparent, depth_write:depth_write,
            reflectivity:reflectivity, present:present
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_string?
        @: _browser_scan_display_optical_fields(
            source, next, alpha, transparent, depth_write,
            reflectivity, present, ch != 34
        )
    ch = 34?
        @: _browser_scan_display_optical_fields(
            source, next, alpha, transparent, depth_write,
            reflectivity, present, true
        )
    (_browser_source_starts_with(source, offset, "texture:", 0) \/
        _browser_source_starts_with(source, offset, "surface_system:", 0))?
        colon_width: 8
        _browser_source_starts_with(source, offset, "surface_system:", 0)?
            .colon_width: 15
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser material extension must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_display_optical_fields(
            source, value_stop, alpha, transparent, depth_write,
            reflectivity, present, false
        )
    (_browser_source_starts_with(source, offset, "alpha:", 0) \/
        _browser_source_starts_with(source, offset, "reflectivity:", 0))?
        colon_width: 6
        _browser_source_starts_with(source, offset, "reflectivity:", 0)?
            .colon_width: 13
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_alpha: alpha
        next_reflectivity: reflectivity
        _browser_source_starts_with(source, offset, "alpha:", 0)?
            .next_alpha: value
        _browser_source_starts_with(source, offset, "reflectivity:", 0)?
            .next_reflectivity: value
        @: _browser_scan_display_optical_fields(
            source, value_stop, next_alpha, transparent, depth_write,
            next_reflectivity, true, false
        )
    (_browser_source_starts_with(source, offset, "transparent:", 0) \/
        _browser_source_starts_with(source, offset, "depth_write:", 0))?
        colon_width: 12
        _browser_source_starts_with(source, offset, "transparent:", 0)?
            .colon_width: 12
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser optical flags require booleans"
        next_transparent: transparent
        next_depth_write: depth_write
        _browser_source_starts_with(source, offset, "transparent:", 0)?
            .next_transparent: value
        _browser_source_starts_with(source, offset, "depth_write:", 0)?
            .next_depth_write: value
        @: _browser_scan_display_optical_fields(
            source, value_stop, alpha, next_transparent, next_depth_write,
            reflectivity, true, false
        )
    _browser_scan_display_optical_fields(
        source, next, alpha, transparent, depth_write,
        reflectivity, present, false
    )

_browser_typed_optical_packet(fields:BrowserDisplayOpticalFields) -> BrowserDisplayOpticalPacket:
    (
        magic:1447773771, version:1, alpha:fields.alpha,
        transparent:fields.transparent, depth_write:fields.depth_write,
        reflectivity:fields.reflectivity
    )

_browser_display_optical_packet(source:str) -> any:
    fields: _browser_scan_display_optical_fields(
        source, 0, 1, false, true, 0, false, false
    )
    ~fields.present?
        @: []
    (fields.alpha >= 0 /\ fields.alpha <= 1 /\
        fields.reflectivity >= 0 /\ fields.reflectivity <= 1)?! "browser optical parameters are invalid"
    (fields.alpha = 1 \/ fields.transparent)?! "browser alpha requires transparent material"
    (fields.depth_write \/ fields.transparent)?! "disabled depth writes require transparent material"
    _browser_typed_optical_packet(fields)

_browser_scan_display_mesh_source(
    source:str,
    offset:int,
    x_source:str,
    y_source:str,
    z_source:str,
    x_axes:[str],
    y_axes:[str],
    z_axes:[str],
    color_source:str,
    receives_lighting:bit,
    casts_shadow:bit,
    receives_shadow:bit,
    roughness:num,
    specular_strength:num,
    unsupported:bit,
    in_string:bit
) -> BrowserDisplayMeshSources:
    vkf_string_eof(source, offset)?
        complex_p: y_source = "__browser_complex_p__"
        final_p_source: ""
        final_x_source: x_source
        final_y_source: y_source
        final_p_axes: []
        final_x_axes: x_axes
        final_y_axes: y_axes
        complex_p?
            .final_p_source: x_source
            .final_x_source: ""
            .final_y_source: ""
            .final_p_axes: x_axes
            .final_x_axes: []
            .final_y_axes: []
        @: (
            p_source:final_p_source,
            x_source:final_x_source,
            y_source:final_y_source,
            z_source:z_source,
            p_axes:final_p_axes,
            x_axes:final_x_axes,
            y_axes:final_y_axes,
            z_axes:z_axes,
            color_source:color_source,
            receives_lighting:receives_lighting,
            casts_shadow:casts_shadow,
            receives_shadow:receives_shadow,
            roughness:roughness,
            specular_strength:specular_strength,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_string?
        @: _browser_scan_display_mesh_source(
            source, next, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, ch != 34
        )
    ch = 34?
        @: _browser_scan_display_mesh_source(
            source, next, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, true
        )
    coordinate: _browser_display_coordinate_key(source, offset)
    coordinate.matched?
        value_start: _browser_display_value_start(
            source, coordinate.value_offset
        )
        vector: vkf_string_peek_scalar(source, value_start) = 91
        procedural_p: coordinate.coordinate = "p" /\ _browser_source_starts_with(source, value_start, "num(", 0)
        (vector \/ procedural_p \/ (coordinate.coordinate = "z" /\
            coordinate.axes.length() = 0))?! "browser display indexed coordinates require vectors"
        (coordinate.coordinate != "p" \/ coordinate.axes.length() > 0)?! "browser display complex p requires semantic axes"
        stop: vkf_decimal_scan_end(source, value_start)
        vector?
            .stop: _browser_display_bracket_stop(
                source, value_start + 1, 1
            )
        procedural_p?
            .stop: _browser_display_call_stop(source, value_start + 4, 1, false)
        (stop > value_start)?! "browser display coordinate value is missing"
        value_source: vkf_utf8_slice(source, value_start, stop)
        next_x: x_source
        next_y: y_source
        next_z: z_source
        next_x_axes: x_axes
        next_y_axes: y_axes
        next_z_axes: z_axes
        coordinate.coordinate = "p"?
            (x_source = "" /\ y_source = "" /\ z_source = "")?! "browser display coordinates must appear once in source order"
            .next_x: value_source
            .next_y: "__browser_complex_p__"
            .next_x_axes: coordinate.axes
        coordinate.coordinate = "x"?
            (x_source = "" /\ y_source = "" /\ z_source = "")?! "browser display coordinates must appear once in x, y, z order"
            .next_x: value_source
            .next_x_axes: coordinate.axes
        coordinate.coordinate = "y"?
            (x_source != "" /\ y_source = "" /\ z_source = "")?! "browser display coordinates must appear once in x, y, z order"
            .next_y: value_source
            .next_y_axes: coordinate.axes
        coordinate.coordinate = "z"?
            (x_source != "" /\ y_source != "" /\ z_source = "")?! "browser display coordinates must appear once in x, y, z order"
            .next_z: value_source
            .next_z_axes: coordinate.axes
        @: _browser_scan_display_mesh_source(
            source, stop, next_x, next_y, next_z,
            next_x_axes, next_y_axes, next_z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    _browser_source_starts_with(source, offset, "color:", 0)?
        value_start: _browser_display_value_start(source, offset + 6)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser display color requires a vector"
        stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        @: _browser_scan_display_mesh_source(
            source, stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes,
            vkf_utf8_slice(source, value_start, stop),
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    (_browser_source_starts_with(source, offset, "receives_lighting:", 0) \/
        _browser_source_starts_with(source, offset, "casts_shadow:", 0) \/
        _browser_source_starts_with(source, offset, "receives_shadow:", 0))?
        colon_width: 18
        _browser_source_starts_with(source, offset, "casts_shadow:", 0)?
            .colon_width: 13
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .colon_width: 16
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        next_value: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .next_value: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .next_value: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser display material flags require booleans"
        next_receives: receives_lighting
        next_casts: casts_shadow
        next_receives_shadow: receives_shadow
        _browser_source_starts_with(source, offset, "receives_lighting:", 0)?
            .next_receives: value
        _browser_source_starts_with(source, offset, "casts_shadow:", 0)?
            .next_casts: value
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .next_receives_shadow: value
        @: _browser_scan_display_mesh_source(
            source, next_value, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            next_receives, next_casts, next_receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    (_browser_source_starts_with(source, offset, "roughness:", 0) \/
        _browser_source_starts_with(source, offset, "specular_strength:", 0))?
        colon_width: 10
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .colon_width: 18
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_roughness: roughness
        next_specular: specular_strength
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .next_roughness: value
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .next_specular: value
        @: _browser_scan_display_mesh_source(
            source, value_stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            next_roughness, next_specular, unsupported, false
        )
    (_browser_source_starts_with(source, offset, "alpha:", 0) \/
        _browser_source_starts_with(source, offset, "reflectivity:", 0))?
        colon_width: 6
        _browser_source_starts_with(source, offset, "reflectivity:", 0)?
            .colon_width: 13
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        @: _browser_scan_display_mesh_source(
            source, value_stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    (_browser_source_starts_with(source, offset, "transparent:", 0) \/
        _browser_source_starts_with(source, offset, "depth_write:", 0))?
        colon_width: 12
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value_stop: value_start + 4
        _browser_source_starts_with(source, value_start, "false", 0)?
            .value_stop: value_start + 5
        (value_stop > value_start)?! "browser optical flags require booleans"
        @: _browser_scan_display_mesh_source(
            source, value_stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    _browser_source_starts_with(source, offset, "texture:", 0)?
        value_start: _browser_display_value_start(source, offset + 8)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser texture must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_display_mesh_source(
            source, value_stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    _browser_source_starts_with(source, offset, "surface_system:", 0)?
        value_start: _browser_display_value_start(source, offset + 15)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser surface system must be a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_display_mesh_source(
            source, value_stop, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    _browser_source_starts_with(source, offset, "id:", 0)?
        @: _browser_scan_display_mesh_source(
            source, offset + 3, x_source, y_source, z_source,
            x_axes, y_axes, z_axes, color_source,
            receives_lighting, casts_shadow, receives_shadow,
            roughness, specular_strength, unsupported, false
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_display_mesh_source(
        source, next, x_source, y_source, z_source,
        x_axes, y_axes, z_axes, color_source,
        receives_lighting, casts_shadow, receives_shadow,
        roughness, specular_strength, unknown, false
    )

_browser_display_grid_shape_matches(
    left:any, right:any, row:int=0
) -> bit:
    left.length() != right.length()?
        @: false
    row >= left.length()?
        @: true
    left.(row).length() != right.(row).length()?
        @: false
    _browser_display_grid_shape_matches(left, right, row + 1)

_browser_display_coordinate_rank(source:str) -> int:
    (~vkf_string_eof(source, 0) /\
        vkf_string_peek_scalar(source, 0) = 91)?! "browser display indexed coordinate requires a vector"
    first: _browser_display_value_start(
        source, vkf_utf8_advance(source, 0)
    )
    (vkf_string_eof(source, first) = false)?! "browser display indexed coordinate is unterminated"
    vkf_string_peek_scalar(source, first) != 91?
        @: 1
    second: _browser_display_value_start(
        source, vkf_utf8_advance(source, first)
    )
    (vkf_string_eof(source, second) = false)?! "browser display indexed coordinate row is unterminated"
    vkf_string_peek_scalar(source, second) = 91?
        @: 3
    2

_browser_display_v6_packet(
    fields:BrowserDisplayMeshSources,
    x:any,
    y:any,
    z:any,
    z_kind:str,
    color:any,
    texture:any,
    optical:any,
    surface_system:any
) -> any:
    (_browser_display_axes_equal(fields.x_axes, fields.y_axes) /\
        fields.x_axes.length() >= 1 /\ fields.x_axes.length() <= 2)?! "browser display x and y axes must match in source order"
    (_browser_display_coordinate_rank(fields.x_source) = fields.x_axes.length() /\
        _browser_display_coordinate_rank(fields.y_source) = fields.y_axes.length())?! "browser display coordinate nesting must match declared axes"
    x_grid: x
    y_grid: y
    fields.x_axes.length() = 1?
        .x_grid: [x]
        .y_grid: [y]
    (x_grid.length() > 0 /\ x_grid.0.length() > 0 /\
        _browser_display_grid_shape_matches(x_grid, y_grid))?! "browser display indexed coordinate shapes disagree"
    topology_axes: _browser_display_axes_by_kind(
        fields.x_axes, "topology", 0, []
    )
    group_axes: _browser_display_axes_by_kind(
        fields.x_axes, "group", 0, []
    )
    time_axis: ""
    _browser_display_axis_contains(fields.x_axes, "t", 0)?
        .time_axis: "t"
    z_kind = "vector"?
        _browser_display_axes_equal(fields.x_axes, fields.z_axes)?! "browser display z axes must match x and y in source order"
        (_browser_display_coordinate_rank(fields.z_source) = fields.z_axes.length())?! "browser display z nesting must match declared axes"
        z_grid: z
        fields.z_axes.length() = 1?
            .z_grid: [z]
        _browser_display_grid_shape_matches(x_grid, z_grid)?! "browser display indexed z shape disagrees"
        @: (
            magic:1447773766, version:6, dimension:3,
            rows:x_grid.length(), columns:x_grid.0.length(),
            color:color, x:x_grid, y:y_grid, z:z_grid,
            x_axes:fields.x_axes, y_axes:fields.y_axes,
            z_axes:fields.z_axes,
            topology_axes:topology_axes,
            group_axes:group_axes,
            time_axis:time_axis,
            receives_lighting:fields.receives_lighting,
            casts_shadow:fields.casts_shadow,
            receives_shadow:fields.receives_shadow,
            roughness:fields.roughness,
            specular_strength:fields.specular_strength,
            texture:texture, optical:optical,
            surface_system:surface_system
        )
    z_kind = "scalar"?
        (fields.z_axes.length() = 0)?! "browser display scalar z must be unindexed"
        @: (
            magic:1447773766, version:6, dimension:3,
            rows:x_grid.length(), columns:x_grid.0.length(),
            color:color, x:x_grid, y:y_grid, z:z,
            x_axes:fields.x_axes, y_axes:fields.y_axes, z_axes:[],
            topology_axes:topology_axes,
            group_axes:group_axes,
            time_axis:time_axis,
            receives_lighting:fields.receives_lighting,
            casts_shadow:fields.casts_shadow,
            receives_shadow:fields.receives_shadow,
            roughness:fields.roughness,
            specular_strength:fields.specular_strength,
            texture:texture, optical:optical,
            surface_system:surface_system
        )
    (z_kind = "missing")?! "browser display z representation is invalid"
    (fields.z_axes.length() = 0)?! "browser display omitted z cannot declare axes"
    (
        magic:1447773766, version:6, dimension:2,
        rows:x_grid.length(), columns:x_grid.0.length(),
        color:color, x:x_grid, y:y_grid,
        x_axes:fields.x_axes, y_axes:fields.y_axes, z_axes:[],
        topology_axes:topology_axes,
        group_axes:group_axes,
        time_axis:time_axis,
        receives_lighting:fields.receives_lighting,
        casts_shadow:fields.casts_shadow,
        receives_shadow:fields.receives_shadow,
        roughness:fields.roughness,
        specular_strength:fields.specular_strength,
        texture:texture, optical:optical,
        surface_system:surface_system
    )

_browser_display_complex_p_packet(
    fields:BrowserDisplayMeshSources,
    coordinates:BrowserLiftedComplexCoordinates,
    color:any,
    texture:any,
    optical:any,
    surface_system:any
) -> any:
    (fields.p_axes.length() >= 1 /\ fields.p_axes.length() <= 2)?! "browser display complex p supports one or two semantic axes"
    x_grid: coordinates.x
    y_grid: coordinates.y
    fields.p_axes.length() = 1?
        .x_grid: [coordinates.x]
        .y_grid: [coordinates.y]
    (x_grid.length() > 0 /\ x_grid.0.length() > 0 /\
        _browser_display_grid_shape_matches(x_grid, y_grid))?! "browser display complex p coordinate shapes disagree"
    topology_axes: _browser_display_axes_by_kind(
        fields.p_axes, "topology", 0, []
    )
    group_axes: _browser_display_axes_by_kind(
        fields.p_axes, "group", 0, []
    )
    time_axis: ""
    _browser_display_axis_contains(fields.p_axes, "t", 0)?
        .time_axis: "t"
    (
        magic:1447773766, version:6, dimension:2,
        rows:x_grid.length(), columns:x_grid.0.length(),
        color:color, x:x_grid, y:y_grid,
        x_axes:fields.p_axes, y_axes:fields.p_axes, z_axes:[],
        topology_axes:topology_axes,
        group_axes:group_axes,
        time_axis:time_axis,
        receives_lighting:fields.receives_lighting,
        casts_shadow:fields.casts_shadow,
        receives_shadow:fields.receives_shadow,
        roughness:fields.roughness,
        specular_strength:fields.specular_strength,
        texture:texture, optical:optical,
        surface_system:surface_system
    )

_browser_display_mesh_source(source:str) -> any:
    fields: _browser_scan_display_mesh_source(
        source, 10, "", "", "", [], [], [], "", false, false, false,
        1, 0, false, false
    )
    ~fields.unsupported?! "browser display does not support this frame.add option"
    color: [0.2, 0.7, 1, 1]
    fields.color_source != ""?
        color_tape: lexer.tagged_numeric_function_token_tape(fields.color_source)
        .color: _browser_lifted_value(color_tape, 0, 1).value
    (color.length() = 4)?! "frame.add color must be RGBA"
    texture: _browser_display_texture_packet(source, 0, false)
    optical: _browser_display_optical_packet(source)
    surface_system: _browser_display_surface_packet(source, 0, false)
    fields.p_source != ""?
        vkf_string_peek_scalar(fields.p_source, 0) != 91?
            procedural_coordinates: _browser_procedural_complex_coordinates(fields.p_source)
            @: _browser_display_complex_p_packet(
                fields, procedural_coordinates, color, texture, optical,
                surface_system
            )
        p_tape: lexer.tagged_numeric_function_token_tape(fields.p_source)
        coordinates: _browser_lifted_complex_coordinates(
            p_tape, fields.p_axes.length()
        )
        (_browser_token_kind(p_tape, coordinates.next) = 5)?! "browser display complex p has trailing tokens"
        @: _browser_display_complex_p_packet(
            fields, coordinates, color, texture, optical, surface_system
        )
    (fields.x_source != "" /\ fields.y_source != "")?! "frame.add requires p or x and y geometry"
    x_tape: lexer.tagged_numeric_function_token_tape(fields.x_source)
    x: _browser_lifted_value(x_tape, 0, 1).value
    y_tape: lexer.tagged_numeric_function_token_tape(fields.y_source)
    y: _browser_lifted_value(y_tape, 0, 1).value
    z: []
    z_kind: "missing"
    fields.z_source != ""?
        z_tape: lexer.tagged_numeric_function_token_tape(fields.z_source)
        .z: _browser_lifted_value(z_tape, 0, 1).value
        .z_kind: "scalar"
        vkf_string_peek_scalar(fields.z_source, 0) = 91?
            .z_kind: "vector"
    indexed: (
        fields.x_axes.length() > 0 \/ fields.y_axes.length() > 0 \/
        fields.z_axes.length() > 0 \/ z_kind = "scalar"
    )
    indexed?
        @: _browser_display_v6_packet(
            fields, x, y, z, z_kind, color,
            texture, optical, surface_system
        )
    (z_kind = "vector")?! "frame.add requires vector z geometry"
    rows: x.length()
    (rows > 0)?! "frame.add geometry must contain rows"
    (
        magic:1447773766, version:5, rows:rows,
        columns:x.0.length(), color:color, x:x, y:y, z:z,
        receives_lighting:fields.receives_lighting,
        casts_shadow:fields.casts_shadow,
        receives_shadow:fields.receives_shadow,
        roughness:fields.roughness,
        specular_strength:fields.specular_strength,
        texture:texture,
        optical:optical,
        surface_system:surface_system
    )

_browser_display_camera_source(source:str) -> any:
    tape: lexer.tagged_numeric_function_token_tape(source)
    index: 4
    parens: 1
    brackets: 0
    pos: []
    target: []
    up: []
    fov: 0
    projection: ""
    ortho_scale: 0
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            (key = "pos" \/ key = "target" \/ key = "up" \/ key = "fov" \/
                key = "projection" \/ key = "ortho_scale")?! "browser camera does not support this option"
            key = "projection"?
                (_browser_token_kind(tape, index + 2) = 25)?! "browser camera projection requires a string"
                encoded: _browser_token_text(tape, index + 2)
                .projection: vkf_utf8_slice(encoded, 1, encoded.length() - 1)
                .index: index + 3
            key != "projection"?
                parsed: _browser_lifted_value(tape, index + 2, 1)
                key = "pos"?
                    .pos: parsed.value
                key = "target"?
                    .target: parsed.value
                key = "up"?
                    .up: parsed.value
                key = "fov"?
                    .fov: parsed.value
                key = "ortho_scale"?
                    .ortho_scale: parsed.value
                .index: parsed.next
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    projection != ""?
        (projection = "orthographic" /\ pos.length() = 3 /\ target.length() = 3 /\
            up.length() = 3 /\ ortho_scale > 0 /\ fov = 0)?! "browser orthographic camera fields are invalid"
        @: (
            magic:1447773768, version:2, pos:pos, target:target, up:up,
            projection:"orthographic", ortho_scale:ortho_scale
        )
    (ortho_scale = 0 /\ pos.length() = 3 /\ target.length() = 3 /\ up.length() = 3 /\ fov > 0)?! "browser camera requires pos, target, up, and fov"
    (magic:1447773768, version:1, pos:pos, target:target, up:up, fov:fov)

_browser_signed_lifted_value(tape:any, index:int) -> BrowserLiftedParse:
    _browser_token_text(tape, index) = "-"?
        @: _browser_lifted_value(tape, index + 1, -1)
    _browser_lifted_value(tape, index, 1)

_browser_display_light_source(source:str) -> any:
    tape: lexer.tagged_numeric_function_token_tape(source)
    index: 4
    parens: 1
    brackets: 0
    light_kind: "point"
    id: ""
    motion: ""
    model: ""
    reflect_of_light_id: ""
    reflect_mirror_mesh_id: ""
    aperture_face_id: ""
    pos: []
    target: []
    color: []
    intensity: 0
    range: 0
    inner_cone_deg: 0
    outer_cone_deg: 0
    casts_shadow: false
    source_radius: 0
    radius: 0
    height: 0
    theta: 0
    angular_velocity: 0
    spread: 0
    show_marker: false
    saw_show_marker: false
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            supported: (key = "id" \/ key = "kind" \/ key = "motion" \/
                key = "model" \/ key = "reflect_of_light_id" \/
                key = "reflect_mirror_mesh_id" \/ key = "aperture_face_id" \/ key = "pos" \/
                key = "target" \/ key = "color" \/ key = "intensity" \/
                key = "range" \/ key = "inner_cone_deg" \/
                key = "outer_cone_deg" \/ key = "casts_shadow" \/
                key = "source_radius" \/ key = "radius" \/ key = "height" \/
                key = "theta" \/ key = "angular_velocity" \/ key = "spread" \/
                key = "show_marker")
            supported?! "browser light does not support this option"
            (key = "id" \/ key = "kind" \/ key = "motion" \/ key = "model" \/
                key = "reflect_of_light_id" \/ key = "reflect_mirror_mesh_id" \/
                key = "aperture_face_id")?
                (_browser_token_kind(tape, index + 2) = 25)?! "browser light id and kind require strings"
                encoded_value: _browser_token_text(tape, index + 2)
                key = "kind"?
                    (encoded_value = "\"point\"" \/ encoded_value = "\"spot\"" \/
                        encoded_value = "\"projected\"")?! "browser light kind is unsupported"
                    encoded_value = "\"spot\""?
                        .light_kind: "spot"
                    encoded_value = "\"projected\""?
                        .light_kind: "projected"
                decoded_value: vkf_utf8_slice(encoded_value, 1, encoded_value.length() - 1)
                key = "id"?
                    .id: decoded_value
                key = "motion"?
                    .motion: decoded_value
                key = "model"?
                    .model: decoded_value
                key = "reflect_of_light_id"?
                    .reflect_of_light_id: decoded_value
                key = "reflect_mirror_mesh_id"?
                    .reflect_mirror_mesh_id: decoded_value
                key = "aperture_face_id"?
                    .aperture_face_id: decoded_value
                .index: index + 3
            (key = "pos" \/ key = "target" \/ key = "color" \/
                key = "intensity" \/ key = "range" \/
                key = "inner_cone_deg" \/ key = "outer_cone_deg" \/
                key = "source_radius" \/ key = "radius" \/ key = "height" \/
                key = "theta" \/ key = "angular_velocity" \/ key = "spread")?
                parsed: _browser_signed_lifted_value(tape, index + 2)
                key = "pos"?
                    .pos: parsed.value
                key = "target"?
                    .target: parsed.value
                key = "color"?
                    .color: parsed.value
                key = "intensity"?
                    .intensity: parsed.value
                key = "range"?
                    .range: parsed.value
                key = "inner_cone_deg"?
                    .inner_cone_deg: parsed.value
                key = "outer_cone_deg"?
                    .outer_cone_deg: parsed.value
                key = "source_radius"?
                    .source_radius: parsed.value
                key = "radius"?
                    .radius: parsed.value
                key = "height"?
                    .height: parsed.value
                key = "theta"?
                    .theta: parsed.value
                key = "angular_velocity"?
                    .angular_velocity: parsed.value
                key = "spread"?
                    .spread: parsed.value
                .index: parsed.next
            (key = "casts_shadow" \/ key = "show_marker")?
                (_browser_token_kind(tape, index + 2) = 1)?! "browser light shadow flag requires a boolean"
                flag: _browser_token_text(tape, index + 2)
                (flag = "true" \/ flag = "false")?! "browser light shadow flag requires a boolean"
                key = "casts_shadow"?
                    .casts_shadow: flag = "true"
                key = "show_marker"?
                    .show_marker: flag = "true"
                    .saw_show_marker: true
                .index: index + 3
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    light_kind = "projected"?
        (id != "" /\ reflect_of_light_id != "" /\ reflect_mirror_mesh_id != "" /\
            aperture_face_id = reflect_mirror_mesh_id /\ model = "blinn_phong" /\
            color.length() = 4 /\ intensity > 0 /\ range > 0 /\
            source_radius >= 0 /\ spread > 0 /\ saw_show_marker /\ ~show_marker)?! "browser projected light fields are invalid"
        @: (
            magic:1447773782, version:1, id:id, kind:"projected",
            reflect_of_light_id:reflect_of_light_id,
            reflect_mirror_mesh_id:reflect_mirror_mesh_id,
            model:model, color:color, intensity:intensity, range:range,
            casts_shadow:casts_shadow, show_marker:show_marker,
            source_radius:source_radius, spread:spread,
            aperture_face_id:aperture_face_id
        )
    (light_kind = "point" /\ motion = "orbit")?
        (id != "" /\ pos.length() = 0 /\ radius > 0 /\ target.length() = 3 /\
            model = "blinn_phong" /\ color.length() = 4 /\ intensity > 0 /\ range > 0 /\
            source_radius >= 0 /\ spread > 0 /\ saw_show_marker)?! "browser orbit light fields are invalid"
        @: (
            magic:1447773781, version:1, id:id, kind:"point", motion:"orbit",
            radius:radius, height:height, theta:theta, angular_velocity:angular_velocity,
            target:target, model:model, color:color, intensity:intensity, range:range,
            casts_shadow:casts_shadow, show_marker:show_marker,
            source_radius:source_radius, spread:spread
        )
    (light_kind = "point" /\ target.length() = 0)?
        (id != "" /\ pos.length() = 3 /\ color.length() = 4 /\ intensity > 0 /\
            range > 0 /\ motion = "" /\ model = "" /\
            reflect_of_light_id = "" /\ reflect_mirror_mesh_id = "" /\
            aperture_face_id = "" /\ radius = 0 /\ height = 0 /\ theta = 0 /\
            angular_velocity = 0 /\ spread = 0 /\ ~saw_show_marker /\
            ~casts_shadow /\ source_radius = 0)?! "browser native point light fields are invalid"
        @: (
            magic:1447773769, version:2, id:id, kind:"point", pos:pos,
            color:color, intensity:intensity, range:range
        )
    (pos.length() = 3 /\ target.length() = 3 /\ color.length() = 4 /\
        intensity > 0 /\ range > 0 /\ source_radius >= 0 /\ motion = "" /\
        model = "" /\ reflect_of_light_id = "" /\ reflect_mirror_mesh_id = "" /\
        aperture_face_id = "" /\ radius = 0 /\ height = 0 /\ theta = 0 /\
        angular_velocity = 0 /\ spread = 0 /\ ~saw_show_marker)?! "browser light requires position, target, color, intensity, and range"
    light_kind = "spot"?
        (inner_cone_deg > 0 /\ outer_cone_deg > inner_cone_deg /\
            outer_cone_deg < 90)?! "browser spot light cone is invalid"
        @: (
            magic:1447773777, version:1, kind:"spot",
            pos:pos, target:target, color:color,
            intensity:intensity, range:range,
            inner_cone_deg:inner_cone_deg, outer_cone_deg:outer_cone_deg,
            casts_shadow:casts_shadow, source_radius:source_radius
        )
    (inner_cone_deg = 0 /\ outer_cone_deg = 0)?! "browser point light does not accept cone options"
    (
        magic:1447773769, version:1, pos:pos, target:target, color:color,
        intensity:intensity, range:range, casts_shadow:casts_shadow,
        source_radius:source_radius
    )

_browser_scan_display_source(
    source:str,
    offset:int,
    packet_count:int,
    packet_index:int,
    selected_source:str,
    selected_kind:str,
    options_source:str,
    unsupported:bit,
    in_string:bit,
    in_comment:bit
) -> BrowserDisplayScan:
    vkf_string_eof(source, offset)?
        @: (
            packet_count:packet_count,
            selected_source:selected_source,
            selected_kind:selected_kind,
            options_source:options_source,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    in_comment?
        ch = 10?
            @: _browser_scan_display_source(
                source, next, packet_count, packet_index,
                selected_source, selected_kind, options_source,
                unsupported, false, false
            )
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source,
            unsupported, false, true
        )
    in_string?
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source, unsupported,
            ch != 34, false
        )
    ch = 35?
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source,
            unsupported, false, true
        )
    ch = 34?
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source,
            unsupported, true, false
        )
    _browser_source_starts_with(
        source, offset, "frame.set_geom_options(", 0
    )?
        stop: _browser_display_call_stop(source, offset + 23, 1, false)
        @: _browser_scan_display_source(
            source, stop, packet_count, packet_index,
            selected_source, selected_kind,
            vkf_utf8_slice(source, offset, stop),
            unsupported, false, false
        )
    _browser_source_starts_with(source, offset, "frame.add_camera(", 0)?
        stop: _browser_display_call_stop(source, offset + 17, 1, false)
        selected: selected_source
        kind: selected_kind
        packet_count = packet_index?
            .selected: vkf_utf8_slice(source, offset, stop)
            .kind: "camera"
        @: _browser_scan_display_source(
            source, stop, packet_count + 1, packet_index,
            selected, kind, options_source, unsupported, false, false
        )
    _browser_source_starts_with(source, offset, "frame.add_light(", 0)?
        stop: _browser_display_call_stop(source, offset + 16, 1, false)
        selected: selected_source
        kind: selected_kind
        packet_count = packet_index?
            .selected: vkf_utf8_slice(source, offset, stop)
            .kind: "light"
        @: _browser_scan_display_source(
            source, stop, packet_count + 1, packet_index,
            selected, kind, options_source, unsupported, false, false
        )
    _browser_source_starts_with(source, offset, "frame.add(", 0)?
        stop: _browser_display_call_stop(source, offset + 10, 1, false)
        selected: selected_source
        kind: selected_kind
        packet_count = packet_index?
            .selected: vkf_utf8_slice(source, offset, stop)
            .kind: "mesh"
        @: _browser_scan_display_source(
            source, stop, packet_count + 1, packet_index,
            selected, kind, options_source, unsupported, false, false
        )
    _browser_source_starts_with(source, offset, "frame.", 0)?
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source,
            true, false, false
        )
    _browser_source_starts_with(source, offset, "controls.", 0)?
        @: _browser_scan_display_source(
            source, next, packet_count, packet_index,
            selected_source, selected_kind, options_source,
            true, false, false
        )
    _browser_scan_display_source(
        source, next, packet_count, packet_index,
        selected_source, selected_kind, options_source,
        unsupported, false, false
    )

_run_tagged_display_source(source:str, packet_index:int) -> any:
    scan: _browser_scan_display_source(
        source, 0, 0, packet_index, "", "", "", false, false, false
    )
    ~scan.unsupported?! "browser display source requires unsupported scene features"
    (scan.packet_count > 0)?! "display source did not retain geometry"
    procedural_p: scan.selected_kind = "mesh" /\ _browser_find_source(scan.selected_source, 0, ":num(") >= 0
    procedural_p?
        math_spill: _browser_find_source(source, 0, "\n:.math\n") >= 0 \/ _browser_find_source(source, 0, "\n: .math\n") >= 0
        math_spill?! "browser display procedural p requires the .math spill"
        unshadowed_math: _browser_find_source(source, 0, "\npi:") < 0 /\ _browser_find_source(source, 0, "\nsin(") < 0
        unshadowed_math?! "browser display procedural p does not support shadowed pi or sin bindings"
    packet_index >= 0?
        (scan.selected_source != "")?! "browser display packet index is out of range"
        scan.selected_kind = "camera"?
            @: _browser_display_camera_source(scan.selected_source)
        scan.selected_kind = "light"?
            @: _browser_display_light_source(scan.selected_source)
        (scan.selected_kind = "mesh")?! "browser display packet kind is unsupported"
        @: _browser_display_mesh_source(scan.selected_source)
    background: []
    combine_transparent: false
    scan.options_source != ""?
        tape: lexer.tagged_numeric_function_token_tape(scan.options_source)
        options: _browser_display_options_call(tape, 4)
        .background: options.background
        .combine_transparent: options.combine_transparent
    (
        kind:"visual_stream", packet_count:scan.packet_count,
        background:background, combine_transparent:combine_transparent
    )

_browser_scan_world_options(
    source:str, offset:int, stop:int, dimension:int,
    em:bit, gravity:bit, rigid_collisions:bit,
    saw_dimension:bit, saw_em:bit, saw_gravity:bit,
    saw_rigid_collisions:bit, unsupported:bit
) -> BrowserWorldOptions:
    offset >= stop?
        @: (
            dimension:dimension, em:em, gravity:gravity,
            rigid_collisions:rigid_collisions,
            saw_dimension:saw_dimension, saw_em:saw_em,
            saw_gravity:saw_gravity,
            saw_rigid_collisions:saw_rigid_collisions,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "dim:", 0)?
        value_start: _browser_display_value_start(source, offset + 4)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        @: _browser_scan_world_options(
            source, value_stop, stop, value, em, gravity, rigid_collisions,
            true, saw_em, saw_gravity, saw_rigid_collisions, unsupported
        )
    (_browser_source_starts_with(source, offset, "em:", 0) \/
        _browser_source_starts_with(source, offset, "gravity:", 0) \/
        _browser_source_starts_with(source, offset, "rigid_collisions:", 0))?
        colon_width: 3
        _browser_source_starts_with(source, offset, "gravity:", 0)?
            .colon_width: 8
        _browser_source_starts_with(source, offset, "rigid_collisions:", 0)?
            .colon_width: 17
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser World flags require booleans"
        next_em: em
        next_gravity: gravity
        next_rigid_collisions: rigid_collisions
        next_saw_em: saw_em
        next_saw_gravity: saw_gravity
        next_saw_rigid_collisions: saw_rigid_collisions
        _browser_source_starts_with(source, offset, "em:", 0)?
            .next_em: value
            .next_saw_em: true
        _browser_source_starts_with(source, offset, "gravity:", 0)?
            .next_gravity: value
            .next_saw_gravity: true
        _browser_source_starts_with(source, offset, "rigid_collisions:", 0)?
            .next_rigid_collisions: value
            .next_saw_rigid_collisions: true
        @: _browser_scan_world_options(
            source, value_stop, stop, dimension,
            next_em, next_gravity, next_rigid_collisions,
            saw_dimension, next_saw_em, next_saw_gravity,
            next_saw_rigid_collisions, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_world_options(
        source, next, stop, dimension, em, gravity, rigid_collisions,
        saw_dimension, saw_em, saw_gravity, saw_rigid_collisions, unknown
    )

_browser_world_source_matches(source:str) -> bit:
    (_browser_source_starts_with(source, 0, ": .ui.display", 0) /\
        _browser_find_source(source, 0, ": .physics") >= 0 /\
        _browser_find_source(source, 0, "Particle(position:[num:2], color:[num:4], radius:num, mass:num):") >= 0 /\
        _browser_find_source(source, 0, "p_u:[particle.position]") >= 0 /\
        _browser_find_source(source, 0, "c_uc:[particle.color]") >= 0 /\
        _browser_find_source(source, 0, "s_u:[particle.radius * 2]") >= 0 /\
        _browser_find_source(source, 0, "s_mode:data") >= 0 /\
        _browser_find_source(source, 0, "view: d.append_world(w, embedding)") >= 0 /\
        _browser_find_source(source, 0, "d.show()") >= 0)

_browser_world_particle_packet(source:str) -> any:
    world_start: _browser_find_source(source, 0, "w: World(")
    (world_start >= 0)?! "browser World requires a retained World binding"
    world_stop: _browser_display_call_stop(source, world_start + 9, 1, false)
    options: _browser_scan_world_options(
        source, world_start + 9, world_stop - 1,
        0, false, false, false, false, false, false, false, false
    )
    (~options.unsupported /\ options.saw_dimension /\ options.saw_em /\
        options.saw_gravity /\ options.saw_rigid_collisions)?! "browser World contains unsupported options"
    (options.dimension = 2 /\ ~options.em /\ ~options.gravity /\
        ~options.rigid_collisions)?! "browser World effects are unsupported"
    particle_start: _browser_find_source(source, world_stop, "w.add(Particle(")
    (particle_start >= 0)?! "browser World requires one Particle"
    position_start: _browser_world_argument_start(source, particle_start + 15)
    (vkf_string_peek_scalar(source, position_start) = 91)?! "browser World Particle position must be a vector"
    position_stop: _browser_display_bracket_stop(source, position_start + 1, 1)
    color_start: _browser_world_argument_start(source, position_stop)
    (vkf_string_peek_scalar(source, color_start) = 91)?! "browser World Particle color must be a vector"
    color_stop: _browser_display_bracket_stop(source, color_start + 1, 1)
    radius_start: _browser_world_argument_start(source, color_stop)
    radius_stop: vkf_decimal_scan_end(source, radius_start)
    mass_start: _browser_world_argument_start(source, radius_stop)
    mass_stop: vkf_decimal_scan_end(source, mass_start)
    close: _browser_display_value_start(source, mass_stop)
    (vkf_string_peek_scalar(source, close) = 41)?! "browser World Particle has unsupported arguments"
    position_tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, position_start, position_stop)
    )
    position: _browser_lifted_value(position_tape, 0, 1).value
    color_tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, color_start, color_stop)
    )
    color: _browser_lifted_value(color_tape, 0, 1).value
    radius: vkf_decimal_parse(vkf_utf8_slice(source, radius_start, radius_stop))
    mass: vkf_decimal_parse(vkf_utf8_slice(source, mass_start, mass_stop))
    (position.length() = 2 /\ color.length() = 4 /\
        radius > 0 /\ mass > 0)?! "browser World Particle values are invalid"
    (
        magic:1447773774, version:1, position:position,
        color:color, size:radius * 2, mass:mass
    )

_run_tagged_world_source(source:str, packet_index:int) -> any:
    _browser_world_source_matches(source)?! "browser World embedding shape is unsupported"
    packet_index < 0?
        @: (
            kind:"visual_stream", packet_count:1,
            background:[], combine_transparent:false
        )
    (packet_index = 0)?! "browser World packet index is out of range"
    _browser_world_particle_packet(source)

_browser_native_rigid_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, "native_scene:(") >= 0 /\
        _browser_find_source(source, 0, "rigid_world_2d:(") >= 0 /\
        _browser_find_source(source, 0, "rigid_bodies_2d:[") >= 0)

_browser_scan_native_rigid_scene(
    source:str, offset:int, stop:int, rect_source:str,
    background_source:str, camera_source:str, lights_source:str,
    timing_source:str, rigid_world_source:str, rigid_bodies_source:str,
    unsupported:bit
) -> BrowserNativeRigidScene:
    offset >= stop?
        @: (
            rect_source:rect_source, background_source:background_source,
            camera_source:camera_source, lights_source:lights_source,
            timing_source:timing_source, rigid_world_source:rigid_world_source,
            rigid_bodies_source:rigid_bodies_source, unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "frame_id:", 0) \/
        _browser_source_starts_with(source, offset, "title:", 0))?
        colon_width: 9
        _browser_source_starts_with(source, offset, "title:", 0)?
            .colon_width: 6
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser rigid scene metadata requires strings"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_native_rigid_scene(
            source, value_stop + 1, stop, rect_source, background_source,
            camera_source, lights_source, timing_source, rigid_world_source,
            rigid_bodies_source, unsupported
        )
    (_browser_source_starts_with(source, offset, "rect:", 0) \/
        _browser_source_starts_with(source, offset, "background:", 0) \/
        _browser_source_starts_with(source, offset, "lights:", 0) \/
        _browser_source_starts_with(source, offset, "rigid_bodies_2d:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "background:", 0)?
            .colon_width: 11
        _browser_source_starts_with(source, offset, "lights:", 0)?
            .colon_width: 7
        _browser_source_starts_with(source, offset, "rigid_bodies_2d:", 0)?
            .colon_width: 16
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser rigid scene collection requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        value_source: vkf_utf8_slice(source, value_start, value_stop)
        next_rect: rect_source
        next_background: background_source
        next_lights: lights_source
        next_bodies: rigid_bodies_source
        _browser_source_starts_with(source, offset, "rect:", 0)?
            .next_rect: value_source
        _browser_source_starts_with(source, offset, "background:", 0)?
            .next_background: value_source
        _browser_source_starts_with(source, offset, "lights:", 0)?
            .next_lights: value_source
        _browser_source_starts_with(source, offset, "rigid_bodies_2d:", 0)?
            .next_bodies: value_source
        @: _browser_scan_native_rigid_scene(
            source, value_stop, stop, next_rect, next_background,
            camera_source, next_lights, timing_source, rigid_world_source,
            next_bodies, unsupported
        )
    (_browser_source_starts_with(source, offset, "camera:", 0) \/
        _browser_source_starts_with(source, offset, "timing:", 0) \/
        _browser_source_starts_with(source, offset, "rigid_world_2d:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "timing:", 0)?
            .colon_width: 7
        _browser_source_starts_with(source, offset, "rigid_world_2d:", 0)?
            .colon_width: 15
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser rigid scene record requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        value_source: vkf_utf8_slice(source, value_start + 1, value_stop - 1)
        next_camera: camera_source
        next_timing: timing_source
        next_world: rigid_world_source
        _browser_source_starts_with(source, offset, "camera:", 0)?
            .next_camera: value_source
        _browser_source_starts_with(source, offset, "timing:", 0)?
            .next_timing: value_source
        _browser_source_starts_with(source, offset, "rigid_world_2d:", 0)?
            .next_world: value_source
        @: _browser_scan_native_rigid_scene(
            source, value_stop, stop, rect_source, background_source,
            next_camera, lights_source, next_timing, next_world,
            rigid_bodies_source, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_rigid_scene(
        source, next, stop, rect_source, background_source, camera_source,
        lights_source, timing_source, rigid_world_source, rigid_bodies_source,
        unknown
    )

_browser_native_rigid_world_packet(source:str) -> any:
    tape: lexer.tagged_numeric_function_token_tape("frame.add(" & source & ")")
    index: 4
    parens: 1
    brackets: 0
    width: 0
    height: 0
    gravity: []
    solver_iterations: 0
    step_dt: 0
    max_substeps: 0
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            (key = "width" \/ key = "height" \/ key = "gravity" \/
                key = "solver_iterations" \/ key = "step_dt" \/
                key = "max_substeps")?! "browser rigid world contains unsupported options"
            parsed: _browser_lifted_value(tape, index + 2, 1)
            key = "width"?
                .width: parsed.value
            key = "height"?
                .height: parsed.value
            key = "gravity"?
                .gravity: parsed.value
            key = "solver_iterations"?
                .solver_iterations: parsed.value
            key = "step_dt"?
                .step_dt: parsed.value
            key = "max_substeps"?
                .max_substeps: parsed.value
            .index: parsed.next
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    (width > 0 /\ height > 0 /\ gravity.length() = 2 /\
        solver_iterations > 0 /\ solver_iterations // 1 = solver_iterations /\
        step_dt > 0 /\ max_substeps > 0 /\ max_substeps // 1 = max_substeps)?! "browser rigid world fields are invalid"
    (
        magic:1447773783, version:1, width:width, height:height,
        gravity:gravity, solver_iterations:solver_iterations,
        step_dt:step_dt, max_substeps:max_substeps
    )

_browser_rigid_contour_valid(contour:any, index:int) -> bit:
    index = contour.length()?
        @: contour.length() >= 3
    (contour.(index).length() = 2 /\
        _browser_rigid_contour_valid(contour, index + 1))

_browser_native_rigid_body_packet(source:str) -> any:
    tape: lexer.tagged_numeric_function_token_tape("frame.add(" & source & ")")
    index: 4
    parens: 1
    brackets: 0
    id: ""
    contour: []
    position: []
    velocity: []
    angular_velocity: 0
    density: 0
    e_n: 0
    static: false
    color: []
    saw_static: false
    saw_angular_velocity: false
    saw_density: false
    saw_e_n: false
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            (key = "id" \/ key = "contours" \/ key = "position" \/
                key = "velocity" \/ key = "angular_velocity" \/
                key = "density" \/ key = "e_n" \/ key = "static" \/
                key = "color")?! "browser rigid body contains unsupported options"
            key = "id"?
                (_browser_token_kind(tape, index + 2) = 25)?! "browser rigid body id requires a string"
                encoded: _browser_token_text(tape, index + 2)
                .id: vkf_utf8_slice(encoded, 1, encoded.length() - 1)
                .index: index + 3
            key = "contours"?
                (_browser_token_kind(tape, index + 2) = 22 /\
                    _browser_token_kind(tape, index + 3) = 22)?! "browser rigid body supports one contour"
                parsed: _browser_lifted_value(tape, index + 3, 1)
                (_browser_token_kind(tape, parsed.next) = 23)?! "browser rigid body supports one contour"
                .contour: parsed.value
                .index: parsed.next + 1
            (key = "position" \/ key = "velocity" \/ key = "color")?
                parsed: _browser_lifted_value(tape, index + 2, 1)
                key = "position"?
                    .position: parsed.value
                key = "velocity"?
                    .velocity: parsed.value
                key = "color"?
                    .color: parsed.value
                .index: parsed.next
            (key = "angular_velocity" \/ key = "density" \/ key = "e_n")?
                parsed: _browser_signed_lifted_value(tape, index + 2)
                key = "angular_velocity"?
                    .angular_velocity: parsed.value
                    .saw_angular_velocity: true
                key = "density"?
                    .density: parsed.value
                    .saw_density: true
                key = "e_n"?
                    .e_n: parsed.value
                    .saw_e_n: true
                .index: parsed.next
            key = "static"?
                (_browser_token_kind(tape, index + 2) = 1)?! "browser rigid body static flag requires a boolean"
                flag: _browser_token_text(tape, index + 2)
                (flag = "true" \/ flag = "false")?! "browser rigid body static flag requires a boolean"
                .static: flag = "true"
                .saw_static: true
                .index: index + 3
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    (id != "" /\ position.length() = 2 /\ color.length() = 4 /\
        _browser_rigid_contour_valid(contour, 0))?! "browser rigid body fields are invalid"
    static?
        (saw_static /\ velocity.length() = 0 /\ ~saw_angular_velocity /\
            ~saw_density /\ ~saw_e_n)?! "browser static rigid body fields are invalid"
        @: (
            magic:1447773784, version:1, id:id, contours:[contour],
            position:position, static:true, color:color
        )
    (~saw_static /\ velocity.length() = 2 /\ saw_angular_velocity /\
        saw_density /\ density > 0 /\ saw_e_n /\ e_n >= 0 /\ e_n <= 1)?! "browser dynamic rigid body fields are invalid"
    (
        magic:1447773784, version:1, id:id, contours:[contour],
        position:position, static:false, color:color, velocity:velocity,
        angular_velocity:angular_velocity, density:density, e_n:e_n
    )

_browser_native_rigid_scene(source:str, packet_index:int) -> any:
    scene_start: _browser_find_source(source, 0, "native_scene:(")
    (scene_start >= 0)?! "browser native rigid scene is missing"
    scene_stop: _browser_display_call_stop(source, scene_start + 14, 1, false)
    scene: _browser_scan_native_rigid_scene(
        source, scene_start + 14, scene_stop - 1,
        "", "", "", "", "", "", "", false
    )
    (~scene.unsupported /\ scene.rect_source != "" /\
        scene.background_source != "" /\ scene.camera_source != "" /\
        scene.lights_source != "" /\ scene.timing_source != "" /\
        scene.rigid_world_source != "" /\ scene.rigid_bodies_source != "")?! "browser native rigid scene contains unsupported options"
    rect_tape: lexer.tagged_numeric_function_token_tape(scene.rect_source)
    rect: _browser_lifted_value(rect_tape, 0, 1).value
    background_tape: lexer.tagged_numeric_function_token_tape(scene.background_source)
    background: _browser_lifted_value(background_tape, 0, 1).value
    (rect.length() = 4 /\ rect.0 >= 0 /\ rect.1 >= 0 /\ rect.2 > 0 /\
        rect.3 > 0 /\ rect.0 + rect.2 <= 1 /\ rect.1 + rect.3 <= 1 /\
        background.length() = 4)?! "browser native rigid scene layout is invalid"
    light_count: _browser_record_list_count(scene.lights_source, 0, 0)
    body_count: _browser_record_list_count(scene.rigid_bodies_source, 0, 0)
    (light_count > 0 /\ body_count > 0)?! "browser native rigid scene requires lights and bodies"
    packet_index < 0?
        @: (
            kind:"visual_stream", packet_count:3 + light_count + body_count,
            background:background, combine_transparent:false
        )
    packet_index = 0?
        @: _browser_display_camera_source("frame.add_camera(" & scene.camera_source & ")")
    packet_index = 1?
        @: _browser_native_timing_packet(scene.timing_source, "", false, 0)
    packet_index < 2 + light_count?
        @: _browser_display_light_source(
            "frame.add_light(" & _browser_record_list_item(
                scene.lights_source, 0, packet_index - 2, 0
            ) & ")"
        )
    packet_index = 2 + light_count?
        @: _browser_native_rigid_world_packet(scene.rigid_world_source)
    (packet_index < 3 + light_count + body_count)?! "browser native rigid scene packet index is out of range"
    _browser_native_rigid_body_packet(
        _browser_record_list_item(
            scene.rigid_bodies_source, 0,
            packet_index - 3 - light_count, 0
        )
    )

_browser_native_cube_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, "native_scene:(") >= 0 /\
        _browser_find_source(source, 0, "cubes:[") >= 0 /\
        _browser_find_source(source, 0, "meshes:[") = -1)

_browser_scan_native_cube_scene(
    source:str, offset:int, stop:int, kind:str,
    background_source:str, camera_source:str, plane_source:str,
    surfaces_source:str, cubes_source:str, lights_source:str,
    shadow_source:str, options:BrowserNativeSceneOptions, unsupported:bit
) -> BrowserNativeCubeScene:
    offset >= stop?
        @: (
            kind:kind, background_source:background_source,
            camera_source:camera_source, plane_source:plane_source,
            surfaces_source:surfaces_source, cubes_source:cubes_source,
            lights_source:lights_source, shadow_source:shadow_source,
            options:options,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "kind:", 0) \/
        _browser_source_starts_with(source, offset, "frame_id:", 0) \/
        _browser_source_starts_with(source, offset, "title:", 0) \/
        _browser_source_starts_with(source, offset, "aspect:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "frame_id:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "title:", 0)?
            .colon_width: 6
        _browser_source_starts_with(source, offset, "aspect:", 0)?
            .colon_width: 7
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native scene text fields require strings"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        next_kind: kind
        next_options: options
        _browser_source_starts_with(source, offset, "kind:", 0)?
            .next_kind: vkf_utf8_slice(source, value_start + 1, value_stop)
        _browser_source_starts_with(source, offset, "aspect:", 0)?
            .next_options: (
                aspect:vkf_utf8_slice(source, value_start + 1, value_stop),
                timing_source:options.timing_source,
                show_light_markers:options.show_light_markers,
                saw_show_light_markers:options.saw_show_light_markers,
                light_marker_size:options.light_marker_size
            )
        @: _browser_scan_native_cube_scene(
            source, value_stop + 1, stop, next_kind, background_source,
            camera_source, plane_source, surfaces_source, cubes_source,
            lights_source, shadow_source, next_options, unsupported
        )
    (_browser_source_starts_with(source, offset, "rect:", 0) \/
        _browser_source_starts_with(source, offset, "background:", 0) \/
        _browser_source_starts_with(source, offset, "surfaces:", 0) \/
        _browser_source_starts_with(source, offset, "cubes:", 0) \/
        _browser_source_starts_with(source, offset, "lights:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "background:", 0)?
            .colon_width: 11
        _browser_source_starts_with(source, offset, "surfaces:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "cubes:", 0)?
            .colon_width: 6
        _browser_source_starts_with(source, offset, "lights:", 0)?
            .colon_width: 7
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native scene collection requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        value_source: vkf_utf8_slice(source, value_start, value_stop)
        next_background: background_source
        next_surfaces: surfaces_source
        next_cubes: cubes_source
        next_lights: lights_source
        _browser_source_starts_with(source, offset, "background:", 0)?
            .next_background: value_source
        _browser_source_starts_with(source, offset, "surfaces:", 0)?
            .next_surfaces: value_source
        _browser_source_starts_with(source, offset, "cubes:", 0)?
            .next_cubes: value_source
        _browser_source_starts_with(source, offset, "lights:", 0)?
            .next_lights: value_source
        @: _browser_scan_native_cube_scene(
            source, value_stop, stop, kind, next_background,
            camera_source, plane_source, next_surfaces, next_cubes,
            next_lights, shadow_source, options, unsupported
        )
    (_browser_source_starts_with(source, offset, "camera:", 0) \/
        _browser_source_starts_with(source, offset, "plane:", 0) \/
        _browser_source_starts_with(source, offset, "shadow:", 0) \/
        _browser_source_starts_with(source, offset, "timing:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "plane:", 0)?
            .colon_width: 6
        _browser_source_starts_with(source, offset, "shadow:", 0)?
            .colon_width: 7
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser native scene field requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        value_source: vkf_utf8_slice(source, value_start + 1, value_stop - 1)
        next_camera: camera_source
        next_plane: plane_source
        next_shadow: shadow_source
        next_timing: options.timing_source
        _browser_source_starts_with(source, offset, "camera:", 0)?
            .next_camera: value_source
        _browser_source_starts_with(source, offset, "plane:", 0)?
            .next_plane: value_source
        _browser_source_starts_with(source, offset, "shadow:", 0)?
            .next_shadow: value_source
        _browser_source_starts_with(source, offset, "timing:", 0)?
            .next_timing: value_source
        next_options: options
        _browser_source_starts_with(source, offset, "timing:", 0)?
            .next_options: (
                aspect:options.aspect, timing_source:next_timing,
                show_light_markers:options.show_light_markers,
                saw_show_light_markers:options.saw_show_light_markers,
                light_marker_size:options.light_marker_size
            )
        @: _browser_scan_native_cube_scene(
            source, value_stop, stop, kind, background_source,
            next_camera, next_plane, surfaces_source, cubes_source,
            lights_source, next_shadow, next_options, unsupported
        )
    _browser_source_starts_with(source, offset, "show_light_markers:", 0)?
        value_start: _browser_display_value_start(source, offset + 19)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser native scene light marker flag requires a boolean"
        @: _browser_scan_native_cube_scene(
            source, value_stop, stop, kind, background_source,
            camera_source, plane_source, surfaces_source, cubes_source,
            lights_source, shadow_source,
            (aspect:options.aspect, timing_source:options.timing_source,
                show_light_markers:value, saw_show_light_markers:true,
                light_marker_size:options.light_marker_size), unsupported
        )
    _browser_source_starts_with(source, offset, "light_marker_size:", 0)?
        value_start: _browser_display_value_start(source, offset + 18)
        value_stop: vkf_decimal_scan_end(source, value_start)
        @: _browser_scan_native_cube_scene(
            source, value_stop, stop, kind, background_source,
            camera_source, plane_source, surfaces_source, cubes_source,
            lights_source, shadow_source,
            (aspect:options.aspect, timing_source:options.timing_source,
                show_light_markers:options.show_light_markers,
                saw_show_light_markers:options.saw_show_light_markers,
                light_marker_size:vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))),
            unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_cube_scene(
        source, next, stop, kind, background_source, camera_source,
        plane_source, surfaces_source, cubes_source, lights_source,
        shadow_source, options, unknown
    )

_browser_scan_native_plane(
    source:str, offset:int, stop:int, center_source:str,
    size:num, z:num, color_source:str, texture_source:str,
    roughness:num, specular_strength:num, unsupported:bit
) -> BrowserNativePlane:
    (offset >= stop \/ vkf_string_eof(source, offset))?
        @: (center_source:center_source, size:size, z:z,
            color_source:color_source, texture_source:texture_source,
            roughness:roughness, specular_strength:specular_strength,
            unsupported:unsupported)
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "center:", 0) \/
        _browser_source_starts_with(source, offset, "color:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "color:", 0)?
            .colon_width: 6
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native plane vector field requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        next_center: center_source
        next_color: color_source
        _browser_source_starts_with(source, offset, "center:", 0)?
            .next_center: vkf_utf8_slice(source, value_start, value_stop)
        _browser_source_starts_with(source, offset, "color:", 0)?
            .next_color: vkf_utf8_slice(source, value_start, value_stop)
        @: _browser_scan_native_plane(
            source, value_stop, stop, next_center, size, z, next_color,
            texture_source, roughness, specular_strength, unsupported
        )
    (_browser_source_starts_with(source, offset, "size:", 0) \/
        _browser_source_starts_with(source, offset, "z:", 0) \/
        _browser_source_starts_with(source, offset, "roughness:", 0) \/
        _browser_source_starts_with(source, offset, "specular_strength:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "z:", 0)?
            .colon_width: 2
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .colon_width: 10
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .colon_width: 18
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_size: size
        next_z: z
        next_roughness: roughness
        next_specular: specular_strength
        _browser_source_starts_with(source, offset, "size:", 0)?
            .next_size: value
        _browser_source_starts_with(source, offset, "z:", 0)?
            .next_z: value
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .next_roughness: value
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .next_specular: value
        @: _browser_scan_native_plane(
            source, value_stop, stop, center_source, next_size, next_z,
            color_source, texture_source, next_roughness, next_specular, unsupported
        )
    _browser_source_starts_with(source, offset, "texture:", 0)?
        value_start: _browser_display_value_start(source, offset + 8)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser native plane texture requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_native_plane(
            source, value_stop, stop, center_source, size, z, color_source,
            vkf_utf8_slice(source, value_start + 1, value_stop - 1),
            roughness, specular_strength, unsupported
        )
    _browser_source_starts_with(source, offset, "id:", 0)?
        value_start: _browser_display_value_start(source, offset + 3)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native plane id requires a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_native_plane(
            source, value_stop + 1, stop, center_source, size, z,
            color_source, texture_source, roughness, specular_strength, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_plane(
        source, next, stop, center_source, size, z, color_source,
        texture_source, roughness, specular_strength, unknown
    )

_browser_scan_native_cube(
    source:str, offset:int, stop:int, center_source:str, size:num,
    color_source:str, rotation_source:str, texture_source:str,
    roughness:num, specular_strength:num,
    casts_shadow:bit, receives_shadow:bit, unsupported:bit
) -> BrowserNativeCube:
    (offset >= stop \/ vkf_string_eof(source, offset))?
        @: (
            center_source:center_source, size:size, color_source:color_source,
            rotation_source:rotation_source, texture_source:texture_source,
            roughness:roughness, specular_strength:specular_strength,
            casts_shadow:casts_shadow, receives_shadow:receives_shadow,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "center:", 0) \/
        _browser_source_starts_with(source, offset, "face_color:", 0) \/
        _browser_source_starts_with(source, offset, "rotation:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "face_color:", 0)?
            .colon_width: 11
        _browser_source_starts_with(source, offset, "rotation:", 0)?
            .colon_width: 9
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native cube vector field requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        next_center: center_source
        next_color: color_source
        next_rotation: rotation_source
        _browser_source_starts_with(source, offset, "center:", 0)?
            .next_center: vkf_utf8_slice(source, value_start, value_stop)
        _browser_source_starts_with(source, offset, "face_color:", 0)?
            .next_color: vkf_utf8_slice(source, value_start, value_stop)
        _browser_source_starts_with(source, offset, "rotation:", 0)?
            .next_rotation: vkf_utf8_slice(source, value_start, value_stop)
        @: _browser_scan_native_cube(
            source, value_stop, stop, next_center, size, next_color,
            next_rotation, texture_source, roughness, specular_strength,
            casts_shadow, receives_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "size:", 0) \/
        _browser_source_starts_with(source, offset, "roughness:", 0) \/
        _browser_source_starts_with(source, offset, "specular_strength:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .colon_width: 10
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .colon_width: 18
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_size: size
        next_roughness: roughness
        next_specular: specular_strength
        _browser_source_starts_with(source, offset, "size:", 0)?
            .next_size: value
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .next_roughness: value
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .next_specular: value
        @: _browser_scan_native_cube(
            source, value_stop, stop, center_source, next_size, color_source,
            rotation_source, texture_source, next_roughness, next_specular,
            casts_shadow, receives_shadow, unsupported
        )
    _browser_source_starts_with(source, offset, "texture:", 0)?
        value_start: _browser_display_value_start(source, offset + 8)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser native cube texture requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_native_cube(
            source, value_stop, stop, center_source, size, color_source,
            rotation_source, vkf_utf8_slice(source, value_start + 1, value_stop - 1),
            roughness, specular_strength, casts_shadow, receives_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "casts_shadow:", 0) \/
        _browser_source_starts_with(source, offset, "receives_shadow:", 0))?
        colon_width: 13
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .colon_width: 16
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser native cube flags require booleans"
        next_casts: casts_shadow
        next_receives: receives_shadow
        _browser_source_starts_with(source, offset, "casts_shadow:", 0)?
            .next_casts: value
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .next_receives: value
        @: _browser_scan_native_cube(
            source, value_stop, stop, center_source, size, color_source,
            rotation_source, texture_source, roughness, specular_strength,
            next_casts, next_receives, unsupported
        )
    _browser_source_starts_with(source, offset, "id:", 0)?
        value_start: _browser_display_value_start(source, offset + 3)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native cube id requires a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_native_cube(
            source, value_stop + 1, stop, center_source, size, color_source,
            rotation_source, texture_source, roughness, specular_strength,
            casts_shadow, receives_shadow, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_cube(
        source, next, stop, center_source, size, color_source,
        rotation_source, texture_source, roughness, specular_strength,
        casts_shadow, receives_shadow, unknown
    )

_browser_scan_native_dice_texture(
    source:str, offset:int, stop:int, kind:str,
    color_a_source:str, color_b_source:str, graph_width_px:num,
    unsupported:bit
) -> BrowserNativeDiceTexture:
    (offset >= stop \/ vkf_string_eof(source, offset))?
        @: (
            kind:kind, color_a_source:color_a_source,
            color_b_source:color_b_source, graph_width_px:graph_width_px,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "kind:", 0)?
        value_start: _browser_display_value_start(source, offset + 5)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native dice texture kind requires a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_native_dice_texture(
            source, value_stop + 1, stop,
            vkf_utf8_slice(source, value_start + 1, value_stop),
            color_a_source, color_b_source, graph_width_px, unsupported
        )
    (_browser_source_starts_with(source, offset, "color_a:", 0) \/
        _browser_source_starts_with(source, offset, "color_b:", 0))?
        value_start: _browser_display_value_start(source, offset + 8)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native dice texture color requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        next_a: color_a_source
        next_b: color_b_source
        _browser_source_starts_with(source, offset, "color_a:", 0)?
            .next_a: vkf_utf8_slice(source, value_start, value_stop)
        _browser_source_starts_with(source, offset, "color_b:", 0)?
            .next_b: vkf_utf8_slice(source, value_start, value_stop)
        @: _browser_scan_native_dice_texture(
            source, value_stop, stop, kind, next_a, next_b,
            graph_width_px, unsupported
        )
    _browser_source_starts_with(source, offset, "graph_width_px:", 0)?
        value_start: _browser_display_value_start(source, offset + 15)
        value_stop: vkf_decimal_scan_end(source, value_start)
        @: _browser_scan_native_dice_texture(
            source, value_stop, stop, kind, color_a_source, color_b_source,
            vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop)),
            unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_dice_texture(
        source, next, stop, kind, color_a_source, color_b_source,
        graph_width_px, unknown
    )

_browser_scan_native_surface(
    source:str, offset:int, stop:int,
    link:BrowserNativeSurfaceLink,
    center_source:str, size_source:str, rotation_source:str, color_source:str,
    texture_source:str, surface_system_source:str,
    roughness:num, specular_strength:num,
    casts_shadow:bit, receives_shadow:bit, unsupported:bit
) -> BrowserNativeSurface:
    (offset >= stop \/ vkf_string_eof(source, offset))?
        @: (
            link:link, center_source:center_source, size_source:size_source,
            rotation_source:rotation_source, color_source:color_source,
            texture_source:texture_source,
            surface_system_source:surface_system_source,
            roughness:roughness, specular_strength:specular_strength,
            casts_shadow:casts_shadow, receives_shadow:receives_shadow,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "center:", 0) \/
        _browser_source_starts_with(source, offset, "size:", 0) \/
        _browser_source_starts_with(source, offset, "rotation:", 0) \/
        _browser_source_starts_with(source, offset, "color:", 0))?
        colon_width: 7
        _browser_source_starts_with(source, offset, "size:", 0)?
            .colon_width: 5
        _browser_source_starts_with(source, offset, "rotation:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "color:", 0)?
            .colon_width: 6
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native surface vector field requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        value_source: vkf_utf8_slice(source, value_start, value_stop)
        next_center: center_source
        next_size: size_source
        next_rotation: rotation_source
        next_color: color_source
        _browser_source_starts_with(source, offset, "center:", 0)?
            .next_center: value_source
        _browser_source_starts_with(source, offset, "size:", 0)?
            .next_size: value_source
        _browser_source_starts_with(source, offset, "rotation:", 0)?
            .next_rotation: value_source
        _browser_source_starts_with(source, offset, "color:", 0)?
            .next_color: value_source
        @: _browser_scan_native_surface(
            source, value_stop, stop, link, next_center, next_size, next_rotation,
            next_color, texture_source, surface_system_source,
            roughness, specular_strength, casts_shadow, receives_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "texture:", 0) \/
        _browser_source_starts_with(source, offset, "surface_system:", 0))?
        colon_width: 8
        _browser_source_starts_with(source, offset, "surface_system:", 0)?
            .colon_width: 15
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser native surface material extension requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        value_source: vkf_utf8_slice(source, value_start + 1, value_stop - 1)
        next_texture: texture_source
        next_surface_system: surface_system_source
        _browser_source_starts_with(source, offset, "texture:", 0)?
            .next_texture: value_source
        _browser_source_starts_with(source, offset, "surface_system:", 0)?
            .next_surface_system: value_source
        @: _browser_scan_native_surface(
            source, value_stop, stop, link, center_source, size_source, rotation_source,
            color_source, next_texture, next_surface_system,
            roughness, specular_strength, casts_shadow, receives_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "alpha:", 0) \/
        _browser_source_starts_with(source, offset, "reflectivity:", 0) \/
        _browser_source_starts_with(source, offset, "roughness:", 0) \/
        _browser_source_starts_with(source, offset, "specular_strength:", 0))?
        colon_width: 6
        _browser_source_starts_with(source, offset, "reflectivity:", 0)?
            .colon_width: 13
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .colon_width: 10
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .colon_width: 18
        value_start: _browser_display_value_start(source, offset + colon_width)
        value_stop: vkf_decimal_scan_end(source, value_start)
        value: vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))
        next_roughness: roughness
        next_specular: specular_strength
        _browser_source_starts_with(source, offset, "roughness:", 0)?
            .next_roughness: value
        _browser_source_starts_with(source, offset, "specular_strength:", 0)?
            .next_specular: value
        @: _browser_scan_native_surface(
            source, value_stop, stop, link, center_source, size_source, rotation_source,
            color_source, texture_source, surface_system_source,
            next_roughness, next_specular, casts_shadow, receives_shadow, unsupported
        )
    (_browser_source_starts_with(source, offset, "transparent:", 0) \/
        _browser_source_starts_with(source, offset, "depth_write:", 0) \/
        _browser_source_starts_with(source, offset, "casts_shadow:", 0) \/
        _browser_source_starts_with(source, offset, "receives_shadow:", 0) \/
        _browser_source_starts_with(source, offset, "no_backface_specular:", 0))?
        colon_width: 12
        _browser_source_starts_with(source, offset, "depth_write:", 0)?
            .colon_width: 12
        _browser_source_starts_with(source, offset, "casts_shadow:", 0)?
            .colon_width: 13
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .colon_width: 16
        _browser_source_starts_with(source, offset, "no_backface_specular:", 0)?
            .colon_width: 21
        value_start: _browser_display_value_start(source, offset + colon_width)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser native surface flags require booleans"
        next_casts: casts_shadow
        next_receives: receives_shadow
        next_link: link
        _browser_source_starts_with(source, offset, "casts_shadow:", 0)?
            .next_casts: value
        _browser_source_starts_with(source, offset, "receives_shadow:", 0)?
            .next_receives: value
        _browser_source_starts_with(source, offset, "no_backface_specular:", 0)?
            .next_link: (
                id:link.id, no_backface_specular:value,
                saw_no_backface_specular:true
            )
        @: _browser_scan_native_surface(
            source, value_stop, stop, next_link, center_source, size_source, rotation_source,
            color_source, texture_source, surface_system_source,
            roughness, specular_strength, next_casts, next_receives, unsupported
        )
    _browser_source_starts_with(source, offset, "id:", 0)?
        value_start: _browser_display_value_start(source, offset + 3)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native surface id requires a string"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        @: _browser_scan_native_surface(
            source, value_stop + 1, stop,
            (id:vkf_utf8_slice(source, value_start + 1, value_stop),
                no_backface_specular:link.no_backface_specular,
                saw_no_backface_specular:link.saw_no_backface_specular),
            center_source, size_source,
            rotation_source, color_source, texture_source, surface_system_source,
            roughness, specular_strength, casts_shadow, receives_shadow, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_surface(
        source, next, stop, link, center_source, size_source, rotation_source,
        color_source, texture_source, surface_system_source,
        roughness, specular_strength, casts_shadow, receives_shadow, unknown
    )

_browser_scan_native_shadow(
    source:str, offset:int, stop:int, enabled:bit, color_source:str,
    lift:num, saw_enabled:bit, unsupported:bit
) -> BrowserNativeShadow:
    (offset >= stop \/ vkf_string_eof(source, offset))?
        @: (enabled:enabled, color_source:color_source, lift:lift,
            saw_enabled:saw_enabled, unsupported:unsupported)
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    _browser_source_starts_with(source, offset, "enabled:", 0)?
        value_start: _browser_display_value_start(source, offset + 8)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser native shadow enabled requires a boolean"
        @: _browser_scan_native_shadow(
            source, value_stop, stop, value, color_source, lift, true, unsupported
        )
    _browser_source_starts_with(source, offset, "color:", 0)?
        value_start: _browser_display_value_start(source, offset + 6)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native shadow color requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        @: _browser_scan_native_shadow(
            source, value_stop, stop, enabled,
            vkf_utf8_slice(source, value_start, value_stop),
            lift, saw_enabled, unsupported
        )
    _browser_source_starts_with(source, offset, "lift:", 0)?
        value_start: _browser_display_value_start(source, offset + 5)
        value_stop: vkf_decimal_scan_end(source, value_start)
        @: _browser_scan_native_shadow(
            source, value_stop, stop, enabled, color_source,
            vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop)),
            saw_enabled, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_shadow(
        source, next, stop, enabled, color_source, lift,
        saw_enabled, unknown
    )

_browser_native_timing_packet(source:str, aspect:str, show_markers:bit, marker_size:num) -> any:
    tape: lexer.tagged_numeric_function_token_tape("frame.add(" & source & ")")
    index: 4
    parens: 1
    brackets: 0
    fps: 0
    duration_seconds: 0
    boundary: ""
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        keyword?
            key: _browser_token_text(tape, index)
            (key = "fps" \/ key = "duration_seconds" \/ key = "boundary")?! "browser native timing contains unsupported options"
            key = "boundary"?
                (_browser_token_kind(tape, index + 2) = 25)?! "browser native timing boundary requires a string"
                encoded: _browser_token_text(tape, index + 2)
                .boundary: vkf_utf8_slice(encoded, 1, encoded.length() - 1)
                .index: index + 3
            (key = "fps" \/ key = "duration_seconds")?
                parsed: _browser_lifted_value(tape, index + 2, 1)
                key = "fps"?
                    .fps: parsed.value
                key = "duration_seconds"?
                    .duration_seconds: parsed.value
                .index: parsed.next
        ~keyword?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    aspect = ""?
        (fps > 0 /\ fps <= 240 /\ duration_seconds > 0 /\ boundary = "repeat" /\
            ~show_markers /\ marker_size = 0)?! "browser native timing fields are invalid"
        @: (
            magic:1447773780, version:2, fps:fps,
            duration_seconds:duration_seconds, boundary:boundary
        )
    (fps > 0 /\ fps <= 240 /\ duration_seconds > 0 /\ boundary = "repeat" /\
        aspect = "equal" /\ marker_size > 0)?! "browser native timing fields are invalid"
    (
        magic:1447773780, version:1, fps:fps,
        duration_seconds:duration_seconds, boundary:boundary, aspect:aspect,
        show_light_markers:show_markers, light_marker_size:marker_size
    )

_browser_record_string_field(source:str, field:str) -> str:
    tape: lexer.tagged_numeric_function_token_tape("frame.add(" & source & ")")
    index: 4
    parens: 1
    brackets: 0
    value: ""
    (parens > 0)?>
        kind: _browser_token_kind(tape, index)
        keyword: (parens = 1 /\ brackets = 0 /\ kind = 1 /\
            _browser_token_kind(tape, index + 1) = 15)
        matched: (keyword /\ _browser_token_text(tape, index) = field)
        matched?
            (_browser_token_kind(tape, index + 2) = 25)?! "browser native reference field requires a string"
            encoded: _browser_token_text(tape, index + 2)
            .value: vkf_utf8_slice(encoded, 1, encoded.length() - 1)
            .index: index + 3
        ~matched?
            kind = 13?
                .parens+: 1
            kind = 14?
                .parens-: 1
            kind = 22?
                .brackets+: 1
            kind = 23?
                .brackets-: 1
            .index+: 1
    value

_browser_record_list_has_id(source:str, target:str, offset:int) -> bit:
    open: _browser_find_source(source, offset, "(")
    open < 0?
        @: false
    stop: _browser_display_call_stop(source, open + 1, 1, false)
    item: vkf_utf8_slice(source, open + 1, stop - 1)
    _browser_record_string_field(item, "id") = target?
        @: true
    _browser_record_list_has_id(source, target, stop)

_browser_native_light_references_valid(lights:str, surfaces:str, offset:int) -> bit:
    open: _browser_find_source(lights, offset, "(")
    open < 0?
        @: true
    stop: _browser_display_call_stop(lights, open + 1, 1, false)
    item: vkf_utf8_slice(lights, open + 1, stop - 1)
    kind: _browser_record_string_field(item, "kind")
    kind = "projected"?
        source_id: _browser_record_string_field(item, "reflect_of_light_id")
        mirror_id: _browser_record_string_field(item, "reflect_mirror_mesh_id")
        aperture_id: _browser_record_string_field(item, "aperture_face_id")
        (source_id != "" /\ mirror_id != "" /\ aperture_id = mirror_id /\
            _browser_record_list_has_id(lights, source_id, 0) /\
            _browser_record_list_has_id(surfaces, mirror_id, 0))?! "browser projected light references are invalid"
    _browser_native_light_references_valid(lights, surfaces, stop)

_browser_record_list_count(source:str, offset:int, count:int) -> int:
    open: _browser_find_source(source, offset, "(")
    open < 0?
        @: count
    stop: _browser_display_call_stop(source, open + 1, 1, false)
    _browser_record_list_count(source, stop, count + 1)

_browser_record_list_item(source:str, offset:int, target:int, index:int) -> str:
    open: _browser_find_source(source, offset, "(")
    (open >= 0)?! "browser native scene record index is out of range"
    stop: _browser_display_call_stop(source, open + 1, 1, false)
    index = target?
        @: vkf_utf8_slice(source, open + 1, stop - 1)
    _browser_record_list_item(source, stop, target, index + 1)

_browser_native_dice_texture_packet(source:str) -> any:
    texture: _browser_scan_native_dice_texture(
        source, 0, 2147483647, "", "", "", -1, false
    )
    (~texture.unsupported /\ texture.kind = "dice" /\
        texture.color_a_source != "" /\ texture.color_b_source != "" /\
        texture.graph_width_px >= 0 /\ texture.graph_width_px <= 32)?! "browser native dice texture contains unsupported options"
    color_a_tape: lexer.tagged_numeric_function_token_tape(texture.color_a_source)
    color_a: _browser_lifted_value(color_a_tape, 0, 1).value
    color_b_tape: lexer.tagged_numeric_function_token_tape(texture.color_b_source)
    color_b: _browser_lifted_value(color_b_tape, 0, 1).value
    (color_a.length() = 4 /\ color_b.length() = 4)?! "browser native dice texture colors must be RGBA"
    (
        magic:1447773778, version:1, kind:"dice",
        color_a:color_a, color_b:color_b,
        graph_width_px:texture.graph_width_px
    )

_browser_native_surface_packet(source:str) -> any:
    surface: _browser_scan_native_surface(
        source, 0, 2147483647,
        (id:"", no_backface_specular:false, saw_no_backface_specular:false),
        "", "", "", "", "", "", 1, 0, false, false, false
    )
    (~surface.unsupported /\ surface.center_source != "" /\
        surface.size_source != "" /\ surface.rotation_source != "" /\
        surface.color_source != "" /\ surface.roughness >= 0 /\
        surface.roughness <= 1 /\ surface.specular_strength >= 0 /\
        surface.specular_strength <= 1)?! "browser native surface contains unsupported options"
    center_tape: lexer.tagged_numeric_function_token_tape(surface.center_source)
    center: _browser_lifted_value(center_tape, 0, 1).value
    size_tape: lexer.tagged_numeric_function_token_tape(surface.size_source)
    size: _browser_lifted_value(size_tape, 0, 1).value
    rotation_tape: lexer.tagged_numeric_function_token_tape(surface.rotation_source)
    rotation: _browser_lifted_value(rotation_tape, 0, 1).value
    color_tape: lexer.tagged_numeric_function_token_tape(surface.color_source)
    color: _browser_lifted_value(color_tape, 0, 1).value
    (center.length() = 3 /\ size.length() = 2 /\ rotation.length() = 3 /\
        color.length() = 4 /\ size.0 > 0 /\ size.1 > 0)?! "browser native surface fields are invalid"
    texture: []
    surface.texture_source != ""?
        .texture: _browser_display_texture_packet(
            "frame.add(texture:(" & surface.texture_source & "))", 0, false
        )
    optical: _browser_display_optical_packet(source)
    surface_system: _browser_display_surface_packet(source, 0, false)
    (surface.surface_system_source = "" \/ surface.link.saw_no_backface_specular \/
        (_browser_find_source(source, 0, "alpha:") >= 0 /\
            _browser_find_source(source, 0, "transparent:") >= 0 /\
            _browser_find_source(source, 0, "depth_write:") >= 0 /\
            _browser_find_source(source, 0, "reflectivity:") >= 0))?! "browser native mirror requires optical material"
    surface.link.saw_no_backface_specular?
        (surface.link.id != "" /\ surface.link.no_backface_specular /\
            surface.surface_system_source != "")?! "browser linked mirror surface fields are invalid"
        @: (
            magic:1447773779, version:2, id:surface.link.id,
            center:center, size:size, rotation:rotation, color:color,
            receives_lighting:true, casts_shadow:surface.casts_shadow,
            receives_shadow:surface.receives_shadow,
            roughness:surface.roughness,
            specular_strength:surface.specular_strength,
            texture:texture, optical:optical, surface_system:surface_system,
            no_backface_specular:surface.link.no_backface_specular
        )
    (
        magic:1447773779, version:1, center:center, size:size,
        rotation:rotation, color:color, receives_lighting:true,
        casts_shadow:surface.casts_shadow,
        receives_shadow:surface.receives_shadow,
        roughness:surface.roughness,
        specular_strength:surface.specular_strength,
        texture:texture, optical:optical, surface_system:surface_system
    )

_browser_native_plane_packet(source:str) -> any:
    plane: _browser_scan_native_plane(
        source, 0, 2147483647, "", 0, 0, "", "", 1, 0, false
    )
    (~plane.unsupported /\ plane.center_source != "" /\ plane.size > 0 /\
        plane.color_source != "" /\ plane.roughness >= 0 /\ plane.roughness <= 1 /\
        plane.specular_strength >= 0 /\ plane.specular_strength <= 1)?! "browser native plane contains unsupported options"
    center_tape: lexer.tagged_numeric_function_token_tape(plane.center_source)
    center: _browser_lifted_value(center_tape, 0, 1).value
    color_tape: lexer.tagged_numeric_function_token_tape(plane.color_source)
    color: _browser_lifted_value(color_tape, 0, 1).value
    (center.length() = 2 /\ color.length() = 4)?! "browser native plane fields are invalid"
    texture: []
    plane.texture_source != ""?
        .texture: _browser_display_texture_packet(
            "frame.add(texture:(" & plane.texture_source & "))", 0, false
        )
    half: plane.size / 2
    (
        magic:1447773766, version:5, rows:2, columns:2, color:color,
        x:[[center.0 - half, center.0 + half], [center.0 - half, center.0 + half]],
        y:[[center.1 - half, center.1 - half], [center.1 + half, center.1 + half]],
        z:[[plane.z, plane.z], [plane.z, plane.z]],
        receives_lighting:true, casts_shadow:false, receives_shadow:true,
        roughness:plane.roughness, specular_strength:plane.specular_strength, texture:texture,
        optical:[], surface_system:[]
    )

_browser_native_cube_packet(source:str) -> any:
    cube: _browser_scan_native_cube(
        source, 0, 2147483647, "", 0, "", "", "", 1, 0,
        false, false, false
    )
    (~cube.unsupported /\ cube.center_source != "" /\ cube.size > 0 /\
        cube.color_source != "" /\ cube.roughness >= 0 /\ cube.roughness <= 1 /\
        cube.specular_strength >= 0 /\ cube.specular_strength <= 1)?! "browser native cube contains unsupported options"
    center_tape: lexer.tagged_numeric_function_token_tape(cube.center_source)
    center: _browser_lifted_value(center_tape, 0, 1).value
    color_tape: lexer.tagged_numeric_function_token_tape(cube.color_source)
    color: _browser_lifted_value(color_tape, 0, 1).value
    (center.length() = 3 /\ color.length() = 4)?! "browser native cube fields are invalid"
    cube.texture_source != ""?
        (cube.rotation_source != "")?! "browser native textured cube requires rotation"
        rotation_tape: lexer.tagged_numeric_function_token_tape(cube.rotation_source)
        rotation: _browser_lifted_value(rotation_tape, 0, 1).value
        (rotation.length() = 3)?! "browser native cube rotation must have three values"
        @: (
            magic:1447773776, version:2, center:center, size:cube.size,
            color:color, roughness:cube.roughness,
            specular_strength:cube.specular_strength,
            casts_shadow:cube.casts_shadow, receives_shadow:cube.receives_shadow,
            rotation:rotation,
            texture:_browser_native_dice_texture_packet(cube.texture_source)
        )
    (cube.rotation_source = "")?! "browser native cube rotation requires a texture"
    (
        magic:1447773776, version:1, center:center, size:cube.size,
        color:color, roughness:cube.roughness,
        specular_strength:cube.specular_strength,
        casts_shadow:cube.casts_shadow, receives_shadow:cube.receives_shadow
    )

_browser_native_cube_scene(source:str, packet_index:int) -> any:
    scene_start: _browser_find_source(source, 0, "native_scene:(")
    (scene_start >= 0)?! "browser native cube scene is missing"
    scene_stop: _browser_display_call_stop(source, scene_start + 14, 1, false)
    scene: _browser_scan_native_cube_scene(
        source, scene_start + 14, scene_stop - 1,
        "", "", "", "", "", "", "", "",
        (aspect:"", timing_source:"", show_light_markers:false,
            saw_show_light_markers:false, light_marker_size:0), false
    )
    (~scene.unsupported /\ scene.kind = "scene_3d" /\
        scene.camera_source != "" /\
        scene.plane_source != "" /\ scene.surfaces_source != "" /\
        scene.cubes_source != "" /\ scene.lights_source != "" /\
        scene.shadow_source != "")?! "browser native cube scene contains unsupported options"
    animated: scene.options.timing_source != ""
    (animated \/ (scene.options.aspect = "" /\ ~scene.options.saw_show_light_markers /\
        scene.options.light_marker_size = 0))?! "browser native scene timing options are incomplete"
    animated?
        (scene.options.aspect = "equal" /\ scene.options.saw_show_light_markers /\
            scene.options.light_marker_size > 0)?! "browser animated native scene options are invalid"
    shadow: _browser_scan_native_shadow(
        scene.shadow_source, 0, 2147483647,
        false, "", 0, false, false
    )
    (~shadow.unsupported /\ shadow.saw_enabled /\ shadow.enabled /\
        shadow.color_source != "" /\ shadow.lift >= 0)?! "browser native shadow contains unsupported options"
    shadow_color_tape: lexer.tagged_numeric_function_token_tape(shadow.color_source)
    shadow_color: _browser_lifted_value(shadow_color_tape, 0, 1).value
    (shadow_color.length() = 4)?! "browser native shadow color must be RGBA"
    background: [0, 0, 0, 0]
    scene.background_source != ""?
        background_tape: lexer.tagged_numeric_function_token_tape(scene.background_source)
        .background: _browser_lifted_value(background_tape, 0, 1).value
    (background.length() = 4)?! "browser native cube scene background must be RGBA"
    cube_count: _browser_record_list_count(scene.cubes_source, 0, 0)
    surface_count: _browser_record_list_count(scene.surfaces_source, 0, 0)
    light_count: _browser_record_list_count(scene.lights_source, 0, 0)
    ((cube_count > 0 \/ surface_count > 0) /\ light_count > 0)?! "browser native scene requires geometry and lights"
    _browser_find_source(scene.lights_source, 0, "kind:\"projected\"") >= 0?
        _browser_native_light_references_valid(scene.lights_source, scene.surfaces_source, 0)?! "browser native scene light references are invalid"
    timing_count: 0
    animated?
        .timing_count: 1
    packet_index < 0?
        @: (
            kind:"visual_stream",
            packet_count:2 + timing_count + surface_count + cube_count + light_count,
            background:background, combine_transparent:false
        )
    packet_index = 0?
        @: _browser_display_camera_source("frame.add_camera(" & scene.camera_source & ")")
    (animated /\ packet_index = 1)?
        @: _browser_native_timing_packet(
            scene.options.timing_source, scene.options.aspect,
            scene.options.show_light_markers, scene.options.light_marker_size
        )
    packet_index = 1 + timing_count?
        @: _browser_native_plane_packet(scene.plane_source)
    packet_index < 2 + timing_count + surface_count?
        @: _browser_native_surface_packet(
            _browser_record_list_item(
                scene.surfaces_source, 0, packet_index - 2 - timing_count, 0
            )
        )
    packet_index < 2 + timing_count + surface_count + cube_count?
        @: _browser_native_cube_packet(
            _browser_record_list_item(
                scene.cubes_source, 0,
                packet_index - 2 - timing_count - surface_count, 0
            )
        )
    (packet_index < 2 + timing_count + surface_count + cube_count + light_count)?! "browser native scene packet index is out of range"
    _browser_display_light_source(
        "frame.add_light(" & _browser_record_list_item(
            scene.lights_source, 0,
            packet_index - 2 - timing_count - surface_count - cube_count, 0
        ) & ")"
    )

_browser_native_field_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, "native_scene:(") >= 0 /\
        _browser_find_source(source, 0, "kind:\"field_mesh\"") >= 0)

_browser_scan_native_field_scene(
    source:str, offset:int, stop:int, kind:str,
    background_source:str, camera_source:str, meshes_source:str,
    unsupported:bit
) -> BrowserNativeFieldScene:
    offset >= stop?
        @: (
            kind:kind, background_source:background_source,
            camera_source:camera_source, meshes_source:meshes_source,
            unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "kind:", 0) \/
        _browser_source_starts_with(source, offset, "frame_id:", 0) \/
        _browser_source_starts_with(source, offset, "title:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "frame_id:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "title:", 0)?
            .colon_width: 6
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser native scene text fields require strings"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        next_kind: kind
        _browser_source_starts_with(source, offset, "kind:", 0)?
            .next_kind: vkf_utf8_slice(source, value_start + 1, value_stop)
        @: _browser_scan_native_field_scene(
            source, value_stop + 1, stop, next_kind,
            background_source, camera_source, meshes_source, unsupported
        )
    (_browser_source_starts_with(source, offset, "rect:", 0) \/
        _browser_source_starts_with(source, offset, "background:", 0))?
        colon_width: 5
        _browser_source_starts_with(source, offset, "background:", 0)?
            .colon_width: 11
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native scene vector field requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        next_background: background_source
        _browser_source_starts_with(source, offset, "background:", 0)?
            .next_background: vkf_utf8_slice(source, value_start, value_stop)
        @: _browser_scan_native_field_scene(
            source, value_stop, stop, kind, next_background,
            camera_source, meshes_source, unsupported
        )
    _browser_source_starts_with(source, offset, "camera:", 0)?
        value_start: _browser_display_value_start(source, offset + 7)
        (vkf_string_peek_scalar(source, value_start) = 40)?! "browser native scene camera requires a record"
        value_stop: _browser_display_call_stop(source, value_start + 1, 1, false)
        @: _browser_scan_native_field_scene(
            source, value_stop, stop, kind, background_source,
            vkf_utf8_slice(source, value_start + 1, value_stop - 1),
            meshes_source, unsupported
        )
    _browser_source_starts_with(source, offset, "meshes:", 0)?
        value_start: _browser_display_value_start(source, offset + 7)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser native scene meshes requires a vector"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        @: _browser_scan_native_field_scene(
            source, value_stop, stop, kind, background_source,
            camera_source, vkf_utf8_slice(source, value_start, value_stop),
            unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_field_scene(
        source, next, stop, kind, background_source,
        camera_source, meshes_source, unknown
    )

_browser_scan_native_field_mesh(
    source:str, offset:int, stop:int, kind:str,
    vertices_source:str, indices_source:str, topology:str,
    render_mode:str, mode3d:bit, color_source:str, unsupported:bit
) -> BrowserNativeFieldMesh:
    offset >= stop?
        @: (
            kind:kind, vertices_source:vertices_source,
            indices_source:indices_source, topology:topology,
            render_mode:render_mode, mode3d:mode3d,
            color_source:color_source, unsupported:unsupported
        )
    ch: vkf_string_peek_scalar(source, offset)
    next: vkf_utf8_advance(source, offset)
    (_browser_source_starts_with(source, offset, "id:", 0) \/
        _browser_source_starts_with(source, offset, "kind:", 0) \/
        _browser_source_starts_with(source, offset, "topology:", 0) \/
        _browser_source_starts_with(source, offset, "render_mode:", 0))?
        colon_width: 3
        _browser_source_starts_with(source, offset, "kind:", 0)?
            .colon_width: 5
        _browser_source_starts_with(source, offset, "topology:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "render_mode:", 0)?
            .colon_width: 12
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 34)?! "browser field mesh text fields require strings"
        value_stop: _browser_display_string_stop(source, value_start + 1)
        value: vkf_utf8_slice(source, value_start + 1, value_stop)
        next_kind: kind
        next_topology: topology
        next_render_mode: render_mode
        _browser_source_starts_with(source, offset, "kind:", 0)?
            .next_kind: value
        _browser_source_starts_with(source, offset, "topology:", 0)?
            .next_topology: value
        _browser_source_starts_with(source, offset, "render_mode:", 0)?
            .next_render_mode: value
        @: _browser_scan_native_field_mesh(
            source, value_stop + 1, stop, next_kind,
            vertices_source, indices_source, next_topology,
            next_render_mode, mode3d, color_source, unsupported
        )
    (_browser_source_starts_with(source, offset, "vertices:", 0) \/
        _browser_source_starts_with(source, offset, "indices:", 0) \/
        _browser_source_starts_with(source, offset, "color:", 0))?
        colon_width: 6
        _browser_source_starts_with(source, offset, "vertices:", 0)?
            .colon_width: 9
        _browser_source_starts_with(source, offset, "indices:", 0)?
            .colon_width: 8
        value_start: _browser_display_value_start(source, offset + colon_width)
        (vkf_string_peek_scalar(source, value_start) = 91)?! "browser field mesh data requires vectors"
        value_stop: _browser_display_bracket_stop(source, value_start + 1, 1)
        value_source: vkf_utf8_slice(source, value_start, value_stop)
        next_vertices: vertices_source
        next_indices: indices_source
        next_color: color_source
        _browser_source_starts_with(source, offset, "vertices:", 0)?
            .next_vertices: value_source
        _browser_source_starts_with(source, offset, "indices:", 0)?
            .next_indices: value_source
        _browser_source_starts_with(source, offset, "color:", 0)?
            .next_color: value_source
        @: _browser_scan_native_field_mesh(
            source, value_stop, stop, kind, next_vertices, next_indices,
            topology, render_mode, mode3d, next_color, unsupported
        )
    _browser_source_starts_with(source, offset, "mode3d:", 0)?
        value_start: _browser_display_value_start(source, offset + 7)
        value: false
        value_stop: value_start
        _browser_source_starts_with(source, value_start, "true", 0)?
            .value: true
            .value_stop: value_start + 4
        ~value?
            _browser_source_starts_with(source, value_start, "false", 0)?
                .value_stop: value_start + 5
            ~_browser_source_starts_with(source, value_start, "false", 0)?
                false?! "browser field mesh mode3d requires a boolean"
        @: _browser_scan_native_field_mesh(
            source, value_stop, stop, kind, vertices_source, indices_source,
            topology, render_mode, value, color_source, unsupported
        )
    unknown: unsupported
    _browser_ascii_identifier_start(ch)?
        identifier_stop: _browser_display_identifier_stop(source, offset)
        (~vkf_string_eof(source, identifier_stop) /\
            vkf_string_peek_scalar(source, identifier_stop) = 58)?
            .unknown: true
    _browser_scan_native_field_mesh(
        source, next, stop, kind, vertices_source, indices_source,
        topology, render_mode, mode3d, color_source, unknown
    )

_browser_field_indices_valid(indices:any, vertex_count:int, index:int) -> bit:
    index = indices.length()?
        @: true
    ((indices.(index) >= 0 /\ indices.(index) < vertex_count /\
        indices.(index) // 1 = indices.(index)) /\
        _browser_field_indices_valid(indices, vertex_count, index + 1))

_browser_native_field_scene(source:str, packet_index:int) -> any:
    scene_start: _browser_find_source(source, 0, "native_scene:(")
    (scene_start >= 0)?! "browser native field scene is missing"
    scene_stop: _browser_display_call_stop(source, scene_start + 14, 1, false)
    scene: _browser_scan_native_field_scene(
        source, scene_start + 14, scene_stop - 1, "", "", "", "", false
    )
    (~scene.unsupported /\ scene.kind = "scene_3d" /\
        scene.background_source != "" /\ scene.camera_source != "" /\
        scene.meshes_source != "")?! "browser native field scene contains unsupported options"
    background_tape: lexer.tagged_numeric_function_token_tape(scene.background_source)
    background: _browser_lifted_value(background_tape, 0, 1).value
    (background.length() = 4)?! "browser native field scene background must be RGBA"
    packet_index < 0?
        @: (
            kind:"visual_stream", packet_count:2,
            background:background, combine_transparent:false
        )
    packet_index = 0?
        @: _browser_display_camera_source(
            "frame.add_camera(" & scene.camera_source & ")"
        )
    (packet_index = 1)?! "browser native field scene packet index is out of range"
    mesh_open: _browser_find_source(scene.meshes_source, 0, "(")
    (mesh_open >= 0)?! "browser native field scene requires a mesh record"
    mesh_stop: _browser_display_call_stop(
        scene.meshes_source, mesh_open + 1, 1, false
    )
    (_browser_find_source(scene.meshes_source, mesh_stop, "(") = -1)?! "browser native field scene supports one mesh"
    mesh: _browser_scan_native_field_mesh(
        scene.meshes_source, mesh_open + 1, mesh_stop - 1,
        "", "", "", "", "", false, "", false
    )
    (~mesh.unsupported /\ mesh.kind = "field_mesh" /\
        mesh.topology = "line-list" /\ mesh.render_mode = "line" /\
        mesh.mode3d /\ mesh.vertices_source != "" /\
        mesh.indices_source != "" /\ mesh.color_source != "")?! "browser native field mesh contains unsupported options"
    vertices_tape: lexer.tagged_numeric_function_token_tape(mesh.vertices_source)
    vertices: _browser_lifted_value(vertices_tape, 0, 1).value
    indices_tape: lexer.tagged_numeric_function_token_tape(mesh.indices_source)
    indices: _browser_lifted_value(indices_tape, 0, 1).value
    color_tape: lexer.tagged_numeric_function_token_tape(mesh.color_source)
    color: _browser_lifted_value(color_tape, 0, 1).value
    (vertices.length() > 0 /\ vertices.length() % 10 = 0 /\
        indices.length() > 0 /\ indices.length() % 2 = 0 /\
        color.length() = 4 /\
        _browser_field_indices_valid(indices, vertices.length() // 10, 0))?! "browser native field mesh data is invalid"
    (
        magic:1447773775, version:1, vertices:vertices,
        indices:indices, topology:mesh.topology,
        render_mode:mesh.render_mode, mode3d:mesh.mode3d, color:color
    )

_browser_token_text(tape:any, index:int) -> str:
    row: index * 6
    vkf_utf8_slice(tape.source, tape.rows.(row + 1), tape.rows.(row + 2))

_browser_token_kind(tape:any, index:int) -> int:
    tape.rows.(index * 6)

_browser_lifted_vector_function_matches(tape:any) -> bit:
    tape.count > 20 /\ tape.rows.0 = 1 /\ tape.rows.6 = 13 /\ tape.rows.12 = 1 /\
    tape.rows.18 = 15 /\ tape.rows.24 = 1 /\ tape.rows.30 = 14 /\
    tape.rows.36 = 20 /\ tape.rows.42 = 17 /\ tape.rows.48 = 1 /\
    tape.rows.54 = 15 /\ tape.rows.60 = 1 /\ tape.rows.66 = 7 /\
    tape.rows.72 = 3 /\ _browser_token_text(tape, 4) = "int" /\
    _browser_token_text(tape, 8) = "int"

_browser_named_axis_source_matches(tape:any) -> bit:
    tape.count > 10 /\ _browser_token_kind(tape, 0) = 1 /\
    _browser_token_kind(tape, 1) = 15 /\ _browser_token_kind(tape, 2) = 22

_run_tagged_named_axis_source(tape:any) -> any:
    index: 0
    names: []
    values: []
    (_browser_token_kind(tape, index) = 1 /\
        _browser_token_kind(tape, index + 1) = 15 /\
        _browser_token_kind(tape, index + 2) = 22)?>
        name: _browser_token_text(tape, index)
        left: _browser_axis_term(tape, index + 2)
        (_browser_token_kind(tape, left.next) = 7)?! "named-axis expression requires a product"
        middle: _browser_axis_term(tape, left.next + 1)
        result: _browser_axis_product2(left, middle)
        .index: middle.next
        (_browser_token_kind(tape, index) = 7)?
            right: _browser_axis_term(tape, index + 1)
            .result: _browser_axis_product3(left, middle, right)
            .index: right.next
        .names: names & [name]
        .values: values & [result]
        (_browser_token_kind(tape, index) = 4)?>
            .index+: 1
    outputs: []
    (_browser_token_kind(tape, index) != 5)?>
        (_browser_token_kind(tape, index) = 15 /\
            _browser_token_kind(tape, index + 1) = 15 /\
            _browser_token_kind(tape, index + 2) = 1)?! "named-axis output requires :: binding"
        .outputs: outputs & [_browser_axis_lookup(
            names, values, _browser_token_text(tape, index + 2), 0
        )]
        .index+: 3
        (_browser_token_kind(tape, index) = 4)?>
            .index+: 1
    (kind:"console", values:outputs)

_browser_inline_space_start(source:str, offset:int) -> int:
    vkf_string_eof(source, offset)?
        @: offset
    ch: vkf_string_peek_scalar(source, offset)
    (ch = 32 \/ ch = 9)?
        @: _browser_inline_space_start(source, vkf_utf8_advance(source, offset))
    offset

_browser_inline_space_only(source:str, offset:int, stop:int) -> bit:
    offset >= stop?
        @: true
    ch: vkf_string_peek_scalar(source, offset)
    ((ch = 32 \/ ch = 9) /\
        _browser_inline_space_only(source, vkf_utf8_advance(source, offset), stop))

_browser_basic_line_stop(source:str, offset:int) -> int:
    stop: _browser_find_source(source, offset, "\n")
    stop < 0?
        @: source.length()
    stop

_browser_basic_number_after(source:str, offset:int) -> num:
    value_start: _browser_inline_space_start(source, offset)
    value_stop: vkf_decimal_scan_end(source, value_start)
    (value_stop > value_start)?! "browser basic-syntax source requires a numeric value"
    line_stop: _browser_basic_line_stop(source, value_stop)
    _browser_inline_space_only(source, value_stop, line_stop)?! "browser basic-syntax numeric line contains unsupported syntax"
    vkf_decimal_parse(vkf_utf8_slice(source, value_start, value_stop))

_browser_basic_loop_factor(source:str, offset:int) -> num:
    marker: _browser_find_source(source, offset, ".total+: \$")
    (marker >= 0)?! "browser basic-syntax loop update is missing"
    line_stop: _browser_basic_line_stop(source, marker)
    suffix: _browser_inline_space_start(source, marker + 10)
    suffix >= line_stop?
        @: 1
    (vkf_string_peek_scalar(source, suffix) = 42)?! "browser basic-syntax loop update is unsupported"
    _browser_basic_number_after(source, suffix + 1)

_browser_basic_loop_sum(index:num, limit:num, factor:num, total:num) -> num:
    index > limit?
        @: total
    _browser_basic_loop_sum(index + 1, limit, factor, total + index * factor)

_browser_basic_switch(k:num, first_increment:num, second_increment:num, steps:int) -> num:
    (steps < 1024)?! "browser basic-syntax switch did not terminate"
    k = 2?
        @: k
    k = 0?
        @: _browser_basic_switch(k + first_increment, first_increment, second_increment, steps + 1)
    k = 1?
        @: _browser_basic_switch(k + second_increment, first_increment, second_increment, steps + 1)
    false?! "browser basic-syntax switch has no matching arm"
    0

_browser_basic_syntax_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, "loop_total() -> int:") >= 0 /\
        _browser_find_source(source, 0, "switch_loop() -> int:") >= 0 /\
        _browser_find_source(source, 0, "k??>") >= 0 /\
        _browser_find_source(source, 0, ":: loop_total()") >= 0 /\
        _browser_find_source(source, 0, ":: switch_loop()") >= 0)

_run_tagged_basic_syntax_source(source:str) -> any:
    _browser_basic_syntax_source_matches(source)?! "browser basic-syntax source shape is unsupported"
    loop_start: _browser_find_source(source, 0, "loop_total() -> int:")
    range_start: _browser_find_source(source, loop_start, "..")
    (range_start >= 0)?! "browser basic-syntax range loop is missing"
    limit_start: _browser_inline_space_start(source, range_start + 2)
    limit_stop: vkf_decimal_scan_end(source, limit_start)
    (limit_stop > limit_start)?! "browser basic-syntax range limit is invalid"
    pipe_start: _browser_inline_space_start(source, limit_stop)
    _browser_source_starts_with(source, pipe_start, ">>", 0)?! "browser basic-syntax range pipe is invalid"
    limit: vkf_decimal_parse(vkf_utf8_slice(source, limit_start, limit_stop))
    (limit >= 0 /\ limit <= 100000 /\ limit // 1 = limit)?! "browser basic-syntax range limit is invalid"
    factor: _browser_basic_loop_factor(source, loop_start)
    switch_start: _browser_find_source(source, 0, "switch_loop() -> int:")
    initial_start: _browser_find_source(source, switch_start, "k:")
    (initial_start >= 0)?! "browser basic-syntax switch initial value is missing"
    initial: _browser_basic_number_after(source, initial_start + 2)
    (initial // 1 = initial)?! "browser basic-syntax switch initial value must be an integer"
    arm0: _browser_find_source(source, switch_start, "0 =>")
    arm1: _browser_find_source(source, switch_start, "1 =>")
    stop_arm: _browser_find_source(source, switch_start, "2 => @|")
    (arm0 >= 0 /\ arm1 > arm0 /\ stop_arm > arm1)?! "browser basic-syntax switch arms are unsupported"
    first_update: _browser_find_source(source, arm0, ".k: k +")
    second_update: _browser_find_source(source, arm1, ".k: k +")
    (first_update > arm0 /\ first_update < arm1 /\
        second_update > arm1 /\ second_update < stop_arm)?! "browser basic-syntax switch updates are unsupported"
    first_increment: _browser_basic_number_after(source, first_update + 7)
    second_increment: _browser_basic_number_after(source, second_update + 7)
    (first_increment // 1 = first_increment /\ second_increment // 1 = second_increment)?! "browser basic-syntax switch increments must be integers"
    (
        kind:"console",
        values:[
            _browser_basic_loop_sum(0, limit, factor, 0),
            _browser_basic_switch(initial, first_increment, second_increment, 0)
        ]
    )

BrowserNumericRange: (bound:num, variable:str, next:int)
BrowserDenseTransform: (
    name:str,
    parameter:str,
    size:num,
    numerator:num,
    diagonal_shift:num,
    diagonal_divisor:num,
    offset:num,
    axis:int
)
BrowserDenseComposition: (name:str, parameter:str, outer:str, inner:str)
BrowserPowerState: (
    state_name:str,
    first_name:str,
    second_name:str,
    first_fill:num,
    second_fill:num,
    size:num
)

_browser_line_start_before_walk(
    source:str, index:int, target:int, latest:int
) -> int:
    index >= target?
        @: latest
    next: vkf_utf8_advance(source, index)
    vkf_string_peek_scalar(source, index) = 10?
        @: _browser_line_start_before_walk(source, next, target, next)
    _browser_line_start_before_walk(source, next, target, latest)

_browser_line_start_before(source:str, target:int) -> int:
    _browser_line_start_before_walk(source, 0, target, 0)

_browser_decimal_at(source:str, offset:int) -> any:
    start: _browser_inline_space_start(source, offset)
    stop: vkf_decimal_scan_end(source, start)
    (stop > start)?! "browser numeric program requires a decimal literal"
    (value:vkf_decimal_parse(vkf_utf8_slice(source, start, stop)), next:stop)

_browser_numeric_range(source:str, offset:int) -> BrowserNumericRange:
    _browser_source_starts_with(source, offset, "..", 0)?! "browser numeric range requires '..'"
    first: _browser_decimal_at(source, offset + 2)
    cursor: _browser_inline_space_start(source, first.next)
    bound: first.value
    vkf_string_peek_scalar(source, cursor) = 45?
        second: _browser_decimal_at(source, cursor + 1)
        .bound: bound - second.value
        .cursor: _browser_inline_space_start(source, second.next)
    _browser_source_starts_with(source, cursor, ">>", 0)?! "browser numeric range requires '>>'"
    line_stop: _browser_basic_line_stop(source, cursor)
    variable_start: _browser_inline_space_start(source, line_stop + 1)
    variable_stop: _browser_find_source(source, variable_start, ":")
    variable_line_stop: _browser_basic_line_stop(source, variable_start)
    ~(variable_stop > variable_start /\ variable_stop < variable_line_stop)?
        @: (bound:bound, variable:"", next:line_stop + 1)
    value_start: _browser_inline_space_start(source, variable_stop + 1)
    vkf_string_peek_scalar(source, value_start) != 36?
        @: (bound:bound, variable:"", next:line_stop + 1)
    _browser_inline_space_only(
        source, vkf_utf8_advance(source, value_start), variable_line_stop
    )?! "browser numeric range index binding contains unsupported syntax"
    (
        bound:bound,
        variable:vkf_utf8_slice(source, variable_start, variable_stop),
        next:variable_line_stop + 1
    )

_browser_function_name(source:str, arrow:int) -> str:
    line_start: _browser_line_start_before(source, arrow)
    open: _browser_find_source(source, line_start, "(")
    (open > line_start /\ open < arrow)?! "browser numeric function name is invalid"
    vkf_utf8_slice(source, line_start, open)

_browser_function_parameter(source:str, arrow:int) -> str:
    line_start: _browser_line_start_before(source, arrow)
    open: _browser_find_source(source, line_start, "(")
    colon: _browser_find_source(source, open, ":")
    (open >= 0 /\ colon > open /\ colon < arrow)?! "browser numeric function parameter is invalid"
    vkf_utf8_slice(source, open + 1, colon)

_browser_vector_return_size(source:str, arrow:int) -> num:
    size_start: _browser_find_source(source, arrow, "[num:")
    (size_start > arrow)?! "browser numeric vector result size is missing"
    size: _browser_decimal_at(source, size_start + 5)
    cursor: _browser_inline_space_start(source, size.next)
    (vkf_string_peek_scalar(source, cursor) = 93)?! "browser numeric vector result size is malformed"
    size.value

_browser_token_is(tape:any, index:int, kind:int, text:str) -> bit:
    (index < tape.count /\ _browser_token_kind(tape, index) = kind /\
        (text = "" \/ _browser_token_text(tape, index) = text))

_browser_bind_update_source_matches(tape:any) -> bit:
    (_browser_token_is(tape, 0, 1, "") /\
        _browser_token_is(tape, 1, 15, ":") /\
        _browser_token_is(tape, 2, 3, "") /\
        _browser_token_is(tape, 3, 4, "") /\
        _browser_token_is(tape, 4, 1, "num") /\
        _browser_token_is(tape, 5, 1, "") /\
        _browser_token_is(tape, 6, 15, ":") /\
        _browser_token_is(tape, 7, 1, "") /\
        _browser_token_is(tape, 8, 7, "*") /\
        _browser_token_is(tape, 9, 3, "") /\
        _browser_token_is(tape, 10, 4, "") /\
        _browser_token_is(tape, 11, 16, ".") /\
        _browser_token_is(tape, 12, 1, "") /\
        _browser_token_is(tape, 13, 15, ":") /\
        _browser_token_is(tape, 14, 1, "") /\
        _browser_token_is(tape, 15, 2, "+") /\
        _browser_token_is(tape, 16, 3, "") /\
        _browser_token_is(tape, 17, 4, "") /\
        _browser_token_is(tape, 18, 15, ":") /\
        _browser_token_is(tape, 19, 15, ":") /\
        _browser_token_is(tape, 20, 1, "") /\
        _browser_token_is(tape, 21, 4, "") /\
        _browser_token_is(tape, 22, 15, ":") /\
        _browser_token_is(tape, 23, 15, ":") /\
        _browser_token_is(tape, 24, 1, "") /\
        ((tape.count = 26 /\ _browser_token_is(tape, 25, 5, "")) \/
         (tape.count = 27 /\ _browser_token_is(tape, 25, 4, "") /\
          _browser_token_is(tape, 26, 5, ""))))

_run_tagged_bind_update_source(tape:any) -> any:
    _browser_bind_update_source_matches(tape)?! "browser binding/update program shape is unsupported"
    first_name: _browser_token_text(tape, 0)
    second_name: _browser_token_text(tape, 5)
    (_browser_token_text(tape, 7) = first_name /\
        _browser_token_text(tape, 12) = first_name /\
        _browser_token_text(tape, 14) = first_name /\
        _browser_token_text(tape, 20) = first_name /\
        _browser_token_text(tape, 24) = second_name)?! "browser binding/update names do not resolve"
    initial: tape.rows.(2 * 6 + 3)
    factor: tape.rows.(9 * 6 + 3)
    delta: tape.rows.(16 * 6 + 3)
    (kind:"console", values:[initial + delta, initial * factor])

_browser_bind_expression_source_matches(tape:any) -> bit:
    (_browser_token_is(tape, 0, 1, "") /\
        _browser_token_is(tape, 1, 15, ":") /\
        _browser_token_is(tape, 2, 13, "(") /\
        _browser_token_is(tape, 3, 1, "") /\
        _browser_token_is(tape, 4, 15, ":") /\
        _browser_token_is(tape, 5, 3, "") /\
        _browser_token_is(tape, 6, 14, ")") /\
        _browser_token_is(tape, 7, 2, "+") /\
        _browser_token_is(tape, 8, 3, "") /\
        _browser_token_is(tape, 9, 4, "") /\
        _browser_token_is(tape, 10, 15, ":") /\
        _browser_token_is(tape, 11, 15, ":") /\
        _browser_token_is(tape, 12, 1, "") /\
        _browser_token_is(tape, 13, 4, "") /\
        _browser_token_is(tape, 14, 15, ":") /\
        _browser_token_is(tape, 15, 15, ":") /\
        _browser_token_is(tape, 16, 1, "") /\
        ((tape.count = 18 /\ _browser_token_is(tape, 17, 5, "")) \/
         (tape.count = 19 /\ _browser_token_is(tape, 17, 4, "") /\
          _browser_token_is(tape, 18, 5, ""))))

_run_tagged_bind_expression_source(tape:any) -> any:
    _browser_bind_expression_source_matches(tape)?! "browser binding expression program shape is unsupported"
    outer_name: _browser_token_text(tape, 0)
    inner_name: _browser_token_text(tape, 3)
    (_browser_token_text(tape, 12) = inner_name /\
        _browser_token_text(tape, 16) = outer_name)?! "browser binding expression names do not resolve"
    inner: tape.rows.(5 * 6 + 3)
    delta: tape.rows.(8 * 6 + 3)
    (kind:"console", values:[inner, inner + delta])

_browser_dense_term(
    source:str,
    diagonal:str,
    outer:str,
    inner:str,
    parameter:str
) -> any:
    tape: lexer.tagged_numeric_function_token_tape(source)
    (tape.count = 26 /\
        _browser_token_is(tape, 0, 13, "(") /\
        _browser_token_is(tape, 1, 3, "") /\
        _browser_token_is(tape, 2, 9, "/") /\
        _browser_token_is(tape, 3, 13, "(") /\
        _browser_token_is(tape, 4, 1, diagonal) /\
        _browser_token_is(tape, 5, 7, "*") /\
        _browser_token_is(tape, 6, 13, "(") /\
        _browser_token_is(tape, 7, 1, diagonal) /\
        _browser_token_is(tape, 8, 2, "+") /\
        _browser_token_is(tape, 9, 3, "") /\
        _browser_token_is(tape, 10, 14, ")") /\
        _browser_token_is(tape, 11, 9, "/") /\
        _browser_token_is(tape, 12, 3, "") /\
        _browser_token_is(tape, 13, 2, "+") /\
        _browser_token_is(tape, 14, 1, "") /\
        _browser_token_is(tape, 15, 2, "+") /\
        _browser_token_is(tape, 16, 3, "") /\
        _browser_token_is(tape, 17, 14, ")") /\
        _browser_token_is(tape, 18, 14, ")") /\
        _browser_token_is(tape, 19, 7, "*") /\
        _browser_token_is(tape, 20, 1, parameter) /\
        _browser_token_is(tape, 21, 16, ".") /\
        _browser_token_is(tape, 22, 13, "(") /\
        _browser_token_is(tape, 23, 1, inner) /\
        _browser_token_is(tape, 24, 14, ")") /\
        _browser_token_is(tape, 25, 5, ""))?! "browser dense transform expression is unsupported"
    axis_name: _browser_token_text(tape, 14)
    axis: 0
    axis_name = inner?
        .axis: 1
    (axis_name = outer \/ axis_name = inner)?! "browser dense transform axis is unknown"
    (
        numerator:tape.rows.(1 * 6 + 3),
        diagonal_shift:tape.rows.(9 * 6 + 3),
        diagonal_divisor:tape.rows.(12 * 6 + 3),
        offset:tape.rows.(16 * 6 + 3),
        axis:axis
    )

_browser_dense_transform(
    source:str, arrow:int, stop:int
) -> BrowserDenseTransform:
    name: _browser_function_name(source, arrow)
    parameter: _browser_function_parameter(source, arrow)
    size: _browser_vector_return_size(source, arrow)
    (size >= 1 /\ size <= 2048 /\ size // 1 = size)?! "browser numeric vector size exceeds the bounded runtime"
    body_start: _browser_basic_line_stop(source, arrow) + 1
    output_start: _browser_find_source(source, body_start, "output: [0:")
    (output_start >= body_start /\ output_start < stop)?! "browser dense transform requires vector allocation"
    allocation: _browser_decimal_at(source, output_start + 11)
    (allocation.value = size)?! "browser dense transform allocation disagrees with its result type"
    outer_start: _browser_find_source(source, allocation.next, "..")
    (outer_start >= 0 /\ outer_start < stop)?! "browser dense transform requires an outer range"
    outer: _browser_numeric_range(source, outer_start)
    (outer.variable != "" /\ outer.bound + 1 = size)?! "browser dense transform outer range disagrees with its vector size"
    total_start: _browser_find_source(source, outer.next, "total: 0")
    inner_start: _browser_find_source(source, outer.next, "..")
    (total_start >= outer.next /\ total_start < inner_start /\ inner_start < stop)?! "browser dense transform requires a zero reduction and inner range"
    inner: _browser_numeric_range(source, inner_start)
    (inner.variable != "" /\ inner.bound + 1 = size)?! "browser dense transform inner range disagrees with its vector size"
    diagonal_start: _browser_inline_space_start(source, inner.next)
    diagonal_colon: _browser_find_source(source, diagonal_start, ":")
    diagonal_stop: _browser_basic_line_stop(source, diagonal_start)
    (diagonal_colon > diagonal_start /\ diagonal_colon < diagonal_stop)?! "browser dense transform diagonal binding is invalid"
    diagonal_name: vkf_utf8_slice(source, diagonal_start, diagonal_colon)
    diagonal_tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, diagonal_colon + 1, diagonal_stop)
    )
    diagonal_forward: (
        _browser_token_is(diagonal_tape, 0, 1, outer.variable) /\
        _browser_token_is(diagonal_tape, 2, 1, inner.variable)
    )
    diagonal_reverse: (
        _browser_token_is(diagonal_tape, 0, 1, inner.variable) /\
        _browser_token_is(diagonal_tape, 2, 1, outer.variable)
    )
    (diagonal_tape.count = 4 /\ (diagonal_forward \/ diagonal_reverse) /\
        _browser_token_is(diagonal_tape, 1, 2, "+") /\
        _browser_token_is(diagonal_tape, 3, 5, ""))?! "browser dense transform diagonal expression is unsupported"
    update_start: _browser_inline_space_start(source, diagonal_stop + 1)
    _browser_source_starts_with(source, update_start, ".total+:", 0)?! "browser dense transform reduction update is invalid"
    update_stop: _browser_basic_line_stop(source, update_start)
    term: _browser_dense_term(
        vkf_utf8_slice(source, update_start + 8, update_stop),
        diagonal_name, outer.variable, inner.variable, parameter
    )
    output_store: _browser_find_source(source, update_stop, "output.(")
    return_start: _browser_find_source(source, output_store, "@: output")
    (output_store > update_stop /\ output_store < return_start /\ return_start < stop)?! "browser dense transform indexed store or return is missing"
    (
        name:name,
        parameter:parameter,
        size:size,
        numerator:term.numerator,
        diagonal_shift:term.diagonal_shift,
        diagonal_divisor:term.diagonal_divisor,
        offset:term.offset,
        axis:term.axis
    )

_browser_dense_composition(
    source:str, arrow:int, stop:int
) -> BrowserDenseComposition:
    name: _browser_function_name(source, arrow)
    parameter: _browser_function_parameter(source, arrow)
    body_start: _browser_inline_space_start(
        source, _browser_basic_line_stop(source, arrow) + 1
    )
    body_stop: _browser_basic_line_stop(source, body_start)
    (body_stop <= stop)?! "browser vector composition body is invalid"
    tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, body_start, body_stop)
    )
    (tape.count = 8 /\
        _browser_token_is(tape, 0, 1, "") /\
        _browser_token_is(tape, 1, 13, "(") /\
        _browser_token_is(tape, 2, 1, "") /\
        _browser_token_is(tape, 3, 13, "(") /\
        _browser_token_is(tape, 4, 1, parameter) /\
        _browser_token_is(tape, 5, 14, ")") /\
        _browser_token_is(tape, 6, 14, ")") /\
        _browser_token_is(tape, 7, 5, ""))?! "browser vector composition expression is unsupported"
    (
        name:name,
        parameter:parameter,
        outer:_browser_token_text(tape, 0),
        inner:_browser_token_text(tape, 2)
    )

_browser_dense_transform_by_name(
    first:BrowserDenseTransform,
    second:BrowserDenseTransform,
    name:str,
    values:any
) -> any:
    name = first.name?
        @: _browser_execute_dense_transform(first, values)
    name = second.name?
        @: _browser_execute_dense_transform(second, values)
    false?! "browser vector composition calls an unknown transform"
    values

_browser_execute_dense_transform(
    transform:BrowserDenseTransform, values:any
) -> any:
    (values.length() = transform.size)?! "browser dense transform input size mismatch"
    [num] output: [0:transform.size]
    i: 0
    (i < transform.size)?>
        total: 0
        j: 0
        (j < transform.size)?>
            diagonal: i + j
            axis_value: i
            transform.axis = 1?
                .axis_value: j
            denominator: (
                diagonal * (diagonal + transform.diagonal_shift) /
                transform.diagonal_divisor + axis_value + transform.offset
            )
            (denominator != 0)?! "browser dense transform divided by zero"
            .total+: transform.numerator / denominator * values.(j)
            .j+: 1
        output.(i): total
        .i+: 1
    output

_browser_execute_dense_composition(
    composition:BrowserDenseComposition,
    first:BrowserDenseTransform,
    second:BrowserDenseTransform,
    values:any
) -> any:
    inner: _browser_dense_transform_by_name(
        first, second, composition.inner, values
    )
    _browser_dense_transform_by_name(
        first, second, composition.outer, inner
    )

_browser_power_state(source:str, driver_start:int, size:num) -> BrowserPowerState:
    state_start: _browser_find_source(source, driver_start, "state: (")
    (state_start >= driver_start)?! "browser power iteration state is missing"
    state_stop: _browser_basic_line_stop(source, state_start)
    tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, state_start, state_stop)
    )
    (tape.count = 20 /\
        _browser_token_is(tape, 0, 1, "") /\
        _browser_token_is(tape, 1, 15, ":") /\
        _browser_token_is(tape, 2, 13, "(") /\
        _browser_token_is(tape, 3, 1, "") /\
        _browser_token_is(tape, 4, 15, ":") /\
        _browser_token_is(tape, 5, 22, "[") /\
        _browser_token_is(tape, 6, 3, "") /\
        _browser_token_is(tape, 7, 15, ":") /\
        _browser_token_is(tape, 8, 3, "") /\
        _browser_token_is(tape, 9, 23, "]") /\
        _browser_token_is(tape, 10, 24, ",") /\
        _browser_token_is(tape, 11, 1, "") /\
        _browser_token_is(tape, 12, 15, ":") /\
        _browser_token_is(tape, 13, 22, "[") /\
        _browser_token_is(tape, 14, 3, "") /\
        _browser_token_is(tape, 15, 15, ":") /\
        _browser_token_is(tape, 16, 3, "") /\
        _browser_token_is(tape, 17, 23, "]") /\
        _browser_token_is(tape, 18, 14, ")") /\
        _browser_token_is(tape, 19, 5, ""))?! "browser power iteration state contains unsupported syntax"
    first_size: tape.rows.(8 * 6 + 3)
    second_size: tape.rows.(16 * 6 + 3)
    (first_size = size /\ second_size = size)?! "browser power iteration state size mismatch"
    (
        state_name:_browser_token_text(tape, 0),
        first_name:_browser_token_text(tape, 3),
        second_name:_browser_token_text(tape, 11),
        first_fill:tape.rows.(6 * 6 + 3),
        second_fill:tape.rows.(14 * 6 + 3),
        size:size
    )

_browser_filled_vector(size:num, value:num) -> any:
    [num] values: [0:size]
    index: 0
    (index < size)?>
        values.(index): value
        .index+: 1
    values

_browser_power_final_multiplier(source:str, return_start:int) -> num:
    return_stop: _browser_basic_line_stop(source, return_start)
    tape: lexer.tagged_numeric_function_token_tape(
        vkf_utf8_slice(source, return_start + 2, return_stop)
    )
    base: (
        tape.count >= 11 /\
        _browser_token_is(tape, 0, 1, "sqrt") /\
        _browser_token_is(tape, 1, 13, "(") /\
        _browser_token_is(tape, 2, 1, "result") /\
        _browser_token_is(tape, 3, 16, ".") /\
        _browser_token_is(tape, 4, 1, "numerator") /\
        _browser_token_is(tape, 5, 9, "/") /\
        _browser_token_is(tape, 6, 1, "result") /\
        _browser_token_is(tape, 7, 16, ".") /\
        _browser_token_is(tape, 8, 1, "denominator") /\
        _browser_token_is(tape, 9, 14, ")")
    )
    base /\ _browser_token_is(tape, 10, 5, "")?
        @: 1
    (tape.count = 13 /\ base /\
        _browser_token_is(tape, 10, 7, "*") /\
        _browser_token_is(tape, 11, 3, "") /\
        _browser_token_is(tape, 12, 5, ""))?! "browser power result expression is unsupported"
    tape.rows.(11 * 6 + 3)

_browser_power_method_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, ":.math") >= 0 /\
        _browser_find_source(source, 0, ") -> [num:") >= 0 /\
        _browser_find_source(source, 0, "output: [0:") >= 0 /\
        _browser_find_source(source, 0, "state: (") >= 0 /\
        _browser_find_source(source, 0, "sqrt(") >= 0 /\
        _browser_find_source(source, 0, ":: ") >= 0)

_run_tagged_power_method_source(source:str) -> any:
    first_arrow: _browser_find_source(source, 0, ") -> [num:")
    second_arrow: _browser_find_source(source, first_arrow + 1, ") -> [num:")
    third_arrow: _browser_find_source(source, second_arrow + 1, ") -> [num:")
    fourth_arrow: _browser_find_source(source, third_arrow + 1, ") -> [num:")
    driver_arrow: _browser_find_source(source, third_arrow + 1, ") -> num:")
    (first_arrow >= 0 /\ second_arrow > first_arrow /\ third_arrow > second_arrow /\
        fourth_arrow < 0 /\ driver_arrow > third_arrow)?! "browser power program function graph is unsupported"
    second_start: _browser_line_start_before(source, second_arrow)
    third_start: _browser_line_start_before(source, third_arrow)
    driver_start: _browser_line_start_before(source, driver_arrow)
    first: _browser_dense_transform(source, first_arrow, second_start)
    second: _browser_dense_transform(source, second_arrow, third_start)
    (first.size = second.size)?! "browser composed transforms require matching vector sizes"
    composition: _browser_dense_composition(source, third_arrow, driver_start)
    state: _browser_power_state(source, driver_start, first.size)
    iteration_start: _browser_find_source(
        source, _browser_basic_line_stop(source, _browser_find_source(source, driver_start, "state: (")), ".."
    )
    iteration: _browser_numeric_range(source, iteration_start)
    steps: iteration.bound + 1
    (steps >= 1 /\ steps <= 64 /\ steps // 1 = steps)?! "browser power iteration count exceeds the bounded runtime"
    work: first.size * first.size * steps * 4
    (work <= 20000000)?! "browser power program exceeds its operation budget"
    first_assignment: _browser_find_source(
        source, iteration.next,
        state.state_name & "." & state.second_name & ":"
    )
    second_assignment: _browser_find_source(
        source, first_assignment + 1,
        state.state_name & "." & state.first_name & ":"
    )
    (first_assignment >= 0 /\ second_assignment > first_assignment)?! "browser power iteration assignments are missing"
    first_call: _browser_find_source(source, first_assignment, composition.name)
    second_call: _browser_find_source(source, second_assignment, composition.name)
    (first_call > first_assignment /\ first_call < second_assignment /\ second_call > second_assignment)?! "browser power iteration must call its vector composition"
    first_expected: (
        state.state_name & "." & state.second_name & ": " &
        composition.name & "(" & state.state_name & "." & state.first_name & ")"
    )
    second_expected: (
        state.state_name & "." & state.first_name & ": " &
        composition.name & "(" & state.state_name & "." & state.second_name & ")"
    )
    first_stop: _browser_basic_line_stop(source, first_assignment)
    second_stop: _browser_basic_line_stop(source, second_assignment)
    (_browser_source_starts_with(source, first_assignment, first_expected, 0) /\
        _browser_inline_space_only(
            source, first_assignment + first_expected.length(), first_stop
        ))?! "browser power first assignment contains unsupported syntax"
    (_browser_source_starts_with(source, second_assignment, second_expected, 0) /\
        _browser_inline_space_only(
            source, second_assignment + second_expected.length(), second_stop
        ))?! "browser power second assignment contains unsupported syntax"
    result_start: _browser_find_source(source, second_assignment, "result: (numerator:0, denominator:0)")
    reduction_start: _browser_find_source(source, result_start, "..")
    (result_start > second_assignment /\ reduction_start > result_start)?! "browser power reduction is missing"
    reduction: _browser_numeric_range(source, reduction_start)
    (reduction.bound + 1 = state.size)?! "browser power reduction size mismatch"
    numerator_update: _browser_find_source(source, reduction.next, "result.numerator +: u.(\$) * v.(\$)")
    denominator_update: _browser_find_source(source, reduction.next, "result.denominator +: v.(\$) * v.(\$)")
    (numerator_update >= 0 /\ denominator_update > numerator_update)?! "browser power reduction expression is unsupported"
    return_start: _browser_find_source(source, denominator_update, "@: ")
    (return_start > denominator_update)?! "browser power result is missing"
    multiplier: _browser_power_final_multiplier(source, return_start)
    driver_name: _browser_function_name(source, driver_arrow)
    top_start: _browser_find_source(
        source, _browser_basic_line_stop(source, return_start), ":: "
    )
    top_expected: ":: " & driver_name & "()"
    top_stop: _browser_basic_line_stop(source, top_start)
    (top_start >= 0 /\
        _browser_source_starts_with(source, top_start, top_expected, 0) /\
        _browser_inline_space_only(
            source, top_start + top_expected.length(), top_stop
        ))?! "browser power top-level call contains unsupported syntax"
    inner: first
    composition.inner = second.name?
        .inner: second
    (composition.inner = first.name \/ composition.inner = second.name)?! "browser vector composition inner transform is unknown"
    outer: first
    composition.outer = second.name?
        .outer: second
    (composition.outer = first.name \/ composition.outer = second.name)?! "browser vector composition outer transform is unknown"
    value: vkf_dense_power([
        state.size, steps,
        inner.numerator, inner.diagonal_shift, inner.diagonal_divisor,
        inner.offset, inner.axis,
        outer.numerator, outer.diagonal_shift, outer.diagonal_divisor,
        outer.offset, outer.axis,
        state.first_fill, state.second_fill, multiplier
    ])
    (kind:"console", values:[value])

BrowserNBodyShape: (bodies:int, dimensions:int)
BrowserNBodyRows: (values:any, next:int)
BrowserNBodyPlan: (
    positions:[num], velocities:[num], masses:[num],
    bodies:int, dimensions:int, timestep:num, steps:int
)

_browser_nbody_compact(
    source:str, cursor:int, stop:int, result:str
) -> str:
    cursor >= stop?
        @: result
    ch: vkf_string_peek_scalar(source, cursor)
    next: vkf_utf8_advance(source, cursor)
    (ch = 9 \/ ch = 10 \/ ch = 13 \/ ch = 32)?
        @: _browser_nbody_compact(source, next, stop, result)
    _browser_nbody_compact(
        source, next, stop, result & vkf_utf8_slice(source, cursor, next)
    )

_browser_nbody_shape_field(source:str, offset:int, name:str) -> any:
    prefix: name & ":[[num:"
    start: _browser_find_source(source, offset, prefix)
    (start >= offset)?! "browser pairwise system shape is missing"
    dimensions: _browser_decimal_at(source, start + prefix.length())
    body_separator: _browser_inline_space_start(source, dimensions.next)
    _browser_source_starts_with(
        source, body_separator, "]:" , 0
    )?! "browser pairwise system dimension is malformed"
    bodies: _browser_decimal_at(source, body_separator + 2)
    close: _browser_inline_space_start(source, bodies.next)
    _browser_source_starts_with(
        source, close, "]", 0
    )?! "browser pairwise system body count is malformed"
    (
        shape:(bodies:bodies.value, dimensions:dimensions.value),
        next:close + 1
    )

_browser_nbody_shape(source:str) -> BrowserNBodyShape:
    positions: _browser_nbody_shape_field(source, 0, "positions")
    velocities: _browser_nbody_shape_field(
        source, positions.next, "velocities"
    )
    mass_prefix: "masses:[num:"
    mass_start: _browser_find_source(
        source, velocities.next, mass_prefix
    )
    (mass_start > velocities.next)?! "browser pairwise mass shape is missing"
    masses: _browser_decimal_at(
        source, mass_start + mass_prefix.length()
    )
    mass_close: _browser_inline_space_start(source, masses.next)
    _browser_source_starts_with(
        source, mass_close, "]", 0
    )?! "browser pairwise mass shape is malformed"
    (positions.shape.bodies = velocities.shape.bodies /\
        positions.shape.dimensions = velocities.shape.dimensions /\
        masses.value = positions.shape.bodies)?! "browser pairwise system shapes disagree"
    (positions.shape.bodies >= 2 /\ positions.shape.bodies <= 16 /\
        positions.shape.dimensions >= 1 /\
        positions.shape.dimensions <= 8 /\
        positions.shape.bodies // 1 = positions.shape.bodies /\
        positions.shape.dimensions // 1 = positions.shape.dimensions)?! "browser pairwise system shape exceeds its bound"
    positions.shape

_browser_nbody_nested_value(source:str, start:int) -> any:
    stop: _browser_display_bracket_stop(source, start + 1, 1)
    tape: lexer.tagged_numeric_function_token_tape(
        _browser_nbody_compact(source, start, stop, "")
    )
    parsed: _browser_lifted_value(tape, 0, 1)
    _browser_token_is(tape, parsed.next, 5, "")?! "browser pairwise vector contains unsupported syntax"
    (value:parsed.value, next:stop)

_browser_nbody_scale_row(
    values:any, index:int, factor:num, result:any
) -> any:
    index >= values.length()?
        @: result
    _browser_nbody_scale_row(
        values, index + 1, factor, result & [values.(index) * factor]
    )

_browser_nbody_scaled_rows(
    source:str, cursor:int, stop:int, index:int, count:int,
    factor:num, values:any
) -> BrowserNBodyRows:
    index = count?
        close: _browser_display_value_start(source, cursor)
        (close < stop /\ vkf_string_peek_scalar(source, close) = 93 /\
            vkf_utf8_advance(source, close) = stop)?! "browser pairwise velocity row count changed"
        @: (values:values, next:stop)
    row_start: _browser_display_value_start(source, cursor)
    (vkf_string_peek_scalar(source, row_start) = 91)?! "browser pairwise velocity row is missing"
    row: _browser_nbody_nested_value(source, row_start)
    row_value: row.value
    next: _browser_display_value_start(source, row.next)
    index > 0?
        scale: "* constants.days_per_year"
        _browser_source_starts_with(source, next, scale, 0)?! "browser pairwise velocity scale changed"
        .row_value: _browser_nbody_scale_row(row.value, 0, factor, [])
        .next: _browser_display_value_start(
            source, next + scale.length()
        )
    index + 1 < count?
        (vkf_string_peek_scalar(source, next) = 44)?! "browser pairwise velocity rows require commas"
        @: _browser_nbody_scaled_rows(
            source, next + 1, stop, index + 1, count,
            factor, values & [row_value]
        )
    _browser_nbody_scaled_rows(
        source, next, stop, index + 1, count,
        factor, values & [row_value]
    )

_browser_nbody_mass_terms(
    tape:any, index:int, solar_mass:num, values:any
) -> BrowserLiftedParse:
    _browser_token_kind(tape, index) = 23?
        @: (value:values, next:index + 1)
    value: solar_mass
    next: index
    values.length() = 0?
        (_browser_token_is(tape, index, 1, "constants") /\
            _browser_token_is(tape, index + 1, 16, ".") /\
            _browser_token_is(tape, index + 2, 1, "solar_mass"))?! "browser pairwise primary mass changed"
        .next: index + 3
    values.length() > 0?
        coefficient: _browser_lifted_number(tape, index, 1)
        (_browser_token_is(tape, coefficient.next, 7, "*") /\
            _browser_token_is(
                tape, coefficient.next + 1, 1, "constants"
            ) /\
            _browser_token_is(tape, coefficient.next + 2, 16, ".") /\
            _browser_token_is(
                tape, coefficient.next + 3, 1, "solar_mass"
            ))?! "browser pairwise mass expression changed"
        .value: coefficient.value * solar_mass
        .next: coefficient.next + 4
    _browser_token_kind(tape, next) = 24?
        @: _browser_nbody_mass_terms(
            tape, next + 1, solar_mass, values & [value]
        )
    (_browser_token_kind(tape, next) = 23)?! "browser pairwise masses require commas or a closing bracket"
    (value:values & [value], next:next + 1)

_browser_nbody_masses(
    source:str, start:int, stop:int, solar_mass:num, bodies:int
) -> [num]:
    tape: lexer.tagged_numeric_function_token_tape(
        _browser_nbody_compact(source, start, stop, "")
    )
    _browser_token_is(tape, 0, 22, "")?! "browser pairwise masses require a vector"
    masses: _browser_nbody_mass_terms(tape, 1, solar_mass, [])
    (_browser_token_is(tape, masses.next, 5, "") /\
        masses.value.length() = bodies)?! "browser pairwise mass count changed"
    masses.value

_browser_nbody_flatten(
    rows:any, bodies:int, dimensions:int
) -> [num]:
    (rows.length() = bodies)?! "browser pairwise body count changed"
    [num] values: [0:bodies * dimensions]
    body: 0
    (body < bodies)?>
        row: rows.(body)
        (row.length() = dimensions)?! "browser pairwise vector dimension changed"
        dimension: 0
        (dimension < dimensions)?>
            values.(body * dimensions + dimension): row.(dimension)
            .dimension+: 1
        .body+: 1
    values

_browser_pairwise_system_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, "positions:[[num:") >= 0 /\
        _browser_find_source(source, 0, "velocities:[[num:") >= 0 /\
        _browser_find_source(source, 0, "masses:[num:") >= 0 /\
        _browser_find_source(source, 0, "momentum: [0, 0, 0]") >= 0 /\
        _browser_find_source(
            source, 0, "velocities.0: momentum * (-1 / solar_mass)"
        ) >= 0 /\
        _browser_find_source(
            source, 0,
            "[num:3] displacement: positions.(i) - positions.(j)"
        ) >= 0 /\
        _browser_find_source(
            source, 0, "magnitude: timestep / |displacement|^3"
        ) >= 0 /\
        _browser_find_source(
            source, 0,
            "totals.potential -: masses.(i) * masses.(j) / |displacement|"
        ) >= 0 /\
        _browser_find_source(
            source, 0, "@: totals.kinetic + totals.potential"
        ) >= 0 /\
        _browser_find_source(source, 0, ":: ") >= 0)

_browser_pairwise_system_plan(source:str) -> BrowserNBodyPlan:
    _browser_pairwise_system_source_matches(source)?! "browser pairwise vector-system shape is unsupported"
    shape: _browser_nbody_shape(source)
    momentum_loop: _browser_find_source(
        source, 0,
        "..4 >>\n        i: \$\n        .momentum+: velocities.(i) * masses.(i)"
    )
    (momentum_loop >= 0)?! "browser pairwise momentum loop bounds changed"
    advance_loop: _browser_find_source(
        source, momentum_loop + 1,
        "..3 >>\n        i: \$\n        (i + 1)..4 >>\n            j: \$\n            [num:3] displacement: positions.(i) - positions.(j)\n            magnitude: timestep / |displacement|^3\n            velocities.(i) -: displacement * masses.(j) * magnitude\n            velocities.(j) +: displacement * masses.(i) * magnitude"
    )
    (advance_loop > momentum_loop)?! "browser pairwise advance loop bounds changed"
    position_loop: _browser_find_source(
        source, advance_loop + 1,
        "..4 >>\n        i: \$\n        positions.(i) +: velocities.(i) * timestep"
    )
    (position_loop > advance_loop)?! "browser pairwise position loop bounds changed"
    kinetic_loop: _browser_find_source(
        source, position_loop + 1,
        "..4 >>\n        i: \$\n        totals.kinetic +: 0.5 * masses.(i) * |velocities.(i)|^2"
    )
    (kinetic_loop > position_loop)?! "browser pairwise kinetic loop bounds changed"
    energy_loop: _browser_find_source(
        source, kinetic_loop + 1,
        "..3 >>\n        i: \$\n        (i + 1)..4 >>\n            j: \$\n            [num:3] displacement: positions.(i) - positions.(j)\n            totals.potential -: masses.(i) * masses.(j) / |displacement|"
    )
    (energy_loop > kinetic_loop)?! "browser pairwise energy loop bounds changed"
    first_numeric_arrow: _browser_find_source(source, 0, ") -> num:")
    driver_arrow: _browser_find_source(
        source, first_numeric_arrow + 1, ") -> num:"
    )
    (first_numeric_arrow >= 0 /\ driver_arrow > first_numeric_arrow)?! "browser pairwise driver function is missing"
    driver_start: _browser_line_start_before(source, driver_arrow)
    function_name: _browser_function_name(source, driver_arrow)
    parameter: _browser_function_parameter(source, driver_arrow)
    constants_start: _browser_find_source(
        source, driver_start, "constants: ("
    )
    system_start: _browser_find_source(source, constants_start, "system: (")
    (constants_start >= driver_start /\ system_start > constants_start)?! "browser pairwise constants or system is missing"
    solar_start: _browser_find_source(
        source, constants_start, "solar_mass:"
    )
    days_start: _browser_find_source(
        source, solar_start, "days_per_year:"
    )
    timestep_start: _browser_find_source(
        source, days_start, "timestep:"
    )
    (solar_start >= constants_start /\ days_start > solar_start /\
        timestep_start > days_start /\ timestep_start < system_start)?! "browser pairwise numeric constants changed"
    solar_mass: _browser_decimal_at(source, solar_start + 11).value
    days_per_year: _browser_decimal_at(source, days_start + 14).value
    timestep: _browser_decimal_at(source, timestep_start + 9).value
    positions_prefix: "positions:"
    positions_start: _browser_find_source(
        source, system_start, positions_prefix
    )
    positions_value_start: _browser_display_value_start(
        source, positions_start + positions_prefix.length()
    )
    positions_rows: _browser_nbody_nested_value(
        source, positions_value_start
    )
    velocities_prefix: "velocities:"
    velocities_start: _browser_find_source(
        source, positions_rows.next, velocities_prefix
    )
    velocities_value_start: _browser_display_value_start(
        source, velocities_start + velocities_prefix.length()
    )
    velocities_stop: _browser_display_bracket_stop(
        source, velocities_value_start + 1, 1
    )
    velocity_rows: _browser_nbody_scaled_rows(
        source, velocities_value_start + 1, velocities_stop,
        0, shape.bodies, days_per_year, []
    )
    masses_prefix: "masses:"
    masses_start: _browser_find_source(
        source, velocities_stop, masses_prefix
    )
    masses_value_start: _browser_display_value_start(
        source, masses_start + masses_prefix.length()
    )
    masses_stop: _browser_display_bracket_stop(
        source, masses_value_start + 1, 1
    )
    masses: _browser_nbody_masses(
        source, masses_value_start, masses_stop,
        solar_mass, shape.bodies
    )
    offset_expected: ".system: offset_momentum(system, constants.solar_mass)"
    offset_call: _browser_find_source(source, masses_stop, offset_expected)
    (offset_call > masses_stop)?! "browser pairwise momentum offset call changed"
    offset_stop: _browser_basic_line_stop(source, offset_call)
    _browser_inline_space_only(
        source, offset_call + offset_expected.length(), offset_stop
    )?! "browser pairwise momentum offset call changed"
    loop_start: _browser_find_source(source, offset_call, "..")
    expected_loop: ".." & parameter & " - 1 >>"
    (offset_call > masses_stop /\ loop_start > offset_call /\
        _browser_source_starts_with(source, loop_start, expected_loop, 0))?! "browser pairwise step loop changed"
    advance_expected: ".system: advance(system, constants.timestep)"
    advance_call: _browser_find_source(source, loop_start, advance_expected)
    (advance_call > loop_start)?! "browser pairwise driver advance call changed"
    advance_stop: _browser_basic_line_stop(source, advance_call)
    _browser_inline_space_only(
        source, advance_call + advance_expected.length(), advance_stop
    )?! "browser pairwise driver advance call changed"
    return_call: _browser_find_source(
        source, advance_call, "@: system_energy(system)"
    )
    top_prefix: ":: " & function_name & "("
    top_start: _browser_find_source(source, return_call, top_prefix)
    (return_call > loop_start /\ top_start > return_call)?! "browser pairwise result call is missing"
    steps: _browser_decimal_at(
        source, top_start + top_prefix.length()
    )
    top_stop: _browser_basic_line_stop(source, top_start)
    close: _browser_inline_space_start(source, steps.next)
    (_browser_source_starts_with(source, close, ")", 0) /\
        _browser_inline_space_only(source, close + 1, top_stop))?! "browser pairwise top-level call contains unsupported syntax"
    (steps.value >= 0 /\ steps.value <= 100000 /\
        steps.value // 1 = steps.value /\
        steps.value * shape.bodies * shape.bodies * shape.dimensions <= 100000000)?! "browser pairwise program exceeds its operation budget"
    positions: _browser_nbody_flatten(
        positions_rows.value, shape.bodies, shape.dimensions
    )
    velocities: _browser_nbody_flatten(
        velocity_rows.values, shape.bodies, shape.dimensions
    )
    (
        positions:positions, velocities:velocities,
        masses:masses, bodies:shape.bodies,
        dimensions:shape.dimensions, timestep:timestep,
        steps:steps.value
    )

_run_tagged_pairwise_system_source(source:str) -> any:
    plan: _browser_pairwise_system_plan(source)
    value: vkf_pairwise_system_energy(
        [plan.bodies, plan.dimensions, plan.timestep, plan.steps] &
            plan.positions & plan.velocities & plan.masses
    )
    (value != null)?! "browser pairwise runtime rejected its source-derived plan"
    (kind:"console", values:[value])

BrowserParityClause: (modulus:num, residue:num, next:int)

_browser_layout_only(source:str, offset:int, stop:int) -> bit:
    offset >= stop?
        @: true
    ch: vkf_string_peek_scalar(source, offset)
    ((ch = 9 \/ ch = 10 \/ ch = 13 \/ ch = 32) /\
        _browser_layout_only(source, vkf_utf8_advance(source, offset), stop))

_browser_expect_statement(source:str, cursor:int, expected:str) -> int:
    start: _browser_find_source(source, cursor, expected)
    (start >= cursor /\ _browser_layout_only(source, cursor, start))?! "browser mutable-control program contains unsupported syntax"
    stop: _browser_basic_line_stop(source, start)
    _browser_inline_space_only(
        source, start + expected.length(), stop
    )?! "browser mutable-control statement contains unsupported syntax"
    stop + 1

_browser_zero_vector_statement(
    source:str, cursor:int, name:str
) -> any:
    prefix: name & ": [0:"
    start: _browser_find_source(source, cursor, prefix)
    (start >= cursor /\ _browser_layout_only(source, cursor, start))?! "browser mutable vector allocation is missing"
    size: _browser_decimal_at(source, start + prefix.length())
    stop: _browser_basic_line_stop(source, start)
    suffix_start: _browser_inline_space_start(source, size.next)
    (_browser_source_starts_with(source, suffix_start, "]", 0) /\
        _browser_inline_space_only(source, suffix_start + 1, stop))?! "browser mutable vector allocation contains unsupported syntax"
    (size:size.value, next:stop + 1)

_browser_numeric_literal_array(source:str) -> any:
    tape: lexer.tagged_numeric_function_token_tape(source)
    (tape.count >= 4 /\ tape.count % 2 = 0 /\
        _browser_token_is(tape, 0, 22, "[") /\
        _browser_token_is(tape, tape.count - 2, 23, "]") /\
        _browser_token_is(tape, tape.count - 1, 5, ""))?! "browser mutable seed must be a numeric array literal"
    num size: (tape.count - 2) / 2
    [num] values: [0:size]
    index: 0
    (index < size)?>
        token: 1 + index * 2
        _browser_token_is(tape, token, 3, "")?! "browser mutable seed contains a non-numeric value"
        index + 1 < size?
            _browser_token_is(tape, token + 1, 24, ",")?! "browser mutable seed separator is invalid"
        values.(index): tape.rows.(token * 6 + 3)
        .index+: 1
    values

_browser_parity_clause(
    source:str, cursor:int, comparison:str
) -> BrowserParityClause:
    prefix: "result.permutation_index % "
    start: _browser_find_source(source, cursor, prefix)
    (start >= cursor /\ _browser_layout_only(source, cursor, start))?! "browser checksum match clause is missing"
    modulus: _browser_decimal_at(source, start + prefix.length())
    comparison_start: _browser_inline_space_start(source, modulus.next)
    operator: "= "
    comparison = "not_equal"?
        .operator: "!= "
    _browser_source_starts_with(source, comparison_start, operator, 0)?! "browser checksum comparison is unsupported"
    residue: _browser_decimal_at(
        source, comparison_start + operator.length()
    )
    stop: _browser_basic_line_stop(source, start)
    question: _browser_inline_space_start(source, residue.next)
    (_browser_source_starts_with(source, question, "?", 0) /\
        _browser_inline_space_only(source, question + 1, stop))?! "browser checksum match clause contains unsupported syntax"
    (modulus:modulus.value, residue:residue.value, next:stop + 1)

_browser_permutation_reduction_source_matches(source:str) -> bit:
    (_browser_find_source(source, 0, ") -> int:") >= 0 /\
        _browser_find_source(source, 0, "permutation: [") >= 0 /\
        _browser_find_source(source, 0, "control.running > 0?>") >= 0 /\
        _browser_find_source(source, 0, "result.permutation_index % ") >= 0 /\
        _browser_find_source(source, 0, "flip.left < flip.right?>") >= 0)

_run_tagged_permutation_reduction_source(source:str) -> any:
    arrow: _browser_find_source(source, 0, ") -> int:")
    (arrow >= 0)?! "browser mutable-control function is missing"
    function_name: _browser_function_name(source, arrow)
    parameter: _browser_function_parameter(source, arrow)
    cursor: _browser_basic_line_stop(source, arrow) + 1

    seed_prefix: "permutation: "
    seed_start: _browser_find_source(source, cursor, seed_prefix)
    (seed_start >= cursor /\ _browser_layout_only(source, cursor, seed_start))?! "browser mutable permutation seed is missing"
    seed_stop: _browser_basic_line_stop(source, seed_start)
    seed: _browser_numeric_literal_array(
        vkf_utf8_slice(
            source, seed_start + seed_prefix.length(), seed_stop
        )
    )
    (seed.length() >= 1 /\ seed.length() <= 64)?! "browser mutable permutation seed exceeds its bound"
    .cursor: seed_stop + 1
    working: _browser_zero_vector_statement(source, cursor, "working")
    rotations: _browser_zero_vector_statement(source, working.next, "rotations")
    (working.size = seed.length() /\ rotations.size = seed.length())?! "browser mutable vector sizes disagree with the seed"
    .cursor: rotations.next
    .cursor: _browser_expect_statement(
        source, cursor,
        "control: (r:" & parameter & ", running:1, searching:0)"
    )
    .cursor: _browser_expect_statement(
        source, cursor,
        "result: (permutation_index:0, checksum:0, maximum_flips:0)"
    )
    .cursor: _browser_expect_statement(
        source, cursor,
        "flip: (left:0, right:0, temporary:0, head:0, count:0)"
    )
    .cursor: _browser_expect_statement(source, cursor, "control.running > 0?>")
    .cursor: _browser_expect_statement(source, cursor, "control.r > 1?>")
    .cursor: _browser_expect_statement(source, cursor, "rotations.(control.r - 1): control.r")
    .cursor: _browser_expect_statement(source, cursor, "control.r -: 1")
    .cursor: _browser_expect_statement(
        source, cursor,
        ".." & parameter & " - 1 >> working.(\$): permutation.(\$)"
    )
    .cursor: _browser_expect_statement(source, cursor, "flip.count: 0")
    .cursor: _browser_expect_statement(source, cursor, "flip.head: working.0")
    .cursor: _browser_expect_statement(source, cursor, "flip.head != 0?>")
    .cursor: _browser_expect_statement(source, cursor, "flip.left: 0")
    .cursor: _browser_expect_statement(source, cursor, "flip.right: flip.head")
    .cursor: _browser_expect_statement(source, cursor, "flip.left < flip.right?>")
    .cursor: _browser_expect_statement(source, cursor, "flip.temporary: working.(flip.left)")
    .cursor: _browser_expect_statement(source, cursor, "working.(flip.left): working.(flip.right)")
    .cursor: _browser_expect_statement(source, cursor, "working.(flip.right): flip.temporary")
    .cursor: _browser_expect_statement(source, cursor, "flip.left +: 1")
    .cursor: _browser_expect_statement(source, cursor, "flip.right -: 1")
    .cursor: _browser_expect_statement(source, cursor, "flip.count +: 1")
    .cursor: _browser_expect_statement(source, cursor, "flip.head: working.0")
    .cursor: _browser_expect_statement(source, cursor, "flip.count > result.maximum_flips?")
    .cursor: _browser_expect_statement(source, cursor, "result.maximum_flips: flip.count")
    even: _browser_parity_clause(source, cursor, "equal")
    .cursor: even.next
    .cursor: _browser_expect_statement(source, cursor, "result.checksum +: flip.count")
    odd: _browser_parity_clause(source, cursor, "not_equal")
    (odd.modulus = even.modulus /\ odd.residue = even.residue)?! "browser checksum clauses must partition the same remainder"
    .cursor: odd.next
    .cursor: _browser_expect_statement(source, cursor, "result.checksum -: flip.count")
    .cursor: _browser_expect_statement(source, cursor, "control.searching: 1")
    .cursor: _browser_expect_statement(source, cursor, "control.searching > 0?>")
    .cursor: _browser_expect_statement(
        source, cursor, "control.r = " & parameter & "?"
    )
    .cursor: _browser_expect_statement(source, cursor, "control.running: 0")
    .cursor: _browser_expect_statement(source, cursor, "control.searching: 0")
    .cursor: _browser_expect_statement(source, cursor, "control.searching > 0?")
    .cursor: _browser_expect_statement(source, cursor, "flip.temporary: permutation.0")
    .cursor: _browser_expect_statement(
        source, cursor,
        "..control.r - 1 >> permutation.(\$): permutation.(\$ + 1)"
    )
    .cursor: _browser_expect_statement(source, cursor, "permutation.(control.r): flip.temporary")
    .cursor: _browser_expect_statement(source, cursor, "rotations.(control.r) -: 1")
    .cursor: _browser_expect_statement(source, cursor, "rotations.(control.r) > 0?")
    .cursor: _browser_expect_statement(source, cursor, "control.searching: 0")
    .cursor: _browser_expect_statement(source, cursor, "rotations.(control.r) = 0?")
    .cursor: _browser_expect_statement(source, cursor, "control.r +: 1")
    .cursor: _browser_expect_statement(source, cursor, "control.running > 0?")
    .cursor: _browser_expect_statement(source, cursor, "result.permutation_index +: 1")
    return_prefix: "@: result.checksum * "
    return_start: _browser_find_source(source, cursor, return_prefix)
    (return_start >= cursor /\ _browser_layout_only(source, cursor, return_start))?! "browser permutation result is missing"
    scale: _browser_decimal_at(
        source, return_start + return_prefix.length()
    )
    return_stop: _browser_basic_line_stop(source, return_start)
    maximum_suffix: "+ result.maximum_flips"
    suffix_start: _browser_inline_space_start(source, scale.next)
    (_browser_source_starts_with(source, suffix_start, maximum_suffix, 0) /\
        _browser_inline_space_only(
            source, suffix_start + maximum_suffix.length(), return_stop
        ))?! "browser permutation result expression is unsupported"
    (scale.value // 1 = scale.value /\ scale.value >= -1000000 /\
        scale.value <= 1000000)?! "browser permutation result scale exceeds its integer bound"
    top_prefix: ":: " & function_name & "("
    top_start: _browser_find_source(source, return_stop, top_prefix)
    (top_start >= return_stop /\
        _browser_layout_only(source, return_stop + 1, top_start))?! "browser permutation top-level call is missing"
    size: _browser_decimal_at(source, top_start + top_prefix.length())
    top_stop: _browser_basic_line_stop(source, top_start)
    close_start: _browser_inline_space_start(source, size.next)
    (_browser_source_starts_with(source, close_start, ")", 0) /\
        _browser_inline_space_only(source, close_start + 1, top_stop))?! "browser permutation top-level call contains unsupported syntax"
    (size.value >= 1 /\ size.value <= 10 /\ size.value <= seed.length() /\
        size.value // 1 = size.value)?! "browser permutation program exceeds its deterministic runtime budget"
    (even.modulus >= 1 /\ even.modulus // 1 = even.modulus /\
        even.residue >= 0 /\ even.residue < even.modulus /\
        even.residue // 1 = even.residue)?! "browser checksum remainder is outside its bound"
    value: vkf_permutation_reduction([
        seed, size.value, even.modulus, even.residue, scale.value, 1
    ])
    (value != null)?! "browser permutation runtime rejected its source-derived plan"
    (kind:"console", values:[value])

_run_tagged_lifted_vector_function(tape:any) -> any:
    _browser_lifted_vector_function_matches(tape)?! "lifted vector function declaration changed"
    function_name: _browser_token_text(tape, 0)
    parameter_name: _browser_token_text(tape, 2)
    (_browser_token_text(tape, 10) = parameter_name)?! "lifted vector body must load its parameter"
    factor: tape.rows.(75)
    index: 13
    (index < tape.count /\ _browser_token_kind(tape, index) = 4)?>
        .index+: 1
    outputs: []
    (_browser_token_kind(tape, index) != 5)?>
        (_browser_token_kind(tape, index) = 15 /\
            _browser_token_kind(tape, index + 1) = 15 /\
            _browser_token_kind(tape, index + 2) = 1 /\
            _browser_token_kind(tape, index + 3) = 13)?! "lifted vector output call changed"
        (_browser_token_text(tape, index + 2) = function_name)?! "lifted vector output must call the declared function"
        parsed: _browser_lifted_value(tape, index + 4, factor)
        (_browser_token_kind(tape, parsed.next) = 14)?! "lifted vector output call requires a closing parenthesis"
        .outputs: outputs & [parsed.value]
        .index: parsed.next + 1
        (index < tape.count /\ _browser_token_kind(tape, index) = 4)?>
            .index+: 1
    (kind:"console", values:outputs)

run_tagged_browser_source(source:str, packet_index:int) -> any:
    _browser_pairwise_system_source_matches(source)?
        @: _run_tagged_pairwise_system_source(source)
    _browser_permutation_reduction_source_matches(source)?
        @: _run_tagged_permutation_reduction_source(source)
    _browser_power_method_source_matches(source)?
        @: _run_tagged_power_method_source(source)
    _browser_basic_syntax_source_matches(source)?
        @: _run_tagged_basic_syntax_source(source)
    _browser_native_rigid_source_matches(source)?
        @: _browser_native_rigid_scene(source, packet_index)
    _browser_native_field_source_matches(source)?
        @: _browser_native_field_scene(source, packet_index)
    _browser_native_cube_source_matches(source)?
        @: _browser_native_cube_scene(source, packet_index)
    _browser_world_source_matches(source)?
        @: _run_tagged_world_source(source, packet_index)
    _browser_display_raw_source_matches(source)?
        @: _run_tagged_display_source(source, packet_index)
    tokens: lexer.tagged_numeric_function_token_tape(source)
    _browser_bind_expression_source_matches(tokens)?
        @: _run_tagged_bind_expression_source(tokens)
    _browser_bind_update_source_matches(tokens)?
        @: _run_tagged_bind_update_source(tokens)
    _browser_lifted_vector_function_matches(tokens)?
        @: _run_tagged_lifted_vector_function(tokens)
    _browser_named_axis_source_matches(tokens)?
        @: _run_tagged_named_axis_source(tokens)
    run_tagged_dependency_source(source)

compile_tagged_numeric_function_call(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_function_call(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_parameter_multiply_application(
        parsed.function_name,
        parsed.parameter_name,
        parsed.factor
    )
    module: mir.mir_lower_numeric_parameter_multiply_typed_module(application)
    maxima: validation.machine_ir_numeric_parameter_multiply_stack_maxima(
        parsed.function_name,
        parsed.parameter_name,
        parsed.factor
    )
    (maxima.0 = 1 /\ maxima.1 = 1 /\ maxima.2 = 2)?! "numeric function Machine IR has unexpected stack maxima"
    module

compile_tagged_numeric_positive_conditional(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_positive_conditional(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_positive_conditional_application(
        parsed.function_name,
        parsed.parameter_name
    )
    module: mir.mir_lower_numeric_positive_conditional_typed_module(application)
    maxima: validation.machine_ir_numeric_positive_conditional_stack_maxima(
        parsed.function_name,
        parsed.parameter_name
    )
    (maxima.0 = 1 /\ maxima.1 = 1 /\ maxima.2 = 2)?! "numeric conditional Machine IR has unexpected stack maxima"
    module

compile_tagged_numeric_count_to_loop(source:str):
    tokens: lexer.tagged_numeric_function_token_tape(source)
    parsed: parser.parse_tagged_numeric_count_to_loop(
        tokens.source, tokens.rows, tokens.count
    )
    application: typed.typed_numeric_count_to_loop_application(
        parsed.function_name,
        parsed.parameter_name,
        parsed.local_name,
        parsed.entry_value
    )
    module: mir.mir_lower_numeric_count_to_loop_typed_module(application)
    maxima: validation.machine_ir_numeric_count_to_loop_stack_maxima(
        parsed.function_name,
        parsed.parameter_name,
        parsed.local_name,
        parsed.entry_value
    )
    (maxima.0 = 1 /\ maxima.1 = 2)?! "numeric loop Machine IR has unexpected stack maxima"
    module

compile_tagged_module_statement(source:str, index:int):
    tokens: lexer.tagged_statement_token_tape(source)
    parsed: parser.parse_tagged_token_tape(
        tokens.source, tokens.rows, tokens.count
    )
    typed_module: typed.typed_tagged_module(
        parsed.module.body.source,
        parsed.module.body.rows,
        parsed.module.body.count
    )
    dynamic_module: mir.mir_tagged_module(
        typed_module.source,
        typed_module.statements,
        typed_module.count
    )
    statement: mir.mir_tagged_module_statement(dynamic_module, index)
    maximum: validation.machine_ir_tagged_statement_stack_maximum(
        statement.instructions.0.kind,
        statement.instructions.1.kind,
        statement.instructions.2.kind,
        statement.instructions.3.kind
    )
    mir.mir_assemble_tagged_statement_module(dynamic_module, index, maximum)

CompilerArtifactManifest: (
    source_path:str,
    source_sha256:str,
    typed_ir_sha256:str,
    compiler_version:str,
    artifact_path:str,
    artifact_content_sha256:str,
    runtime_hash:str,
    manifest_hash:str,
    status:str
)

CompilerArtifactResult: (manifest_path:str, artifact_path:str, status:str)

manifest(
    source_path:str,
    source_sha256:str,
    typed_ir_sha256:str,
    compiler_version:str,
    artifact_path:str,
    artifact_content_sha256:str,
    runtime_hash:str,
    manifest_hash:str,
    status:str
):
    (
        source_path: source_path,
        source_sha256: source_sha256,
        typed_ir_sha256: typed_ir_sha256,
        compiler_version: compiler_version,
        artifact_path: artifact_path,
        artifact_content_sha256: artifact_content_sha256,
        runtime_hash: runtime_hash,
        manifest_hash: manifest_hash,
        status: status
    )

artifact_result(manifest_path:str, artifact_path:str, status:str):
    (manifest_path: manifest_path, artifact_path: artifact_path, status: status)

compiler_artifact_smoke_capability:
    name: "vkf_compiler_artifact_smoke"
    input: [
        "--source file.vkf",
        "--typed-ir file.json"
    ]
    writes: [
        ".vkfbuild/<stem>/manifest.json",
        ".vkfbuild/<stem>/<stem>.cmd"
    ]
    manifest_fields: [
        "source_path",
        "source_sha256",
        "typed_ir_sha256",
        "compiler_version",
        "artifact_path",
        "artifact_content_sha256",
        "runtime_hash",
        "manifest_hash",
        "status"
    ]
    statuses: [
        "compiled when source hash or typed IR hash changed",
        "compiled when artifact missing",
        "current when manifest hash matches and artifact exists"
    ]
    artifact_emission: [
        "store_binding const values into native-owned value table",
        "load from prior store_binding",
        "expr_stmt external print emits script output",
        "manifest hash includes artifact content hash",
        "tampered artifact recompiles"
    ]
    supported_ir_subset: [
        "typed_module",
        "store_binding",
        "const",
        "load",
        "unknown external calls typed any"
    ]
    unsupported: [
        "known calls are hard diagnostic until artifact emission supports call targets",
        "unsupported typed IR writes no successful manifest"
    ]
    ownership: [
        "native smoke owns build directory",
        "no Python startup",
        "no shell fallback",
        "no source lexer fallback inside artifact smoke"
    ]
    percent: 82
    :

wasm_artifact_smoke_capability:
    name: "vkf_wasm_artifact_smoke"
    input: [
