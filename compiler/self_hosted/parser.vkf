parse_tagged_derived_binding_addition(
    source:str, token_rows:[num], token_count:int
) -> TaggedNestedAddition:
    (token_count = 15)?! "derived binding tracer expects three statements and EOF"
    (token_rows.(0) = 1 /\ token_rows.(6) = 6 /\
        token_rows.(12) = 3 /\ token_rows.(18) = 4 /\
        token_rows.(24) = 1 /\ token_rows.(30) = 6 /\
        token_rows.(36) = 1 /\ token_rows.(42) = 2 /\
        token_rows.(48) = 3 /\ token_rows.(54) = 4 /\
        token_rows.(60) = 1 /\ token_rows.(66) = 2 /\
        token_rows.(72) = 3 /\ token_rows.(78) = 4 /\
        token_rows.(84) = 5)?! "derived binding tracer token shape mismatch"
    (vkf_utf8_slice(source, token_rows.(1), token_rows.(2)) =
        vkf_utf8_slice(source, token_rows.(37), token_rows.(38)))?! "derived binding source dependency does not match"
    (vkf_utf8_slice(source, token_rows.(25), token_rows.(26)) =
        vkf_utf8_slice(source, token_rows.(61), token_rows.(62)))?! "demanded expression does not match its derived binding"
    [num:3] values: [token_rows.(15), token_rows.(51), token_rows.(75)]
    (kind:"derived_binding_addition", values:values)

parse_tagged_two_derived_bindings(
    source:str, token_rows:[num], token_count:int
) -> TaggedDependencyChain:
    (token_count = 21)?! "dependency chain tracer expects four statements and EOF"
    (token_rows.(0) = 1 /\ token_rows.(6) = 6 /\
        token_rows.(12) = 3 /\ token_rows.(18) = 4 /\
        token_rows.(24) = 1 /\ token_rows.(30) = 6 /\
        token_rows.(36) = 1 /\ token_rows.(42) = 2 /\
        token_rows.(48) = 3 /\ token_rows.(54) = 4 /\
        token_rows.(60) = 1 /\ token_rows.(66) = 6 /\
        token_rows.(72) = 1 /\ token_rows.(78) = 2 /\
        token_rows.(84) = 3 /\ token_rows.(90) = 4 /\
        token_rows.(96) = 1 /\ token_rows.(102) = 2 /\
        token_rows.(108) = 3 /\ token_rows.(114) = 4 /\
        token_rows.(120) = 5)?! "dependency chain tracer token shape mismatch"
    (vkf_utf8_slice(source, token_rows.(1), token_rows.(2)) =
        vkf_utf8_slice(source, token_rows.(37), token_rows.(38)))?! "first dependency link does not match"
    (vkf_utf8_slice(source, token_rows.(25), token_rows.(26)) =
        vkf_utf8_slice(source, token_rows.(73), token_rows.(74)))?! "second dependency link does not match"
    (vkf_utf8_slice(source, token_rows.(61), token_rows.(62)) =
        vkf_utf8_slice(source, token_rows.(97), token_rows.(98)))?! "demanded dependency link does not match"
    [num:4] values: [
        token_rows.(15), token_rows.(51), token_rows.(87), token_rows.(111)
    ]
    (kind:"two_derived_bindings", values:values)

tagged_module_statement(
    module:TaggedStatementModule, index:int
) -> TaggedBinaryOpNode:
    tagged_statement_node(module.body, index)

parse_type_annotation(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "IDENT" => type_annotation(current.value, span(current.location, current.location))
        unsupported_syntax(cursor, "expected type annotation")

parse_call(cursor:ParseCursor, callee:any):
    open: peek(cursor)
    open.kind??
        "LPAREN" => call_node(callee, [], span(callee.span.start, open.location))
        unsupported_syntax(cursor, "expected call argument list")

parse_block(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "INDENT" => block_node([], span(current.location, current.location))
        unsupported_syntax(cursor, "expected indented block")

parse_bind(cursor:ParseCursor):
    target: parse_identifier(cursor)
    colon_cursor: advance(cursor)
    value_cursor: expect(colon_cursor, "COLON")
    bind_node(target, null, parse_literal(value_cursor), target.span)

parse_function_definition(cursor:ParseCursor):
    name: parse_identifier(cursor)
    params_cursor: expect(advance(cursor), "LPAREN")
    body_cursor: expect(params_cursor, "COLON")
    function_definition(name.name, [], null, parse_block(body_cursor), name.span)

parse_parameter(cursor:ParseCursor):
    name: parse_identifier(cursor)
    current: peek(cursor)
    current.kind??
        "COLON" => (name: name.name, type: parse_type_annotation(advance(cursor)))
        (name: name.name, type: null)

parse_return_type(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "ARROW" => parse_type_annotation(advance(cursor))
        null

parse_statement(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "IDENT" => parse_bind(cursor)
        unsupported_syntax(cursor, "expected statement")

native_parser_smoke_capability:
    name: "vkf_parser_token_stream_smoke"
    input: "versioned token stream json from stdin or argv"
    validates: ["vektorflow.token_stream", "version", "tokens", "EOF"]
    emits_ast_json: [
        "module",
        "bind",
        "number_literal",
        "string_literal",
        "bool_literal",
        "null_literal",
        "identifier",
        "call",
        "binary_op"
    ]
    parses_statements: [
        "answer: 42",
        "name: string literal",
        "flag: true",
        "value: null",
        "print(answer)",
        "newline-separated module body"
    ]
    parses_functions: [
        "function header name plus params",
        "param type annotations",
        "return type annotation after ARROW",
        "INDENT DEDENT function body blocks",
        "AT_COLON return statement"
    ]
    unsupported: ["bind annotation answer:num: 42 because bootstrap parser does not support that exact shape"]
    errors: ["unsupported token diagnostic includes file line column"]
    :

parse_module_from_cursor(cursor:ParseCursor):
    first: peek(cursor)
    module_node([], span(first.location, first.location))

parse_token_stream_json(json_text:str):
    envelope: vkf_json_decode(json_text)
    validate_envelope_shape(envelope)
    start: cursor(envelope)
    validate_eof(start)
    parse_module_from_cursor(start)

