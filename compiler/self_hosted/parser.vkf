# Self-hosted VKF parser seed.
#
# This file is compiler source, not runtime example code. Bootstrap accepts it
# as the source-level contract for the future VKF-owned parser.

TOKEN_STREAM_SCHEMA: "vektorflow.token_stream"
TOKEN_STREAM_VERSION: 1

# Private bootstrap declaration shape; not a token/API schema or expression AST.
_bootstrap_shape_source_stop(source:str) -> int:
    position: 0
    (~vkf_string_eof(source, position))?>
        .position: vkf_utf8_advance(source, position)
    position

_bootstrap_shape_kind(rows:[num], count:int, index:int, source_stop:int) -> num:
    (index < 0 \/ index >= count)?
        @: 0
    start: rows.(index * 6 + 1)
    stop: rows.(index * 6 + 2)
    (start < 0 \/ stop < start \/ stop > source_stop \/
        start % 1 != 0 \/ stop % 1 != 0)?
        @: 0
    (rows.(index * 6) != 5 /\ start = stop)?
        @: 0
    (rows.(index * 6) = 5 /\ (start != source_stop \/ stop != start))?
        @: 0
    index > 0?
        start < rows.((index - 1) * 6 + 2)?
            @: 0
    rows.(index * 6)

_bootstrap_shape_text(source:str, rows:[num], index:int) -> str:
    vkf_utf8_slice(source, rows.(index * 6 + 1), rows.(index * 6 + 2))

_bootstrap_record_function_shape(source:str, rows:[num], count:int):
    [num] parameter_starts: []
    [num] parameter_stops: []
    [num] type_starts: []
    [num] type_stops: []
    [num] field_starts: []
    [num] field_stops: []
    [num] expression_starts: []
    [num] expression_stops: []
    shape: (
        valid:false, error_index:0, name:"",
        parameter_starts:parameter_starts, parameter_stops:parameter_stops,
        type_starts:type_starts, type_stops:type_stops,
        field_starts:field_starts, field_stops:field_stops, expression_starts:expression_starts,
        expression_stops:expression_stops
    )
    index: 0
    type_start: 0
    expression_start: 0
    [num] delimiters: []
    depth: 0
    closing_kind: 0
    scanning: false
    kind: 0
    (count < 1 \/ rows.length() != count * 6)?
        @: shape
    source_stop: _bootstrap_shape_source_stop(source)
    (_bootstrap_shape_kind(rows, count, index, source_stop) = 4)?>
        .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 1)?
        shape.error_index: index
        @: shape
    shape.name: _bootstrap_shape_text(source, rows, index)
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 13)?
        shape.error_index: index
        @: shape
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 14)?>
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 1)?
            shape.error_index: index
            @: shape
        shape.parameter_starts: shape.parameter_starts & [rows.(index * 6 + 1)]
        shape.parameter_stops: shape.parameter_stops & [rows.(index * 6 + 2)]
        .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 15)?
            shape.error_index: index
            @: shape
        .index+: 1
        .type_start: index
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 22)?
            shape.error_index: index
            @: shape
        .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 1)?
            shape.error_index: index
            @: shape
        .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 23)?
            shape.error_index: index
            @: shape
        shape.type_starts: shape.type_starts & [rows.(type_start * 6 + 1)]
        shape.type_stops: shape.type_stops & [rows.(index * 6 + 2)]
        .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) = 24)?
            .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 14 /\
            _bootstrap_shape_kind(rows, count, index - 1, source_stop) != 24)?
            shape.error_index: index
            @: shape
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 15)?
        shape.error_index: index
        @: shape
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) = 4)?>
        .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 13)?
        shape.error_index: index
        @: shape
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) = 14)?
        shape.error_index: index
        @: shape
    (_bootstrap_shape_kind(rows, count, index, source_stop) != 14)?>
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 1)?
            shape.error_index: index
            @: shape
        shape.field_starts: shape.field_starts & [rows.(index * 6 + 1)]
        shape.field_stops: shape.field_stops & [rows.(index * 6 + 2)]
        .index+: 1
        (_bootstrap_shape_kind(rows, count, index, source_stop) != 15)?
            shape.error_index: index
            @: shape
        .index+: 1
        .expression_start: index
        .delimiters: []
        .depth: 0
        .scanning: true
        scanning?>
            .kind: _bootstrap_shape_kind(rows, count, index, source_stop)
            (kind = 0 \/ kind = 5)?
                shape.error_index: index
                @: shape
            ((kind = 14 \/ kind = 24) /\ depth = 0)?
                .scanning: false
            scanning?
                (kind = 13 \/ kind = 22)?
                    .closing_kind: kind + 1
                    depth = delimiters.length()?
                        .delimiters: delimiters & [closing_kind]
                    depth < delimiters.length()?
                        delimiters.(depth): closing_kind
                    .depth+: 1
                (kind = 14 \/ kind = 23)?
                    depth = 0?
                        shape.error_index: index
                        @: shape
                    kind != delimiters.(depth - 1)?
                        shape.error_index: index
                        @: shape
                    .depth-: 1
                .index+: 1
        (index = expression_start)?
            shape.error_index: index
            @: shape
        shape.expression_starts: shape.expression_starts & [rows.(expression_start * 6 + 1)]
        shape.expression_stops: shape.expression_stops & [rows.((index - 1) * 6 + 2)]
        (_bootstrap_shape_kind(rows, count, index, source_stop) = 24)?
            .index+: 1
    .index+: 1
    (_bootstrap_shape_kind(rows, count, index, source_stop) = 4)?>
        .index+: 1
    shape.error_index: index
    shape.valid: _bootstrap_shape_kind(rows, count, index, source_stop) = 5 /\ index = count - 1
    shape

Location: (file:str, line:num, column:num)
Span: (start:Location, stop:Location)
Token: (kind:str, value:any, location:Location)
TokenStreamEnvelope: (schema:str, version:num, tokens:any)
Diagnostic: (code:str, message:str, file:str, line:num, column:num, span:Span)
ParseCursor: (envelope:TokenStreamEnvelope, tokens:any, index:num, diagnostics:any)
ParseResult: (module:any, diagnostics:any)
TaggedTokenValue: (tag:str, text:str, number:num)
TaggedParserToken: (kind:str, value:TaggedTokenValue, location:Location)
TaggedTokenVector: [TaggedParserToken:4]
TaggedParseCursor: (
    index:num,
    bounded:bit,
    kind:str,
    value_tag:str,
    text:str,
    number:num,
    file:str,
    line:num,
    column:num
)

ModuleNode: (kind:str, body:any, span:Span)
BindNode: (kind:str, target:any, annotation:any, value:any, span:Span)
NumberLiteralNode: (kind:str, value:num, span:Span)
StringLiteralNode: (kind:str, value:str, raw:bit, span:Span)
BoolLiteralNode: (kind:str, value:bit, span:Span)
NullLiteralNode: (kind:str, span:Span)
IdentifierNode: (kind:str, name:str, span:Span)
CallNode: (kind:str, callee:any, args:any, span:Span)
BinaryOpNode: (kind:str, op:str, left:any, right:any, span:Span)
TaggedBinaryOpNode: (
    kind:str,
    op:str,
    left:IdentifierNode,
    right:NumberLiteralNode,
    span:Span
)
TaggedSingleStatementModule: (kind:str, body:[TaggedBinaryOpNode:1], span:Span)
TaggedSingleStatementResult: (module:TaggedSingleStatementModule, diagnostics:any)
TaggedTwoStatementModule: (kind:str, body:[TaggedBinaryOpNode:2], span:Span)
TaggedTwoStatementResult: (module:TaggedTwoStatementModule, diagnostics:any)
TaggedThreeStatementModule: (kind:str, body:[TaggedBinaryOpNode:3], span:Span)
TaggedThreeStatementResult: (module:TaggedThreeStatementModule, diagnostics:any)
TaggedStatementStorage: (source:str, rows:[num], count:int)
TaggedStatementModule: (kind:str, body:TaggedStatementStorage, span:Span)
TaggedStatementResult: (module:TaggedStatementModule, diagnostics:any)
TaggedNestedAddition: (kind:str, values:[num:3])
TaggedDependencyChain: (kind:str, values:[num:4])
TaggedDynamicArithmetic: (kind:str, values:[num:5])
TaggedDynamicAddition: (kind:str, values:[num])
TaggedDynamicMixedArithmetic: (kind:str, operators:[num], values:[num])
TaggedDynamicGroupedArithmetic: (kind:str, tokens:[num], values:[num])
TaggedNumericFunctionCall: (
    function_name:str,
    parameter_name:str,
    factor:num
)
TaggedNumericConditionalCall: (
    function_name:str,
    parameter_name:str
)
TaggedNumericLoopCall: (
    function_name:str,
    parameter_name:str,
    local_name:str,
    entry_value:num
)
TaggedImportOnlyModule: (alias_name:str, module_name:str)
TaggedScalarBindingOutput: (binding_name:str, value:num)
DottedIndexNode: (kind:str, base:any, indices:any, span:Span)
MatchArmNode: (kind:str, condition:any, body:any)
MatchStmtNode: (kind:str, discriminant:any, arms:any, loop:bit, catch:bit)
FunctionDefinitionNode: (kind:str, name:str, params:any, return_type:any, body:any, span:Span)
BlockNode: (kind:str, statements:any, span:Span)
TypeAnnotationNode: (kind:str, name:str, span:Span)

location(file:str, line:num, column:num):
    (file: file, line: line, column: column)

span(start:Location, stop:Location):
    (start: start, stop: stop)

token(kind:str, value:any, location:Location):
    (kind: kind, value: value, location: location)

token_stream_envelope(schema:str, version:num, tokens:any):
    (schema: schema, version: version, tokens: tokens)

diagnostic(code:str, message:str, where:Location, stop:Location):
    (
        code: code,
        message: message,
        file: where.file,
        line: where.line,
        column: where.column,
        span: span(where, stop)
    )

cursor(envelope:TokenStreamEnvelope):
    (envelope: envelope, tokens: envelope.tokens, index: 0, diagnostics: [])

tagged_cursor(first:TaggedParserToken) -> TaggedParseCursor:
    (
        index:0,
        bounded:true,
        kind:first.kind,
        value_tag:first.value.tag,
        text:first.value.text,
        number:first.value.number,
        file:first.location.file,
        line:first.location.line,
        column:first.location.column
    )

tagged_advance(
    cursor:TaggedParseCursor, next:TaggedParserToken
) -> TaggedParseCursor:
    (
        index:cursor.index + 1,
        bounded:cursor.bounded,
        kind:next.kind,
        value_tag:next.value.tag,
        text:next.value.text,
        number:next.value.number,
        file:next.location.file,
        line:next.location.line,
        column:next.location.column
    )

peek(cursor:ParseCursor):
    cursor.tokens.(cursor.index)

peek_kind(cursor:ParseCursor):
    peek(cursor).kind

advance(cursor:ParseCursor):
    (
        envelope: cursor.envelope,
        tokens: cursor.tokens,
        index: cursor.index + 1,
        diagnostics: cursor.diagnostics
    )

at_end(cursor:ParseCursor):
    peek_kind(cursor) = "EOF"

with_diagnostic(cursor:ParseCursor, issue:Diagnostic):
    (
        envelope: cursor.envelope,
        tokens: cursor.tokens,
        index: cursor.index,
        diagnostics: cursor.diagnostics & [issue]
    )

expect(cursor:ParseCursor, kind:str):
    current: peek(cursor)
    current.kind??
        kind => advance(cursor)
        with_diagnostic(
            cursor,
            diagnostic(
                "expected-token",
                "expected token kind",
                current.location,
                current.location
            )
        )

module_node(body:any, span:Span):
    (kind: "module", body: body, span: span)

bind_node(target:any, annotation:any, value:any, span:Span):
    (kind: "bind", target: target, annotation: annotation, value: value, span: span)

number_literal(value:num, span:Span):
    (kind: "number_literal", value: value, span: span)

string_literal(value:str, raw:bit, span:Span):
    (kind: "string_literal", value: value, raw: raw, span: span)

bool_literal(value:bit, span:Span):
    (kind: "bool_literal", value: value, span: span)

null_literal(span:Span):
    (kind: "null_literal", span: span)

identifier_node(name:str, span:Span):
    (kind: "identifier", name: name, span: span)

call_node(callee:any, args:any, span:Span):
    (kind: "call", callee: callee, args: args, span: span)

binary_op_node(op:str, left:any, right:any, span:Span):
    (kind: "binary_op", op: op, left: left, right: right, span: span)

dotted_index_node(base:any, indices:any, span:Span):
    (kind: "dotted_index", base: base, indices: indices, span: span)

match_arm_node(condition:any, body:any):
    (kind: "match_arm", condition: condition, body: body)

match_stmt_node(discriminant:any, arms:any):
    (kind: "match_stmt", discriminant: discriminant, arms: arms, loop: false, catch: false)

function_definition(name:str, params:any, return_type:any, body:any, span:Span):
    (
        kind: "function_definition",
        name: name,
        params: params,
        return_type: return_type,
        body: body,
        span: span
    )

block_node(statements:any, span:Span):
    (kind: "block", statements: statements, span: span)

type_annotation(name:str, span:Span):
    (kind: "type_annotation", name: name, span: span)

validate_location_shape(value:any):
    value.file /\ value.line /\ value.column

validate_token_shape(value:any):
    value.kind /\ value.location /\ validate_location_shape(value.location)

validate_envelope_shape(envelope:TokenStreamEnvelope):
    envelope.schema = TOKEN_STREAM_SCHEMA /\ envelope.version = TOKEN_STREAM_VERSION /\ envelope.tokens

validate_eof(cursor:ParseCursor):
    last: cursor.tokens.(len(cursor.tokens) - 1)
    last.kind = "EOF"

unsupported_syntax(cursor:ParseCursor, feature:str):
    current: peek(cursor)
    with_diagnostic(
        cursor,
        diagnostic(
            "unsupported-syntax",
            feature,
            current.location,
            current.location
        )
    )

parse_literal(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "NUMBER" => number_literal(current.value, span(current.location, current.location))
        "STRING" => string_literal(current.value, false, span(current.location, current.location))
        "STRING_RAW" => string_literal(current.value, true, span(current.location, current.location))
        "TRUE" => bool_literal(true, span(current.location, current.location))
        "FALSE" => bool_literal(false, span(current.location, current.location))
        "NULL" => null_literal(span(current.location, current.location))
        unsupported_syntax(cursor, "expected literal")

parse_identifier(cursor:ParseCursor):
    current: peek(cursor)
    current.kind??
        "IDENT" => identifier_node(current.value, span(current.location, current.location))
        unsupported_syntax(cursor, "expected identifier")

parse_tagged_identifier(current:TaggedParserToken) -> IdentifierNode:
    identifier_node(
        current.value.text,
        span(current.location, current.location)
    )

parse_tagged_number(current:TaggedParserToken) -> NumberLiteralNode:
    number_literal(
        current.value.number,
        span(current.location, current.location)
    )

parse_tagged_cursor_identifier(cursor:TaggedParseCursor) -> IdentifierNode:
    where: location(cursor.file, cursor.line, cursor.column)
    identifier_node(cursor.text, span(where, where))

parse_tagged_cursor_number(cursor:TaggedParseCursor) -> NumberLiteralNode:
    where: location(cursor.file, cursor.line, cursor.column)
    number_literal(cursor.number, span(where, where))

tagged_at_end(cursor:TaggedParseCursor) -> bit:
    cursor.kind = "EOF"

tagged_binary_operator(cursor:TaggedParseCursor) -> str:
    cursor.kind??
        "PLUS" => "+"
        cursor.kind

parse_tagged_binary_expression(
    left:TaggedParseCursor,
    operator:TaggedParseCursor,
    right:TaggedParseCursor
) -> TaggedBinaryOpNode:
    start: location(left.file, left.line, left.column)
    stop: location(right.file, right.line, right.column)
    binary_op_node(
        tagged_binary_operator(operator),
        parse_tagged_cursor_identifier(left),
        parse_tagged_cursor_number(right),
        span(start, stop)
    )

parse_tagged_binary_result(
    left:TaggedParseCursor,
    operator:TaggedParseCursor,
    right:TaggedParseCursor
) -> TaggedSingleStatementResult:
    start: location(left.file, left.line, left.column)
    stop: location(right.file, right.line, right.column)
    expression: parse_tagged_binary_expression(left, operator, right)
    parsed_module: module_node([expression], span(start, stop))
    (module:parsed_module, diagnostics:[])

append_tagged_binary_statement(
    result:TaggedSingleStatementResult,
    left:TaggedParseCursor,
    operator:TaggedParseCursor,
    right:TaggedParseCursor
) -> TaggedTwoStatementResult:
    stop: location(right.file, right.line, right.column)
    expression: parse_tagged_binary_expression(left, operator, right)
    parsed_module: (
        kind:"module",
        body:result.module.body & [expression],
        span:span(result.module.span.start, stop)
    )
    (module:parsed_module, diagnostics:result.diagnostics)

parse_tagged_two_statement_result(
    first_left:TaggedParseCursor,
    first_operator:TaggedParseCursor,
    first_right:TaggedParseCursor,
    second_left:TaggedParseCursor,
    second_operator:TaggedParseCursor,
    second_right:TaggedParseCursor
) -> TaggedTwoStatementResult:
    first_result: parse_tagged_binary_result(
        first_left, first_operator, first_right
    )
    append_tagged_binary_statement(
        first_result, second_left, second_operator, second_right
    )

append_tagged_third_statement(
    result:TaggedTwoStatementResult,
    left:TaggedParseCursor,
    operator:TaggedParseCursor,
    right:TaggedParseCursor
) -> TaggedThreeStatementResult:
    stop: location(right.file, right.line, right.column)
    expression: parse_tagged_binary_expression(left, operator, right)
    parsed_module: (
        kind:"module",
        body:result.module.body & [expression],
        span:span(result.module.span.start, stop)
    )
    (module:parsed_module, diagnostics:result.diagnostics)

tagged_statement_storage(source:str) -> TaggedStatementStorage:
    [num] rows: []
    (source:source, rows:rows, count:0)

append_tagged_statement(
    storage:TaggedStatementStorage,
    identifier_start:num,
    identifier_stop:num,
    operator_code:num,
    value:num,
    left_line:num,
    left_column:num,
    right_line:num,
    right_column:num
) -> TaggedStatementStorage:
    [num] row: [
        identifier_start,
        identifier_stop,
        operator_code,
        value,
        left_line,
        left_column,
        right_line,
        right_column
    ]
    (
        source:storage.source,
        rows:storage.rows & row,
        count:storage.count + 1
    )

tagged_statement_operator(operator_code:num) -> str:
    operator_code??
        1 => "+"
        3 => "-"
        4 => "*"
        5 => "/"
        6 => "%"
        7 => "^"
        8 => "//"
        "unknown"

tagged_statement_operator_code(token_kind:num) -> num:
    token_kind??
        2 => 1
        6 => 2
        8 => 3
        7 => 4
        9 => 5
        10 => 6
        11 => 7
        12 => 8
        0

tagged_statement_node(
    storage:TaggedStatementStorage, index:int
) -> TaggedBinaryOpNode:
    offset: index * 8
    left_where: location(
        "<self-hosted>", storage.rows.(offset + 4), storage.rows.(offset + 5)
    )
    right_where: location(
        "<self-hosted>", storage.rows.(offset + 6), storage.rows.(offset + 7)
    )
    binary_op_node(
        tagged_statement_operator(storage.rows.(offset + 2)),
        identifier_node(
            vkf_utf8_slice(
                storage.source,
                storage.rows.(offset),
                storage.rows.(offset + 1)
            ),
            span(left_where, left_where)
        ),
        number_literal(
            storage.rows.(offset + 3), span(right_where, right_where)
        ),
        span(left_where, right_where)
    )

parse_tagged_token_tape(
    source:str, token_rows:[num], token_count:int
) -> TaggedStatementResult:
    storage: tagged_statement_storage(source)
    index: 0
    first_where: location(
        "<self-hosted>", token_rows.(4), token_rows.(5)
    )
    last_where: first_where
    (index < token_count /\ token_rows.(index * 6) != 5)?>
        left_offset: index * 6
        operator_offset: (index + 1) * 6
        right_offset: (index + 2) * 6
        .storage: append_tagged_statement(
            storage,
            token_rows.(left_offset + 1),
            token_rows.(left_offset + 2),
            tagged_statement_operator_code(token_rows.(operator_offset)),
            token_rows.(right_offset + 3),
            token_rows.(left_offset + 4),
            token_rows.(left_offset + 5),
            token_rows.(right_offset + 4),
            token_rows.(right_offset + 5)
        )
        .last_where: location(
            "<self-hosted>",
            token_rows.(right_offset + 4),
            token_rows.(right_offset + 5)
        )
        .index: index + 4
    parsed_module: (
        kind:"module",
        body:storage,
        span:span(first_where, last_where)
    )
    (module:parsed_module, diagnostics:[])

parse_tagged_numeric_function_call(
    source:str, token_rows:[num], token_count:int
) -> TaggedNumericFunctionCall:
    (token_count = 26)?! "numeric function source has an unexpected token count"
    (token_rows.(0) = 15 /\ token_rows.(6) = 16 /\ token_rows.(12) = 1 /\
        token_rows.(18) = 4 /\ token_rows.(24) = 1 /\ token_rows.(30) = 13 /\
        token_rows.(36) = 1 /\ token_rows.(42) = 15 /\ token_rows.(48) = 1 /\
        token_rows.(54) = 14 /\ token_rows.(60) = 15 /\ token_rows.(66) = 4 /\
        token_rows.(72) = 1 /\ token_rows.(78) = 7 /\ token_rows.(84) = 3 /\
        token_rows.(90) = 4 /\ token_rows.(96) = 15 /\ token_rows.(102) = 15 /\
        token_rows.(108) = 1 /\ token_rows.(114) = 13 /\ token_rows.(120) = 1 /\
        token_rows.(126) = 13 /\ token_rows.(132) = 14 /\ token_rows.(138) = 14 /\
        token_rows.(144) = 4 /\ token_rows.(150) = 5)?! "numeric function source does not match declaration-call grammar"
    str import_name: vkf_utf8_slice(source, token_rows.(13), token_rows.(14))
    str function_name: vkf_utf8_slice(source, token_rows.(25), token_rows.(26))
    str parameter_name: vkf_utf8_slice(source, token_rows.(37), token_rows.(38))
    str parameter_type: vkf_utf8_slice(source, token_rows.(49), token_rows.(50))
    str body_name: vkf_utf8_slice(source, token_rows.(73), token_rows.(74))
    str call_name: vkf_utf8_slice(source, token_rows.(109), token_rows.(110))
    str host_name: vkf_utf8_slice(source, token_rows.(121), token_rows.(122))
    (import_name = "system")?! "numeric function source requires system import"
    (parameter_type = "num")?! "numeric function parameter must be num"
    (body_name = parameter_name)?! "numeric function body must load its parameter"
    (call_name = function_name)?! "numeric function call target does not match declaration"
    (host_name = "cpu_count")?! "numeric function argument must be cpu_count()"
    (
        function_name:function_name,
        parameter_name:parameter_name,
        factor:token_rows.(87)
    )

parse_tagged_numeric_positive_conditional(
    source:str, token_rows:[num], token_count:int
) -> TaggedNumericConditionalCall:
    (token_count = 41)?! "numeric conditional source has an unexpected token count"
    (token_rows.(0) = 1 /\ token_rows.(6) = 15 /\ token_rows.(12) = 16 /\
        token_rows.(18) = 1 /\ token_rows.(24) = 4 /\ token_rows.(30) = 1 /\
