    final_row: expression_stop * 6
    eof_row: (token_count - 1) * 6
    (token_rows.(final_row) = 4 /\ token_rows.(eof_row) = 5)?! "printed dynamic grouped arithmetic source suffix changed"
    [num] tokens: []
    [num] values: []
    token_index: 6
    parenthesis_depth: 0
    identifier_count: 0
    expecting_operand: true
    (token_index < expression_stop)?>
        row: token_index * 6
        token_kind: token_rows.(row)
        (token_kind = 1 \/ token_kind = 2 \/ token_kind = 3 \/
            token_kind = 7 \/ token_kind = 9 \/ token_kind = 10 \/
            token_kind = 11 \/ token_kind = 12 \/ token_kind = 13 \/
            token_kind = 14 \/ token_kind = 20)?! "printed dynamic grouped arithmetic has an unsupported token"
        (token_kind = 1 \/ token_kind = 3)?
            expecting_operand?! "printed dynamic grouped arithmetic has adjacent operands"
            token_kind = 1?
                (vkf_utf8_slice(source, token_rows.(1), token_rows.(2)) =
                    vkf_utf8_slice(source, token_rows.(row + 1), token_rows.(row + 2)))?! "printed dynamic grouped arithmetic must load its binding"
                .identifier_count+: 1
                .values: values & [token_rows.(15)]
            token_kind = 3?
                .values: values & [token_rows.(row + 3)]
            .tokens: tokens & [token_kind]
            .expecting_operand: false
        token_kind = 13?
            expecting_operand?! "printed dynamic grouped arithmetic has a misplaced opening parenthesis"
            .tokens: tokens & [token_kind]
            .values: values & [0]
            .parenthesis_depth+: 1
        token_kind = 14?
            (~expecting_operand /\ parenthesis_depth > 0)?! "printed dynamic grouped arithmetic has a misplaced closing parenthesis"
            .tokens: tokens & [token_kind]
            .values: values & [0]
            .parenthesis_depth-: 1
        (token_kind = 20 /\ expecting_operand)?
            .tokens: tokens & [21]
            .values: values & [0]
        (token_kind = 2 \/ token_kind = 7 \/ token_kind = 9 \/
            token_kind = 10 \/ token_kind = 11 \/ token_kind = 12 \/
            (token_kind = 20 /\ ~expecting_operand))?
            (~expecting_operand)?! "printed dynamic grouped arithmetic has a misplaced operator"
            .tokens: tokens & [token_kind]
            .values: values & [0]
            .expecting_operand: true
        .token_index+: 1
    (~expecting_operand /\ parenthesis_depth = 0)?! "printed dynamic grouped arithmetic has an incomplete expression"
    (identifier_count = 1)?! "printed dynamic grouped arithmetic must load one binding"
    (kind:"dynamic_grouped_arithmetic", tokens:tokens, values:values)

parse_tagged_binding_nested_addition(
    source:str, token_rows:[num], token_count:int
) -> TaggedNestedAddition:
    (token_count = 11)?! "nested addition tracer expects binding, expression, and EOF"
    (token_rows.(0) = 1 /\ token_rows.(6) = 6 /\
        token_rows.(12) = 3 /\ token_rows.(18) = 4 /\
        token_rows.(24) = 1 /\ token_rows.(30) = 2 /\
        token_rows.(36) = 3 /\ token_rows.(42) = 2 /\
        token_rows.(48) = 3 /\ token_rows.(54) = 4 /\
        token_rows.(60) = 5)?! "nested addition tracer token shape mismatch"
    (vkf_utf8_slice(source, token_rows.(1), token_rows.(2)) =
        vkf_utf8_slice(source, token_rows.(25), token_rows.(26)))?! "nested addition expression does not match its binding"
    [num:3] values: [token_rows.(15), token_rows.(39), token_rows.(51)]
    (kind:"nested_addition", values:values)

