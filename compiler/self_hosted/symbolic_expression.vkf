# Host-runtime-free symbolic expression kernel.
#
# Parsing, diagnostics, canonical presentation, workspace ownership,
# classification, coordinate contexts, and evaluation all live here in VKF.
# Browser code transports tagged values only.

SymbolicLocation: (offset:num, line:num, column:num)
SymbolicToken: (kind:str, text:str, value:any, location:SymbolicLocation)
SymbolicCursor: (source:str, offset:num, line:num, column:num)
SymbolicDiagnostic: (code:str, message:str, location:SymbolicLocation)
SymbolicLexResult: (tokens:any, diagnostics:any)
SymbolicParseState: (tokens:any, index:num, diagnostics:any)
SymbolicParseResult: (ast:any, next:SymbolicParseState)
SymbolicProgram: (
    ast:any,
    variants:any,
    diagnostics:any,
    latex:str,
    variables:any,
    classification:str,
    valueKind:str,
    context:any,
    clip:any
)
SymbolicDraft: (
    latex:str,
    complete:bool,
    recoverable:bool,
    diagnostics:any
)
SymbolicWorkspace: any
SymbolicEvaluation: (x:num, y:num, z:num, t:num, context:any)

symbolic_location(offset:num, line:num, column:num):
    (offset: offset, line: line, column: column)

symbolic_token(kind:str, text:str, value:any, location:SymbolicLocation):
    (kind: kind, text: text, value: value, location: location)

symbolic_cursor(source:str):
    (source: source, offset: 0, line: 1, column: 1)

symbolic_diagnostic(code:str, message:str, location:SymbolicLocation):
    (code: code, message: message, location: location)

symbolic_lex_result(tokens:any, diagnostics:any):
    (tokens: tokens, diagnostics: diagnostics)

symbolic_parse_state(tokens:any, index:num, diagnostics:any):
    (tokens: tokens, index: index, diagnostics: diagnostics)

symbolic_parse_result(ast:any, next:SymbolicParseState):
    (ast: ast, next: next)

symbolic_number(value:num, text:str, location:SymbolicLocation):
    (kind: "number", value: value, text: text, location: location)

symbolic_variable(name:str, location:SymbolicLocation):
    (kind: "variable", name: name, location: location)

symbolic_unary(op:str, operand:any, location:SymbolicLocation):
    (kind: "unary", op: op, operand: operand, location: location)

symbolic_binary(op:str, left:any, right:any, location:SymbolicLocation):
    (kind: "binary", op: op, left: left, right: right, location: location)

symbolic_implicit_multiplication(left:any, right:any, location:SymbolicLocation):
    (
        kind: "binary",
        op: "*",
        left: left,
        right: right,
        implicit: true,
        location: location
    )

symbolic_call(name:str, args:any, location:SymbolicLocation):
    (kind: "call", name: name, args: args, location: location)

symbolic_tuple(items:any, location:SymbolicLocation):
    (kind: "tuple", items: items, location: location)

symbolic_multiset(items:any, location:SymbolicLocation):
    (kind: "multiset", items: items, location: location)

symbolic_definition(name:str, parameters:any, value:any, location:SymbolicLocation):
    (
        kind: "definition",
        name: name,
        parameters: parameters,
        value: value,
        location: location
    )

symbolic_error_node(location:SymbolicLocation):
    (kind: "error", location: location)

symbolic_complex(real:num, imaginary:num):
    (kind: "complex", real: real, imaginary: imaginary)

symbolic_vector(x:num, y:num):
    (kind: "vector", x: x, y: y)

symbolic_vector_node(x:any, y:any, location:SymbolicLocation):
    (kind: "vector", x: x, y: y, location: location)

symbolic_range(start:any, end:any, location:SymbolicLocation):
    (kind: "range", start: start, end: end, location: location)

symbolic_global_context():
    (
        kind: "global",
        dimension: 2,
        originX: 0,
        originY: 0,
        basisXX: 1,
        basisXY: 0,
        basisYX: 0,
        basisYY: 1
    )

symbolic_affine_context(
    kind:str,
    originX:num,
    originY:num,
    basisXX:num,
    basisXY:num,
    basisYX:num,
    basisYY:num
):
    (
        kind: kind,
        originX: originX,
        originY: originY,
        basisXX: basisXX,
        basisXY: basisXY,
        basisYX: basisYX,
        basisYY: basisYY
    )

symbolic_no_clip():
    (kind: "none", vertices: vkf_list_empty())

symbolic_face_clip(vertices:any):
    (kind: "face", vertices: vertices)

symbolic_context_dimension(context:any):
    context.dimension = null?
        @: 2
    context.dimension

symbolic_workspace():
    vkf_list_empty()

symbolic_pack_plot_vertices(vertices:any, revision:num):
    packed: vkf_plot_pack(vertices, revision)
    packed = null?
        @: null
    symbolic_plot_metadata(packed)

symbolic_plot_builder(capacity:num, revision:num):
    vkf_plot_builder_create(capacity, revision)

symbolic_plot_builder_push(builder:any, vertex:any):
    vkf_plot_builder_push(builder, vertex)

symbolic_plot_builder_metadata(builder:any):
    packed: vkf_plot_builder_finish(builder)
    packed = null?
        @: null
    symbolic_plot_metadata(packed)

symbolic_plot_metadata(packed:any):
    (
        pointer: packed.(0),
        count: packed.(1),
        stride: packed.(2),
        revision: packed.(3)
    )

symbolic_cursor_location(cursor:SymbolicCursor):
    symbolic_location(cursor.offset, cursor.line, cursor.column)

symbolic_cursor_eof(cursor:SymbolicCursor):
    vkf_string_eof(cursor.source, cursor.offset)

symbolic_cursor_peek(cursor:SymbolicCursor):
    vkf_string_peek_scalar(cursor.source, cursor.offset)

symbolic_cursor_advance(cursor:SymbolicCursor):
    next_offset: vkf_utf8_advance(cursor.source, cursor.offset)
    ch: symbolic_cursor_peek(cursor)
    ch = 10?
        @: symbolic_location_cursor(
            cursor.source,
            next_offset,
            cursor.line + 1,
            1
        )
    symbolic_location_cursor(
        cursor.source,
        next_offset,
        cursor.line,
        cursor.column + 1
    )

symbolic_location_cursor(source:str, offset:num, line:num, column:num):
    (source: source, offset: offset, line: line, column: column)

symbolic_is_digit(ch:num):
    ch >= 48 /\ ch <= 57

symbolic_is_identifier_start(ch:num):
    (ch >= 97 /\ ch <= 122) \/ (ch >= 65 /\ ch <= 90) \/ ch = 95

symbolic_is_space(ch:num):
    ch = 32 \/ ch = 9 \/ ch = 10 \/ ch = 13

symbolic_scan_number(cursor:SymbolicCursor):
    scanned_end: vkf_decimal_scan_end(cursor.source, cursor.offset)
    end: symbolic_decimal_end_before_range(cursor.source, scanned_end)
    text: vkf_utf8_slice(cursor.source, cursor.offset, end)
    (
        text: text,
        value: vkf_decimal_parse(text),
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_decimal_end_before_range(source:str, end:num):
    end <= 0?
        @: end
    vkf_string_eof(source, end)?
        @: end
    previous: vkf_string_peek_scalar(source, end - 1)
    current: vkf_string_peek_scalar(source, end)
    previous = 46 /\ current = 46?
        @: end - 1
    end

symbolic_scan_identifier(cursor:SymbolicCursor):
    end: vkf_identifier_scan_end(cursor.source, cursor.offset)
    (
        text: vkf_utf8_slice(cursor.source, cursor.offset, end),
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_scan_operator(cursor:SymbolicCursor):
    width: vkf_operator_width(cursor.source, cursor.offset)
    end: cursor.offset + width
    text: vkf_utf8_slice(cursor.source, cursor.offset, end)
    (
        kind: vkf_operator_kind(text),
        text: text,
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_cursor_at(cursor:SymbolicCursor, offset:num):
    symbolic_location_cursor(
        cursor.source,
        offset,
        cursor.line,
        cursor.column + offset - cursor.offset
    )

symbolic_tokenize_step(cursor:SymbolicCursor, tokens:any, diagnostics:any):
    symbolic_cursor_eof(cursor)?
        eof_token: symbolic_token(
            "EOF",
            "",
            null,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_lex_result(tokens & [eof_token], diagnostics)

    ch: symbolic_cursor_peek(cursor)
    symbolic_is_space(ch)?
        @: symbolic_tokenize_step(
            symbolic_cursor_advance(cursor),
            tokens,
            diagnostics
        )

    symbolic_is_digit(ch)?
        number_scan: symbolic_scan_number(cursor)
        number_token: symbolic_token(
            "NUMBER",
            number_scan.text,
            number_scan.value,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            number_scan.next,
            tokens & [number_token],
            diagnostics
        )

    symbolic_is_identifier_start(ch)?
        identifier_scan: symbolic_scan_identifier(cursor)
        identifier_token: symbolic_token(
            "IDENT",
            identifier_scan.text,
            identifier_scan.text,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            identifier_scan.next,
            tokens & [identifier_token],
            diagnostics
        )

    operator_scan: symbolic_scan_operator(cursor)
    operator_scan.kind = "INVALID"?
        issue: symbolic_diagnostic(
            "unexpected-character",
            "expected a mathematical expression token",
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            symbolic_cursor_advance(cursor),
            tokens,
            diagnostics & [issue]
        )

    operator_token: symbolic_token(
        operator_scan.kind,
        operator_scan.text,
        operator_scan.text,
        symbolic_cursor_location(cursor)
    )
    @: symbolic_tokenize_step(
        operator_scan.next,
        tokens & [operator_token],
        diagnostics
    )

symbolic_tokenize(source:str):
    symbolic_tokenize_step(symbolic_cursor(source), [], [])

symbolic_state_current(state:SymbolicParseState):
    state.tokens.(state.index)

symbolic_state_advance(state:SymbolicParseState):
    symbolic_parse_state(state.tokens, state.index + 1, state.diagnostics)

symbolic_state_with_diagnostic(
    state:SymbolicParseState,
    issue:SymbolicDiagnostic
):
    symbolic_parse_state(
        state.tokens,
        state.index,
        state.diagnostics & [issue]
    )

symbolic_parse_primary(state:SymbolicParseState):
    current: symbolic_state_current(state)
    current.kind??
        "NUMBER" => symbolic_parse_result(
            symbolic_number(current.value, current.text, current.location),
            symbolic_state_advance(state)
        )
        "IDENT" => symbolic_parse_identifier(state, current)
        "LPAREN" => symbolic_parse_parenthesized(state)
        "LBRACKET" => symbolic_parse_vector(state)
        "LBRACE" => symbolic_parse_set(state)
        symbolic_parse_primary_error(state, current)

symbolic_parse_vector(state:SymbolicParseState):
    open: symbolic_state_current(state)
    first: symbolic_parse_relation(symbolic_state_advance(state))
    separator: symbolic_state_current(first.next)
    separator.kind = "COMMA"?
        @: symbolic_parse_vector_second(open, first)
    symbolic_parse_collection_error(first, separator, "expected comma in vector")

symbolic_parse_vector_second(open:SymbolicToken, first:SymbolicParseResult):
    second: symbolic_parse_relation(symbolic_state_advance(first.next))
    close: symbolic_state_current(second.next)
    close.kind = "RBRACKET"?
        @: symbolic_parse_result(
            symbolic_vector_node(first.ast, second.ast, open.location),
            symbolic_state_advance(second.next)
        )
    symbolic_parse_collection_error(second, close, "expected closing ]")

symbolic_parse_identifier(state:SymbolicParseState, identifier:SymbolicToken):
    next: symbolic_state_advance(state)
    current: symbolic_state_current(next)
    current.kind??
        "LPAREN" => symbolic_parse_call(identifier, next)
        symbolic_parse_result(
            symbolic_variable(identifier.text, identifier.location),
            next
        )

symbolic_parse_call(identifier:SymbolicToken, state:SymbolicParseState):
    symbolic_parse_call_items(
        identifier,
        symbolic_state_advance(state),
        vkf_list_empty()
    )

symbolic_parse_call_items(
    identifier:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_call(identifier.text, items, identifier.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_call_item(identifier, state, items)

symbolic_parse_call_item(
    identifier:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_call_items(
            identifier,
            symbolic_state_advance(item.next),
            next_items
        )
        "RPAREN" => symbolic_parse_result(
            symbolic_call(identifier.text, next_items, identifier.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or )")

symbolic_parse_primary_error(
    state:SymbolicParseState,
    current:SymbolicToken
):
    issue: symbolic_diagnostic(
        "expected-expression",
        "expected number, variable, or parenthesized expression",
        current.location
    )
    symbolic_parse_result(
        symbolic_error_node(current.location),
        symbolic_state_with_diagnostic(state, issue)
    )

symbolic_parse_parenthesized(state:SymbolicParseState):
    open: symbolic_state_current(state)
    next: symbolic_state_advance(state)
    current: symbolic_state_current(next)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(vkf_list_empty(), open.location),
            symbolic_state_advance(next)
        )
        symbolic_parse_parenthesized_inner(open, next)

symbolic_parse_parenthesized_inner(
    open:SymbolicToken,
    state:SymbolicParseState
):
    inner: symbolic_parse_relation(state)
    close: symbolic_state_current(inner.next)
    close.kind??
        "RPAREN" => symbolic_parse_result(
            inner.ast,
            symbolic_state_advance(inner.next)
        )
        "COMMA" => symbolic_parse_tuple_items(
            open,
            symbolic_state_advance(inner.next),
            [inner.ast]
        )
        symbolic_parse_parenthesized_error(inner, open)

symbolic_parse_tuple_items(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(items, open.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_tuple_item(open, state, items)

symbolic_parse_tuple_item(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_tuple_items(
            open,
            symbolic_state_advance(item.next),
            next_items
        )
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(next_items, open.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or )")

symbolic_parse_set(state:SymbolicParseState):
    open: symbolic_state_current(state)
    symbolic_parse_set_items(
        open,
        symbolic_state_advance(state),
        vkf_list_empty()
    )

symbolic_parse_set_items(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RBRACE" => symbolic_parse_result(
            symbolic_multiset(items, open.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_set_item(open, state, items)

symbolic_parse_set_item(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_set_items(
            open,
            symbolic_state_advance(item.next),
            next_items
        )
        "RBRACE" => symbolic_parse_result(
            symbolic_multiset(next_items, open.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or }")

symbolic_parse_collection_error(
    parsed:SymbolicParseResult,
    current:SymbolicToken,
    message:str
):
    issue: symbolic_diagnostic(
        "expected-collection-separator",
        message,
        current.location
    )
    symbolic_parse_result(
        parsed.ast,
        symbolic_state_with_diagnostic(parsed.next, issue)
    )

symbolic_parse_parenthesized_error(
    inner:SymbolicParseResult,
    open:SymbolicToken
):
    issue: symbolic_diagnostic(
        "expected-close-parenthesis",
        "expected closing parenthesis",
        open.location
    )
    symbolic_parse_result(
        inner.ast,
        symbolic_state_with_diagnostic(inner.next, issue)
    )

symbolic_parse_unary(state:SymbolicParseState):
    current: symbolic_state_current(state)
    current.kind??
        "PLUS" => symbolic_parse_unary(symbolic_state_advance(state))
        "MINUS" => symbolic_parse_unary_operand(state)
        symbolic_parse_primary(state)

symbolic_parse_unary_operand(state:SymbolicParseState):
    operator: symbolic_state_current(state)
    operand: symbolic_parse_unary(symbolic_state_advance(state))
    symbolic_parse_result(
        symbolic_unary("-", operand.ast, operator.location),
        operand.next
    )

symbolic_parse_power(state:SymbolicParseState):
    left: symbolic_parse_unary(state)
    current: symbolic_state_current(left.next)
    current.kind??
        "CARET" => symbolic_parse_power_right(left, current)
        left

symbolic_parse_power_right(left:SymbolicParseResult, operator:SymbolicToken):
    right: symbolic_parse_power(symbolic_state_advance(left.next))
    symbolic_parse_result(
        symbolic_binary("^", left.ast, right.ast, operator.location),
        right.next
    )

symbolic_parse_multiplicative(state:SymbolicParseState):
    left: symbolic_parse_power(state)
    symbolic_parse_multiplicative_tail(left)

symbolic_parse_multiplicative_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind??
        "STAR" => symbolic_parse_multiplicative_right(left, current, "*")
        "SLASH" => symbolic_parse_multiplicative_right(left, current, "/")
        "IDENT" => symbolic_parse_implicit_multiplicative(left, current)
        left

symbolic_parse_implicit_multiplicative(
    left:SymbolicParseResult,
    rightToken:SymbolicToken
):
    right: symbolic_parse_power(left.next)
    combined: symbolic_parse_result(
        symbolic_implicit_multiplication(
            left.ast,
            right.ast,
            rightToken.location
        ),
        right.next
    )
    symbolic_parse_multiplicative_tail(combined)

symbolic_parse_multiplicative_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_power(symbolic_state_advance(left.next))
    combined: symbolic_parse_result(
        symbolic_binary(op, left.ast, right.ast, operator.location),
        right.next
    )
    symbolic_parse_multiplicative_tail(combined)

symbolic_parse_additive(state:SymbolicParseState):
    left: symbolic_parse_multiplicative(state)
    symbolic_parse_additive_tail(left)

symbolic_parse_additive_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind??
        "PLUS" => symbolic_parse_additive_right(left, current, "+")
        "MINUS" => symbolic_parse_additive_right(left, current, "-")
        left

symbolic_parse_additive_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_multiplicative(symbolic_state_advance(left.next))
    combined: symbolic_parse_result(
        symbolic_binary(op, left.ast, right.ast, operator.location),
        right.next
    )
    symbolic_parse_additive_tail(combined)

symbolic_parse_range(state:SymbolicParseState):
    left: symbolic_parse_additive(state)
    current: symbolic_state_current(left.next)
    current.kind = "RANGE"?
        @: symbolic_parse_range_right(left, current)
    left

symbolic_parse_range_right(left:SymbolicParseResult, operator:SymbolicToken):
    right: symbolic_parse_additive(symbolic_state_advance(left.next))
    symbolic_parse_result(
        symbolic_range(left.ast, right.ast, operator.location),
        right.next
    )

symbolic_parse_relation(state:SymbolicParseState):
    left: symbolic_parse_range(state)
    current: symbolic_state_current(left.next)
    current.kind??
        "EQ" => symbolic_parse_relation_right(left, current, "=")
        "LT" => symbolic_parse_relation_right(left, current, "<")
        "GT" => symbolic_parse_relation_right(left, current, ">")
        "LE" => symbolic_parse_relation_right(left, current, "<=")
        "GE" => symbolic_parse_relation_right(left, current, ">=")
        left

symbolic_parse_relation_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_range(symbolic_state_advance(left.next))
    symbolic_parse_result(
        symbolic_relation_node(left.ast, op, right.ast, operator.location),
        right.next
    )

symbolic_relation_node(left:any, op:str, right:any, location:SymbolicLocation):
    op = "="?
        left.kind??
            "call" => symbolic_definition(
                left.name,
                left.args,
                right,
                location
            )
            symbolic_binary(op, left, right, location)
    symbolic_binary(op, left, right, location)

symbolic_parse_tokens(lexed:SymbolicLexResult):
    state: symbolic_parse_state(lexed.tokens, 0, lexed.diagnostics)
    parsed: symbolic_parse_relation(state)
    current: symbolic_state_current(parsed.next)
    current.kind??
        "EOF" => parsed
        symbolic_parse_trailing_error(parsed, current)

symbolic_parse_trailing_error(
    parsed:SymbolicParseResult,
    current:SymbolicToken
):
    issue: symbolic_diagnostic(
        "unexpected-token",
        "expected end of expression",
        current.location
    )
    symbolic_parse_result(
        parsed.ast,
        symbolic_state_with_diagnostic(parsed.next, issue)
    )

symbolic_latex(node:any):
    symbolic_latex_at(node, 0)

symbolic_latex_at(node:any, parentPrecedence:num):
    own_precedence: symbolic_precedence(node)
    rendered: symbolic_latex_unwrapped(node, own_precedence)
    own_precedence < parentPrecedence?
        @: "\\left(" & rendered & "\\right)"
    rendered

symbolic_precedence(node:any):
    node.kind??
        "definition" => 1
        "binary" => symbolic_binary_precedence(node.op)
        "unary" => 5
        6

symbolic_binary_precedence(op:str):
    op??
        "=" => 1
        "<" => 1
        ">" => 1
        "<=" => 1
        ">=" => 1
        "+" => 2
        "-" => 2
        "*" => 3
        "/" => 3
        "^" => 4
        0

symbolic_latex_unwrapped(node:any, precedence:num):
    node.kind??
        "number" => node.text
        "variable" => symbolic_variable_latex(node.name)
        "unary" => "-" & symbolic_latex_at(node.operand, precedence)
        "binary" => symbolic_binary_latex(node, precedence)
        "call" => symbolic_call_latex(node)
        "vector" => "\\begin{pmatrix}" & symbolic_latex(node.x) & "\\\\" & symbolic_latex(node.y) & "\\end{pmatrix}"
        "range" => symbolic_latex(node.start) & ".." & symbolic_latex(node.end)
        "tuple" => "\\left(" & symbolic_latex_items(node.items, 0) & "\\right)"
        "multiset" => "\\left\\{" & symbolic_latex_items(node.items, 0) & "\\right\\}"
        "definition" => symbolic_definition_latex(node)
        "\\operatorname{error}"

symbolic_latex_items(items:any, index:num):
    index >= vkf_list_length(items)?
        @: ""
    tail: symbolic_latex_items(items, index + 1)
    tail = ""?
        @: symbolic_latex(items.(index))
    symbolic_latex(items.(index)) & ", " & tail

symbolic_call_latex(node:any):
    node.name??
        "sqrt" => "\\sqrt{" & symbolic_latex(node.args.(0)) & "}"
        "abs" => "\\left|" & symbolic_latex(node.args.(0)) & "\\right|"
        "vector" => "\\begin{pmatrix}" & symbolic_latex(node.args.(0)) & "\\\\" & symbolic_latex(node.args.(1)) & "\\end{pmatrix}"
        "complex" => symbolic_latex(node.args.(0)) & " + " & symbolic_latex(node.args.(1)) & "\\mathrm{i}"
        symbolic_function_latex(node.name) & "\\left(" & symbolic_latex_items(node.args, 0) & "\\right)"

symbolic_function_latex(name:str):
    name??
        "sin" => "\\sin"
        "cos" => "\\cos"
        "tan" => "\\tan"
        "atan2" => "\\operatorname{atan2}"
        "\\operatorname{" & name & "}"

symbolic_definition_latex(node:any):
    symbolic_function_latex(node.name) & "\\left(" & symbolic_latex_items(node.parameters, 0) & "\\right) = " & symbolic_latex(node.value)

symbolic_variable_latex(name:str):
    name??
        "pi" => "\\pi"
        "phi" => "\\phi"
        "i" => "\\mathrm{i}"
        name

symbolic_binary_latex(node:any, precedence:num):
    node.op??
        "+" => symbolic_latex_at(node.left, precedence) & " + " & symbolic_latex_at(node.right, precedence)
        "-" => symbolic_latex_at(node.left, precedence) & " - " & symbolic_latex_at(node.right, precedence + 1)
        "*" => symbolic_multiplication_latex(node, precedence)
        "/" => "\\frac{" & symbolic_latex(node.left) & "}{" & symbolic_latex(node.right) & "}"
        "^" => symbolic_power_latex(node)
        "=" => symbolic_latex(node.left) & " = " & symbolic_latex(node.right)
        "<" => symbolic_latex(node.left) & " < " & symbolic_latex(node.right)
        ">" => symbolic_latex(node.left) & " > " & symbolic_latex(node.right)
        "<=" => symbolic_latex(node.left) & " \\le " & symbolic_latex(node.right)
        ">=" => symbolic_latex(node.left) & " \\ge " & symbolic_latex(node.right)
        "\\operatorname{error}"

symbolic_power_latex(node:any):
    exponent: symbolic_power_exponent_latex(node.right)
    "{" & symbolic_latex(node.left) & "}^{" & exponent & "}"

symbolic_power_exponent_latex(node:any):
    node.kind = "range"?
        @: "\\left(" & symbolic_latex(node) & "\\right)"
    symbolic_latex(node)

symbolic_multiplication_latex(node:any, precedence:num):
    node.implicit = true?
        @: symbolic_latex_at(node.left, precedence) & symbolic_latex_at(node.right, precedence)
    symbolic_latex_at(node.left, precedence) & " \\cdot " & symbolic_latex_at(node.right, precedence)

symbolic_evaluation(x:num, y:num, z:num, t:num, context:any):
    dx: x - context.originX
    dy: y - context.originY
    determinant: context.basisXX * context.basisYY - context.basisXY * context.basisYX
    local_x: (dx * context.basisYY - dy * context.basisYX) / determinant
    local_y: (dy * context.basisXX - dx * context.basisXY) / determinant
    (x: local_x, y: local_y, z: z, t: t, context: context)

symbolic_local_evaluation(x:num, y:num, z:num, t:num, context:any):
    (x: x, y: y, z: z, t: t, context: context)

symbolic_evaluate(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    node.kind??
        "number" => node.value
        "variable" => symbolic_variable_value(
            node.name,
            evaluation,
            parameterNames,
            parameterValues
        )
        "unary" => symbolic_negate_value(
            symbolic_evaluate(
                node.operand,
                evaluation,
                workspace,
                parameterNames,
                parameterValues
            ),
            symbolic_value_kind_for_context(node.operand, evaluation.context)
        )
        "binary" => symbolic_binary_value(
            node,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "call" => symbolic_call_value(
            node,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "vector" => symbolic_vector(
            symbolic_evaluate(node.x, evaluation, workspace, parameterNames, parameterValues),
            symbolic_evaluate(node.y, evaluation, workspace, parameterNames, parameterValues)
        )
        "range" => symbolic_range_values(
            symbolic_evaluate(node.start, evaluation, workspace, parameterNames, parameterValues),
            symbolic_evaluate(node.end, evaluation, workspace, parameterNames, parameterValues)
        )
        "tuple" => symbolic_evaluate_items(
            node.items,
            0,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "multiset" => symbolic_evaluate_items(
            node.items,
            0,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        null

symbolic_range_values(start:num, end:num):
    start <= end?
        @: symbolic_range_values_ascending(start, end)
    symbolic_range_values_descending(start, end)

symbolic_range_values_ascending(current:num, end:num):
    current > end?
        @: vkf_list_empty()
    vkf_list_single(current) & symbolic_range_values_ascending(current + 1, end)

symbolic_range_values_descending(current:num, end:num):
    current < end?
        @: vkf_list_empty()
    vkf_list_single(current) & symbolic_range_values_descending(current - 1, end)

symbolic_evaluate_items(
    items:any,
    index:num,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    vkf_list_single(
        symbolic_evaluate(
            items.(index),
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
    ) & symbolic_evaluate_items(
        items,
        index + 1,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )

symbolic_parameter_value(names:any, values:any, index:num, name:str):
    index >= vkf_list_length(names)?
        @: null
    names.(index) = name?
        @: values.(index)
    symbolic_parameter_value(names, values, index + 1, name)

symbolic_variable_value(
    name:str,
    evaluation:SymbolicEvaluation,
    parameterNames:any,
    parameterValues:any
):
    name??
        "x" => evaluation.x
        "y" => evaluation.y
        "z" => symbolic_z_value(evaluation)
        "t" => evaluation.t
        "r" => vkf_math_sqrt(evaluation.x * evaluation.x + evaluation.y * evaluation.y)
        "phi" => symbolic_atan2(evaluation.y, evaluation.x)
        "pi" => 3.141592653589793
        "i" => symbolic_complex(0, 1)
        symbolic_free_variable_value(
            name,
            evaluation,
            parameterNames,
            parameterValues
        )

symbolic_free_variable_value(
    name:str,
    evaluation:SymbolicEvaluation,
    parameterNames:any,
    parameterValues:any
):
    value: symbolic_parameter_value(parameterNames, parameterValues, 0, name)
    value = null?
        @: evaluation.t
    value

symbolic_z_value(evaluation:SymbolicEvaluation):
    symbolic_context_dimension(evaluation.context) = 2?
        @: symbolic_complex(evaluation.x, evaluation.y)
    evaluation.z

symbolic_call_value(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    args: symbolic_evaluate_items(
        node.args,
        0,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    node.name??
        "sqrt" => vkf_math_sqrt(args.(0))
        "sin" => vkf_math_sin(args.(0))
        "cos" => vkf_math_cos(args.(0))
        "tan" => vkf_math_tan(args.(0))
        "abs" => vkf_math_abs(args.(0))
        "atan2" => symbolic_atan2(args.(0), args.(1))
        "vector" => symbolic_vector(args.(0), args.(1))
        "complex" => symbolic_complex(args.(0), args.(1))
        symbolic_user_call(node.name, args, evaluation, workspace)

symbolic_atan2(y:num, x:num):
    x > 0?
        @: symbolic_atan(y / x)
    x < 0 /\ y >= 0?
        @: symbolic_atan(y / x) + 3.141592653589793
    x < 0 /\ y < 0?
        @: symbolic_atan(y / x) - 3.141592653589793
    y > 0?
        @: 1.5707963267948966
    y < 0?
        @: -1.5707963267948966
    y - y

symbolic_atan(value:num):
    value > 1?
        @: 1.5707963267948966 - symbolic_atan(1 / value)
    value < -1?
        @: -1.5707963267948966 - symbolic_atan(1 / value)
    value / (1 + 0.28 * value * value)

symbolic_user_call(
    name:str,
    args:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace
):
    definition: symbolic_find_definition(workspace, 0, name)
    definition = null?
        @: null
    symbolic_evaluate(
        definition.value,
        evaluation,
        workspace,
        symbolic_parameter_names(definition.parameters, 0),
        args
    )

symbolic_parameter_names(parameters:any, index:num):
    index >= vkf_list_length(parameters)?
        @: vkf_list_empty()
    vkf_list_single(parameters.(index).name) & symbolic_parameter_names(
        parameters,
        index + 1
    )

symbolic_find_definition(workspace:SymbolicWorkspace, index:num, name:str):
    index >= vkf_list_length(workspace)?
        @: null
    program: workspace.(index)
    program.ast.kind??
        "definition" => symbolic_definition_or_next(
            workspace,
            index,
            name,
            program.ast
        )
        symbolic_find_definition(workspace, index + 1, name)

symbolic_definition_or_next(
    workspace:SymbolicWorkspace,
    index:num,
    name:str,
    definition:any
):
    definition.name = name?
        @: definition
    symbolic_find_definition(workspace, index + 1, name)

symbolic_negate_value(value:any, kind:str):
    kind??
        "complex" => symbolic_complex(0 - value.real, 0 - value.imaginary)
        "vector" => symbolic_vector(0 - value.x, 0 - value.y)
        0 - value

symbolic_binary_value(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    left: symbolic_evaluate(
        node.left,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    right: symbolic_evaluate(
        node.right,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    left_kind: symbolic_value_kind_for_context(node.left, evaluation.context)
    right_kind: symbolic_value_kind_for_context(node.right, evaluation.context)
    value_kind: symbolic_binary_value_kind(left_kind, right_kind)
    value_kind??
        "complex" => symbolic_complex_binary(
            node.op,
            symbolic_as_complex(left, left_kind),
            symbolic_as_complex(right, right_kind)
        )
        "vector" => symbolic_vector_binary(
            node.op,
            left,
            right,
            left_kind,
            right_kind
        )
        symbolic_scalar_binary(node.op, left, right)

symbolic_scalar_binary(op:str, left:any, right:any):
    op??
        "+" => left + right
        "-" => left - right
        "*" => left * right
        "/" => left / right
        "^" => symbolic_real_power(left, right)
        "=" => left = right
        "<" => left < right
        ">" => left > right
        "<=" => left <= right
        ">=" => left >= right
        null

symbolic_real_power(base:num, exponent:num):
    symbolic_is_integer(exponent)?
        @: symbolic_integer_power(base, exponent)
    base < 0?
        @: null
    base = 0 /\ exponent > 0?
        @: base
    base = 0?
        @: null
    symbolic_exponential(exponent * symbolic_natural_log(base))

symbolic_is_integer(value:num):
    value = 0?
        @: true
    value > 0 /\ value < 1?
        @: false
    value < 0 /\ value > -1?
        @: false
    value > 0?
        @: symbolic_is_integer(value - 1)
    symbolic_is_integer(value + 1)

symbolic_integer_power(base:num, exponent:num):
    exponent = 0?
        @: 1
    exponent < 0?
        @: 1 / symbolic_integer_power(base, 0 - exponent)
    symbolic_integer_power_positive(base, exponent, 1)

symbolic_integer_power_positive(base:num, exponent:num, result:num):
    exponent = 0?
        @: result
    symbolic_integer_power_positive(base, exponent - 1, result * base)

symbolic_natural_log(value:num):
    value <= 0?
        @: null
    normalized: symbolic_log_normalize(value, 0)
    y: (normalized.value - 1) / (normalized.value + 1)
    result: 2 * symbolic_log_series(y, y * y, 1, 12) + normalized.scale * 0.6931471805599453
    result

symbolic_log_normalize(value:num, scale:num):
    value >= 2?
        @: symbolic_log_normalize(value / 2, scale + 1)
    value < 1?
        @: symbolic_log_normalize(value * 2, scale - 1)
    normalized: (value: value, scale: scale)
    normalized

symbolic_log_series(term:num, square:num, denominator:num, remaining:num):
    remaining = 1?
        @: term / denominator
    term / denominator + symbolic_log_series(
        term * square,
        square,
        denominator + 2,
        remaining - 1
    )

symbolic_exponential(value:num):
    reduced: symbolic_exp_reduce(value, 0)
    series: symbolic_exp_series(reduced.value, 1, 1, 1, 24)
    symbolic_exp_scale(series, reduced.scale)

symbolic_exp_reduce(value:num, scale:num):
    value > 0.6931471805599453?
        @: symbolic_exp_reduce(value - 0.6931471805599453, scale + 1)
    value < -0.6931471805599453?
        @: symbolic_exp_reduce(value + 0.6931471805599453, scale - 1)
    reduced: (value: value, scale: scale)
    reduced

symbolic_exp_series(
    value:num,
    term:num,
    sum:num,
    denominator:num,
    remaining:num
):
    remaining = 0?
        @: sum
    next: term * value / denominator
    symbolic_exp_series(
        value,
        next,
        sum + next,
        denominator + 1,
        remaining - 1
    )

symbolic_exp_scale(value:num, scale:num):
    scale = 0?
        @: value
    scale > 0?
        @: symbolic_exp_scale(value * 2, scale - 1)
    symbolic_exp_scale(value / 2, scale + 1)

symbolic_as_complex(value:any, kind:str):
    kind = "complex"?
        @: value
    symbolic_complex(value, 0)

symbolic_complex_binary(op:str, left:any, right:any):
    op??
        "+" => symbolic_complex(
            left.real + right.real,
            left.imaginary + right.imaginary
        )
        "-" => symbolic_complex(
            left.real - right.real,
            left.imaginary - right.imaginary
        )
        "*" => symbolic_complex(
            left.real * right.real - left.imaginary * right.imaginary,
            left.real * right.imaginary + left.imaginary * right.real
        )
        "/" => symbolic_complex_divide(left, right)
        "^" => symbolic_complex_power(left, right)
        "=" => left.real = right.real /\ left.imaginary = right.imaginary
        null

symbolic_complex_power(base:any, exponent:any):
    exponent.imaginary = 0?
        @: symbolic_complex_integer_power(base, exponent.real)
    symbolic_invalid_complex_power()

symbolic_invalid_complex_power():
    @: null

symbolic_complex_integer_power(base:any, exponent:num):
    exponent = 0?
        @: symbolic_complex(1, 0)
    exponent > 0 /\ exponent < 1?
        @: null
    exponent < 0 /\ exponent > -1?
        @: null
    exponent < 0?
        @: symbolic_complex_divide(
            symbolic_complex(1, 0),
            symbolic_complex_integer_power(base, 0 - exponent)
        )
    symbolic_complex_binary(
        "*",
        base,
        symbolic_complex_integer_power(base, exponent - 1)
    )

symbolic_complex_divide(left:any, right:any):
    denominator: right.real * right.real + right.imaginary * right.imaginary
    symbolic_complex(
        (left.real * right.real + left.imaginary * right.imaginary) / denominator,
        (left.imaginary * right.real - left.real * right.imaginary) / denominator
    )

symbolic_vector_binary(
    op:str,
    left:any,
    right:any,
    leftKind:str,
    rightKind:str
):
    op??
        "+" => symbolic_vector(left.x + right.x, left.y + right.y)
        "-" => symbolic_vector(left.x - right.x, left.y - right.y)
        "*" => symbolic_vector_scale(left, right, leftKind, rightKind)
        "/" => symbolic_vector(left.x / right, left.y / right)
        "=" => left.x = right.x /\ left.y = right.y
        null

symbolic_vector_scale(left:any, right:any, leftKind:str, rightKind:str):
    leftKind = "vector"?
        @: symbolic_vector(left.x * right, left.y * right)
    symbolic_vector_scale_right(left, right, rightKind)

symbolic_vector_scale_right(left:any, right:any, rightKind:str):
    rightKind??
        "vector" => symbolic_vector(right.x * left, right.y * left)
        null

symbolic_list_contains(items:any, index:num, expected:str):
    index >= vkf_list_length(items)?
        @: false
    items.(index) = expected?
        @: true
    symbolic_list_contains(items, index + 1, expected)

symbolic_value_kind(node:any):
    node.kind??
        "number" => "scalar"
        "variable" => symbolic_variable_value_kind(node.name)
        "unary" => symbolic_value_kind(node.operand)
        "binary" => symbolic_binary_node_value_kind(node)
        "call" => symbolic_call_value_kind(node.name)
        "vector" => "vector"
        "range" => "range"
        "tuple" => "tuple"
        "multiset" => "multiset"
        "definition" => symbolic_value_kind(node.value)
        "error"

symbolic_value_kind_for_context(node:any, context:any):
    node.kind??
        "variable" => symbolic_variable_value_kind_for_context(node.name, context)
        "unary" => symbolic_value_kind_for_context(node.operand, context)
        "binary" => symbolic_binary_value_kind_for_context(node, context)
        "definition" => symbolic_value_kind_for_context(node.value, context)
        symbolic_value_kind(node)

symbolic_variable_value_kind_for_context(name:str, context:any):
    name = "z" /\ symbolic_context_dimension(context) = 3?
        @: "scalar"
    symbolic_variable_value_kind(name)

symbolic_binary_value_kind_for_context(node:any, context:any):
    symbolic_is_relation(node.op)?
        @: "scalar"
    symbolic_binary_value_kind(
        symbolic_value_kind_for_context(node.left, context),
        symbolic_value_kind_for_context(node.right, context)
    )

symbolic_variable_value_kind(name:str):
    name??
        "i" => "complex"
        "z" => "complex"
        "scalar"

symbolic_call_value_kind(name:str):
    name??
        "vector" => "vector"
        "complex" => "complex"
        "scalar"

symbolic_binary_node_value_kind(node:any):
    symbolic_is_relation(node.op)?
        @: "scalar"
    symbolic_binary_value_kind(
        symbolic_value_kind(node.left),
        symbolic_value_kind(node.right)
    )

symbolic_binary_value_kind(leftKind:str, rightKind:str):
    leftKind??
        "complex" => "complex"
        "vector" => symbolic_right_value_kind(rightKind, "vector")
        symbolic_right_value_kind(rightKind, "scalar")

symbolic_right_value_kind(rightKind:str, fallback:str):
    rightKind??
        "complex" => "complex"
        "vector" => "vector"
        fallback

symbolic_is_relation(op:str):
    op = "=" \/ op = "<" \/ op = ">" \/ op = "<=" \/ op = ">="

symbolic_items_variables(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    symbolic_variables(items.(index)) & symbolic_items_variables(items, index + 1)

symbolic_variables(node:any):
    node.kind??
        "variable" => symbolic_variable_dependencies(node.name)
        "unary" => symbolic_variables(node.operand)
        "binary" => symbolic_variables(node.left) & symbolic_variables(node.right)
        "call" => symbolic_items_variables(node.args, 0)
        "vector" => symbolic_variables(node.x) & symbolic_variables(node.y)
        "range" => symbolic_variables(node.start) & symbolic_variables(node.end)
        "tuple" => symbolic_items_variables(node.items, 0)
        "multiset" => symbolic_items_variables(node.items, 0)
        "definition" => symbolic_variables(node.value)
        symbolic_empty_variables()

# Cartesian-expand sets while preserving and translating tuples as linked geometry.
symbolic_binary_scalar_variant(node:any, left:any, right:any):
    node.implicit = true?
        @: symbolic_implicit_multiplication(left, right, node.location)
    symbolic_binary(node.op, left, right, node.location)

symbolic_is_linked_collection(node:any):
    node.kind = "tuple" \/ (node.kind = "binary" /\ node.op = "^" /\ (node.right.kind = "tuple" \/ node.right.kind = "range"))

symbolic_linked_collection_items(node:any):
    node.kind = "tuple"?
        @: node.items
    symbolic_linked_power_items(node, symbolic_item_variants(node.right), 0)

symbolic_linked_power_items(node:any, exponents:any, index:num):
    index >= vkf_list_length(exponents)?
        @: vkf_list_empty()
    current: symbolic_binary("^", node.left, exponents.(index), node.location)
    vkf_list_single(current) & symbolic_linked_power_items(node, exponents, index + 1)

symbolic_map_binary_left(node:any, items:any, right:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: items.(index)
    current.kind = "tuple"?
        nested: symbolic_tuple(symbolic_map_binary_left(node, current.items, right, 0), current.location)
        @: vkf_list_single(nested) & symbolic_map_binary_left(node, items, right, index + 1)
    mapped: symbolic_binary_scalar_variant(node, current, right)
    vkf_list_single(mapped) & symbolic_map_binary_left(node, items, right, index + 1)

symbolic_map_binary_right(node:any, left:any, items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: items.(index)
    current.kind = "tuple"?
        nested: symbolic_tuple(symbolic_map_binary_right(node, left, current.items, 0), current.location)
        @: vkf_list_single(nested) & symbolic_map_binary_right(node, left, items, index + 1)
    mapped: symbolic_binary_scalar_variant(node, left, current)
    vkf_list_single(mapped) & symbolic_map_binary_right(node, left, items, index + 1)

symbolic_binary_variant(node:any, left:any, right:any):
    node.op != "^" /\ symbolic_is_linked_collection(left) /\ symbolic_is_linked_collection(right) = false?
        @: symbolic_tuple(symbolic_map_binary_left(node, symbolic_linked_collection_items(left), right, 0), left.location)
    node.op != "^" /\ symbolic_is_linked_collection(right) /\ symbolic_is_linked_collection(left) = false?
        @: symbolic_tuple(symbolic_map_binary_right(node, left, symbolic_linked_collection_items(right), 0), right.location)
    symbolic_binary_scalar_variant(node, left, right)

symbolic_binary_variants(node:any, leftVariants:any, rightVariants:any, leftIndex:num, rightIndex:num):
    leftIndex >= vkf_list_length(leftVariants)?
        @: vkf_list_empty()
    rightIndex >= vkf_list_length(rightVariants)?
        @: symbolic_binary_variants(node, leftVariants, rightVariants, leftIndex + 1, 0)
    vkf_list_single(symbolic_binary_variant(node, leftVariants.(leftIndex), rightVariants.(rightIndex))) & symbolic_binary_variants(node, leftVariants, rightVariants, leftIndex, rightIndex + 1)

symbolic_unary_variants(node:any, variants:any, index:num):
    index >= vkf_list_length(variants)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_unary(node.op, variants.(index), node.location)) & symbolic_unary_variants(node, variants, index + 1)

symbolic_vector_variants(node:any, xVariants:any, yVariants:any, xIndex:num, yIndex:num):
    xIndex >= vkf_list_length(xVariants)?
        @: vkf_list_empty()
    yIndex >= vkf_list_length(yVariants)?
        @: symbolic_vector_variants(node, xVariants, yVariants, xIndex + 1, 0)
    vkf_list_single(symbolic_vector_node(xVariants.(xIndex), yVariants.(yIndex), node.location)) & symbolic_vector_variants(node, xVariants, yVariants, xIndex, yIndex + 1)

symbolic_append_argument_variants(prefixes:any, variants:any, prefixIndex:num, variantIndex:num):
    prefixIndex >= vkf_list_length(prefixes)?
        @: vkf_list_empty()
    variantIndex >= vkf_list_length(variants)?
        @: symbolic_append_argument_variants(prefixes, variants, prefixIndex + 1, 0)
    vkf_list_single(prefixes.(prefixIndex) & [variants.(variantIndex)]) & symbolic_append_argument_variants(prefixes, variants, prefixIndex, variantIndex + 1)

symbolic_argument_variant_lists(args:any, index:num, prefixes:any):
    index >= vkf_list_length(args)?
        @: prefixes
    symbolic_argument_variant_lists(args, index + 1, symbolic_append_argument_variants(prefixes, symbolic_ast_variants(args.(index)), 0, 0))

symbolic_call_variants(node:any, argumentLists:any, index:num):
    index >= vkf_list_length(argumentLists)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_call(node.name, argumentLists.(index), node.location)) & symbolic_call_variants(node, argumentLists, index + 1)

symbolic_tuple_variants(node:any, itemLists:any, index:num):
    index >= vkf_list_length(itemLists)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_tuple(itemLists.(index), node.location)) & symbolic_tuple_variants(node, itemLists, index + 1)

symbolic_definition_variants(node:any, variants:any, index:num):
    index >= vkf_list_length(variants)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_definition(node.name, node.parameters, variants.(index), node.location)) & symbolic_definition_variants(node, variants, index + 1)

symbolic_static_range_variants(node:any):
    node.start.kind = "number" /\ node.end.kind = "number"?
        @: symbolic_static_range_numbers(node.start.value, node.end.value, node.location)
    vkf_list_single(node)

symbolic_static_range_numbers(current:num, end:num, location:any):
    current <= end?
        @: symbolic_static_range_numbers_ascending(current, end, location)
    symbolic_static_range_numbers_descending(current, end, location)

symbolic_static_range_numbers_ascending(current:num, end:num, location:any):
    current > end?
        @: vkf_list_empty()
    vkf_list_single(symbolic_number(current, "", location)) & symbolic_static_range_numbers_ascending(current + 1, end, location)

symbolic_static_range_numbers_descending(current:num, end:num, location:any):
    current < end?
        @: vkf_list_empty()
    vkf_list_single(symbolic_number(current, "", location)) & symbolic_static_range_numbers_descending(current - 1, end, location)

symbolic_item_variants(item:any):
    item.kind = "range"?
        @: symbolic_static_range_variants(item)
    symbolic_ast_variants(item)

symbolic_multiset_variants(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: symbolic_item_variants(items.(index))
    current & symbolic_multiset_variants(items, index + 1)

symbolic_ast_variants(node:any):
    node.kind??
        "multiset" => symbolic_multiset_variants(node.items, 0)
        "unary" => symbolic_unary_variants(node, symbolic_ast_variants(node.operand), 0)
        "binary" => symbolic_binary_variants(node, symbolic_ast_variants(node.left), symbolic_ast_variants(node.right), 0, 0)
        "call" => symbolic_call_variants(node, symbolic_argument_variant_lists(node.args, 0, vkf_list_single(vkf_list_empty())), 0)
        "tuple" => symbolic_tuple_variants(node, symbolic_argument_variant_lists(node.items, 0, vkf_list_single(vkf_list_empty())), 0)
        "vector" => symbolic_vector_variants(node, symbolic_ast_variants(node.x), symbolic_ast_variants(node.y), 0, 0)
        "definition" => symbolic_definition_variants(node, symbolic_ast_variants(node.value), 0)
        vkf_list_single(node)

symbolic_empty_variables():
    vkf_list_empty()

symbolic_single_variable(name:str):
    vkf_list_single(name)

symbolic_variable_dependencies(name:str):
    name??
        "pi" => vkf_list_empty()
        "i" => vkf_list_empty()
        "r" => vkf_list_pair("x", "y")
        "phi" => vkf_list_pair("x", "y")
        symbolic_single_variable(name)

symbolic_is_power_family_collection(node:any):
    node.kind = "range" \/ node.kind = "multiset"

symbolic_is_y_of_x_power_family(ast:any):
    ast.kind = "binary" /\ ast.op = "^" /\ symbolic_is_power_family_collection(ast.right) /\ symbolic_power_base_has_x_only(ast.left)

symbolic_is_x_of_y_power_family(ast:any):
    ast.kind = "binary" /\ ast.op = "^" /\ symbolic_is_power_family_collection(ast.right) /\ symbolic_power_base_has_y_only(ast.left)

symbolic_power_base_has_x_only(base:any):
    variables: symbolic_variables(base)
    symbolic_list_contains(variables, 0, "x") /\ symbolic_list_contains(variables, 0, "y") = false /\ symbolic_list_contains(variables, 0, "z") = false

symbolic_power_base_has_y_only(base:any):
    variables: symbolic_variables(base)
    symbolic_list_contains(variables, 0, "y") /\ symbolic_list_contains(variables, 0, "x") = false /\ symbolic_list_contains(variables, 0, "z") = false

symbolic_classification(ast:any, variables:any, value_kind:str):
    symbolic_is_y_of_x_power_family(ast)?
        @: "y-of-x-family"
    symbolic_is_x_of_y_power_family(ast)?
        @: "x-of-y-family"
    ast.kind = "binary" /\ ast.op = "^" /\ ast.right.kind = "multiset"?
        @: "point-set"
    ast.kind = "binary" /\ ast.op = "^" /\ (ast.right.kind = "tuple" \/ ast.right.kind = "range")?
        @: "linked-tuple"
    ast.kind??
        "definition" => "definition"
        "tuple" => "linked-tuple"
        "multiset" => "point-set"
        "binary" => symbolic_binary_classification(ast, variables, value_kind)
        symbolic_variable_classification(variables, value_kind)

symbolic_binary_classification(ast:any, variables:any, valueKind:str):
    ast.op??
        "=" => "implicit-curve"
        "<" => "open-region"
        ">" => "open-region"
        "<=" => "closed-region"
        ">=" => "closed-region"
        symbolic_variable_classification(variables, valueKind)

symbolic_parameter_variable_count(variables:any, index:num):
    index >= vkf_list_length(variables)?
        @: 0
    variables.(index) = "t"?
        @: symbolic_parameter_variable_count(variables, index + 1)
    rest: symbolic_parameter_variable_count(variables, index + 1)
    rest + 1

symbolic_variable_classification(variables:any, valueKind:str):
    has_x: symbolic_list_contains(variables, 0, "x")
    has_y: symbolic_list_contains(variables, 0, "y")
    has_z: symbolic_list_contains(variables, 0, "z")
    has_t: symbolic_list_contains(variables, 0, "t")
    parameter_count: symbolic_parameter_variable_count(variables, 0)
    valueKind = "vector" \/ valueKind = "complex"?
        has_x /\ has_y?
            @: "vector-field"
        parameter_count > 0?
            @: "parametric"
        @: "literal"
    has_x /\ has_y?
        @: "scalar-field"
    has_z?
        @: "scalar-field"
    has_x?
        @: "y-of-x"
    has_y?
        @: "x-of-y"
    @: "literal"

symbolic_compile(source:str):
    symbolic_compile_with_context(
        source,
        symbolic_global_context(),
        symbolic_no_clip()
    )

symbolic_compile_draft(source:str):
    program: symbolic_compile(source)
    complete: vkf_list_length(program.diagnostics) = 0
    complete?
        @: symbolic_draft(
            program.latex,
            true,
            true,
            program.diagnostics
        )
    lexed: symbolic_tokenize(source)
    symbolic_draft(
        symbolic_draft_latex_tokens(lexed.tokens, 0),
        false,
        true,
        program.diagnostics
    )

symbolic_draft(
    latex:str,
    isComplete:any,
    isRecoverable:any,
    diagnostics:any
):
    (
        latex: latex,
        complete: isComplete,
        recoverable: isRecoverable,
        diagnostics: diagnostics
    )

symbolic_draft_latex_tokens(tokens:any, index:num):
    current: tokens.(index)
    current.kind??
        "EOF" => ""
        "CARET" => symbolic_draft_power_latex(tokens, index)
        symbolic_draft_token_latex(tokens, index) & symbolic_draft_latex_tokens(
            tokens,
            index + 1
        )

symbolic_draft_power_latex(tokens:any, index:num):
    next: tokens.(index + 1)
    next.kind??
        "NUMBER" => "^{" & next.text & "}" & symbolic_draft_latex_tokens(
            tokens,
            index + 2
        )
        "IDENT" => "^{" & symbolic_variable_latex(next.text) & "}" & symbolic_draft_latex_tokens(
            tokens,
            index + 2
        )
        "^{}" & symbolic_draft_latex_tokens(tokens, index + 1)

symbolic_draft_token_latex(tokens:any, index:num):
    current: tokens.(index)
    current.kind??
        "NUMBER" => current.text
        "IDENT" => symbolic_draft_identifier_latex(tokens, index)
        "PLUS" => " + "
        "MINUS" => " - "
        "STAR" => " \\cdot "
        "SLASH" => "/"
        "LPAREN" => "("
        "RPAREN" => ")"
        "LBRACKET" => "["
        "RBRACKET" => "]"
        "LBRACE" => "\\{"
        "RBRACE" => "\\}"
        "COMMA" => ", "
        "RANGE" => ".."
        "EQ" => " = "
        "LT" => " < "
        "GT" => " > "
        "LE" => " \\le "
        "GE" => " \\ge "
        current.text

symbolic_draft_identifier_latex(tokens:any, index:num):
    current: tokens.(index)
    next: tokens.(index + 1)
    next.kind = "LPAREN"?
        @: symbolic_function_latex(current.text)
    symbolic_variable_latex(current.text)

symbolic_compile_with_context(source:str, context:any, clip:any):
    lexed: symbolic_tokenize(source)
    parsed: symbolic_parse_tokens(lexed)
    variables: symbolic_variables(parsed.ast)
    value_kind: symbolic_value_kind_for_context(parsed.ast, context)
    symbolic_program(
        parsed.ast,
        parsed.next.diagnostics & symbolic_semantic_diagnostics(parsed.ast),
        symbolic_latex(parsed.ast),
        variables,
        symbolic_classification(parsed.ast, variables, value_kind),
        value_kind,
        context,
        clip
    )

symbolic_program(
    ast:any,
    diagnostics:any,
    latex:str,
    variables:any,
    classification:str,
    valueKind:str,
    context:any,
    clip:any
):
    (
        ast: ast,
        variants: symbolic_ast_variants(ast),
        diagnostics: diagnostics,
        latex: latex,
        variables: variables,
        classification: classification,
        valueKind: valueKind,
        context: context,
        clip: clip
    )

symbolic_program_evaluate(program:SymbolicProgram, x:num, y:num):
    symbolic_program_evaluate_at(
        program,
        x,
        y,
        0,
        0,
        program.context,
        symbolic_workspace()
    )

symbolic_program_evaluate_at(
    program:SymbolicProgram,
    x:num,
    y:num,
    z:num,
    t:num,
    context:any,
    workspace:SymbolicWorkspace
):
    symbolic_evaluate(
        program.ast,
        symbolic_evaluation(x, y, z, t, context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )

symbolic_program_evaluate_local_at(
    program:SymbolicProgram,
    x:num,
    y:num,
    z:num,
    t:num,
    workspace:SymbolicWorkspace
):
    symbolic_evaluate(
        program.ast,
        symbolic_local_evaluation(x, y, z, t, program.context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )

symbolic_workspace_compile(
    workspace:SymbolicWorkspace,
    source:str,
    context:any,
    clip:any
):
    program: symbolic_compile_with_context(source, context, clip)
    handle: vkf_list_length(workspace)
    next_workspace: workspace & [program]
    (workspace: next_workspace, handle: handle, program: program)

symbolic_workspace_append(
    workspace:SymbolicWorkspace,
    source:str,
    context:any,
    clip:any
):
    symbolic_workspace_compile(workspace, source, context, clip).workspace

symbolic_workspace_latest_handle(workspace:SymbolicWorkspace):
    vkf_list_length(workspace) - 1

symbolic_workspace_latest_program(workspace:SymbolicWorkspace):
    symbolic_workspace_program(
        workspace,
        symbolic_workspace_latest_handle(workspace)
    )

symbolic_workspace_program(workspace:SymbolicWorkspace, handle:num):
    workspace.(handle)

symbolic_workspace_evaluate(
    workspace:SymbolicWorkspace,
    handle:num,
    x:num,
    y:num,
    z:num,
    t:num
):
    program: symbolic_workspace_program(workspace, handle)
    symbolic_program_evaluate_at(
        program,
        x,
        y,
        z,
        t,
        program.context,
        workspace
    )

symbolic_plot(
    program:SymbolicProgram,
    workspace:SymbolicWorkspace,
    view:any,
    style:any,
    revision:num
):
    builder: symbolic_plot_builder(
        symbolic_plot_capacity(program, workspace, view),
        revision
    )
    builder = null?
        @: null
    symbolic_has_analytical_variants(program)?
        @: symbolic_plot_analytical_variants(program, workspace, view, style, builder, 0, vkf_list_empty())
    symbolic_has_literal_variants(program)?
        @: symbolic_plot_literal_variants(program, workspace, view, style, builder, 0, vkf_list_empty())
    sampled: symbolic_plot_into_builder(
        program,
        workspace,
        view,
        style,
        builder
    )
    program.classification = "y-of-x-family" \/ program.classification = "x-of-y-family"?
        @: symbolic_curve_family_plot_result(program, workspace, view, sampled)
    symbolic_is_linked_power_collection(program.ast)?
        @: symbolic_linked_power_plot_result(program, workspace, view.t, sampled)
    program.ast.kind = "tuple"?
        @: symbolic_linked_tuple_plot_result(program, sampled)
    program.classification = "closed-region"?
        @: symbolic_closed_region_plot_result(
            program,
            workspace,
            view,
            style,
            sampled
        )
    metadata: symbolic_plot_builder_metadata(sampled)
    symbolic_plot_result(metadata, program.classification)

symbolic_is_linked_power_collection(node:any):
    node.kind = "binary" /\ node.op = "^" /\ (node.right.kind = "tuple" \/ node.right.kind = "range")

symbolic_curve_family_points_per_curve(classification:str, view:any):
    classification = "y-of-x-family"?
        @: view.xSteps
    view.ySteps

symbolic_curve_family_plot_result(program:any, workspace:any, view:any, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    curveCount: symbolic_power_exponent_count(program.ast, program, workspace, view.t)
    pointsPerCurve: symbolic_curve_family_points_per_curve(program.classification, view)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_curve_family_ranges(curveCount, pointsPerCurve, 0)
    )

symbolic_curve_family_ranges(curveCount:num, pointsPerCurve:num, index:num):
    index >= curveCount?
        @: vkf_list_empty()
    current: vkf_list_single(
        (
            mode: "time-curve",
            part: "edge",
            first: index * pointsPerCurve,
            count: pointsPerCurve
        )
    )
    current & symbolic_curve_family_ranges(curveCount, pointsPerCurve, index + 1)

symbolic_linked_power_plot_result(program:any, workspace:any, frameTime:num, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    pointCount: symbolic_power_exponent_count(program.ast, program, workspace, frameTime)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_linked_literal_ranges(pointCount, complete.count)
    )

symbolic_linked_literal_ranges(pointCount:num, completeCount:num):
    points: vkf_list_single(
        (mode: "points", part: "edge", first: 0, count: pointCount)
    )
    edges: vkf_list_single(
        (
            mode: "linked-line-segments",
            part: "edge",
            first: pointCount,
            count: completeCount - pointCount
        )
    )
    points & edges

symbolic_linked_tuple_plot_result(program:any, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    pointCount: symbolic_literal_collection_point_count(program.ast.items, 0)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_linked_literal_ranges(pointCount, complete.count)
    )

symbolic_closed_region_plot_result(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any
):
    fillCount: builder.(2) + 0
    outlined: symbolic_sample_implicit(
        program,
        workspace,
        view,
        style,
        builder,
        0,
        0
    )
    complete: symbolic_plot_builder_metadata(outlined)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_closed_region_ranges(fillCount, complete.count)
    )

symbolic_closed_region_ranges(fillCount:num, completeCount:num):
    first: vkf_list_single(
        (
            mode: "triangles",
            part: "face",
            first: 0,
            count: fillCount
        )
    )
    second: vkf_list_single(
        (
            mode: "linked-line-segments",
            part: "edge",
            first: fillCount,
            count: completeCount - fillCount
        )
    )
    first & second

symbolic_plot_capacity(program:any, workspace:any, view:any):
    base: symbolic_plot_single_capacity(program, workspace, view)
    symbolic_has_analytical_variants(program) \/ symbolic_has_literal_variants(program)?
        @: base * vkf_list_length(program.variants)
    base

symbolic_plot_single_capacity(program:any, workspace:any, view:any):
    program.classification??
        "y-of-x-family" => symbolic_power_exponent_count(program.ast, program, workspace, view.t) * view.xSteps
        "x-of-y-family" => symbolic_power_exponent_count(program.ast, program, workspace, view.t) * view.ySteps
        "y-of-x" => view.xSteps
        "x-of-y" => view.ySteps
        "parametric" => view.tSteps
        "vector-field" => view.fieldXSteps * view.fieldYSteps * 2
        "scalar-field" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 6
        "implicit-curve" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 4
        "open-region" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 6
        "closed-region" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 10
        1024

symbolic_has_analytical_variants(program:any):
    vkf_list_length(program.variants) > 1 /\ symbolic_is_analytical_classification(program.classification) /\ program.classification != "y-of-x-family" /\ program.classification != "x-of-y-family"

symbolic_has_literal_variants(program:any):
    vkf_list_length(program.variants) > 1 /\ symbolic_is_analytical_classification(program.classification) = false /\ program.classification != "y-of-x-family" /\ program.classification != "x-of-y-family"

symbolic_is_analytical_classification(classification:str):
    classification = "y-of-x" \/ classification = "x-of-y" \/ classification = "parametric" \/ classification = "vector-field" \/ classification = "scalar-field" \/ classification = "implicit-curve" \/ classification = "open-region" \/ classification = "closed-region"

symbolic_variant_program(program:any, ast:any):
    (
        ast: ast,
        variants: vkf_list_single(ast),
        diagnostics: program.diagnostics,
        latex: program.latex,
        variables: program.variables,
        classification: program.classification,
        valueKind: program.valueKind,
        context: program.context,
        clip: program.clip
    )

symbolic_plot_analytical_variants(program:any, workspace:any, view:any, style:any, builder:any, index:num, ranges:any):
    index >= vkf_list_length(program.variants)?
        metadata: symbolic_plot_builder_metadata(builder)
        @: (
            pointer: metadata.pointer,
            count: metadata.count,
            stride: metadata.stride,
            revision: metadata.revision,
            ranges: ranges
        )
    variant: symbolic_variant_program(program, program.variants.(index))
    first: builder.(2) + 0
    sampled: symbolic_plot_into_builder(variant, workspace, view, style, builder)
    program.classification = "closed-region"?
        faceEnd: sampled.(2) + 0
        outlined: symbolic_sample_implicit(variant, workspace, view, style, sampled, 0, 0)
        nextRanges: ranges & symbolic_variant_closed_ranges(first, faceEnd, outlined.(2))
        @: symbolic_plot_analytical_variants(program, workspace, view, style, outlined, index + 1, nextRanges)
    last: sampled.(2) + 0
    nextRange: vkf_list_single((
        mode: symbolic_plot_mode(program.classification),
        part: symbolic_plot_part(program.classification),
        first: first,
        count: last - first
    ))
    symbolic_plot_analytical_variants(program, workspace, view, style, sampled, index + 1, ranges & nextRange)

symbolic_variant_closed_ranges(first:num, faceEnd:num, end:num):
    vkf_list_pair(
        (mode: "triangles", part: "face", first: first, count: faceEnd - first),
        (mode: "linked-line-segments", part: "edge", first: faceEnd, count: end - faceEnd)
    )

symbolic_plot_literal_variants(program:any, workspace:any, view:any, style:any, builder:any, index:num, ranges:any):
    index >= vkf_list_length(program.variants)?
        metadata: symbolic_plot_builder_metadata(builder)
        @: (
            pointer: metadata.pointer,
            count: metadata.count,
            stride: metadata.stride,
            revision: metadata.revision,
            ranges: ranges
        )
    ast: program.variants.(index)
    variant: symbolic_variant_program(program, ast)
    first: builder.(2) + 0
    plotted: symbolic_plot_literal(variant, workspace, view.t, style, builder)
    last: plotted.(2) + 0
    nextRanges: ranges & symbolic_literal_variant_ranges(ast, variant, workspace, view.t, first, last)
    symbolic_plot_literal_variants(program, workspace, view, style, plotted, index + 1, nextRanges)

symbolic_literal_variant_ranges(ast:any, program:any, workspace:any, frameTime:num, first:num, last:num):
    symbolic_is_linked_power_collection(ast)?
        pointCount: symbolic_power_exponent_count(ast, program, workspace, frameTime)
        @: symbolic_offset_linked_literal_ranges(first, pointCount, last)
    ast.kind = "tuple"?
        tuplePointCount: symbolic_literal_collection_point_count(ast.items, 0)
        @: symbolic_offset_linked_literal_ranges(first, tuplePointCount, last)
    vkf_list_single((mode: "points", part: "edge", first: first, count: last - first))

symbolic_offset_linked_literal_ranges(first:num, pointCount:num, last:num):
    points: vkf_list_single((mode: "points", part: "edge", first: first, count: pointCount))
    edges: vkf_list_single((mode: "linked-line-segments", part: "edge", first: first + pointCount, count: last - first - pointCount))
    points & edges

symbolic_plot_result(metadata:any, classification:str):
    metadata = null?
        @: null
    symbolic_plot_result_record(metadata, classification)

symbolic_plot_result_record(metadata:any, classification:str):
    (
        pointer: metadata.pointer,
        count: metadata.count,
        stride: metadata.stride,
        revision: metadata.revision,
        ranges: symbolic_plot_ranges(classification, metadata.count)
    )

symbolic_plot_ranges(classification:str, count:num):
    vkf_list_single(
        (
            mode: symbolic_plot_mode(classification),
            part: symbolic_plot_part(classification),
            first: 0,
            count: count
        )
    )

symbolic_plot_mode(classification:str):
    classification??
        "literal" => "points"
        "point-set" => "points"
        "linked-tuple" => "linked-line-segments"
        "y-of-x-family" => "time-curve"
        "x-of-y-family" => "time-curve"
        "y-of-x" => "time-curve"
        "x-of-y" => "time-curve"
        "parametric" => "time-curve"
        "implicit-curve" => "linked-line-segments"
        "scalar-field" => "scalar-field-triangles"
        "vector-field" => "vector-field-glyphs"
        "open-region" => "triangles"
        "closed-region" => "triangles"
        "triangles"

symbolic_plot_part(classification:str):
    classification??
        "open-region" => "face"
        "closed-region" => "face"
        "scalar-field" => "face"
        "edge"

symbolic_plot_into_builder(
    program:SymbolicProgram,
    workspace:SymbolicWorkspace,
    view:any,
    style:any,
    builder:any
):
    program.classification??
        "y-of-x-family" => symbolic_sample_explicit_x_family(program, workspace, view, style, builder, 0, 0)
        "x-of-y-family" => symbolic_sample_explicit_y_family(program, workspace, view, style, builder, 0, 0)
        "y-of-x" => symbolic_sample_explicit_x(program, workspace, view, style, builder, 0)
        "x-of-y" => symbolic_sample_explicit_y(program, workspace, view, style, builder, 0)
        "parametric" => symbolic_sample_parametric(program, workspace, view, style, builder, 0)
        "vector-field" => symbolic_sample_vector_field(program, workspace, view, style, builder, 0, 0)
        "scalar-field" => symbolic_sample_scalar_field(program, workspace, view, style, builder, 0, 0)
        "implicit-curve" => symbolic_sample_implicit(program, workspace, view, style, builder, 0, 0)
        "open-region" => symbolic_sample_region(program, workspace, view, style, builder, 0, 0)
        "closed-region" => symbolic_sample_region(program, workspace, view, style, builder, 0, 0)
        symbolic_plot_literal(program, workspace, view.t, style, builder)

symbolic_power_family_value(program:any, workspace:any, x:num, y:num, frameTime:num, exponentIndex:num):
    evaluation: symbolic_local_evaluation(x, y, 0, frameTime, program.context)
    base: symbolic_evaluate(
        program.ast.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    exponent: symbolic_power_exponents(program.ast, program, workspace, frameTime).(exponentIndex)
    baseKind: symbolic_value_kind_for_context(program.ast.left, program.context)
    symbolic_power_collection_value(base, baseKind, exponent)

symbolic_sample_explicit_x_family(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num):
    exponentIndex >= symbolic_power_exponent_count(program.ast, program, workspace, view.t)?
        @: builder
    index >= view.xSteps?
        @: symbolic_sample_explicit_x_family(program, workspace, view, style, builder, exponentIndex + 1, 0)
    x: symbolic_sample_coordinate(view.xMin, view.xMax, view.xSteps, index)
    y: symbolic_power_family_value(program, workspace, x, 0, view.t, exponentIndex)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_x_family(program, workspace, view, style, pushed, exponentIndex, index + 1)

symbolic_sample_explicit_y_family(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num):
    exponentIndex >= symbolic_power_exponent_count(program.ast, program, workspace, view.t)?
        @: builder
    index >= view.ySteps?
        @: symbolic_sample_explicit_y_family(program, workspace, view, style, builder, exponentIndex + 1, 0)
    y: symbolic_sample_coordinate(view.yMin, view.yMax, view.ySteps, index)
    x: symbolic_power_family_value(program, workspace, 0, y, view.t, exponentIndex)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_y_family(program, workspace, view, style, pushed, exponentIndex, index + 1)

symbolic_sample_explicit_x(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.xSteps?
        @: builder
    x: symbolic_sample_coordinate(view.xMin, view.xMax, view.xSteps, index)
    y: symbolic_program_evaluate_local_at(
        program,
        x,
        0,
        0,
        view.t,
        workspace
    )
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_x(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1
    )

symbolic_sample_explicit_y(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.ySteps?
        @: builder
    y: symbolic_sample_coordinate(view.yMin, view.yMax, view.ySteps, index)
    x: symbolic_program_evaluate_local_at(
        program,
        0,
        y,
        0,
        view.t,
        workspace
    )
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_y(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1
    )

symbolic_sample_parametric(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.tSteps?
        @: builder
    parameter: symbolic_sample_coordinate(view.tMin, view.tMax, view.tSteps, index)
    value: symbolic_program_evaluate_parameter_at(
        program,
        parameter,
        view.t,
        workspace
    )
    point: symbolic_plot_point(value, parameter)
    pushed: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )
    symbolic_sample_parametric(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1
    )

symbolic_program_evaluate_parameter_at(
    program:any,
    parameter:num,
    frameTime:num,
    workspace:any
):
    symbolic_list_contains(program.variables, 0, "x")?
        @: symbolic_program_evaluate_local_at(program, parameter, 0, 0, frameTime, workspace)
    symbolic_list_contains(program.variables, 0, "y")?
        @: symbolic_program_evaluate_local_at(program, 0, parameter, 0, frameTime, workspace)
    symbolic_list_contains(program.variables, 0, "z")?
        @: symbolic_program_evaluate_local_at(program, 0, 0, parameter, frameTime, workspace)
    symbolic_program_evaluate_local_at(program, parameter, 0, 0, frameTime, workspace)

symbolic_plot_point(value:any, parameter:num):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(parameter, value)

symbolic_literal_point(value:any):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(value, 0)

symbolic_sample_vector_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps?
        @: builder
    yIndex >= view.fieldYSteps?
        @: symbolic_sample_vector_field(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x: symbolic_sample_coordinate(
        view.xMin,
        view.xMax,
        view.fieldXSteps,
        xIndex
    )
    y: symbolic_sample_coordinate(
        view.yMin,
        view.yMax,
        view.fieldYSteps,
        yIndex
    )
    value: symbolic_program_evaluate_local_at(
        program,
        x,
        y,
        0,
        view.t,
        workspace
    )
    vector: symbolic_plot_vector(value)
    scale: view.vectorScale
    start: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(x, y, style)
    )
    glyph: symbolic_plot_builder_push(
        start,
        symbolic_line_vertex(
            x + vector.(0) * scale,
            y + vector.(1) * scale,
            style
        )
    )
    symbolic_sample_vector_field(
        program,
        workspace,
        view,
        style,
        glyph,
        xIndex,
        yIndex + 1
    )

symbolic_plot_vector(value:any):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(0, 0)

symbolic_sample_scalar_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_scalar_field(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    v00: symbolic_program_evaluate_local_at(program, x0, y0, 0, view.t, workspace)
    v10: symbolic_program_evaluate_local_at(program, x1, y0, 0, view.t, workspace)
    v11: symbolic_program_evaluate_local_at(program, x1, y1, 0, view.t, workspace)
    v01: symbolic_program_evaluate_local_at(program, x0, y1, 0, view.t, workspace)
    cell: symbolic_push_scalar_field_cell(
        builder,
        x0,
        y0,
        x1,
        y1,
        v00,
        v10,
        v11,
        v01,
        style
    )
    symbolic_sample_scalar_field(
        program,
        workspace,
        view,
        style,
        cell,
        xIndex,
        yIndex + 1
    )

symbolic_push_scalar_field_cell(
    builder:any,
    x0:num,
    y0:num,
    x1:num,
    y1:num,
    v00:num,
    v10:num,
    v11:num,
    v01:num,
    style:any
):
    bottomLeft: symbolic_field_vertex(x0, y0, v00, style)
    bottomRight: symbolic_field_vertex(x1, y0, v10, style)
    topRight: symbolic_field_vertex(x1, y1, v11, style)
    topLeft: symbolic_field_vertex(x0, y1, v01, style)
    first: symbolic_plot_builder_push(builder, bottomLeft)
    second: symbolic_plot_builder_push(first, bottomRight)
    third: symbolic_plot_builder_push(second, topRight)
    fourth: symbolic_plot_builder_push(third, bottomLeft)
    fifth: symbolic_plot_builder_push(fourth, topRight)
    symbolic_plot_builder_push(fifth, topLeft)

symbolic_sample_implicit(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_implicit(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    v00: symbolic_relation_residual(program, workspace, x0, y0, view.t)
    v10: symbolic_relation_residual(program, workspace, x1, y0, view.t)
    v11: symbolic_relation_residual(program, workspace, x1, y1, view.t)
    v01: symbolic_relation_residual(program, workspace, x0, y1, view.t)
    cell: symbolic_push_implicit_cell(
        builder,
        x0,
        y0,
        x1,
        y1,
        v00,
        v10,
        v11,
        v01,
        style
    )
    symbolic_sample_implicit(
        program,
        workspace,
        view,
        style,
        cell,
        xIndex,
        yIndex + 1
    )

symbolic_relation_residual(program:any, workspace:any, x:num, y:num, t:num):
    evaluation: symbolic_local_evaluation(x, y, 0, t, program.context)
    left: symbolic_evaluate(
        program.ast.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    right: symbolic_evaluate(
        program.ast.right,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    left - right

symbolic_push_implicit_cell(
    builder:any,
    x0:num,
    y0:num,
    x1:num,
    y1:num,
    v00:num,
    v10:num,
    v11:num,
    v01:num,
    style:any
):
    caseIndex: symbolic_implicit_case(v00, v10, v11, v01)
    bottom: symbolic_implicit_intersection(x0, y0, v00, x1, y0, v10)
    right: symbolic_implicit_intersection(x1, y0, v10, x1, y1, v11)
    top: symbolic_implicit_intersection(x1, y1, v11, x0, y1, v01)
    left: symbolic_implicit_intersection(x0, y1, v01, x0, y0, v00)
    caseIndex??
        1 => symbolic_push_segment(builder, bottom, left, style)
        2 => symbolic_push_segment(builder, bottom, right, style)
        3 => symbolic_push_segment(builder, left, right, style)
        4 => symbolic_push_segment(builder, right, top, style)
        5 => symbolic_push_two_segments(builder, bottom, right, top, left, style)
        6 => symbolic_push_segment(builder, bottom, top, style)
        7 => symbolic_push_segment(builder, left, top, style)
        8 => symbolic_push_segment(builder, left, top, style)
        9 => symbolic_push_segment(builder, bottom, top, style)
        10 => symbolic_push_two_segments(builder, bottom, left, right, top, style)
        11 => symbolic_push_segment(builder, right, top, style)
        12 => symbolic_push_segment(builder, left, right, style)
        13 => symbolic_push_segment(builder, bottom, right, style)
        14 => symbolic_push_segment(builder, bottom, left, style)
        builder

symbolic_implicit_case(v00:num, v10:num, v11:num, v01:num):
    symbolic_sign_bit(v00) + symbolic_sign_bit(v10) * 2 + symbolic_sign_bit(v11) * 4 + symbolic_sign_bit(v01) * 8

symbolic_sign_bit(value:num):
    value >= 0?
        @: 1
    value - value

symbolic_implicit_intersection(
    x0:num,
    y0:num,
    value0:num,
    x1:num,
    y1:num,
    value1:num
):
    ratio: value0 / (value0 - value1)
    vkf_list_pair(
        x0 + (x1 - x0) * ratio,
        y0 + (y1 - y0) * ratio
    )

symbolic_push_segment(builder:any, first:any, second:any, style:any):
    start: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(first.(0), first.(1), style)
    )
    symbolic_plot_builder_push(
        start,
        symbolic_line_vertex(second.(0), second.(1), style)
    )

symbolic_push_two_segments(
    builder:any,
    first:any,
    second:any,
    third:any,
    fourth:any,
    style:any
):
    one: symbolic_push_segment(builder, first, second, style)
    symbolic_push_segment(one, third, fourth, style)

symbolic_sample_region(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_region(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    center: symbolic_program_evaluate_local_at(
        program,
        (x0 + x1) / 2,
        (y0 + y1) / 2,
        0,
        view.t,
        workspace
    )
    center?
        @: symbolic_region_cell_and_rest(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex,
            yIndex,
            x0,
            y0,
            x1,
            y1
        )
    symbolic_sample_region(
        program,
        workspace,
        view,
        style,
        builder,
        xIndex,
        yIndex + 1
    )

symbolic_region_cell_and_rest(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num,
    x0:num,
    y0:num,
    x1:num,
    y1:num
):
    filled: symbolic_push_face_cell(builder, x0, y0, x1, y1, style)
    symbolic_sample_region(
        program,
        workspace,
        view,
        style,
        filled,
        xIndex,
        yIndex + 1
    )

symbolic_push_face_cell(builder:any, x0:num, y0:num, x1:num, y1:num, style:any):
    first: symbolic_plot_builder_push(builder, symbolic_face_vertex(x0, y0, style))
    second: symbolic_plot_builder_push(first, symbolic_face_vertex(x1, y0, style))
    third: symbolic_plot_builder_push(second, symbolic_face_vertex(x1, y1, style))
    fourth: symbolic_plot_builder_push(third, symbolic_face_vertex(x0, y0, style))
    fifth: symbolic_plot_builder_push(fourth, symbolic_face_vertex(x1, y1, style))
    symbolic_plot_builder_push(fifth, symbolic_face_vertex(x0, y1, style))

symbolic_plot_literal(program:any, workspace:any, frameTime:num, style:any, builder:any):
    program.ast.kind = "binary" /\ program.ast.op = "^" /\ program.ast.right.kind = "multiset"?
        @: symbolic_plot_power_points(program.ast, program, workspace, frameTime, style, builder)
    symbolic_is_linked_power_collection(program.ast)?
        points: symbolic_plot_power_points(program.ast, program, workspace, frameTime, style, builder)
        @: symbolic_plot_power_segments(program.ast, program, workspace, frameTime, style, points, 0)
    program.ast.kind = "tuple"?
        tuplePoints: symbolic_plot_set_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
        @: symbolic_plot_tuple_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            tuplePoints,
            0
        )
    program.ast.kind = "multiset"?
        @: symbolic_plot_set_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    point: symbolic_node_plot_point(program.ast, program, workspace, frameTime)
    symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )

symbolic_power_exponents(node:any, program:any, workspace:any, frameTime:num):
    evaluation: symbolic_local_evaluation(0, 0, 0, frameTime, program.context)
    node.right.kind = "range"?
        @: symbolic_evaluate(
            node.right,
            evaluation,
            workspace,
            vkf_list_empty(),
            vkf_list_empty()
        )
    symbolic_power_exponent_items(node.right.items, 0, evaluation, workspace)

symbolic_power_exponent_items(items:any, index:num, evaluation:any, workspace:any):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: symbolic_power_exponent_values(items.(index), evaluation, workspace)
    current & symbolic_power_exponent_items(items, index + 1, evaluation, workspace)

symbolic_power_exponent_values(node:any, evaluation:any, workspace:any):
    value: symbolic_evaluate(
        node,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    node.kind = "range"?
        @: value
    vkf_list_single(value)

symbolic_power_exponent_count(node:any, program:any, workspace:any, frameTime:num):
    vkf_list_length(symbolic_power_exponents(node, program, workspace, frameTime))

symbolic_power_collection_point(node:any, program:any, workspace:any, index:num, frameTime:num):
    evaluation: symbolic_local_evaluation(0, 0, 0, frameTime, program.context)
    base: symbolic_evaluate(
        node.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    exponent: symbolic_power_exponents(node, program, workspace, frameTime).(index)
    baseKind: symbolic_value_kind_for_context(node.left, program.context)
    value: symbolic_power_collection_value(base, baseKind, exponent)
    symbolic_literal_point(value)

symbolic_power_collection_value(base:any, baseKind:str, exponent:num):
    baseKind = "complex"?
        @: symbolic_complex_power(
            symbolic_as_complex(base, baseKind),
            symbolic_complex(exponent, 0)
        )
    symbolic_real_power(base, exponent)

symbolic_plot_power_points(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    symbolic_plot_power_points_at(node, program, workspace, frameTime, style, builder, 0)

symbolic_plot_power_points_at(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= symbolic_power_exponent_count(node, program, workspace, frameTime)?
        @: builder
    point: symbolic_power_collection_point(node, program, workspace, index, frameTime)
    pushed: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )
    symbolic_plot_power_points_at(node, program, workspace, frameTime, style, pushed, index + 1)

symbolic_plot_power_segments(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index + 1 >= symbolic_power_exponent_count(node, program, workspace, frameTime)?
        @: builder
    first: symbolic_power_collection_point(node, program, workspace, index, frameTime)
    second: symbolic_power_collection_point(node, program, workspace, index + 1, frameTime)
    linked: symbolic_push_segment(builder, first, second, style)
    symbolic_plot_power_segments(node, program, workspace, frameTime, style, linked, index + 1)

symbolic_plot_tuple_items(
    items:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= vkf_list_length(items)?
        @: builder
    nested: symbolic_plot_nested_tuple(
        items.(index),
        program,
        workspace,
        frameTime,
        style,
        builder
    )
    index + 1 >= vkf_list_length(items)?
        @: nested
    first: symbolic_node_plot_point(items.(index), program, workspace, frameTime)
    second: symbolic_node_plot_point(items.(index + 1), program, workspace, frameTime)
    linked: symbolic_push_segment(nested, first, second, style)
    symbolic_plot_tuple_items(
        items,
        program,
        workspace,
        frameTime,
        style,
        linked,
        index + 1
    )

symbolic_plot_nested_tuple(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    node.kind = "tuple"?
        @: symbolic_plot_tuple_items(
            node.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    builder

symbolic_plot_set_items(
    items:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= vkf_list_length(items)?
        @: builder
    pushed: symbolic_plot_set_node(
        items.(index),
        program,
        workspace,
        frameTime,
        style,
        builder
    )
    symbolic_plot_set_items(
        items,
        program,
        workspace,
        frameTime,
        style,
        pushed,
        index + 1
    )

symbolic_literal_collection_point_count(items:any, index:num):
    index >= vkf_list_length(items)?
        @: 0
    node: items.(index)
    nestedCount: symbolic_literal_node_point_count(node)
    nestedCount + symbolic_literal_collection_point_count(items, index + 1)

symbolic_literal_node_point_count(node:any):
    node.kind??
        "tuple" => symbolic_literal_collection_point_count(node.items, 0)
        "multiset" => symbolic_literal_collection_point_count(node.items, 0)
        1

symbolic_plot_set_node(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    node.kind = "tuple" \/ node.kind = "multiset"?
        @: symbolic_plot_set_items(
            node.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    point: symbolic_node_plot_point(node, program, workspace, frameTime)
    symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )

symbolic_node_plot_point(node:any, program:any, workspace:any, frameTime:num):
    node.kind = "tuple"?
        @: symbolic_node_plot_point(node.items.(0), program, workspace, frameTime)
    value: symbolic_evaluate(
        node,
        symbolic_local_evaluation(0, 0, 0, frameTime, program.context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    symbolic_literal_point(value)


symbolic_sample_coordinate(minimum:num, maximum:num, steps:num, index:num):
    steps <= 1?
        @: minimum
    minimum + (maximum - minimum) * index / (steps - 1)

symbolic_line_vertex(x:num, y:num, style:any):
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(style.edgeR, style.edgeG)
    third: vkf_list_pair(style.edgeB, style.edgeA)
    first & second & third

symbolic_face_vertex(x:num, y:num, style:any):
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(style.faceR, style.faceG)
    third: vkf_list_pair(style.faceB, style.faceA)
    first & second & third

symbolic_field_vertex(x:num, y:num, value:num, style:any):
    normalized: symbolic_clamp_unit(
        (value - style.valueMin) / (style.valueMax - style.valueMin)
    )
    color: symbolic_field_color(normalized, style)
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(color.r, color.g)
    third: vkf_list_pair(color.b, color.a)
    first & second & third

symbolic_field_color(normalized:num, style:any):
    style.colormapPoints = null?
        @: symbolic_field_fallback_color(normalized, style)
    vkf_list_length(style.colormapPoints) = 0?
        @: symbolic_field_fallback_color(normalized, style)
    symbolic_colormap_sample(style.colormapPoints, normalized, 0)

symbolic_field_fallback_color(normalized:num, style:any):
    (
        r: style.faceR,
        g: style.faceG,
        b: style.faceB,
        a: style.faceA * normalized
    )

symbolic_colormap_sample(points:any, position:num, index:num):
    first: points.(0)
    position <= first.pos?
        @: symbolic_colormap_point(first)
    index + 1 >= vkf_list_length(points)?
        @: symbolic_colormap_point(points.(vkf_list_length(points) - 1))
    upper: points.(index + 1)
    position <= upper.pos?
        @: symbolic_colormap_interpolate(points.(index), upper, position)
    symbolic_colormap_sample(points, position, index + 1)

symbolic_colormap_interpolate(lower:any, upper:any, position:num):
    span: upper.pos - lower.pos
    amount: symbolic_colormap_amount(span, position, lower.pos)
    (
        r: symbolic_mix(lower.color.(0), upper.color.(0), amount) / 255,
        g: symbolic_mix(lower.color.(1), upper.color.(1), amount) / 255,
        b: symbolic_mix(lower.color.(2), upper.color.(2), amount) / 255,
        a: symbolic_mix(lower.alpha, upper.alpha, amount)
    )

symbolic_colormap_amount(span:num, position:num, lowerPosition:num):
    span = 0?
        @: position - position
    amount: (position - lowerPosition) / span
    amount

symbolic_colormap_point(point:any):
    (
        r: point.color.(0) / 255,
        g: point.color.(1) / 255,
        b: point.color.(2) / 255,
        a: point.alpha
    )

symbolic_mix(first:num, second:num, amount:num):
    first + (second - first) * amount

symbolic_clamp_unit(value:num):
    value < 0?
        @: 0
    value > 1?
        @: 1
    value

symbolic_semantic_diagnostics(ast:any):
    ast.kind??
        "call" => symbolic_call_diagnostics(ast)
        "definition" => symbolic_definition_diagnostics(ast)
        "unary" => symbolic_semantic_diagnostics(ast.operand)
        "binary" => symbolic_semantic_diagnostics(ast.left) & symbolic_semantic_diagnostics(ast.right)
        "vector" => symbolic_semantic_diagnostics(ast.x) & symbolic_semantic_diagnostics(ast.y)
        "range" => symbolic_semantic_diagnostics(ast.start) & symbolic_semantic_diagnostics(ast.end)
        "tuple" => symbolic_items_diagnostics(ast.items, 0)
        "multiset" => symbolic_items_diagnostics(ast.items, 0)
        vkf_list_empty()

symbolic_items_diagnostics(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    symbolic_semantic_diagnostics(items.(index)) & symbolic_items_diagnostics(
        items,
        index + 1
    )

symbolic_call_diagnostics(node:any):
    expected: symbolic_builtin_arity(node.name)
    nested: symbolic_items_diagnostics(node.args, 0)
    expected < 0?
        @: nested
    vkf_list_length(node.args) = expected?
        @: nested
    vkf_list_single(
        symbolic_diagnostic(
            "invalid-arity",
            "function argument count does not match its definition",
            node.location
        )
    ) & nested

symbolic_builtin_arity(name:str):
    name??
        "sqrt" => 1
        "sin" => 1
        "cos" => 1
        "tan" => 1
        "abs" => 1
        "atan2" => 2
        "vector" => 2
        "complex" => 2
        -1

symbolic_definition_diagnostics(node:any):
    parameters: symbolic_parameter_diagnostics(node.parameters, 0)
    parameters & symbolic_semantic_diagnostics(node.value)

symbolic_parameter_diagnostics(parameters:any, index:num):
    index >= vkf_list_length(parameters)?
        @: vkf_list_empty()
    current: parameters.(index)
    current.kind = "variable"?
        @: symbolic_parameter_diagnostics(parameters, index + 1)
    vkf_list_single(
        symbolic_diagnostic(
            "invalid-parameter",
            "function parameters must be variable names",
            current.location
        )
    ) & symbolic_parameter_diagnostics(parameters, index + 1)

symbolic_expression_capability:
    name: "self_hosted_symbolic_kernel"
    grammar: [
        "decimal numbers",
        "variables x y z t r phi",
        "constants pi and i",
        "prefix plus and minus",
        "binary plus minus multiply divide power",
        "comparisons and equality",
        "parenthesized expressions, tuples, multisets, and inclusive ranges",
        "calls and named function definitions",
        "complex(real, imaginary) and vector(x, y)"
    ]
    deterministic_interfaces: [
        "symbolic_tokenize(source)",
        "symbolic_parse_tokens(lexed)",
        "symbolic_compile(source)",
        "symbolic_compile_draft(source)",
        "symbolic_compile_with_context(source, context, clip)",
        "symbolic_latex(ast)",
        "symbolic_workspace_compile(workspace, source, context, clip)",
        "symbolic_workspace_append(workspace, source, context, clip)",
        "symbolic_workspace_evaluate(workspace, handle, x, y, z, t)",
        "symbolic_program_evaluate_at(program, x, y, z, t, context, workspace)",
        "symbolic_plot(program, workspace, view, style, revision)"
    ]
    classifications: [
        "literal",
        "point-set",
        "linked-tuple",
        "y-of-x",
        "x-of-y",
        "parametric",
        "implicit-curve",
        "open-region",
        "closed-region",
        "scalar-field",
        "vector-field"
    ]
    coordinate_contexts: ["global", "vertex", "edge", "face"]
    native_bootstrap_status: "source lexes, parses, lowers, executes, samples, and packs GPU ranges through the tagged WASM runtime"
    rendering_modules: [
        "vf-symbolic-plot-renderer",
        "vf-screen-simplex-renderer"
    ]
    missing: []
    :
