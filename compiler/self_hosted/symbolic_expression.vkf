symbolic_complex_power(base:any, exponent:any):
    exponent.imaginary = 0?
        @: symbolic_complex_integer_power(base, exponent.real)
    symbolic_invalid_complex_power()

symbolic_invalid_complex_power():
    @: null

symbolic_complex_integer_power(base:any, exponent:num):
    exponent = 0?
        @: symbolic_complex(1, 0)
    exponent > 0 /\ exponent < 1?
        @: null
    exponent < 0 /\ exponent > -1?
        @: null
    exponent < 0?
        @: symbolic_complex_divide(
            symbolic_complex(1, 0),
            symbolic_complex_integer_power(base, 0 - exponent)
        )
    symbolic_complex_binary(
        "*",
        base,
        symbolic_complex_integer_power(base, exponent - 1)
    )

symbolic_complex_divide(left:any, right:any):
    denominator: right.real * right.real + right.imaginary * right.imaginary
    symbolic_complex(
        (left.real * right.real + left.imaginary * right.imaginary) / denominator,
        (left.imaginary * right.real - left.real * right.imaginary) / denominator
    )

symbolic_vector_binary(
    op:str,
    left:any,
    right:any,
    leftKind:str,
    rightKind:str
):
    op??
        "+" => symbolic_vector(left.x + right.x, left.y + right.y)
        "-" => symbolic_vector(left.x - right.x, left.y - right.y)
        "*" => symbolic_vector_scale(left, right, leftKind, rightKind)
        "/" => symbolic_vector(left.x / right, left.y / right)
        "=" => left.x = right.x /\ left.y = right.y
        null

symbolic_vector_scale(left:any, right:any, leftKind:str, rightKind:str):
    leftKind = "vector"?
        @: symbolic_vector(left.x * right, left.y * right)
    symbolic_vector_scale_right(left, right, rightKind)

symbolic_vector_scale_right(left:any, right:any, rightKind:str):
    rightKind??
        "vector" => symbolic_vector(right.x * left, right.y * left)
        null

symbolic_list_contains(items:any, index:num, expected:str):
    index >= vkf_list_length(items)?
        @: false
    items.(index) = expected?
        @: true
    symbolic_list_contains(items, index + 1, expected)

symbolic_unique_variables(items:any, index:num, unique:any):
    index >= vkf_list_length(items)?
        @: unique
    current: items.(index)
    symbolic_list_contains(unique, 0, current)?
        @: symbolic_unique_variables(items, index + 1, unique)
    symbolic_unique_variables(items, index + 1, unique & vkf_list_single(current))

symbolic_value_kind(node:any):
    node.kind??
        "number" => "scalar"
        "variable" => symbolic_variable_value_kind(node.name)
        "unary" => symbolic_value_kind(node.operand)
        "group" => symbolic_value_kind(node.expression)
        "binary" => symbolic_binary_node_value_kind(node)
        "call" => symbolic_call_value_kind(node.name)
        "vector" => "vector"
        "range" => "range"
        "tuple" => "tuple"
        "multiset" => "multiset"
        "definition" => symbolic_value_kind(node.value)
        "error"

symbolic_value_kind_for_context(node:any, context:any):
    node.kind??
        "variable" => symbolic_variable_value_kind_for_context(node.name, context)
        "unary" => symbolic_value_kind_for_context(node.operand, context)
        "group" => symbolic_value_kind_for_context(node.expression, context)
