        "multiset" => symbolic_multiset_variants(node.items, 0)
        "range" => symbolic_static_range_variants(node)
        "unary" => symbolic_unary_variants(node, symbolic_ast_variants(node.operand), 0)
        "group" => symbolic_group_variants(node, symbolic_ast_variants(node.expression), 0)
        "binary" => symbolic_binary_variants(node, symbolic_ast_variants(node.left), symbolic_ast_variants(node.right), 0, 0)
        "call" => symbolic_call_variants(node, symbolic_argument_variant_lists(node.args, 0, vkf_list_single(vkf_list_empty())), 0)
        "tuple" => symbolic_tuple_variants(node, symbolic_argument_variant_lists(node.items, 0, vkf_list_single(vkf_list_empty())), 0)
        "vector" => symbolic_vector_variants(node, symbolic_ast_variants(node.x), symbolic_ast_variants(node.y), 0, 0)
        "definition" => symbolic_definition_variants(node, symbolic_ast_variants(node.value), 0)
        vkf_list_single(node)

# Tuples are linked geometry only as standalone geometry. Inside an expression
# they are lanes: equal-length tuples zip, while sets still Cartesian-expand.
symbolic_tuple_length_merge(left:num, right:num):
    left < 0 \/ right < 0?
        @: -1
    left = 0?
        @: right
    right = 0?
        @: left
    left = right?
        @: left
    mismatch: 0 - 1
    mismatch

symbolic_expression_tuple_length_items(items:any, index:num, current:num):
    index >= vkf_list_length(items)?
        @: current
    next: symbolic_tuple_length_merge(current, symbolic_expression_tuple_length(items.(index)))
    symbolic_expression_tuple_length_items(items, index + 1, next)

symbolic_group_tuple_length(node:any):
    node.expression.kind = "range"?
        @: symbolic_static_range_length(node.expression)
    symbolic_expression_tuple_length(node.expression)

symbolic_expression_tuple_length(node:any):
    node.kind??
        "tuple" => symbolic_tuple_length_merge(
            vkf_list_length(node.items),
            symbolic_expression_tuple_length_items(node.items, 0, 0)
        )
        "unary" => symbolic_expression_tuple_length(node.operand)
        "group" => symbolic_group_tuple_length(node)
        "binary" => symbolic_tuple_length_merge(
            symbolic_expression_tuple_length(node.left),
            symbolic_expression_tuple_length(node.right)
        )
        "call" => symbolic_expression_tuple_length_items(node.args, 0, 0)
        "vector" => symbolic_tuple_length_merge(
            symbolic_expression_tuple_length(node.x),
            symbolic_expression_tuple_length(node.y)
        )
        "range" => symbolic_static_range_length(node)
        "multiset" => 0
        "definition" => symbolic_expression_tuple_length(node.value)
        0

symbolic_tuple_lane_items(items:any, index:num, lane:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_tuple_lane(items.(index), lane)) & symbolic_tuple_lane_items(items, index + 1, lane)

symbolic_tuple_lane_binary(node:any, lane:num):
    left: symbolic_tuple_lane(node.left, lane)
    right: symbolic_tuple_lane(node.right, lane)
    node.implicit = true?
        @: symbolic_implicit_multiplication(left, right, node.location)
    symbolic_binary(node.op, left, right, node.location)

symbolic_group_tuple_lane(node:any, lane:num):
    node.expression.kind = "range"?
        @: symbolic_group(symbolic_static_range_lane(node.expression, lane), node.location)
    symbolic_group(symbolic_tuple_lane(node.expression, lane), node.location)

symbolic_tuple_lane(node:any, lane:num):
    node.kind??
        "tuple" => symbolic_tuple_lane(node.items.(lane), lane)
        "unary" => symbolic_unary(node.op, symbolic_tuple_lane(node.operand, lane), node.location)
        "group" => symbolic_group_tuple_lane(node, lane)
        "binary" => symbolic_tuple_lane_binary(node, lane)
        "call" => symbolic_call(node.name, symbolic_tuple_lane_items(node.args, 0, lane), node.location)
        "vector" => symbolic_vector_node(
            symbolic_tuple_lane(node.x, lane),
            symbolic_tuple_lane(node.y, lane),
            node.location
        )
        "range" => symbolic_static_range_lane(node, lane)
        "multiset" => node
        "definition" => symbolic_definition(
            node.name,
            node.parameters,
            symbolic_tuple_lane(node.value, lane),
            node.location
        )
