symbolic_tuple_lane_variants(ast:any, lane:num, tupleLength:num):
    lane >= tupleLength?
        @: vkf_list_empty()
    symbolic_ast_variants(symbolic_tuple_lane(ast, lane)) & symbolic_tuple_lane_variants(ast, lane + 1, tupleLength)

symbolic_geometry_preserves_tuples(classification:str):
    classification = "linked-tuple" \/ classification = "point-set"

symbolic_ast_items_contain_call(items:any, index:num):
    index >= vkf_list_length(items)?
        @: false
    symbolic_ast_contains_call(items.(index)) \/ symbolic_ast_items_contain_call(items, index + 1)

symbolic_ast_contains_call(node:any):
    node.kind??
        "call" => true
        "unary" => symbolic_ast_contains_call(node.operand)
        "group" => symbolic_ast_contains_call(node.expression)
        "binary" => symbolic_ast_contains_call(node.left) \/ symbolic_ast_contains_call(node.right)
        "tuple" => symbolic_ast_items_contain_call(node.items, 0)
        "vector" => symbolic_ast_contains_call(node.x) \/ symbolic_ast_contains_call(node.y)
        "range" => symbolic_ast_contains_call(node.start) \/ symbolic_ast_contains_call(node.end)
        "multiset" => symbolic_ast_items_contain_call(node.items, 0)
        "definition" => symbolic_ast_contains_call(node.value)
        false

symbolic_tuple_lanes_enabled(ast:any, classification:str):
    symbolic_geometry_preserves_tuples(classification)?
        @: false
    classification = "definition"?
        @: false
    classification = "literal"?
        @: symbolic_ast_contains_call(ast)
    enabled: true
    enabled

symbolic_program_variants(ast:any, classification:str):
    symbolic_tuple_lanes_enabled(ast, classification) = false?
        @: symbolic_ast_variants(ast)
    tupleLength: symbolic_expression_tuple_length(ast)
    tupleLength > 0?
        @: symbolic_tuple_lane_variants(ast, 0, tupleLength)
    symbolic_ast_variants(ast)

symbolic_group_variants(node:any, variants:any, index:num):
    index >= vkf_list_length(variants)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_group(variants.(index), node.location)) & symbolic_group_variants(node, variants, index + 1)

symbolic_empty_variables():
    vkf_list_empty()

symbolic_single_variable(name:str):
    vkf_list_single(name)

symbolic_variable_dependencies(name:str):
    name??
        "pi" => vkf_list_empty()
        "i" => vkf_list_empty()
        "r" => vkf_list_pair("x", "y")
        "phi" => vkf_list_pair("x", "y")
        symbolic_single_variable(name)

symbolic_is_power_family_collection(node:any):
    unwrapped: symbolic_ungroup(node)
    unwrapped.kind = "range" \/ unwrapped.kind = "multiset"

symbolic_ungroup(node:any):
    node.kind = "group"?
        @: symbolic_ungroup(node.expression)
    node

symbolic_is_y_of_x_power_family(ast:any):
    unwrapped: symbolic_ungroup(ast)
    unwrapped.kind = "binary" /\ unwrapped.op = "^" /\ symbolic_is_power_family_collection(unwrapped.right) /\ symbolic_power_base_has_x_only(unwrapped.left)

symbolic_is_x_of_y_power_family(ast:any):
    unwrapped: symbolic_ungroup(ast)
    unwrapped.kind = "binary" /\ unwrapped.op = "^" /\ symbolic_is_power_family_collection(unwrapped.right) /\ symbolic_power_base_has_y_only(unwrapped.left)

symbolic_power_base_has_x_only(base:any):
    variables: symbolic_variables(base)
    symbolic_list_contains(variables, 0, "x") /\ symbolic_list_contains(variables, 0, "y") = false /\ symbolic_list_contains(variables, 0, "z") = false

symbolic_power_base_has_y_only(base:any):
    variables: symbolic_variables(base)
    symbolic_list_contains(variables, 0, "y") /\ symbolic_list_contains(variables, 0, "x") = false /\ symbolic_list_contains(variables, 0, "z") = false

symbolic_variables_are_temporal_only(variables:any, index:num):
    index >= vkf_list_length(variables)?
        @: true
    current: variables.(index)
    (current = "t" \/ current = "n" \/ current = "N")?
        @: symbolic_variables_are_temporal_only(variables, index + 1)
    temporalOnly: false
    temporalOnly

symbolic_tuple_classification(variables:any, valueKind:str):
    symbolic_variables_are_temporal_only(variables, 0)?
        @: "linked-tuple"
    symbolic_variable_classification(variables, valueKind)

symbolic_classification(ast:any, variables:any, value_kind:str):
    symbolic_is_y_of_x_power_family(ast)?
        @: "y-of-x-family"
    symbolic_is_x_of_y_power_family(ast)?
        @: "x-of-y-family"
    ast.kind = "binary" /\ ast.op = "^" /\ ast.right.kind = "multiset"?
        @: "point-set"
    ast.kind = "binary" /\ ast.op = "^" /\ ast.right.kind = "tuple"?
        @: symbolic_tuple_classification(variables, value_kind)
    ast.kind??
        "definition" => "definition"
        "tuple" => symbolic_tuple_classification(variables, value_kind)
        "multiset" => symbolic_multiset_classification(variables, value_kind)
        "binary" => symbolic_binary_classification(ast, variables, value_kind)
        symbolic_variable_classification(variables, value_kind)

symbolic_multiset_classification(variables:any, valueKind:str):
    member_classification: symbolic_variable_classification(variables, valueKind)
    member_classification = "literal"?
        @: "point-set"
    member_classification

symbolic_binary_classification(ast:any, variables:any, valueKind:str):
    ast.op??
        "=" => "implicit-curve"
        "<" => "open-region"
        ">" => "open-region"
        "<=" => "closed-region"
        ">=" => "closed-region"
        "and" => symbolic_chained_relation_classification(ast)
        "or" => "boundary-constraint"
        symbolic_variable_classification(variables, valueKind)

symbolic_chained_relation_classification(ast:any):
    symbolic_chained_relation_is_open(ast)?
        @: "open-region"
    @: "closed-region"

symbolic_chained_relation_is_open(ast:any):
    ast.kind != "binary"?
        @: false
    ast.op = "<" \/ ast.op = ">"?
        @: true
    ast.op = "and"?
        @: symbolic_chained_relation_is_open(ast.left) \/ symbolic_chained_relation_is_open(ast.right)
    @: false

symbolic_parameter_variable_count(variables:any, index:num):
    index >= vkf_list_length(variables)?
        @: 0
    variables.(index) = "t" \/ variables.(index) = "n" \/ variables.(index) = "N"?
        @: symbolic_parameter_variable_count(variables, index + 1)
    rest: symbolic_parameter_variable_count(variables, index + 1)
    rest + 1

symbolic_variable_classification(variables:any, valueKind:str):
    has_x: symbolic_list_contains(variables, 0, "x")
    has_y: symbolic_list_contains(variables, 0, "y")
    has_z: symbolic_list_contains(variables, 0, "z")
    has_t: symbolic_list_contains(variables, 0, "t")
    parameter_count: symbolic_parameter_variable_count(variables, 0)
    valueKind = "complex"?
        has_x /\ has_y?
            @: "complex-field"
        parameter_count > 0?
            @: "parametric"
        @: "literal"
    valueKind = "vector"?
        has_x /\ has_y?
            @: "vector-field"
        parameter_count > 0?
            @: "parametric"
        @: "literal"
    has_x /\ has_y?
        @: "scalar-field"
    has_z?
        @: "scalar-field"
    has_x?
        @: "y-of-x"
    has_y?
        @: "x-of-y"
    @: "literal"

symbolic_compile(source:str):
    symbolic_compile_with_context(
        source,
        symbolic_global_context(),
        symbolic_no_clip()
    )

symbolic_compile_draft(source:str):
    lexed: symbolic_tokenize(source)
    symbolic_draft_tokens_ready(lexed.tokens) = false?
        @: symbolic_incomplete_draft(lexed)
    program: symbolic_compile(source)
    complete: vkf_list_length(program.diagnostics) = 0
    complete?
        @: symbolic_draft(
            program.latex,
            true,
            true,
            program.diagnostics
        )
    symbolic_uncompiled_draft(lexed, program.diagnostics)

symbolic_uncompiled_draft(lexed:any, diagnostics:any):
    symbolic_draft(
        symbolic_draft_latex_tokens(lexed.tokens, 0),
        false,
        true,
        diagnostics
    )

symbolic_draft_for_uncompiled(lexed:any, diagnostics:any):
    symbolic_draft_tokens_ready(lexed.tokens)?
        @: symbolic_uncompiled_draft(lexed, diagnostics)
    symbolic_incomplete_draft(lexed)

symbolic_incomplete_draft(lexed:any):
    eof: lexed.tokens.(vkf_list_length(lexed.tokens) - 1)
    issue: symbolic_diagnostic(
        "incomplete-expression",
        "expression can be completed",
        eof.location
    )
    symbolic_draft(
        symbolic_draft_latex_tokens(lexed.tokens, 0),
        false,
        true,
        lexed.diagnostics & [issue]
    )

symbolic_draft_tokens_ready(tokens:any):
    symbolic_draft_tokens_balanced(tokens, 0, 0, 0, 0) /\ symbolic_draft_last_token_ready(tokens, 0, "")

symbolic_draft_tokens_balanced(tokens:any, index:num, parens:num, brackets:num, braces:num):
    current: tokens.(index)
    current.kind??
        "EOF" => parens = 0 /\ brackets = 0 /\ braces = 0
        "LPAREN" => symbolic_draft_tokens_balanced(tokens, index + 1, parens + 1, brackets, braces)
        "RPAREN" => parens > 0 /\ symbolic_draft_tokens_balanced(tokens, index + 1, parens - 1, brackets, braces)
        "LBRACKET" => symbolic_draft_tokens_balanced(tokens, index + 1, parens, brackets + 1, braces)
        "RBRACKET" => brackets > 0 /\ symbolic_draft_tokens_balanced(tokens, index + 1, parens, brackets - 1, braces)
        "LBRACE" => symbolic_draft_tokens_balanced(tokens, index + 1, parens, brackets, braces + 1)
        "RBRACE" => braces > 0 /\ symbolic_draft_tokens_balanced(tokens, index + 1, parens, brackets, braces - 1)
        symbolic_draft_tokens_balanced(tokens, index + 1, parens, brackets, braces)

symbolic_draft_last_token_ready(tokens:any, index:num, previousKind:str):
    current: tokens.(index)
    current.kind = "EOF"?
        @: previousKind = "NUMBER" \/ previousKind = "IDENT" \/ previousKind = "RPAREN" \/ previousKind = "RBRACKET" \/ previousKind = "RBRACE"
    symbolic_draft_last_token_ready(tokens, index + 1, current.kind)

symbolic_draft(
    latex:str,
    isComplete:any,
    isRecoverable:any,
    diagnostics:any
):
    (
        latex: latex,
        complete: isComplete,
        recoverable: isRecoverable,
        diagnostics: diagnostics
    )

symbolic_draft_latex_tokens(tokens:any, index:num):
    current: tokens.(index)
    current.kind??
        "EOF" => ""
        "CARET" => symbolic_draft_power_latex(tokens, index)
        "IDENT" => symbolic_draft_identifier_tail_latex(tokens, index)
        "LPAREN" => symbolic_draft_parenthesized_latex(tokens, index)
        symbolic_draft_token_latex(tokens, index) & symbolic_draft_latex_tokens(
            tokens,
            index + 1
        )

symbolic_draft_parenthesized_latex(tokens:any, open:num):
    close: symbolic_draft_power_group_end(tokens, open + 1, 0)
    closer: symbolic_draft_call_closer(tokens, close)
    "\\left(" & symbolic_draft_latex_range(tokens, open + 1, close) & closer & symbolic_draft_latex_tokens(
        tokens,
        symbolic_draft_call_next(tokens, close)
    )

symbolic_draft_identifier_tail_latex(tokens:any, index:num):
    next: tokens.(index + 1)
    next.kind = "LPAREN"?
        preview: symbolic_draft_call_preview(tokens, index)
        @: preview.latex & symbolic_draft_latex_tokens(tokens, preview.next)
    symbolic_draft_identifier_latex(tokens, index) & symbolic_draft_latex_tokens(tokens, index + 1)

symbolic_draft_call_preview(tokens:any, index:num):
    name: tokens.(index).text
    open: index + 1
    close: symbolic_draft_call_end(tokens, open + 1, 0)
    latex: symbolic_draft_call_template_latex(name, tokens, open, close)
    (
        latex: latex,
        next: symbolic_draft_call_next(tokens, close)
    )

symbolic_draft_call_next(tokens:any, close:num):
    tokens.(close).kind = "RPAREN"?
        @: close + 1
    close

symbolic_draft_call_template_latex(name:str, tokens:any, open:num, close:num):
    name??
        "sum" => symbolic_draft_range_template_latex(tokens, open, "\\sum")
        "product" => symbolic_draft_range_template_latex(tokens, open, "\\prod")
        "integrate" => symbolic_draft_integral_template_latex(tokens, open)
        "integral" => symbolic_draft_integral_template_latex(tokens, open)
        "integ" => symbolic_draft_integral_template_latex(tokens, open)
        symbolic_function_application_latex(name) & "\\left(" & symbolic_draft_latex_range(tokens, open + 1, close) & symbolic_draft_call_closer(tokens, close)

symbolic_draft_call_closer(tokens:any, close:num):
    tokens.(close).kind = "RPAREN"?
        @: "\\right)"
    @: "\\right."

symbolic_draft_call_end(tokens:any, index:num, depth:num):
    current: tokens.(index)
    current.kind??
        "EOF" => index
        "LPAREN" => symbolic_draft_call_end(tokens, index + 1, depth + 1)
        "LBRACKET" => symbolic_draft_call_end(tokens, index + 1, depth + 1)
        "LBRACE" => symbolic_draft_call_end(tokens, index + 1, depth + 1)
        "RPAREN" => symbolic_draft_call_end_after_close(tokens, index, depth)
        "RBRACKET" => symbolic_draft_call_end(tokens, index + 1, depth - 1)
        "RBRACE" => symbolic_draft_call_end(tokens, index + 1, depth - 1)
        symbolic_draft_call_end(tokens, index + 1, depth)

symbolic_draft_call_end_after_close(tokens:any, index:num, depth:num):
    depth = 0?
        @: index
    symbolic_draft_call_end(tokens, index + 1, depth - 1)

symbolic_draft_call_argument_start(tokens:any, open:num, target:num):
    target = 0?
        @: open + 1
    symbolic_draft_call_argument_start_at(tokens, open + 1, target, 0)

symbolic_draft_call_argument_start_at(tokens:any, index:num, remaining:num, depth:num):
    current: tokens.(index)
    current.kind??
        "EOF" => -1
        "LPAREN" => symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth + 1)
        "LBRACKET" => symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth + 1)
        "LBRACE" => symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth + 1)
        "RPAREN" => symbolic_draft_argument_start_after_close(tokens, index, remaining, depth)
        "RBRACKET" => symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth - 1)
        "RBRACE" => symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth - 1)
        "COMMA" => symbolic_draft_argument_start_after_comma(tokens, index, remaining, depth)
        symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth)

symbolic_draft_argument_start_after_close(tokens:any, index:num, remaining:num, depth:num):
    depth = 0?
        @: -1
    symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth - 1)

symbolic_draft_argument_start_after_comma(tokens:any, index:num, remaining:num, depth:num):
    depth > 0?
        @: symbolic_draft_call_argument_start_at(tokens, index + 1, remaining, depth)
    remaining = 1?
        @: index + 1
    symbolic_draft_call_argument_start_at(tokens, index + 1, remaining - 1, depth)

symbolic_draft_call_argument_end(tokens:any, index:num, depth:num):
    current: tokens.(index)
    current.kind??
        "EOF" => index
        "COMMA" => symbolic_draft_argument_end_after_comma(tokens, index, depth)
        "LPAREN" => symbolic_draft_call_argument_end(tokens, index + 1, depth + 1)
        "LBRACKET" => symbolic_draft_call_argument_end(tokens, index + 1, depth + 1)
        "LBRACE" => symbolic_draft_call_argument_end(tokens, index + 1, depth + 1)
        "RPAREN" => symbolic_draft_argument_end_after_close(tokens, index, depth)
        "RBRACKET" => symbolic_draft_call_argument_end(tokens, index + 1, depth - 1)
        "RBRACE" => symbolic_draft_call_argument_end(tokens, index + 1, depth - 1)
        symbolic_draft_call_argument_end(tokens, index + 1, depth)

symbolic_draft_argument_end_after_comma(tokens:any, index:num, depth:num):
    depth = 0?
        @: index
    symbolic_draft_call_argument_end(tokens, index + 1, depth)

symbolic_draft_argument_end_after_close(tokens:any, index:num, depth:num):
    depth = 0?
        @: index
    symbolic_draft_call_argument_end(tokens, index + 1, depth - 1)

symbolic_draft_call_argument_latex(tokens:any, open:num, target:num):
    start: symbolic_draft_call_argument_start(tokens, open, target)
    start < 0?
        @: ""
    symbolic_draft_latex_range(tokens, start, symbolic_draft_call_argument_end(tokens, start, 0))

symbolic_draft_call_has_argument(tokens:any, open:num, target:num):
    symbolic_draft_call_argument_start(tokens, open, target) >= 0

symbolic_draft_range_template_latex(tokens:any, open:num, operator:str):
    body: symbolic_draft_call_argument_latex(tokens, open, 0)
    symbolic_draft_call_has_argument(tokens, open, 1) = false?
        @: operator & symbolic_draft_template_body_latex(body)
    variable: symbolic_draft_call_argument_latex(tokens, open, 1)
    lower: symbolic_draft_call_argument_latex(tokens, open, 2)
    upper: symbolic_draft_call_argument_latex(tokens, open, 3)
    limits: "_{" & variable & "=" & lower & "}"
    symbolic_draft_call_has_argument(tokens, open, 3)?
        @: operator & limits & "^{" & symbolic_draft_template_bound_latex(upper) & "}" & symbolic_draft_template_body_latex(body)
    operator & limits & symbolic_draft_template_body_latex(body)

symbolic_draft_integral_template_latex(tokens:any, open:num):
    body: symbolic_draft_call_argument_latex(tokens, open, 0)
    variable: symbolic_draft_call_argument_latex(tokens, open, 1)
    lower: symbolic_draft_call_argument_latex(tokens, open, 2)
    upper: symbolic_draft_call_argument_latex(tokens, open, 3)
    operator: symbolic_draft_integral_operator(tokens, open, lower, upper)
    differential: symbolic_draft_integral_differential(tokens, open, variable)
    operator & symbolic_draft_template_body_latex(body) & differential

symbolic_draft_integral_operator(tokens:any, open:num, lower:str, upper:str):
    lower_operator: symbolic_draft_integral_lower_operator(tokens, open, lower)
    symbolic_draft_call_has_argument(tokens, open, 3)?
        @: lower_operator & "^{" & symbolic_draft_template_bound_latex(upper) & "}"
    lower_operator

symbolic_draft_integral_lower_operator(tokens:any, open:num, lower:str):
    symbolic_draft_call_has_argument(tokens, open, 2)?
        @: "\\int_{" & lower & "}"
    operator: "\\int"
    operator

symbolic_draft_integral_differential(tokens:any, open:num, variable:str):
    symbolic_draft_call_has_argument(tokens, open, 1)?
        @: "\\,d" & variable
    empty: ""
    empty

symbolic_draft_template_body_latex(body:str):
    body = ""?
        @: ""
    padded: " " & body
    padded

symbolic_draft_template_bound_latex(bound:str):
    bound = "inf"?
        @: "\\infty"
    bound

symbolic_draft_latex_range(tokens:any, index:num, end:num):
    index >= end?
        @: ""
    current: tokens.(index)
    current.kind = "CARET"?
        @: symbolic_draft_power_latex_range(tokens, index, end)
    current.kind = "LPAREN"?
        @: symbolic_draft_parenthesized_latex_range(tokens, index, end)
    current.kind = "IDENT" /\ index + 1 < end /\ tokens.(index + 1).kind = "LPAREN"?
        preview: symbolic_draft_call_preview(tokens, index)
        @: preview.latex & symbolic_draft_latex_range(tokens, preview.next, end)
    symbolic_draft_token_latex(tokens, index) & symbolic_draft_latex_range(tokens, index + 1, end)

symbolic_draft_parenthesized_latex_range(tokens:any, open:num, end:num):
    close: symbolic_draft_power_group_end_range(tokens, open + 1, end, 0)
    closer: symbolic_draft_call_closer(tokens, close)
    "\\left(" & symbolic_draft_latex_range(tokens, open + 1, close) & closer & symbolic_draft_latex_range(
        tokens,
        symbolic_draft_call_next(tokens, close),
        end
    )

symbolic_draft_power_latex_range(tokens:any, index:num, end:num):
    index + 1 >= end?
        @: "^{}"
    next: tokens.(index + 1)
    next.kind??
        "NUMBER" => "^{" & next.text & "}" & symbolic_draft_latex_range(tokens, index + 2, end)
        "IDENT" => "^{" & symbolic_variable_latex(next.text) & "}" & symbolic_draft_latex_range(tokens, index + 2, end)
        "LPAREN" => symbolic_draft_parenthesized_power_latex_range(tokens, index + 1, end)
        "^{}" & symbolic_draft_latex_range(tokens, index + 1, end)

symbolic_draft_power_latex(tokens:any, index:num):
    next: tokens.(index + 1)
    next.kind??
        "NUMBER" => "^{" & next.text & "}" & symbolic_draft_latex_tokens(
            tokens,
            index + 2
        )
        "IDENT" => "^{" & symbolic_variable_latex(next.text) & "}" & symbolic_draft_latex_tokens(
            tokens,
            index + 2
        )
        "LPAREN" => symbolic_draft_parenthesized_power_latex(tokens, index + 1)
        "^{}" & symbolic_draft_latex_tokens(tokens, index + 1)

symbolic_draft_parenthesized_power_latex(tokens:any, open:num):
    close: symbolic_draft_power_group_end(tokens, open + 1, 0)
    "^{" & symbolic_draft_latex_range(tokens, open + 1, close) & "}" & symbolic_draft_latex_tokens(
        tokens,
        symbolic_draft_call_next(tokens, close)
    )

symbolic_draft_parenthesized_power_latex_range(tokens:any, open:num, end:num):
    close: symbolic_draft_power_group_end_range(tokens, open + 1, end, 0)
    "^{" & symbolic_draft_latex_range(tokens, open + 1, close) & "}" & symbolic_draft_latex_range(
        tokens,
        symbolic_draft_call_next(tokens, close),
        end
    )

symbolic_draft_power_group_end(tokens:any, index:num, depth:num):
    current: tokens.(index)
    current.kind??
        "EOF" => index
        "LPAREN" => symbolic_draft_power_group_end(tokens, index + 1, depth + 1)
        "RPAREN" => symbolic_draft_power_group_end_after_close(tokens, index, depth)
        symbolic_draft_power_group_end(tokens, index + 1, depth)

symbolic_draft_power_group_end_after_close(tokens:any, index:num, depth:num):
    depth = 0?
        @: index
    symbolic_draft_power_group_end(tokens, index + 1, depth - 1)

symbolic_draft_power_group_end_range(tokens:any, index:num, end:num, depth:num):
    index >= end?
        @: end
    current: tokens.(index)
    current.kind??
        "EOF" => index
        "LPAREN" => symbolic_draft_power_group_end_range(tokens, index + 1, end, depth + 1)
        "RPAREN" => symbolic_draft_power_group_end_range_after_close(tokens, index, end, depth)
        symbolic_draft_power_group_end_range(tokens, index + 1, end, depth)

symbolic_draft_power_group_end_range_after_close(tokens:any, index:num, end:num, depth:num):
    depth = 0?
        @: index
    symbolic_draft_power_group_end_range(tokens, index + 1, end, depth - 1)

symbolic_draft_token_latex(tokens:any, index:num):
    current: tokens.(index)
    current.kind??
        "NUMBER" => current.text
        "IDENT" => symbolic_draft_identifier_latex(tokens, index)
        "PLUS" => " + "
        "MINUS" => " - "
        "STAR" => " \\cdot "
        "SLASH" => "/"
        "LPAREN" => "("
        "RPAREN" => ")"
        "LBRACKET" => "["
        "RBRACKET" => "]"
        "LBRACE" => "\\{"
        "RBRACE" => "\\}"
        "COMMA" => ", "
        "RANGE" => ".."
        "EQ" => " = "
        "LT" => " < "
        "GT" => " > "
        "LE" => " \\le "
        "GE" => " \\ge "
        "OR" => " \\lor "
        current.text

symbolic_draft_identifier_latex(tokens:any, index:num):
    current: tokens.(index)
    next: tokens.(index + 1)
    next.kind = "LPAREN"?
        @: symbolic_function_latex(current.text)
    symbolic_variable_latex(current.text)

symbolic_compile_with_context(source:str, context:any, clip:any):
    lexed: symbolic_tokenize(source)
    parsed: symbolic_parse_tokens(lexed)
    semantic_ast: symbolic_strip_groups(parsed.ast)
    variables: symbolic_unique_variables(symbolic_variables(semantic_ast), 0, vkf_list_empty())
    active_context: symbolic_owned_context(context)
    value_kind: symbolic_value_kind_for_context(semantic_ast, active_context)
    classification: symbolic_classification(semantic_ast, variables, value_kind)
    symbolic_program(
        semantic_ast,
        parsed.next.diagnostics & symbolic_semantic_diagnostics(semantic_ast) & symbolic_tuple_length_diagnostics(semantic_ast, classification),
        symbolic_latex(parsed.ast),
        variables,
        classification,
        value_kind,
        active_context,
        clip
    )

symbolic_strip_groups(node:any):
    node.kind??
        "group" => symbolic_strip_groups(node.expression)
        "unary" => symbolic_unary(node.op, symbolic_strip_groups(node.operand), node.location)
        "binary" => symbolic_strip_groups_binary(node)
        "call" => symbolic_call(node.name, symbolic_strip_group_items(node.args, 0), node.location)
        "vector" => symbolic_vector_node(symbolic_strip_groups(node.x), symbolic_strip_groups(node.y), node.location)
        "range" => symbolic_range(symbolic_strip_groups(node.start), symbolic_strip_groups(node.end), node.location)
        "tuple" => symbolic_tuple(symbolic_strip_group_items(node.items, 0), node.location)
        "multiset" => symbolic_multiset(symbolic_strip_group_items(node.items, 0), node.location)
        "definition" => symbolic_definition(node.name, node.parameters, symbolic_strip_groups(node.value), node.location)
        node

symbolic_strip_groups_binary(node:any):
    left: symbolic_strip_groups(node.left)
    right: symbolic_strip_groups(node.right)
    node.implicit = true?
        @: symbolic_implicit_multiplication(left, right, node.location)
    symbolic_binary(node.op, left, right, node.location)

symbolic_strip_group_items(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    vkf_list_single(symbolic_strip_groups(items.(index))) & symbolic_strip_group_items(items, index + 1)

symbolic_program(
    ast:any,
    diagnostics:any,
    latex:str,
    variables:any,
    classification:str,
    valueKind:str,
    context:any,
    clip:any
):
    (
        ast: ast,
        variants: symbolic_program_variants(ast, classification),
        diagnostics: diagnostics,
        latex: latex,
        variables: variables,
        classification: classification,
        valueKind: valueKind,
        context: context,
        clip: clip
    )

symbolic_program_evaluate(program:SymbolicProgram, x:num, y:num):
    symbolic_program_evaluate_at(
        program,
        x,
        y,
        0,
        0,
        program.context,
        symbolic_workspace()
    )

symbolic_program_evaluate_at(
    program:SymbolicProgram,
    x:num,
    y:num,
    z:num,
    t:num,
    context:any,
    workspace:SymbolicWorkspace
):
    value: symbolic_raw_program_evaluate_at(program, x, y, z, t, context, workspace)
    symbolic_number_is_finite(value)?
        @: value
    program.classification = "y-of-x"?
        @: symbolic_recover_world_x_limit(program, x, y, z, t, context, workspace, value)
    program.classification = "x-of-y"?
        @: symbolic_recover_world_y_limit(program, x, y, z, t, context, workspace, value)
    value

symbolic_raw_program_evaluate_at(program:any, x:num, y:num, z:num, t:num, context:any, workspace:any):
    symbolic_evaluate(
        program.ast,
        symbolic_evaluation(x, y, z, t, context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )

symbolic_program_evaluate_local_at(
    program:SymbolicProgram,
    x:num,
    y:num,
    z:num,
    t:num,
    workspace:SymbolicWorkspace
):
    value: symbolic_raw_program_evaluate_local_at(program, x, y, z, t, workspace)
    symbolic_number_is_finite(value)?
        @: value
    program.classification = "y-of-x"?
        @: symbolic_recover_local_x_limit(program, x, y, z, t, workspace, value)
    program.classification = "x-of-y"?
        @: symbolic_recover_local_y_limit(program, x, y, z, t, workspace, value)
    value

symbolic_raw_program_evaluate_local_at(program:any, x:num, y:num, z:num, t:num, workspace:any):
    symbolic_evaluate(
        program.ast,
        symbolic_local_evaluation(x, y, z, t, program.context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )

symbolic_recover_world_x_limit(program:any, x:num, y:num, z:num, t:num, context:any, workspace:any, fallback:num):
    outerDelta: (1 + vkf_math_abs(x)) * 0.0001
    innerDelta: outerDelta / 2
    outerLeft: symbolic_raw_program_evaluate_at(program, x - outerDelta, y, z, t, context, workspace)
    outerRight: symbolic_raw_program_evaluate_at(program, x + outerDelta, y, z, t, context, workspace)
    innerLeft: symbolic_raw_program_evaluate_at(program, x - innerDelta, y, z, t, context, workspace)
    innerRight: symbolic_raw_program_evaluate_at(program, x + innerDelta, y, z, t, context, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    fallback

symbolic_recover_world_y_limit(program:any, x:num, y:num, z:num, t:num, context:any, workspace:any, fallback:num):
    outerDelta: (1 + vkf_math_abs(y)) * 0.0001
    innerDelta: outerDelta / 2
    outerLeft: symbolic_raw_program_evaluate_at(program, x, y - outerDelta, z, t, context, workspace)
    outerRight: symbolic_raw_program_evaluate_at(program, x, y + outerDelta, z, t, context, workspace)
    innerLeft: symbolic_raw_program_evaluate_at(program, x, y - innerDelta, z, t, context, workspace)
    innerRight: symbolic_raw_program_evaluate_at(program, x, y + innerDelta, z, t, context, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    fallback

symbolic_recover_local_x_limit(program:any, x:num, y:num, z:num, t:num, workspace:any, fallback:num):
    outerDelta: (1 + vkf_math_abs(x)) * 0.0001
    innerDelta: outerDelta / 2
    outerLeft: symbolic_raw_program_evaluate_local_at(program, x - outerDelta, y, z, t, workspace)
    outerRight: symbolic_raw_program_evaluate_local_at(program, x + outerDelta, y, z, t, workspace)
    innerLeft: symbolic_raw_program_evaluate_local_at(program, x - innerDelta, y, z, t, workspace)
    innerRight: symbolic_raw_program_evaluate_local_at(program, x + innerDelta, y, z, t, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    fallback

symbolic_recover_local_y_limit(program:any, x:num, y:num, z:num, t:num, workspace:any, fallback:num):
    outerDelta: (1 + vkf_math_abs(y)) * 0.0001
    innerDelta: outerDelta / 2
    outerLeft: symbolic_raw_program_evaluate_local_at(program, x, y - outerDelta, z, t, workspace)
    outerRight: symbolic_raw_program_evaluate_local_at(program, x, y + outerDelta, z, t, workspace)
    innerLeft: symbolic_raw_program_evaluate_local_at(program, x, y - innerDelta, z, t, workspace)
    innerRight: symbolic_raw_program_evaluate_local_at(program, x, y + innerDelta, z, t, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    fallback

symbolic_workspace_compile(
    workspace:SymbolicWorkspace,
    source:str,
    context:any,
    clip:any
):
    program: symbolic_compile_with_context(source, context, clip)
    handle: vkf_list_length(workspace)
    next_workspace: workspace & [program]
    (workspace: next_workspace, handle: handle, program: program)

symbolic_workspace_append(
    workspace:SymbolicWorkspace,
    source:str,
    context:any,
    clip:any
):
    symbolic_workspace_compile(workspace, source, context, clip).workspace

symbolic_workspace_latest_handle(workspace:SymbolicWorkspace):
    vkf_list_length(workspace) - 1

symbolic_workspace_latest_program(workspace:SymbolicWorkspace):
    symbolic_workspace_program(
        workspace,
        symbolic_workspace_latest_handle(workspace)
    )

symbolic_workspace_program(workspace:SymbolicWorkspace, handle:num):
    workspace.(handle)

symbolic_workspace_evaluate(
    workspace:SymbolicWorkspace,
    handle:num,
    x:num,
    y:num,
    z:num,
    t:num
):
    program: symbolic_workspace_program(workspace, handle)
    symbolic_program_evaluate_at(
        program,
        x,
        y,
        z,
        t,
        program.context,
        workspace
    )

symbolic_plot(
    program:SymbolicProgram,
    workspace:SymbolicWorkspace,
    view:any,
    style:any,
    revision:num
):
    builder: symbolic_plot_builder(
        symbolic_plot_capacity(program, workspace, view),
        revision
    )
    builder = null?
        @: null
    symbolic_has_analytical_variants(program)?
        @: symbolic_plot_analytical_variants(program, workspace, view, style, builder, 0, vkf_list_empty())
    symbolic_has_literal_variants(program)?
        @: symbolic_plot_literal_variants(program, workspace, view, style, builder, 0, vkf_list_empty())
    sampled: symbolic_plot_into_builder(
        program,
        workspace,
        view,
        style,
        builder
    )
    program.classification = "y-of-x-family" \/ program.classification = "x-of-y-family"?
        @: symbolic_curve_family_plot_result(program, workspace, view, sampled)
    symbolic_is_linked_power_collection(program.ast)?
        @: symbolic_linked_power_plot_result(program, workspace, view.t, sampled)
    program.ast.kind = "tuple"?
        @: symbolic_linked_tuple_plot_result(program, sampled)
    program.classification = "y-of-x"?
        markedX: symbolic_append_closed_x_constraint_points(program, workspace, view, style, sampled, 0)
        @: symbolic_constrained_curve_plot_result(markedX, "y-of-x", view.xSteps)
    program.classification = "x-of-y"?
        markedY: symbolic_append_closed_y_constraint_points(program, workspace, view, style, sampled, 0)
        @: symbolic_constrained_curve_plot_result(markedY, "x-of-y", view.ySteps)
    program.classification = "parametric"?
        markedParameter: symbolic_append_closed_parameter_constraint_points(
            program,
            workspace,
            view,
            style,
            sampled,
            symbolic_program_parameter_name(program),
            0
        )
        @: symbolic_constrained_curve_plot_result(markedParameter, "parametric", view.tSteps)
    program.classification = "closed-region"?
        @: symbolic_closed_region_plot_result(
            program,
            workspace,
            view,
            style,
            sampled
        )
    metadata: symbolic_plot_builder_metadata(sampled)
    symbolic_plot_result(metadata, program.classification)

symbolic_plot_variant(
    program:SymbolicProgram,
    workspace:SymbolicWorkspace,
    view:any,
    style:any,
    revision:num,
    variantIndex:num
):
    variantIndex < 0 \/ variantIndex >= vkf_list_length(program.variants)?
        @: null
    symbolic_plot(
        symbolic_variant_program(program, program.variants.(variantIndex)),
        workspace,
        view,
        style,
        revision
    )

symbolic_is_linked_power_collection(node:any):
    node.kind = "binary" /\ node.op = "^" /\ node.right.kind = "tuple"

symbolic_curve_family_points_per_curve(classification:str, view:any):
    classification = "y-of-x-family"?
        @: view.xSteps
    view.ySteps

symbolic_curve_family_plot_result(program:any, workspace:any, view:any, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    curveCount: symbolic_power_exponent_count(program.ast, program, workspace, view.t)
    pointsPerCurve: symbolic_curve_family_points_per_curve(program.classification, view)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_curve_family_ranges(curveCount, pointsPerCurve, 0)
    )

symbolic_curve_family_ranges(curveCount:num, pointsPerCurve:num, index:num):
    index >= curveCount?
        @: vkf_list_empty()
    current: vkf_list_single(
        (
            mode: "time-curve",
            part: "edge",
            first: index * pointsPerCurve,
            count: pointsPerCurve
        )
    )
    current & symbolic_curve_family_ranges(curveCount, pointsPerCurve, index + 1)

symbolic_linked_power_plot_result(program:any, workspace:any, frameTime:num, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    pointCount: symbolic_power_exponent_count(program.ast, program, workspace, frameTime)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_linked_literal_ranges(pointCount, complete.count)
    )

symbolic_linked_literal_ranges(pointCount:num, completeCount:num):
    points: vkf_list_single(
        (mode: "points", part: "edge", first: 0, count: pointCount)
    )
    edges: vkf_list_single(
        (
            mode: "linked-line-segments",
            part: "edge",
            first: pointCount,
            count: completeCount - pointCount
        )
    )
    points & edges

symbolic_linked_tuple_plot_result(program:any, builder:any):
    complete: symbolic_plot_builder_metadata(builder)
    pointCount: symbolic_literal_collection_point_count(program.ast.items, 0)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_linked_literal_ranges(pointCount, complete.count)
    )

symbolic_closed_region_plot_result(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any
):
    fillCount: builder.(2) + 0
    outlined: symbolic_sample_implicit(
        program,
        workspace,
        view,
        style,
        builder,
        0,
        0
    )
    complete: symbolic_plot_builder_metadata(outlined)
    (
        pointer: complete.pointer,
        count: complete.count,
        stride: complete.stride,
        revision: complete.revision,
        ranges: symbolic_closed_region_ranges(fillCount, complete.count)
    )

symbolic_closed_region_ranges(fillCount:num, completeCount:num):
    first: vkf_list_single(
        (
            mode: "triangles",
            part: "face",
            first: 0,
            count: fillCount
        )
    )
    second: vkf_list_single(
        (
            mode: "linked-line-segments",
            part: "edge",
            first: fillCount,
            count: completeCount - fillCount
        )
    )
    first & second

symbolic_plot_capacity(program:any, workspace:any, view:any):
    base: symbolic_plot_single_capacity(program, workspace, view)
    symbolic_has_analytical_variants(program) \/ symbolic_has_literal_variants(program)?
        @: base * vkf_list_length(program.variants)
    program.classification = "y-of-x" \/ program.classification = "x-of-y"?
        @: base + vkf_list_length(workspace)
    program.classification = "parametric"?
        @: base + symbolic_workspace_closed_parameter_boundary_count(
            workspace,
            symbolic_program_parameter_name(program),
            0
        )
    base

symbolic_plot_single_capacity(program:any, workspace:any, view:any):
    program.classification??
        "y-of-x-family" => symbolic_power_exponent_count(program.ast, program, workspace, view.t) * view.xSteps
        "x-of-y-family" => symbolic_power_exponent_count(program.ast, program, workspace, view.t) * view.ySteps
        "y-of-x" => view.xSteps
        "x-of-y" => view.ySteps
        "parametric" => view.tSteps
        "vector-field" => view.fieldXSteps * view.fieldYSteps * 6
        "scalar-field" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 6
        "complex-field" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 6
        "implicit-curve" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 4
        "open-region" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 6
        "closed-region" => (view.fieldXSteps - 1) * (view.fieldYSteps - 1) * 10
        1024

symbolic_has_analytical_variants(program:any):
    vkf_list_length(program.variants) > 1 /\ symbolic_is_analytical_classification(program.classification) /\ program.classification != "y-of-x-family" /\ program.classification != "x-of-y-family"

symbolic_has_literal_variants(program:any):
    vkf_list_length(program.variants) > 1 /\ symbolic_is_analytical_classification(program.classification) = false /\ program.classification != "y-of-x-family" /\ program.classification != "x-of-y-family"

symbolic_is_analytical_classification(classification:str):
    classification = "y-of-x" \/ classification = "x-of-y" \/ classification = "parametric" \/ classification = "vector-field" \/ classification = "scalar-field" \/ classification = "complex-field" \/ classification = "implicit-curve" \/ classification = "open-region" \/ classification = "closed-region"

symbolic_variant_program(program:any, ast:any):
    (
        ast: ast,
        variants: vkf_list_single(ast),
        diagnostics: program.diagnostics,
        latex: program.latex,
        variables: program.variables,
        classification: program.classification,
        valueKind: program.valueKind,
        context: program.context,
        clip: program.clip
    )

symbolic_compile_document(source:str, profile:str, context:any, clip:any):
    active_context: symbolic_document_context(context)
    active_clip: symbolic_document_clip(clip)
    normalized: symbolic_document_normalize_math(source, profile, 0)
    lexed: symbolic_tokenize(source)
    symbolic_document_math_end(source, 0, profile) = symbolic_document_source_end(source, 0) /\ symbolic_draft_tokens_ready(lexed.tokens) = false?
        @: symbolic_document_draft_result(source, symbolic_incomplete_draft(lexed))
    whole: symbolic_compile_with_context(normalized, active_context, active_clip)
    vkf_list_length(whole.diagnostics) = 0 /\ symbolic_document_program_supported(whole, profile)?
        entry: symbolic_document_program_entry(source, 0, symbolic_document_source_end(source, 0), whole)
        spans: vkf_list_single(symbolic_document_math_span(source, 0, symbolic_document_source_end(source, 0), whole, 0))
        @: symbolic_document_result(source, spans, vkf_list_single(entry))
    scanned: symbolic_document_scan(source, profile, active_context, active_clip, 0, 0, vkf_list_empty(), vkf_list_empty())
    symbolic_document_result(source, scanned.spans, scanned.programs)

symbolic_document_context(context:any):
    context = null?
        @: symbolic_global_context()
    context

symbolic_document_clip(clip:any):
    clip = null?
        @: symbolic_no_clip()
    clip

symbolic_document_scan(
    source:str,
    profile:str,
    context:any,
    clip:any,
    offset:num,
    textStart:num,
    spans:any,
    programs:any
):
    vkf_string_eof(source, offset)?
        final_spans: symbolic_document_flush_text(source, textStart, offset, spans)
        @: (spans: final_spans, programs: programs)
    ch: vkf_string_peek_scalar(source, offset)
    ch = 92?
        before_raw: symbolic_document_flush_text(source, textStart, offset, spans)
        raw_text: vkf_utf8_slice(source, offset, symbolic_document_source_end(source, 0))
        raw_span: symbolic_document_raw_span(raw_text, offset, symbolic_document_source_end(source, 0))
        @: (spans: before_raw & [raw_span], programs: programs)
    ch = 47 /\ symbolic_document_slash_command_end(source, offset) > offset + 1?
        command_end: symbolic_document_slash_command_end(source, offset)
        before_command: symbolic_document_flush_text(source, textStart, offset, spans)
        command_source: vkf_utf8_slice(source, offset, command_end)
        command_span: symbolic_document_command_span(command_source, offset, command_end)
        @: symbolic_document_scan(
            source,
            profile,
            context,
            clip,
            command_end,
            command_end,
            before_command & [command_span],
            programs
        )
    symbolic_document_math_anchor(source, offset, profile)?
        math_end: symbolic_document_math_end(source, offset, profile)
        math_source: vkf_utf8_slice(source, offset, math_end)
        normalized_math: symbolic_document_normalize_math(math_source, profile, 0)
        compiled: symbolic_compile_with_context(normalized_math, context, clip)
        vkf_list_length(compiled.diagnostics) = 0 /\ symbolic_document_program_supported(compiled, profile)?
            before_math: symbolic_document_flush_text(source, textStart, offset, spans)
            program_index: vkf_list_length(programs)
            math_span: symbolic_document_math_span(math_source, offset, math_end, compiled, program_index)
            entry: symbolic_document_program_entry(math_source, offset, math_end, compiled)
            @: symbolic_document_scan(
                source,
                profile,
                context,
                clip,
                math_end,
                math_end,
                before_math & [math_span],
                programs & [entry]
            )
        math_lexed: symbolic_tokenize(math_source)
        before_draft: symbolic_document_flush_text(source, textStart, offset, spans)
        math_draft: symbolic_draft_for_uncompiled(math_lexed, compiled.diagnostics)
        draft_span: symbolic_document_math_draft_span(math_source, offset, math_end, math_draft)
        @: symbolic_document_scan(
            source,
            profile,
            context,
            clip,
            math_end,
            math_end,
            before_draft & [draft_span],
            programs
        )

    symbolic_document_scan(
        source,
        profile,
        context,
        clip,
        symbolic_document_advance(source, offset),
        textStart,
        spans,
        programs
    )

symbolic_document_advance(source:str, offset:num):
    vkf_utf8_advance(source, offset)

symbolic_document_source_end(source:str, offset:num):
    vkf_string_eof(source, offset)?
        @: offset
    symbolic_document_source_end(source, symbolic_document_advance(source, offset))

symbolic_document_flush_text(source:str, start:num, stop:num, spans:any):
    stop <= start?
        @: spans
    text: vkf_utf8_slice(source, start, stop)
    spans & [symbolic_document_text_span(text, start, stop)]

symbolic_document_text_span(source:str, start:num, stop:num):
    (
        kind: "text",
        source: source,
        start: start,
        end: stop,
        latex: "\\mathrm{" & symbolic_document_text_latex(source, 0) & "}",
        executable: false,
        roles: vkf_list_single(symbolic_document_role("text", source, start, stop))
    )

symbolic_document_raw_span(source:str, start:num, stop:num):
    (
        kind: "raw-katex",
        source: source,
        start: start,
        end: stop,
        latex: source,
        executable: false,
        roles: vkf_list_single(symbolic_document_role("raw-katex", source, start, stop))
    )

symbolic_document_command_span(source:str, start:num, stop:num):
    name: vkf_utf8_slice(source, 1, symbolic_document_source_end(source, 0))
    command: symbolic_document_command_latex(name)
    (
        kind: "raw-katex",
        source: source,
        start: start,
        end: stop,
        latex: command,
        executable: false,
        roles: vkf_list_single(symbolic_document_role("command", source, start, stop))
    )

symbolic_document_command_latex(name:str):
    name = "a"?
        @: "a"
    name = "i"?
        @: "i"
    name = "I"?
        @: "I"
    vkf_utf8_slice("\\mathrm", 0, 1) & name

symbolic_document_math_span(source:str, start:num, stop:num, program:any, programIndex:num):
    (
        kind: "math",
        source: source,
        start: start,
        end: stop,
        latex: program.latex,
        executable: true,
        programIndex: programIndex,
        roles: symbolic_document_math_roles(symbolic_tokenize(source).tokens, start, 0)
    )

symbolic_document_math_draft_span(source:str, start:num, stop:num, draft:any):
    (
        kind: "math-draft",
        source: source,
        start: start,
        end: stop,
        latex: draft.latex,
        executable: false,
        diagnostics: draft.diagnostics,
        roles: symbolic_document_math_roles(symbolic_tokenize(source).tokens, start, 0)
    )

symbolic_document_draft_result(source:str, draft:any):
    (
        source: source,
        latex: draft.latex,
        spans: vkf_list_single(symbolic_document_math_draft_span(source, 0, symbolic_document_source_end(source, 0), draft)),
        programs: vkf_list_empty(),
        program: null,
        diagnostics: draft.diagnostics,
        complete: false,
        recoverable: draft.recoverable,
        plottable: false
    )
symbolic_document_program_entry(source:str, start:num, stop:num, program:any):
    (
        source: source,
        start: start,
        end: stop,
        program: program
    )

symbolic_document_result(source:str, spans:any, programs:any):
    aggregate: symbolic_document_aggregate_program(programs)
    (
        source: source,
        latex: symbolic_document_spans_latex(spans, 0),
        spans: spans,
        programs: programs,
        program: aggregate,
        diagnostics: symbolic_document_spans_diagnostics(spans, 0),
        complete: symbolic_document_spans_complete(spans, 0),
        recoverable: true,
        plottable: symbolic_document_programs_plottable(programs, 0)
    )

symbolic_document_spans_complete(spans:any, index:num):
    index >= vkf_list_length(spans)?
        @: true
    spans.(index).kind = "math-draft"?
        @: false
    symbolic_document_spans_complete(spans, index + 1)

symbolic_document_spans_diagnostics(spans:any, index:num):
    index >= vkf_list_length(spans)?
        @: vkf_list_empty()
    current: spans.(index)
    current.kind = "math-draft"?
        @: current.diagnostics & symbolic_document_spans_diagnostics(spans, index + 1)
    symbolic_document_spans_diagnostics(spans, index + 1)

symbolic_document_spans_latex(spans:any, index:num):
    index >= vkf_list_length(spans)?
        @: ""
    spans.(index).latex & symbolic_document_spans_latex(spans, index + 1)

symbolic_document_programs_plottable(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: false
    symbolic_program_is_plottable(programs.(index).program)?
        @: true
    symbolic_document_programs_plottable(programs, index + 1)

symbolic_program_is_plottable(program:any):
    program.classification != "definition" /\ vkf_list_length(program.diagnostics) = 0

symbolic_document_aggregate_program(programs:any):
    vkf_list_length(programs) = 0?
        @: null
    vkf_list_length(programs) = 1?
        @: programs.(0).program
    members: symbolic_document_program_values(programs, 0)
    (
        ast: (kind: "group", items: symbolic_document_program_asts(programs, 0)),
        variants: symbolic_document_program_variants(programs, 0),
        diagnostics: vkf_list_empty(),
        latex: symbolic_document_program_latex(programs, 0),
        variables: symbolic_document_program_variables(programs, 0),
        classification: "plot-group",
        valueKind: "group",
        context: programs.(0).program.context,
        clip: programs.(0).program.clip,
        members: members
    )

symbolic_document_program_values(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: vkf_list_empty()
    vkf_list_single(programs.(index).program) & symbolic_document_program_values(programs, index + 1)

symbolic_document_program_asts(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: vkf_list_empty()
    vkf_list_single(programs.(index).program.ast) & symbolic_document_program_asts(programs, index + 1)

symbolic_document_program_variants(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: vkf_list_empty()
    programs.(index).program.variants & symbolic_document_program_variants(programs, index + 1)

symbolic_document_program_latex(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: ""
    tail: symbolic_document_program_latex(programs, index + 1)
    tail = ""?
        @: programs.(index).program.latex
    programs.(index).program.latex & ", " & tail

symbolic_document_program_variables(programs:any, index:num):
    index >= vkf_list_length(programs)?
        @: vkf_list_empty()
    programs.(index).program.variables & symbolic_document_program_variables(programs, index + 1)

symbolic_document_math_anchor(source:str, offset:num, profile:str):
    offset > 0 /\ symbolic_is_identifier_start(vkf_string_peek_scalar(source, offset - 1))?
        @: false
    ch: vkf_string_peek_scalar(source, offset)
    symbolic_is_identifier_start(ch) = false?
        @: false
    end: vkf_identifier_scan_end(source, offset)
    name: vkf_utf8_slice(source, offset, end)
    symbolic_document_known_identifier(name, profile) \/ symbolic_document_identifier_is_call(source, end)

symbolic_document_known_identifier(name:str, profile:str):
    name = "x" \/ name = "y" \/ name = "z" \/ name = "t" \/ name = "r" \/ name = "e" \/ name = "i" \/ symbolic_greek_identifier(name) \/ (profile = "platonic" /\ symbolic_document_platonic_implicit_product(name) != "")

symbolic_document_platonic_implicit_product(name:str):
    name??
        "xy" => "x y"
        "ix" => "i x"
        "xi" => "x i"
        "iy" => "i y"
        "yi" => "y i"
        "iz" => "i z"
        "zi" => "z i"
        ""

symbolic_document_program_supported(program:any, profile:str):
    profile != "platonic"?
        @: true
    symbolic_document_variables_supported(program.variables, 0, profile)

symbolic_document_variables_supported(variables:any, index:num, profile:str):
    index >= vkf_list_length(variables)?
        @: true
    name: variables.(index)
    supported: symbolic_document_known_identifier(name, profile)
    supported /\ symbolic_document_variables_supported(variables, index + 1, profile)

symbolic_document_identifier_is_call(source:str, offset:num):
    vkf_string_eof(source, offset)?
        @: false
    vkf_string_peek_scalar(source, offset) = 40

symbolic_document_math_end(source:str, offset:num, profile:str):
    symbolic_document_math_end_at(source, offset, profile, false)

symbolic_document_math_end_at(source:str, offset:num, profile:str, consumed:any):
    vkf_string_eof(source, offset)?
        @: offset
    ch: vkf_string_peek_scalar(source, offset)
    symbolic_is_space(ch)?
        next: symbolic_document_skip_spaces(source, offset)
        vkf_string_eof(source, next)?
            @: offset
        symbolic_document_math_continues_at(source, next, profile)?
            @: symbolic_document_math_end_at(source, next, profile, consumed)
        @: offset
    symbolic_is_identifier_start(ch)?
        end: vkf_identifier_scan_end(source, offset)
        name: vkf_utf8_slice(source, offset, end)
        consumed \/ symbolic_document_known_identifier(name, profile) \/ symbolic_document_identifier_is_call(source, end)?
            @: symbolic_document_math_end_at(source, end, profile, true)
        @: offset
    symbolic_is_digit(ch)?
        scanned: symbolic_scan_number(symbolic_location_cursor(source, offset, 1, offset + 1))
        @: symbolic_document_math_end_at(source, scanned.next.offset, profile, true)
    symbolic_document_math_operator(ch)?
        @: symbolic_document_math_end_at(source, symbolic_document_advance(source, offset), profile, true)
    offset

symbolic_document_math_continues_at(source:str, offset:num, profile:str):
    ch: vkf_string_peek_scalar(source, offset)
    symbolic_is_identifier_start(ch) = false?
        @: symbolic_is_digit(ch) \/ symbolic_document_math_operator(ch)
    end: vkf_identifier_scan_end(source, offset)
    name: vkf_utf8_slice(source, offset, end)
    symbolic_document_known_identifier(name, profile) \/ symbolic_document_identifier_is_call(source, end)

symbolic_document_math_operator(ch:num):
    ch = 43 \/ ch = 45 \/ ch = 42 \/ ch = 47 \/ ch = 94 \/ ch = 40 \/ ch = 41 \/ ch = 91 \/ ch = 93 \/ ch = 123 \/ ch = 125 \/ ch = 44 \/ ch = 46 \/ ch = 61 \/ ch = 60 \/ ch = 62

symbolic_document_skip_spaces(source:str, offset:num):
    vkf_string_eof(source, offset)?
        @: offset
    symbolic_is_space(vkf_string_peek_scalar(source, offset))?
        @: symbolic_document_skip_spaces(source, symbolic_document_advance(source, offset))
    offset

symbolic_document_slash_command_end(source:str, offset:num):
    next: symbolic_document_advance(source, offset)
    vkf_string_eof(source, next)?
        @: next
    symbolic_is_identifier_start(vkf_string_peek_scalar(source, next))?
        @: vkf_identifier_scan_end(source, next)
    next

symbolic_document_normalize_math(source:str, profile:str, offset:num):
    vkf_string_eof(source, offset)?
        @: ""
    ch: vkf_string_peek_scalar(source, offset)
    symbolic_is_identifier_start(ch)?
        end: vkf_identifier_scan_end(source, offset)
        name: vkf_utf8_slice(source, offset, end)
        normalized: symbolic_document_normalized_identifier(name, profile)
        @: normalized & symbolic_document_normalize_math(source, profile, end)
    next: symbolic_document_advance(source, offset)
    vkf_utf8_slice(source, offset, next) & symbolic_document_normalize_math(source, profile, next)

symbolic_document_normalized_identifier(name:str, profile:str):
    implicit_product: symbolic_document_platonic_implicit_product(name)
    profile = "platonic" /\ implicit_product != ""?
        @: implicit_product
    name

symbolic_document_text_latex(source:str, offset:num):
    vkf_string_eof(source, offset)?
        @: ""
    ch: vkf_string_peek_scalar(source, offset)
    next: symbolic_document_advance(source, offset)
    symbolic_document_text_scalar_latex(ch, vkf_utf8_slice(source, offset, next)) & symbolic_document_text_latex(source, next)

symbolic_document_text_scalar_latex(ch:num, scalar:str):
    ch??
        32 => "\\ "
        9 => "\\ "
        10 => "\\\\"
        13 => ""
        35 => "\\#"
        36 => "\\$"
        37 => "\\%"
        38 => "\\&"
        95 => "\\_"
        123 => "\\{"
        125 => "\\}"
        scalar

symbolic_document_math_roles(tokens:any, base:num, index:num):
    current: tokens.(index)
    current.kind = "EOF"?
        @: vkf_list_empty()
    role_kind: symbolic_document_token_role(tokens, index)
    start: base + current.location.offset
    stop: start + symbolic_document_source_end(current.text, 0)
    vkf_list_single(symbolic_document_role(role_kind, current.text, start, stop)) & symbolic_document_math_roles(tokens, base, index + 1)

symbolic_document_token_role(tokens:any, index:num):
    current: tokens.(index)
    current.kind??
        "NUMBER" => "literal"
        "IDENT" => symbolic_document_identifier_role(tokens, index)
        "LPAREN" => "wrapper"
        "RPAREN" => "wrapper"
        "LBRACKET" => "wrapper"
        "RBRACKET" => "wrapper"
        "LBRACE" => "wrapper"
        "RBRACE" => "wrapper"
        "COMMA" => "separator"
        "operator"

symbolic_document_identifier_role(tokens:any, index:num):
    next: tokens.(index + 1)
    next.kind??
        "LPAREN" => "function"
        symbolic_document_non_function_identifier_role(tokens.(index))

symbolic_document_non_function_identifier_role(current:any):
    current.text??
        "pi" => "literal"
        "i" => "literal"
        "variable"

symbolic_document_role(kind:str, source:str, start:num, stop:num):
    (kind: kind, source: source, start: start, end: stop)

symbolic_plot_analytical_variants(program:any, workspace:any, view:any, style:any, builder:any, index:num, ranges:any):
    index >= vkf_list_length(program.variants)?
        metadata: symbolic_plot_builder_metadata(builder)
        @: (
            pointer: metadata.pointer,
            count: metadata.count,
            stride: metadata.stride,
            revision: metadata.revision,
            ranges: ranges
        )
    variant: symbolic_variant_program(program, program.variants.(index))
    first: builder.(2) + 0
    sampled: symbolic_plot_into_builder(variant, workspace, view, style, builder)
    program.classification = "closed-region"?
        faceEnd: sampled.(2) + 0
        outlined: symbolic_sample_implicit(variant, workspace, view, style, sampled, 0, 0)
        nextRanges: ranges & symbolic_variant_closed_ranges(first, faceEnd, outlined.(2))
        @: symbolic_plot_analytical_variants(program, workspace, view, style, outlined, index + 1, nextRanges)
    last: sampled.(2) + 0
    nextRange: vkf_list_single((
        mode: symbolic_plot_mode(program.classification),
        part: symbolic_plot_part(program.classification),
        first: first,
        count: last - first
    ))
    symbolic_plot_analytical_variants(program, workspace, view, style, sampled, index + 1, ranges & nextRange)

symbolic_variant_closed_ranges(first:num, faceEnd:num, end:num):
    vkf_list_pair(
        (mode: "triangles", part: "face", first: first, count: faceEnd - first),
        (mode: "linked-line-segments", part: "edge", first: faceEnd, count: end - faceEnd)
    )

symbolic_plot_literal_variants(program:any, workspace:any, view:any, style:any, builder:any, index:num, ranges:any):
    index >= vkf_list_length(program.variants)?
        metadata: symbolic_plot_builder_metadata(builder)
        @: (
            pointer: metadata.pointer,
            count: metadata.count,
            stride: metadata.stride,
            revision: metadata.revision,
            ranges: ranges
        )
    ast: program.variants.(index)
    variant: symbolic_variant_program(program, ast)
    first: builder.(2) + 0
    plotted: symbolic_plot_literal(variant, workspace, view.t, style, builder)
    last: plotted.(2) + 0
    nextRanges: ranges & symbolic_literal_variant_ranges(ast, variant, workspace, view.t, first, last)
    symbolic_plot_literal_variants(program, workspace, view, style, plotted, index + 1, nextRanges)

symbolic_literal_variant_ranges(ast:any, program:any, workspace:any, frameTime:num, first:num, last:num):
    symbolic_is_linked_power_collection(ast)?
        pointCount: symbolic_power_exponent_count(ast, program, workspace, frameTime)
        @: symbolic_offset_linked_literal_ranges(first, pointCount, last)
    ast.kind = "tuple"?
        tuplePointCount: symbolic_literal_collection_point_count(ast.items, 0)
        @: symbolic_offset_linked_literal_ranges(first, tuplePointCount, last)
    vkf_list_single((mode: "points", part: "edge", first: first, count: last - first))

symbolic_offset_linked_literal_ranges(first:num, pointCount:num, last:num):
    points: vkf_list_single((mode: "points", part: "edge", first: first, count: pointCount))
    edges: vkf_list_single((mode: "linked-line-segments", part: "edge", first: first + pointCount, count: last - first - pointCount))
    points & edges

symbolic_plot_result(metadata:any, classification:str):
    metadata = null?
        @: null
    symbolic_plot_result_record(metadata, classification)

symbolic_plot_result_record(metadata:any, classification:str):
    (
        pointer: metadata.pointer,
        count: metadata.count,
        stride: metadata.stride,
        revision: metadata.revision,
        ranges: symbolic_plot_ranges(classification, metadata.count)
    )

symbolic_plot_ranges(classification:str, count:num):
    vkf_list_single(
        (
            mode: symbolic_plot_mode(classification),
            part: symbolic_plot_part(classification),
            first: 0,
            count: count
        )
    )

symbolic_plot_mode(classification:str):
    classification??
        "literal" => "points"
        "point-set" => "points"
        "linked-tuple" => "linked-line-segments"
        "y-of-x-family" => "time-curve"
        "x-of-y-family" => "time-curve"
        "y-of-x" => "time-curve"
        "x-of-y" => "time-curve"
        "parametric" => "time-curve"
        "implicit-curve" => "linked-line-segments"
        "scalar-field" => "scalar-field-triangles"
        "complex-field" => "scalar-field-triangles"
        "vector-field" => "vector-field-glyphs"
        "open-region" => "triangles"
        "closed-region" => "triangles"
        "triangles"

symbolic_plot_part(classification:str):
    classification??
        "open-region" => "face"
        "closed-region" => "face"
        "scalar-field" => "face"
        "complex-field" => "face"
        "edge"

symbolic_plot_into_builder(
    program:SymbolicProgram,
    workspace:SymbolicWorkspace,
    view:any,
    style:any,
    builder:any
):
    program.classification??
        "y-of-x-family" => symbolic_sample_explicit_x_family(program, workspace, view, style, builder, 0, 0)
        "x-of-y-family" => symbolic_sample_explicit_y_family(program, workspace, view, style, builder, 0, 0)
        "y-of-x" => symbolic_sample_explicit_x(program, workspace, view, style, builder, 0)
        "x-of-y" => symbolic_sample_explicit_y(program, workspace, view, style, builder, 0)
        "parametric" => symbolic_sample_parametric(program, workspace, view, style, builder, 0)
        "vector-field" => symbolic_plot_vector_field(program, workspace, view, style, builder)
        "scalar-field" => symbolic_sample_scalar_field(program, workspace, view, style, builder, 0, 0)
        "complex-field" => symbolic_sample_complex_field(program, workspace, view, style, builder, 0, 0)
        "implicit-curve" => symbolic_sample_implicit(program, workspace, view, style, builder, 0, 0)
        "open-region" => symbolic_sample_region(program, workspace, view, style, builder, 0, 0)
        "closed-region" => symbolic_sample_region(program, workspace, view, style, builder, 0, 0)
        "boundary-constraint" => builder
        symbolic_plot_literal(program, workspace, view.t, style, builder)

symbolic_power_family_value(program:any, workspace:any, x:num, y:num, frameTime:num, exponentIndex:num):
    evaluation: symbolic_local_evaluation(x, y, 0, frameTime, program.context)
    base: symbolic_evaluate(
        program.ast.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    exponent: symbolic_power_exponents(program.ast, program, workspace, frameTime).(exponentIndex)
    baseKind: symbolic_value_kind_for_context(program.ast.left, program.context)
    symbolic_power_collection_value(base, baseKind, exponent)

symbolic_sample_chunk_end(index:num, count:num):
    end: index + 64
    end > count?
        @: count
    end

symbolic_sample_explicit_x_family(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num):
    exponentIndex >= symbolic_power_exponent_count(program.ast, program, workspace, view.t)?
        @: builder
    index >= view.xSteps?
        @: symbolic_sample_explicit_x_family(program, workspace, view, style, builder, exponentIndex + 1, 0)
    stop: symbolic_sample_chunk_end(index, view.xSteps)
    sampled: symbolic_sample_explicit_x_family_chunk(program, workspace, view, style, builder, exponentIndex, index, stop)
    symbolic_sample_explicit_x_family(program, workspace, view, style, sampled, exponentIndex, stop)

symbolic_sample_explicit_x_family_chunk(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num, stop:num):
    index >= stop?
        @: builder
    x: symbolic_sample_coordinate(view.xMin, view.xMax, view.xSteps, index)
    y: symbolic_power_family_value(program, workspace, x, 0, view.t, exponentIndex)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_x_family_chunk(program, workspace, view, style, pushed, exponentIndex, index + 1, stop)

symbolic_sample_explicit_y_family(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num):
    exponentIndex >= symbolic_power_exponent_count(program.ast, program, workspace, view.t)?
        @: builder
    index >= view.ySteps?
        @: symbolic_sample_explicit_y_family(program, workspace, view, style, builder, exponentIndex + 1, 0)
    stop: symbolic_sample_chunk_end(index, view.ySteps)
    sampled: symbolic_sample_explicit_y_family_chunk(program, workspace, view, style, builder, exponentIndex, index, stop)
    symbolic_sample_explicit_y_family(program, workspace, view, style, sampled, exponentIndex, stop)

symbolic_sample_explicit_y_family_chunk(program:any, workspace:any, view:any, style:any, builder:any, exponentIndex:num, index:num, stop:num):
    index >= stop?
        @: builder
    y: symbolic_sample_coordinate(view.yMin, view.yMax, view.ySteps, index)
    x: symbolic_power_family_value(program, workspace, 0, y, view.t, exponentIndex)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_y_family_chunk(program, workspace, view, style, pushed, exponentIndex, index + 1, stop)

symbolic_sample_explicit_x(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.xSteps?
        @: builder
    stop: symbolic_sample_chunk_end(index, view.xSteps)
    sampled: symbolic_sample_explicit_x_chunk(program, workspace, view, style, builder, index, stop)
    symbolic_sample_explicit_x(program, workspace, view, style, sampled, stop)

symbolic_sample_explicit_x_chunk(program:any, workspace:any, view:any, style:any, builder:any, index:num, stop:num):
    index >= stop?
        @: builder
    x: symbolic_sample_coordinate(view.xMin, view.xMax, view.xSteps, index)
    rawY: symbolic_program_evaluate_local_at(
        program,
        x,
        0,
        0,
        view.t,
        workspace
    )
    resolvedY: symbolic_resolve_explicit_x_sample(program, workspace, view, x, rawY)
    allowed: symbolic_workspace_point_within_constraints(program, workspace, x, resolvedY, 0, view.t, vkf_list_empty(), vkf_list_empty(), 0)
    y: symbolic_constrained_value(allowed, resolvedY)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_x_chunk(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1,
        stop
    )

symbolic_sample_explicit_y(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.ySteps?
        @: builder
    stop: symbolic_sample_chunk_end(index, view.ySteps)
    sampled: symbolic_sample_explicit_y_chunk(program, workspace, view, style, builder, index, stop)
    symbolic_sample_explicit_y(program, workspace, view, style, sampled, stop)

symbolic_sample_explicit_y_chunk(program:any, workspace:any, view:any, style:any, builder:any, index:num, stop:num):
    index >= stop?
        @: builder
    y: symbolic_sample_coordinate(view.yMin, view.yMax, view.ySteps, index)
    rawX: symbolic_program_evaluate_local_at(
        program,
        0,
        y,
        0,
        view.t,
        workspace
    )
    resolvedX: symbolic_resolve_explicit_y_sample(program, workspace, view, y, rawX)
    allowed: symbolic_workspace_point_within_constraints(program, workspace, resolvedX, y, 0, view.t, vkf_list_empty(), vkf_list_empty(), 0)
    x: symbolic_constrained_value(allowed, resolvedX)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    symbolic_sample_explicit_y_chunk(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1,
        stop
    )

symbolic_number_is_finite(value:num):
    value = value /\ value - value = 0

symbolic_limit_pair_converges(outerLeft:num, outerRight:num, innerLeft:num, innerRight:num):
    outerAverage: (outerLeft + outerRight) / 2
    innerAverage: (innerLeft + innerRight) / 2
    tolerance: 0.00001 * (1 + vkf_math_abs(innerAverage))
    vkf_math_abs(outerAverage - innerAverage) <= tolerance

symbolic_constrained_value(allowed:bit, value:num):
    allowed?
        @: value
    zero: 0
    zero / zero

symbolic_workspace_point_within_constraints(program:any, workspace:any, localX:num, localY:num, z:num, t:num, parameterNames:any, parameterValues:any, index:num):
    index >= vkf_list_length(workspace)?
        @: 1 = 1
    constraint: workspace.(index)
    constraint.classification = "open-region" \/ constraint.classification = "closed-region" \/ constraint.classification = "boundary-constraint"?
        worldX: program.context.originX + program.context.basisXX * localX + program.context.basisYX * localY
        worldY: program.context.originY + program.context.basisXY * localX + program.context.basisYY * localY
        symbolic_constraint_contains_or_borders(constraint, workspace, worldX, worldY, z, t, parameterNames, parameterValues)?
            @: symbolic_workspace_point_within_constraints(program, workspace, localX, localY, z, t, parameterNames, parameterValues, index + 1)
        @: 0 = 1
    symbolic_workspace_point_within_constraints(program, workspace, localX, localY, z, t, parameterNames, parameterValues, index + 1)

symbolic_constraint_contains_or_borders(constraint:any, workspace:any, worldX:num, worldY:num, z:num, t:num, parameterNames:any, parameterValues:any):
    evaluation: symbolic_evaluation(worldX, worldY, z, t, constraint.context)
    symbolic_constraint_ast_contains_or_borders(constraint.ast, evaluation, workspace, parameterNames, parameterValues)

symbolic_constraint_ast_contains_or_borders(ast:any, evaluation:any, workspace:any, parameterNames:any, parameterValues:any):
    ast.kind = "binary" /\ ast.op = "and"?
        @: symbolic_constraint_ast_contains_or_borders(ast.left, evaluation, workspace, parameterNames, parameterValues) /\ symbolic_constraint_ast_contains_or_borders(ast.right, evaluation, workspace, parameterNames, parameterValues)
    ast.kind = "binary" /\ ast.op = "or"?
        @: symbolic_constraint_ast_contains_or_borders(ast.left, evaluation, workspace, parameterNames, parameterValues) \/ symbolic_constraint_ast_contains_or_borders(ast.right, evaluation, workspace, parameterNames, parameterValues)
    value: symbolic_evaluate(ast, evaluation, workspace, parameterNames, parameterValues)
    value?
        @: 1 = 1
    left: symbolic_evaluate(ast.left, evaluation, workspace, parameterNames, parameterValues)
    right: symbolic_evaluate(ast.right, evaluation, workspace, parameterNames, parameterValues)
    tolerance: 0.000000001 * (1 + vkf_math_abs(left) + vkf_math_abs(right))
    vkf_math_abs(left - right) <= tolerance

symbolic_simple_closed_x_boundary(constraint:any, workspace:any, frameTime:num):
    constraint.classification != "closed-region"?
        @: null
    constraint.ast.left.kind = "variable" /\ constraint.ast.left.name = "x" /\ symbolic_list_contains(symbolic_variables(constraint.ast.right), 0, "x") = false /\ symbolic_list_contains(symbolic_variables(constraint.ast.right), 0, "y") = false?
        @: symbolic_evaluate(constraint.ast.right, symbolic_local_evaluation(0, 0, 0, frameTime, constraint.context), workspace, vkf_list_empty(), vkf_list_empty())
    constraint.ast.right.kind = "variable" /\ constraint.ast.right.name = "x" /\ symbolic_list_contains(symbolic_variables(constraint.ast.left), 0, "x") = false /\ symbolic_list_contains(symbolic_variables(constraint.ast.left), 0, "y") = false?
        @: symbolic_evaluate(constraint.ast.left, symbolic_local_evaluation(0, 0, 0, frameTime, constraint.context), workspace, vkf_list_empty(), vkf_list_empty())
    missing: null
    missing

symbolic_simple_closed_y_boundary(constraint:any, workspace:any, frameTime:num):
    constraint.classification != "closed-region"?
        @: null
    constraint.ast.left.kind = "variable" /\ constraint.ast.left.name = "y" /\ symbolic_list_contains(symbolic_variables(constraint.ast.right), 0, "x") = false /\ symbolic_list_contains(symbolic_variables(constraint.ast.right), 0, "y") = false?
        @: symbolic_evaluate(constraint.ast.right, symbolic_local_evaluation(0, 0, 0, frameTime, constraint.context), workspace, vkf_list_empty(), vkf_list_empty())
    constraint.ast.right.kind = "variable" /\ constraint.ast.right.name = "y" /\ symbolic_list_contains(symbolic_variables(constraint.ast.left), 0, "x") = false /\ symbolic_list_contains(symbolic_variables(constraint.ast.left), 0, "y") = false?
        @: symbolic_evaluate(constraint.ast.left, symbolic_local_evaluation(0, 0, 0, frameTime, constraint.context), workspace, vkf_list_empty(), vkf_list_empty())
    missing: null
    missing

symbolic_append_closed_x_constraint_points(program:any, workspace:any, view:any, style:any, builder:any, index:num):
    index >= vkf_list_length(workspace)?
        @: builder
    boundary: symbolic_simple_closed_x_boundary(workspace.(index), workspace, view.t)
    boundary = null \/ boundary < view.xMin \/ boundary > view.xMax?
        @: symbolic_append_closed_x_constraint_points(program, workspace, view, style, builder, index + 1)
    y: symbolic_program_evaluate_local_at(program, boundary, 0, 0, view.t, workspace)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(boundary, y, style))
    symbolic_append_closed_x_constraint_points(program, workspace, view, style, pushed, index + 1)

symbolic_append_closed_y_constraint_points(program:any, workspace:any, view:any, style:any, builder:any, index:num):
    index >= vkf_list_length(workspace)?
        @: builder
    boundary: symbolic_simple_closed_y_boundary(workspace.(index), workspace, view.t)
    boundary = null \/ boundary < view.yMin \/ boundary > view.yMax?
        @: symbolic_append_closed_y_constraint_points(program, workspace, view, style, builder, index + 1)
    x: symbolic_program_evaluate_local_at(program, 0, boundary, 0, view.t, workspace)
    pushed: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, boundary, style))
    symbolic_append_closed_y_constraint_points(program, workspace, view, style, pushed, index + 1)

symbolic_workspace_closed_parameter_boundary_count(workspace:any, parameterName:str, index:num):
    index >= vkf_list_length(workspace)?
        @: 0
    current: symbolic_closed_parameter_boundary_count(workspace.(index).ast, parameterName)
    current + symbolic_workspace_closed_parameter_boundary_count(workspace, parameterName, index + 1)

symbolic_closed_parameter_boundary_count(ast:any, parameterName:str):
    ast.kind != "binary"?
        @: 0
    ast.op = "and" \/ ast.op = "or"?
        @: symbolic_closed_parameter_boundary_count(ast.left, parameterName) + symbolic_closed_parameter_boundary_count(ast.right, parameterName)
    ast.op != "<=" /\ ast.op != ">=" /\ ast.op != "="?
        @: 0
    boundary: symbolic_parameter_boundary_expression(ast, parameterName)
    boundary = null?
        @: 0
    count: 1
    count

symbolic_parameter_boundary_expression(ast:any, parameterName:str):
    ast.left.kind = "variable" /\ ast.left.name = parameterName /\ symbolic_list_contains(symbolic_variables(ast.right), 0, parameterName) = false?
        @: ast.right
    ast.right.kind = "variable" /\ ast.right.name = parameterName /\ symbolic_list_contains(symbolic_variables(ast.left), 0, parameterName) = false?
        @: ast.left
    missing: null
    missing

symbolic_append_closed_parameter_constraint_points(program:any, workspace:any, view:any, style:any, builder:any, parameterName:str, index:num):
    index >= vkf_list_length(workspace)?
        @: builder
    marked: symbolic_append_closed_parameter_ast_points(
        program,
        workspace.(index).ast,
        workspace,
        view,
        style,
        builder,
        parameterName
    )
    symbolic_append_closed_parameter_constraint_points(program, workspace, view, style, marked, parameterName, index + 1)

symbolic_append_closed_parameter_ast_points(program:any, ast:any, workspace:any, view:any, style:any, builder:any, parameterName:str):
    ast.kind != "binary"?
        @: builder
    ast.op = "and" \/ ast.op = "or"?
        leftMarked: symbolic_append_closed_parameter_ast_points(program, ast.left, workspace, view, style, builder, parameterName)
        @: symbolic_append_closed_parameter_ast_points(program, ast.right, workspace, view, style, leftMarked, parameterName)
    ast.op != "<=" /\ ast.op != ">=" /\ ast.op != "="?
        @: builder
    expression: symbolic_parameter_boundary_expression(ast, parameterName)
    expression = null?
        @: builder
    boundary: symbolic_evaluate(
        expression,
        symbolic_local_evaluation(0, 0, 0, view.t, program.context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    boundary < view.tMin \/ boundary > view.tMax?
        @: builder
    value: symbolic_program_evaluate_parameter_at(program, boundary, view.t, workspace)
    point: symbolic_plot_point(value, boundary)
    symbolic_plot_builder_push(builder, symbolic_line_vertex(point.(0), point.(1), style))

symbolic_constrained_curve_plot_result(builder:any, classification:str, lineCount:num):
    metadata: symbolic_plot_builder_metadata(builder)
    pointCount: metadata.count - lineCount
    lineRange: vkf_list_single((mode: "time-curve", part: "edge", first: 0, count: lineCount))
    pointCount > 0?
        pointsRange: vkf_list_single((mode: "points", part: "edge", first: lineCount, count: pointCount))
        @: (pointer: metadata.pointer, count: metadata.count, stride: metadata.stride, revision: metadata.revision, ranges: lineRange & pointsRange)
    lineOnly: (pointer: metadata.pointer, count: metadata.count, stride: metadata.stride, revision: metadata.revision, ranges: lineRange)
    lineOnly

symbolic_resolve_explicit_x_sample(program:any, workspace:any, view:any, x:num, value:num):
    symbolic_number_is_finite(value)?
        @: value
    step: vkf_math_abs(view.xMax - view.xMin) / (view.xSteps - 1)
    outerDelta: step / 1024
    innerDelta: outerDelta / 2
    outerLeft: symbolic_program_evaluate_local_at(program, x - outerDelta, 0, 0, view.t, workspace)
    outerRight: symbolic_program_evaluate_local_at(program, x + outerDelta, 0, 0, view.t, workspace)
    innerLeft: symbolic_program_evaluate_local_at(program, x - innerDelta, 0, 0, view.t, workspace)
    innerRight: symbolic_program_evaluate_local_at(program, x + innerDelta, 0, 0, view.t, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    value

symbolic_resolve_explicit_y_sample(program:any, workspace:any, view:any, y:num, value:num):
    symbolic_number_is_finite(value)?
        @: value
    step: vkf_math_abs(view.yMax - view.yMin) / (view.ySteps - 1)
    outerDelta: step / 1024
    innerDelta: outerDelta / 2
    outerLeft: symbolic_program_evaluate_local_at(program, 0, y - outerDelta, 0, view.t, workspace)
    outerRight: symbolic_program_evaluate_local_at(program, 0, y + outerDelta, 0, view.t, workspace)
    innerLeft: symbolic_program_evaluate_local_at(program, 0, y - innerDelta, 0, view.t, workspace)
    innerRight: symbolic_program_evaluate_local_at(program, 0, y + innerDelta, 0, view.t, workspace)
    symbolic_limit_pair_converges(outerLeft, outerRight, innerLeft, innerRight)?
        @: (innerLeft + innerRight) / 2
    value

symbolic_sample_parametric(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    index:num
):
    index >= view.tSteps?
        @: builder
    parameter: symbolic_sample_coordinate(view.tMin, view.tMax, view.tSteps, index)
    value: symbolic_program_evaluate_parameter_at(
        program,
        parameter,
        view.t,
        workspace
    )
    point: symbolic_plot_point(value, parameter)
    parameterName: symbolic_program_parameter_name(program)
    parameterNames: vkf_list_single(parameterName)
    parameterValues: vkf_list_single(parameter)
    allowed: symbolic_workspace_point_within_constraints(
        program,
        workspace,
        point.(0),
        point.(1),
        0,
        view.t,
        parameterNames,
        parameterValues,
        0
    )
    pushed: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(
            symbolic_constrained_value(allowed, point.(0)),
            symbolic_constrained_value(allowed, point.(1)),
            style
        )
    )
    symbolic_sample_parametric(
        program,
        workspace,
        view,
        style,
        pushed,
        index + 1
    )

symbolic_program_evaluate_parameter_at(
    program:any,
    parameter:num,
    frameTime:num,
    workspace:any
):
    parameterName: symbolic_program_parameter_name(program)
    symbolic_evaluate(
        program.ast,
        symbolic_local_evaluation(0, 0, 0, frameTime, program.context),
        workspace,
        vkf_list_single(parameterName),
        vkf_list_single(parameter)
    )

symbolic_program_parameter_name(program:any):
    symbolic_parameter_name(program.variables, 0)

symbolic_parameter_name(variables:any, index:num):
    index >= vkf_list_length(variables)?
        @: "x"
    name: variables.(index)
    name = "t" \/ name = "n" \/ name = "N"?
        @: symbolic_parameter_name(variables, index + 1)
    name

symbolic_plot_point(value:any, parameter:num):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(parameter, value)

symbolic_literal_point(value:any):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(value, 0)

symbolic_plot_vector_field(program:any, workspace:any, view:any, style:any, builder:any):
    maximum: symbolic_vector_field_max_magnitude(program, workspace, view, 0, 0, 0)
    symbolic_sample_vector_field(program, workspace, view, style, builder, 0, 0, maximum)

symbolic_vector_field_max_magnitude(
    program:any,
    workspace:any,
    view:any,
    xIndex:num,
    yIndex:num,
    maximum:num
):
    xIndex >= view.fieldXSteps?
        @: maximum
    yIndex >= view.fieldYSteps?
        @: symbolic_vector_field_max_magnitude(program, workspace, view, xIndex + 1, 0, maximum)
    x: view.fieldXMin + xIndex * view.fieldXInterval
    y: view.fieldYMin + yIndex * view.fieldYInterval
    value: symbolic_program_evaluate_local_at(program, x, y, 0, view.t, workspace)
    vector: symbolic_plot_vector(value)
    magnitude: vkf_math_sqrt(vector.(0) * vector.(0) + vector.(1) * vector.(1))
    magnitude > maximum?
        @: symbolic_vector_field_max_magnitude(program, workspace, view, xIndex, yIndex + 1, magnitude)
    symbolic_vector_field_max_magnitude(program, workspace, view, xIndex, yIndex + 1, maximum)

symbolic_sample_vector_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num,
    maximum:num
):
    maximum <= 0.000000001?
        @: builder
    xIndex >= view.fieldXSteps?
        @: builder
    yIndex >= view.fieldYSteps?
        @: symbolic_sample_vector_field(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0,
            maximum
        )
    x: view.fieldXMin + xIndex * view.fieldXInterval
    y: view.fieldYMin + yIndex * view.fieldYInterval
    value: symbolic_program_evaluate_local_at(
        program,
        x,
        y,
        0,
        view.t,
        workspace
    )
    vector: symbolic_plot_vector(value)
    scale: view.vectorScale / maximum
    glyph: symbolic_push_vector_glyph(
        builder,
        x,
        y,
        vector.(0),
        vector.(1),
        scale,
        view.vectorArrowLength,
        view.vectorArrowWidth,
        style
    )
    symbolic_sample_vector_field(
        program,
        workspace,
        view,
        style,
        glyph,
        xIndex,
        yIndex + 1,
        maximum
    )

symbolic_push_vector_glyph(
    builder:any,
    x:num,
    y:num,
    vx:num,
    vy:num,
    scale:num,
    arrowLength:num,
    arrowWidth:num,
    style:any
):
    endX: x + vx * scale
    endY: y + vy * scale
    shaftStart: symbolic_plot_builder_push(builder, symbolic_line_vertex(x, y, style))
    shaft: symbolic_plot_builder_push(shaftStart, symbolic_line_vertex(endX, endY, style))
    magnitude: vkf_math_sqrt(vx * vx + vy * vy)
    magnitude <= 0.000000001?
        @: shaft
    ux: vx / magnitude
    uy: vy / magnitude
    backX: endX - ux * arrowLength
    backY: endY - uy * arrowLength
    leftX: backX - uy * arrowWidth
    leftY: backY + ux * arrowWidth
    rightX: backX + uy * arrowWidth
    rightY: backY - ux * arrowWidth
    leftStart: symbolic_plot_builder_push(shaft, symbolic_line_vertex(endX, endY, style))
    left: symbolic_plot_builder_push(leftStart, symbolic_line_vertex(leftX, leftY, style))
    rightStart: symbolic_plot_builder_push(left, symbolic_line_vertex(endX, endY, style))
    symbolic_plot_builder_push(rightStart, symbolic_line_vertex(rightX, rightY, style))

symbolic_plot_vector(value:any):
    value.kind??
        "complex" => vkf_list_pair(value.real, value.imaginary)
        "vector" => vkf_list_pair(value.x, value.y)
        vkf_list_pair(0, 0)

symbolic_sample_scalar_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    symbolic_sample_color_field(program, workspace, view, style, builder, xIndex, yIndex, false)

symbolic_sample_complex_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    symbolic_sample_color_field(program, workspace, view, style, builder, xIndex, yIndex, true)

symbolic_sample_color_field(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num,
    complexField:bit
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_color_field(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0,
            complexField
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    v00: symbolic_program_evaluate_local_at(program, x0, y0, 0, view.t, workspace)
    v10: symbolic_program_evaluate_local_at(program, x1, y0, 0, view.t, workspace)
    v11: symbolic_program_evaluate_local_at(program, x1, y1, 0, view.t, workspace)
    v01: symbolic_program_evaluate_local_at(program, x0, y1, 0, view.t, workspace)
    cell: symbolic_push_color_field_cell(
        builder,
        x0,
        y0,
        x1,
        y1,
        v00,
        v10,
        v11,
        v01,
        style,
        complexField
    )
    symbolic_sample_color_field(
        program,
        workspace,
        view,
        style,
        cell,
        xIndex,
        yIndex + 1,
        complexField
    )

symbolic_push_color_field_cell(
    builder:any,
    x0:num,
    y0:num,
    x1:num,
    y1:num,
    v00:any,
    v10:any,
    v11:any,
    v01:any,
    style:any,
    complexField:bit
):
    bottomLeft: symbolic_color_field_vertex(x0, y0, v00, style, complexField)
    bottomRight: symbolic_color_field_vertex(x1, y0, v10, style, complexField)
    topRight: symbolic_color_field_vertex(x1, y1, v11, style, complexField)
    topLeft: symbolic_color_field_vertex(x0, y1, v01, style, complexField)
    first: symbolic_plot_builder_push(builder, bottomLeft)
    second: symbolic_plot_builder_push(first, bottomRight)
    third: symbolic_plot_builder_push(second, topRight)
    fourth: symbolic_plot_builder_push(third, bottomLeft)
    fifth: symbolic_plot_builder_push(fourth, topRight)
    symbolic_plot_builder_push(fifth, topLeft)

symbolic_sample_implicit(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_implicit(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    v00: symbolic_relation_residual(program, workspace, x0, y0, view.t)
    v10: symbolic_relation_residual(program, workspace, x1, y0, view.t)
    v11: symbolic_relation_residual(program, workspace, x1, y1, view.t)
    v01: symbolic_relation_residual(program, workspace, x0, y1, view.t)
    cell: symbolic_push_implicit_cell(
        builder,
        x0,
        y0,
        x1,
        y1,
        v00,
        v10,
        v11,
        v01,
        style
    )
    symbolic_sample_implicit(
        program,
        workspace,
        view,
        style,
        cell,
        xIndex,
        yIndex + 1
    )

symbolic_relation_residual(program:any, workspace:any, x:num, y:num, t:num):
    evaluation: symbolic_local_evaluation(x, y, 0, t, program.context)
    left: symbolic_evaluate(
        program.ast.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    right: symbolic_evaluate(
        program.ast.right,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    left - right

symbolic_push_implicit_cell(
    builder:any,
    x0:num,
    y0:num,
    x1:num,
    y1:num,
    v00:num,
    v10:num,
    v11:num,
    v01:num,
    style:any
):
    caseIndex: symbolic_implicit_case(v00, v10, v11, v01)
    bottom: symbolic_implicit_intersection(x0, y0, v00, x1, y0, v10)
    right: symbolic_implicit_intersection(x1, y0, v10, x1, y1, v11)
    top: symbolic_implicit_intersection(x1, y1, v11, x0, y1, v01)
    left: symbolic_implicit_intersection(x0, y1, v01, x0, y0, v00)
    caseIndex??
        1 => symbolic_push_segment(builder, bottom, left, style)
        2 => symbolic_push_segment(builder, bottom, right, style)
        3 => symbolic_push_segment(builder, left, right, style)
        4 => symbolic_push_segment(builder, right, top, style)
        5 => symbolic_push_two_segments(builder, bottom, right, top, left, style)
        6 => symbolic_push_segment(builder, bottom, top, style)
        7 => symbolic_push_segment(builder, left, top, style)
        8 => symbolic_push_segment(builder, left, top, style)
        9 => symbolic_push_segment(builder, bottom, top, style)
        10 => symbolic_push_two_segments(builder, bottom, left, right, top, style)
        11 => symbolic_push_segment(builder, right, top, style)
        12 => symbolic_push_segment(builder, left, right, style)
        13 => symbolic_push_segment(builder, bottom, right, style)
        14 => symbolic_push_segment(builder, bottom, left, style)
        builder

symbolic_implicit_case(v00:num, v10:num, v11:num, v01:num):
    symbolic_sign_bit(v00) + symbolic_sign_bit(v10) * 2 + symbolic_sign_bit(v11) * 4 + symbolic_sign_bit(v01) * 8

symbolic_sign_bit(value:num):
    value >= 0?
        @: 1
    value - value

symbolic_implicit_intersection(
    x0:num,
    y0:num,
    value0:num,
    x1:num,
    y1:num,
    value1:num
):
    ratio: value0 / (value0 - value1)
    vkf_list_pair(
        x0 + (x1 - x0) * ratio,
        y0 + (y1 - y0) * ratio
    )

symbolic_push_segment(builder:any, first:any, second:any, style:any):
    start: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(first.(0), first.(1), style)
    )
    symbolic_plot_builder_push(
        start,
        symbolic_line_vertex(second.(0), second.(1), style)
    )

symbolic_push_two_segments(
    builder:any,
    first:any,
    second:any,
    third:any,
    fourth:any,
    style:any
):
    one: symbolic_push_segment(builder, first, second, style)
    symbolic_push_segment(one, third, fourth, style)

symbolic_sample_region(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num
):
    xIndex >= view.fieldXSteps - 1?
        @: builder
    yIndex >= view.fieldYSteps - 1?
        @: symbolic_sample_region(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex + 1,
            0
        )
    x0: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex)
    x1: symbolic_sample_coordinate(view.xMin, view.xMax, view.fieldXSteps, xIndex + 1)
    y0: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex)
    y1: symbolic_sample_coordinate(view.yMin, view.yMax, view.fieldYSteps, yIndex + 1)
    center: symbolic_program_evaluate_local_at(
        program,
        (x0 + x1) / 2,
        (y0 + y1) / 2,
        0,
        view.t,
        workspace
    )
    center?
        @: symbolic_region_cell_and_rest(
            program,
            workspace,
            view,
            style,
            builder,
            xIndex,
            yIndex,
            x0,
            y0,
            x1,
            y1
        )
    symbolic_sample_region(
        program,
        workspace,
        view,
        style,
        builder,
        xIndex,
        yIndex + 1
    )

symbolic_region_cell_and_rest(
    program:any,
    workspace:any,
    view:any,
    style:any,
    builder:any,
    xIndex:num,
    yIndex:num,
    x0:num,
    y0:num,
    x1:num,
    y1:num
):
    filled: symbolic_push_face_cell(builder, x0, y0, x1, y1, style)
    symbolic_sample_region(
        program,
        workspace,
        view,
        style,
        filled,
        xIndex,
        yIndex + 1
    )

symbolic_push_face_cell(builder:any, x0:num, y0:num, x1:num, y1:num, style:any):
    first: symbolic_plot_builder_push(builder, symbolic_face_vertex(x0, y0, style))
    second: symbolic_plot_builder_push(first, symbolic_face_vertex(x1, y0, style))
    third: symbolic_plot_builder_push(second, symbolic_face_vertex(x1, y1, style))
    fourth: symbolic_plot_builder_push(third, symbolic_face_vertex(x0, y0, style))
    fifth: symbolic_plot_builder_push(fourth, symbolic_face_vertex(x1, y1, style))
    symbolic_plot_builder_push(fifth, symbolic_face_vertex(x0, y1, style))

symbolic_plot_literal(program:any, workspace:any, frameTime:num, style:any, builder:any):
    program.ast.kind = "binary" /\ program.ast.op = "^" /\ program.ast.right.kind = "multiset"?
        @: symbolic_plot_power_points(program.ast, program, workspace, frameTime, style, builder)
    symbolic_is_linked_power_collection(program.ast)?
        points: symbolic_plot_power_points(program.ast, program, workspace, frameTime, style, builder)
        @: symbolic_plot_power_segments(program.ast, program, workspace, frameTime, style, points, 0)
    program.ast.kind = "tuple"?
        tuplePoints: symbolic_plot_set_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
        @: symbolic_plot_tuple_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            tuplePoints,
            0
        )
    program.ast.kind = "multiset"?
        @: symbolic_plot_set_items(
            program.ast.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    point: symbolic_node_plot_point(program.ast, program, workspace, frameTime)
    symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )

symbolic_power_exponents(node:any, program:any, workspace:any, frameTime:num):
    evaluation: symbolic_local_evaluation(0, 0, 0, frameTime, program.context)
    node.right.kind = "range"?
        @: symbolic_evaluate(
            node.right,
            evaluation,
            workspace,
            vkf_list_empty(),
            vkf_list_empty()
        )
    symbolic_power_exponent_items(node.right.items, 0, evaluation, workspace)

symbolic_power_exponent_items(items:any, index:num, evaluation:any, workspace:any):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: symbolic_power_exponent_values(items.(index), evaluation, workspace)
    current & symbolic_power_exponent_items(items, index + 1, evaluation, workspace)

symbolic_power_exponent_values(node:any, evaluation:any, workspace:any):
    value: symbolic_evaluate(
        node,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    node.kind = "range"?
        @: value
    vkf_list_single(value)

symbolic_power_exponent_count(node:any, program:any, workspace:any, frameTime:num):
    vkf_list_length(symbolic_power_exponents(node, program, workspace, frameTime))

symbolic_power_collection_point(node:any, program:any, workspace:any, index:num, frameTime:num):
    evaluation: symbolic_local_evaluation(0, 0, 0, frameTime, program.context)
    base: symbolic_evaluate(
        node.left,
        evaluation,
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    exponent: symbolic_power_exponents(node, program, workspace, frameTime).(index)
    baseKind: symbolic_value_kind_for_context(node.left, program.context)
    value: symbolic_power_collection_value(base, baseKind, exponent)
    symbolic_literal_point(value)

symbolic_power_collection_value(base:any, baseKind:str, exponent:num):
    baseKind = "complex"?
        @: symbolic_complex_power(
            symbolic_as_complex(base, baseKind),
            symbolic_complex(exponent, 0)
        )
    symbolic_real_power(base, exponent)

symbolic_plot_power_points(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    symbolic_plot_power_points_at(node, program, workspace, frameTime, style, builder, 0)

symbolic_plot_power_points_at(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= symbolic_power_exponent_count(node, program, workspace, frameTime)?
        @: builder
    point: symbolic_power_collection_point(node, program, workspace, index, frameTime)
    pushed: symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )
    symbolic_plot_power_points_at(node, program, workspace, frameTime, style, pushed, index + 1)

symbolic_plot_power_segments(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index + 1 >= symbolic_power_exponent_count(node, program, workspace, frameTime)?
        @: builder
    first: symbolic_power_collection_point(node, program, workspace, index, frameTime)
    second: symbolic_power_collection_point(node, program, workspace, index + 1, frameTime)
    linked: symbolic_push_segment(builder, first, second, style)
    symbolic_plot_power_segments(node, program, workspace, frameTime, style, linked, index + 1)

symbolic_plot_tuple_items(
    items:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= vkf_list_length(items)?
        @: builder
    nested: symbolic_plot_nested_tuple(
        items.(index),
        program,
        workspace,
        frameTime,
        style,
        builder
    )
    index + 1 >= vkf_list_length(items)?
        @: nested
    first: symbolic_node_plot_point(items.(index), program, workspace, frameTime)
    second: symbolic_node_plot_point(items.(index + 1), program, workspace, frameTime)
    linked: symbolic_push_segment(nested, first, second, style)
    symbolic_plot_tuple_items(
        items,
        program,
        workspace,
        frameTime,
        style,
        linked,
        index + 1
    )

symbolic_plot_nested_tuple(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    node.kind = "tuple"?
        @: symbolic_plot_tuple_items(
            node.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    builder

symbolic_plot_set_items(
    items:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any,
    index:num
):
    index >= vkf_list_length(items)?
        @: builder
    pushed: symbolic_plot_set_node(
        items.(index),
        program,
        workspace,
        frameTime,
        style,
        builder
    )
    symbolic_plot_set_items(
        items,
        program,
        workspace,
        frameTime,
        style,
        pushed,
        index + 1
    )

symbolic_literal_collection_point_count(items:any, index:num):
    index >= vkf_list_length(items)?
        @: 0
    node: items.(index)
    nestedCount: symbolic_literal_node_point_count(node)
    nestedCount + symbolic_literal_collection_point_count(items, index + 1)

symbolic_literal_node_point_count(node:any):
    node.kind??
        "tuple" => symbolic_literal_collection_point_count(node.items, 0)
        "multiset" => symbolic_literal_collection_point_count(node.items, 0)
        1

symbolic_plot_set_node(
    node:any,
    program:any,
    workspace:any,
    frameTime:num,
    style:any,
    builder:any
):
    node.kind = "tuple" \/ node.kind = "multiset"?
        @: symbolic_plot_set_items(
            node.items,
            program,
            workspace,
            frameTime,
            style,
            builder,
            0
        )
    point: symbolic_node_plot_point(node, program, workspace, frameTime)
    symbolic_plot_builder_push(
        builder,
        symbolic_line_vertex(point.(0), point.(1), style)
    )

symbolic_node_plot_point(node:any, program:any, workspace:any, frameTime:num):
    node.kind = "tuple"?
        @: symbolic_node_plot_point(node.items.(0), program, workspace, frameTime)
    value: symbolic_evaluate(
        node,
        symbolic_local_evaluation(0, 0, 0, frameTime, program.context),
        workspace,
        vkf_list_empty(),
        vkf_list_empty()
    )
    symbolic_literal_point(value)


symbolic_sample_coordinate(minimum:num, maximum:num, steps:num, index:num):
    steps <= 1?
        @: minimum
    minimum + (maximum - minimum) * index / (steps - 1)

symbolic_line_vertex(x:num, y:num, style:any):
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(style.edgeR, style.edgeG)
    third: vkf_list_pair(style.edgeB, style.edgeA)
    first & second & third

symbolic_face_vertex(x:num, y:num, style:any):
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(style.faceR, style.faceG)
    third: vkf_list_pair(style.faceB, style.faceA)
    first & second & third

symbolic_color_field_vertex(x:num, y:num, value:any, style:any, complexField:bit):
    complexField?
        @: symbolic_complex_field_vertex(x, y, value, style)
    symbolic_field_vertex(x, y, value, style)

symbolic_field_vertex(x:num, y:num, value:num, style:any):
    normalized: symbolic_color_scale_normalized(
        value,
        style.valueMin,
        style.valueMax,
        style.colorScaleMode
    )
    color: symbolic_field_color(normalized, style)
    symbolic_colored_vertex(x, y, color, color.a)

symbolic_complex_field_vertex(x:num, y:num, value:any, style:any):
    phase: symbolic_atan2(value.imaginary, value.real)
    phasePosition: symbolic_color_scale_apply_mode(
        (phase + 3.141592653589793) / 6.283185307179586,
        style.colorScaleMode
    )
    magnitude: vkf_math_sqrt(value.real * value.real + value.imaginary * value.imaginary)
    magnitudeAlpha: symbolic_color_scale_normalized(
        magnitude,
        symbolic_style_magnitude_min(style),
        symbolic_style_magnitude_max(style),
        "clamp"
    )
    color: symbolic_complex_field_color(phasePosition, style)
    symbolic_colored_vertex(x, y, color, color.a * magnitudeAlpha)

symbolic_colored_vertex(x:num, y:num, color:any, alpha:num):
    first: vkf_list_pair(x, y)
    second: vkf_list_pair(color.r, color.g)
    third: vkf_list_pair(color.b, alpha)
    first & second & third

symbolic_color_scale_normalized(value:num, minimum:num, maximum:num, mode:any):
    symbolic_color_scale_apply_mode((value - minimum) / (maximum - minimum), mode)

symbolic_color_scale_apply_mode(value:num, mode:any):
    mode = "cyclic"?
        @: symbolic_repeat_unit(value)
    symbolic_clamp_unit(value)

symbolic_repeat_unit(value:num):
    ((value % 1) + 1) % 1

symbolic_style_magnitude_min(style:any):
    style.magnitudeMin = null?
        @: 0
    style.magnitudeMin

symbolic_style_magnitude_max(style:any):
    style.magnitudeMax = null?
        @: 1
    style.magnitudeMax

symbolic_complex_field_color(normalized:num, style:any):
    style.colormapPoints = null?
        @: symbolic_complex_field_fallback_color(style)
    vkf_list_length(style.colormapPoints) = 0?
        @: symbolic_complex_field_fallback_color(style)
    symbolic_colormap_sample(style.colormapPoints, normalized, 0)

symbolic_complex_field_fallback_color(style:any):
    (
        r: style.faceR,
        g: style.faceG,
        b: style.faceB,
        a: style.faceA
    )

symbolic_field_color(normalized:num, style:any):
    style.colormapPoints = null?
        @: symbolic_field_fallback_color(normalized, style)
    vkf_list_length(style.colormapPoints) = 0?
        @: symbolic_field_fallback_color(normalized, style)
    symbolic_colormap_sample(style.colormapPoints, normalized, 0)

symbolic_field_fallback_color(normalized:num, style:any):
    (
        r: style.faceR,
        g: style.faceG,
        b: style.faceB,
        a: style.faceA * normalized
    )

symbolic_colormap_sample(points:any, position:num, index:num):
    first: points.(0)
    position <= first.pos?
        @: symbolic_colormap_point(first)
    index + 1 >= vkf_list_length(points)?
        @: symbolic_colormap_point(points.(vkf_list_length(points) - 1))
    upper: points.(index + 1)
    position <= upper.pos?
        @: symbolic_colormap_interpolate(points.(index), upper, position)
    symbolic_colormap_sample(points, position, index + 1)

symbolic_colormap_interpolate(lower:any, upper:any, position:num):
    span: upper.pos - lower.pos
    amount: symbolic_colormap_amount(span, position, lower.pos)
    (
        r: symbolic_mix(lower.color.(0), upper.color.(0), amount) / 255,
        g: symbolic_mix(lower.color.(1), upper.color.(1), amount) / 255,
        b: symbolic_mix(lower.color.(2), upper.color.(2), amount) / 255,
        a: symbolic_mix(lower.alpha, upper.alpha, amount)
    )

symbolic_colormap_amount(span:num, position:num, lowerPosition:num):
    span = 0?
        @: position - position
    amount: (position - lowerPosition) / span
    amount

symbolic_colormap_point(point:any):
    (
        r: point.color.(0) / 255,
        g: point.color.(1) / 255,
        b: point.color.(2) / 255,
        a: point.alpha
    )

symbolic_mix(first:num, second:num, amount:num):
    first + (second - first) * amount

symbolic_clamp_unit(value:num):
    value < 0?
        @: 0
    value > 1?
        @: 1
    value

symbolic_semantic_diagnostics(ast:any):
    ast.kind??
        "call" => symbolic_call_diagnostics(ast)
        "definition" => symbolic_definition_diagnostics(ast)
        "unary" => symbolic_semantic_diagnostics(ast.operand)
        "group" => symbolic_semantic_diagnostics(ast.expression)
        "binary" => symbolic_semantic_diagnostics(ast.left) & symbolic_semantic_diagnostics(ast.right)
        "vector" => symbolic_semantic_diagnostics(ast.x) & symbolic_semantic_diagnostics(ast.y)
        "range" => symbolic_semantic_diagnostics(ast.start) & symbolic_semantic_diagnostics(ast.end)
        "tuple" => symbolic_items_diagnostics(ast.items, 0)
        "multiset" => symbolic_items_diagnostics(ast.items, 0)
        vkf_list_empty()

symbolic_tuple_length_diagnostics(ast:any, classification:str):
    symbolic_tuple_lanes_enabled(ast, classification) = false?
        @: vkf_list_empty()
    symbolic_expression_tuple_length(ast) < 0?
        @: vkf_list_single(
            symbolic_diagnostic(
                "tuple-length-mismatch",
                "tuples in one expression must have equal lengths",
                ast.location
            )
        )
    vkf_list_empty()

symbolic_items_diagnostics(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    symbolic_semantic_diagnostics(items.(index)) & symbolic_items_diagnostics(
        items,
        index + 1
    )

symbolic_call_diagnostics(node:any):
    expected: symbolic_builtin_arity(node.name)
    nested: symbolic_items_diagnostics(node.args, 0)
    expected < 0?
        @: nested
    vkf_list_length(node.args) = expected?
        @: nested
    vkf_list_single(
        symbolic_diagnostic(
            "invalid-arity",
            "function argument count does not match its definition",
            node.location
        )
    ) & nested

symbolic_builtin_arity(name:str):
    name??
        "sqrt" => 1
        "sin" => 1
        "cos" => 1
        "tan" => 1
        "abs" => 1
        "atan2" => 2
        "vector" => 2
        "complex" => 2
        -1

symbolic_definition_diagnostics(node:any):
    parameters: symbolic_parameter_diagnostics(node.parameters, 0)
    parameters & symbolic_semantic_diagnostics(node.value)

symbolic_parameter_diagnostics(parameters:any, index:num):
    index >= vkf_list_length(parameters)?
        @: vkf_list_empty()
    current: parameters.(index)
    current.kind = "variable"?
        @: symbolic_parameter_diagnostics(parameters, index + 1)
    vkf_list_single(
        symbolic_diagnostic(
            "invalid-parameter",
            "function parameters must be variable names",
            current.location
        )
    ) & symbolic_parameter_diagnostics(parameters, index + 1)

symbolic_expression_capability:
    name: "self_hosted_symbolic_kernel"
    grammar: [
        "decimal numbers",
        "variables x y z t r phi",
        "constants pi and i",
        "prefix plus and minus",
        "binary plus minus multiply divide power",
        "comparisons and equality",
        "parenthesized expressions, tuples, multisets, and inclusive ranges",
        "calls and named function definitions",
        "complex(real, imaginary) and vector(x, y)"
    ]
    deterministic_interfaces: [
        "symbolic_tokenize(source)",
        "symbolic_parse_tokens(lexed)",
        "symbolic_compile(source)",
        "symbolic_compile_draft(source)",
        "symbolic_compile_with_context(source, context, clip)",
        "symbolic_latex(ast)",
        "symbolic_workspace_compile(workspace, source, context, clip)",
        "symbolic_workspace_append(workspace, source, context, clip)",
        "symbolic_workspace_evaluate(workspace, handle, x, y, z, t)",
        "symbolic_program_evaluate_at(program, x, y, z, t, context, workspace)",
        "symbolic_plot(program, workspace, view, style, revision)",
        "symbolic_plot_variant(program, workspace, view, style, revision, variantIndex)"
    ]
    classifications: [
        "literal",
        "point-set",
        "linked-tuple",
        "y-of-x",
        "x-of-y",
        "parametric",
        "implicit-curve",
        "open-region",
        "closed-region",
        "boundary-constraint",
        "scalar-field",
        "complex-field",
        "vector-field"
    ]
    coordinate_contexts: ["global", "vertex", "edge", "face"]
    native_bootstrap_status: "source lexes, parses, lowers, executes, samples, and packs GPU ranges through the tagged WASM runtime"
    rendering_modules: [
        "vf-symbolic-plot-renderer",
        "vf-screen-simplex-renderer"
    ]
    missing: []
    :
