    mapped: symbolic_binary_scalar_variant(node, left, current)
    vkf_list_single(mapped) & symbolic_map_binary_right(node, left, items, index + 1)

symbolic_binary_variant(node:any, left:any, right:any):
    node.op != "^" /\ symbolic_is_linked_collection(left) /\ symbolic_is_linked_collection(right) = false?
        @: symbolic_tuple(symbolic_map_binary_left(node, symbolic_linked_collection_items(left), right, 0), left.location)
    node.op != "^" /\ symbolic_is_linked_collection(right) /\ symbolic_is_linked_collection(left) = false?
        @: symbolic_tuple(symbolic_map_binary_right(node, left, symbolic_linked_collection_items(right), 0), right.location)
