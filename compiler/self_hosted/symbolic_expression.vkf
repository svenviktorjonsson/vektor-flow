symbolic_variable_value_kind_for_context(name:str, context:any):
    name = "z" /\ symbolic_context_dimension(context) = 3?
        @: "scalar"
    symbolic_variable_value_kind(name)

symbolic_binary_value_kind_for_context(node:any, context:any):
    symbolic_is_relation(node.op)?
        @: "scalar"
    symbolic_binary_value_kind(
        symbolic_value_kind_for_context(node.left, context),
        symbolic_value_kind_for_context(node.right, context)
    )

symbolic_variable_value_kind(name:str):
    name??
        "i" => "complex"
        "z" => "complex"
        "scalar"

symbolic_call_value_kind(name:str):
    name??
        "vector" => "vector"
        "complex" => "complex"
        "scalar"

symbolic_binary_node_value_kind(node:any):
    symbolic_is_relation(node.op)?
        @: "scalar"
    symbolic_binary_value_kind(
        symbolic_value_kind(node.left),
        symbolic_value_kind(node.right)
    )

symbolic_binary_value_kind(leftKind:str, rightKind:str):
    leftKind??
        "complex" => "complex"
        "vector" => symbolic_right_value_kind(rightKind, "vector")
        symbolic_right_value_kind(rightKind, "scalar")

symbolic_right_value_kind(rightKind:str, fallback:str):
    rightKind??
        "complex" => "complex"
        "vector" => "vector"
        fallback

symbolic_is_relation(op:str):
    op = "=" \/ op = "<" \/ op = ">" \/ op = "<=" \/ op = ">=" \/ op = "and" \/ op = "or"

symbolic_items_variables(items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    symbolic_variables(items.(index)) & symbolic_items_variables(items, index + 1)

symbolic_variables(node:any):
    node.kind??
        "variable" => symbolic_variable_dependencies(node.name)
        "unary" => symbolic_variables(node.operand)
        "group" => symbolic_variables(node.expression)
        "binary" => symbolic_variables(node.left) & symbolic_variables(node.right)
        "call" => symbolic_items_variables(node.args, 0)
        "vector" => symbolic_variables(node.x) & symbolic_variables(node.y)
        "range" => symbolic_variables(node.start) & symbolic_variables(node.end)
        "tuple" => symbolic_items_variables(node.items, 0)
        "multiset" => symbolic_items_variables(node.items, 0)
        "definition" => symbolic_variables(node.value)
        symbolic_empty_variables()

# Cartesian-expand sets while preserving and translating tuples as linked geometry.
symbolic_binary_scalar_variant(node:any, left:any, right:any):
    node.implicit = true?
        @: symbolic_implicit_multiplication(left, right, node.location)
    symbolic_binary(node.op, left, right, node.location)

symbolic_is_linked_collection(node:any):
    unwrapped: symbolic_ungroup(node)
    unwrapped.kind = "tuple" \/ (unwrapped.kind = "binary" /\ unwrapped.op = "^" /\ symbolic_ungroup(unwrapped.right).kind = "tuple")

symbolic_linked_collection_items(node:any):
    node.kind = "tuple"?
        @: node.items
    symbolic_linked_power_items(node, symbolic_item_variants(node.right), 0)

symbolic_linked_power_items(node:any, exponents:any, index:num):
    index >= vkf_list_length(exponents)?
        @: vkf_list_empty()
    current: symbolic_binary("^", node.left, exponents.(index), node.location)
    vkf_list_single(current) & symbolic_linked_power_items(node, exponents, index + 1)

symbolic_map_binary_left(node:any, items:any, right:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: items.(index)
    current.kind = "tuple"?
        nested: symbolic_tuple(symbolic_map_binary_left(node, current.items, right, 0), current.location)
        @: vkf_list_single(nested) & symbolic_map_binary_left(node, items, right, index + 1)
    mapped: symbolic_binary_scalar_variant(node, current, right)
    vkf_list_single(mapped) & symbolic_map_binary_left(node, items, right, index + 1)

symbolic_map_binary_right(node:any, left:any, items:any, index:num):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    current: items.(index)
    current.kind = "tuple"?
        nested: symbolic_tuple(symbolic_map_binary_right(node, left, current.items, 0), current.location)
