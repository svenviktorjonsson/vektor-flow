# Host-runtime-free symbolic expression kernel.
#
# Parsing, diagnostics, canonical presentation, workspace ownership,
# classification, coordinate contexts, and evaluation all live here in VKF.
# Browser code transports tagged values only.

SymbolicLocation: (offset:num, line:num, column:num)
SymbolicToken: (kind:str, text:str, value:any, location:SymbolicLocation)
SymbolicCursor: (source:str, offset:num, line:num, column:num)
SymbolicDiagnostic: (code:str, message:str, location:SymbolicLocation)
SymbolicLexResult: (tokens:any, diagnostics:any)
SymbolicParseState: (tokens:any, index:num, diagnostics:any)
SymbolicParseResult: (ast:any, next:SymbolicParseState)
SymbolicProgram: (
    ast:any,
    variants:any,
    diagnostics:any,
    latex:str,
    variables:any,
    classification:str,
    valueKind:str,
    context:any,
    clip:any
)
SymbolicDraft: (
    latex:str,
    complete:bit,
    recoverable:bit,
    diagnostics:any
)
SymbolicDocument: (
    source:str,
    latex:str,
    spans:any,
    programs:any,
    program:any,
    diagnostics:any,
    complete:bit,
    recoverable:bit,
    plottable:bit
)
SymbolicWorkspace: any
SymbolicEvaluation: (x:num, y:num, z:num, t:num, context:any)

symbolic_location(offset:num, line:num, column:num):
    (offset: offset, line: line, column: column)

symbolic_token(kind:str, text:str, value:any, location:SymbolicLocation):
    (kind: kind, text: text, value: value, location: location)

symbolic_cursor(source:str):
    (source: source, offset: 0, line: 1, column: 1)

symbolic_diagnostic(code:str, message:str, location:SymbolicLocation):
    (code: code, message: message, location: location)

symbolic_lex_result(tokens:any, diagnostics:any):
    (tokens: tokens, diagnostics: diagnostics)

symbolic_parse_state(tokens:any, index:num, diagnostics:any):
    (tokens: tokens, index: index, diagnostics: diagnostics)

symbolic_parse_result(ast:any, next:SymbolicParseState):
    (ast: ast, next: next)

symbolic_number(value:num, text:str, location:SymbolicLocation):
    (kind: "number", value: value, text: text, location: location)

symbolic_variable(name:str, location:SymbolicLocation):
    (kind: "variable", name: name, location: location)

symbolic_unary(op:str, operand:any, location:SymbolicLocation):
    (kind: "unary", op: op, operand: operand, location: location)

symbolic_group(expression:any, location:SymbolicLocation):
    (kind: "group", expression: expression, location: location)

symbolic_binary(op:str, left:any, right:any, location:SymbolicLocation):
    (kind: "binary", op: op, left: left, right: right, location: location)

symbolic_implicit_multiplication(left:any, right:any, location:SymbolicLocation):
    (
        kind: "binary",
        op: "*",
        left: left,
        right: right,
        implicit: true,
        location: location
    )

symbolic_call(name:str, args:any, location:SymbolicLocation):
    (kind: "call", name: name, args: args, location: location)

symbolic_tuple(items:any, location:SymbolicLocation):
    (kind: "tuple", items: items, location: location)

symbolic_multiset(items:any, location:SymbolicLocation):
    (kind: "multiset", items: items, location: location)

symbolic_definition(name:str, parameters:any, value:any, location:SymbolicLocation):
    (
        kind: "definition",
        name: name,
        parameters: parameters,
        value: value,
        location: location
    )

symbolic_error_node(location:SymbolicLocation):
    (kind: "error", location: location)

symbolic_complex(real:num, imaginary:num):
    (kind: "complex", real: real, imaginary: imaginary)

symbolic_vector(x:num, y:num):
    (kind: "vector", x: x, y: y)

symbolic_vector_node(x:any, y:any, location:SymbolicLocation):
    (kind: "vector", x: x, y: y, location: location)

symbolic_range(start:any, end:any, location:SymbolicLocation):
    (kind: "range", start: start, end: end, location: location)

symbolic_global_context():
    (
        kind: "global",
        dimension: 2,
        originX: 0,
        originY: 0,
        basisXX: 1,
        basisXY: 0,
        basisYX: 0,
        basisYY: 1,
        n: 0,
        N: 1
    )

symbolic_affine_context(
    kind:str,
    originX:num,
    originY:num,
    basisXX:num,
    basisXY:num,
    basisYX:num,
    basisYY:num
):
    (
        kind: kind,
        originX: originX,
        originY: originY,
        basisXX: basisXX,
        basisXY: basisXY,
        basisYX: basisYX,
        basisYY: basisYY
    )

symbolic_no_clip():
    (kind: "none", vertices: vkf_list_empty())

symbolic_face_clip(vertices:any):
    (kind: "face", vertices: vertices)

symbolic_context_dimension(context:any):
    context.dimension = null?
        @: 2
    context.dimension

symbolic_workspace():
    vkf_list_empty()

symbolic_pack_plot_vertices(vertices:any, revision:num):
    packed: vkf_plot_pack(vertices, revision)
    packed = null?
        @: null
    symbolic_plot_metadata(packed)

symbolic_plot_builder(capacity:num, revision:num):
    vkf_plot_builder_create(capacity, revision)

symbolic_plot_builder_push(builder:any, vertex:any):
    vkf_plot_builder_push(builder, vertex)

symbolic_plot_builder_metadata(builder:any):
    packed: vkf_plot_builder_finish(builder)
    packed = null?
        @: null
    symbolic_plot_metadata(packed)

symbolic_plot_metadata(packed:any):
    (
        pointer: packed.(0),
        count: packed.(1),
        stride: packed.(2),
        revision: packed.(3)
    )

symbolic_cursor_location(cursor:SymbolicCursor):
    symbolic_location(cursor.offset, cursor.line, cursor.column)

symbolic_cursor_eof(cursor:SymbolicCursor):
    vkf_string_eof(cursor.source, cursor.offset)

symbolic_cursor_peek(cursor:SymbolicCursor):
    vkf_string_peek_scalar(cursor.source, cursor.offset)

symbolic_cursor_advance(cursor:SymbolicCursor):
    next_offset: vkf_utf8_advance(cursor.source, cursor.offset)
    ch: symbolic_cursor_peek(cursor)
    ch = 10?
        @: symbolic_location_cursor(
            cursor.source,
            next_offset,
            cursor.line + 1,
            1
        )
    symbolic_location_cursor(
        cursor.source,
        next_offset,
        cursor.line,
        cursor.column + 1
    )

symbolic_location_cursor(source:str, offset:num, line:num, column:num):
    (source: source, offset: offset, line: line, column: column)

symbolic_is_digit(ch:num):
    ch >= 48 /\ ch <= 57

symbolic_is_identifier_start(ch:num):
    (ch >= 97 /\ ch <= 122) \/ (ch >= 65 /\ ch <= 90) \/ ch = 95

symbolic_is_space(ch:num):
    ch = 32 \/ ch = 9 \/ ch = 10 \/ ch = 13

symbolic_scan_number(cursor:SymbolicCursor):
    scanned_end: vkf_decimal_scan_end(cursor.source, cursor.offset)
    end: symbolic_decimal_end_before_range(cursor.source, scanned_end)
    text: vkf_utf8_slice(cursor.source, cursor.offset, end)
    (
        text: text,
        value: vkf_decimal_parse(text),
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_decimal_end_before_range(source:str, end:num):
    end <= 0?
        @: end
    vkf_string_eof(source, end)?
        @: end
    previous: vkf_string_peek_scalar(source, end - 1)
    current: vkf_string_peek_scalar(source, end)
    previous = 46 /\ current = 46?
        @: end - 1
    end

symbolic_scan_identifier(cursor:SymbolicCursor):
    end: vkf_identifier_scan_end(cursor.source, cursor.offset)
    (
        text: vkf_utf8_slice(cursor.source, cursor.offset, end),
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_scan_operator(cursor:SymbolicCursor):
    width: vkf_operator_width(cursor.source, cursor.offset)
    end: cursor.offset + width
    text: vkf_utf8_slice(cursor.source, cursor.offset, end)
    (
        kind: vkf_operator_kind(text),
        text: text,
        next: symbolic_cursor_at(cursor, end)
    )

symbolic_is_logical_or(cursor:SymbolicCursor):
    symbolic_cursor_peek(cursor) != 92?
        @: false
    next: symbolic_cursor_advance(cursor)
    symbolic_cursor_eof(next)?
        @: false
    symbolic_cursor_peek(next) = 47

symbolic_is_logical_and(cursor:SymbolicCursor):
    symbolic_cursor_peek(cursor) != 47?
        @: false
    next: symbolic_cursor_advance(cursor)
    symbolic_cursor_eof(next)?
        @: false
    symbolic_cursor_peek(next) = 92

symbolic_cursor_at(cursor:SymbolicCursor, offset:num):
    symbolic_location_cursor(
        cursor.source,
        offset,
        cursor.line,
        cursor.column + offset - cursor.offset
    )

symbolic_tokenize_step(cursor:SymbolicCursor, tokens:any, diagnostics:any):
    symbolic_cursor_eof(cursor)?
        eof_token: symbolic_token(
            "EOF",
            "",
            null,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_lex_result(tokens & [eof_token], diagnostics)

    ch: symbolic_cursor_peek(cursor)
    symbolic_is_space(ch)?
        @: symbolic_tokenize_step(
            symbolic_cursor_advance(cursor),
            tokens,
            diagnostics
        )

    symbolic_is_logical_or(cursor)?
        after_backslash: symbolic_cursor_advance(cursor)
        after_or: symbolic_cursor_advance(after_backslash)
        or_token: symbolic_token(
            "OR",
            "\\/",
            "\\/",
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(after_or, tokens & [or_token], diagnostics)

    symbolic_is_logical_and(cursor)?
        after_slash: symbolic_cursor_advance(cursor)
        after_and: symbolic_cursor_advance(after_slash)
        and_token: symbolic_token(
            "AND",
            "/\\",
            "/\\",
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(after_and, tokens & [and_token], diagnostics)

    symbolic_is_digit(ch)?
        number_scan: symbolic_scan_number(cursor)
        number_token: symbolic_token(
            "NUMBER",
            number_scan.text,
            number_scan.value,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            number_scan.next,
            tokens & [number_token],
            diagnostics
        )

    symbolic_is_identifier_start(ch)?
        identifier_scan: symbolic_scan_identifier(cursor)
        identifier_token: symbolic_token(
            "IDENT",
            identifier_scan.text,
            identifier_scan.text,
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            identifier_scan.next,
            tokens & [identifier_token],
            diagnostics
        )

    operator_scan: symbolic_scan_operator(cursor)
    operator_scan.kind = "INVALID"?
        issue: symbolic_diagnostic(
            "unexpected-character",
            "expected a mathematical expression token",
            symbolic_cursor_location(cursor)
        )
        @: symbolic_tokenize_step(
            symbolic_cursor_advance(cursor),
            tokens,
            diagnostics & [issue]
        )

    operator_token: symbolic_token(
        operator_scan.kind,
        operator_scan.text,
        operator_scan.text,
        symbolic_cursor_location(cursor)
    )
    @: symbolic_tokenize_step(
        operator_scan.next,
        tokens & [operator_token],
        diagnostics
    )

symbolic_tokenize(source:str):
    symbolic_tokenize_step(symbolic_cursor(source), [], [])

symbolic_state_current(state:SymbolicParseState):
    state.tokens.(state.index)

symbolic_state_advance(state:SymbolicParseState):
    symbolic_parse_state(state.tokens, state.index + 1, state.diagnostics)

symbolic_state_with_diagnostic(
    state:SymbolicParseState,
    issue:SymbolicDiagnostic
):
    symbolic_parse_state(
        state.tokens,
        state.index,
        state.diagnostics & [issue]
    )

symbolic_parse_primary(state:SymbolicParseState):
    current: symbolic_state_current(state)
    current.kind??
        "NUMBER" => symbolic_parse_result(
            symbolic_number(current.value, current.text, current.location),
            symbolic_state_advance(state)
        )
        "IDENT" => symbolic_parse_identifier(state, current)
        "LPAREN" => symbolic_parse_parenthesized(state)
        "LBRACKET" => symbolic_parse_vector(state)
        "LBRACE" => symbolic_parse_set(state)
        symbolic_parse_primary_error(state, current)

symbolic_parse_vector(state:SymbolicParseState):
    open: symbolic_state_current(state)
    first: symbolic_parse_relation(symbolic_state_advance(state))
    separator: symbolic_state_current(first.next)
    separator.kind = "COMMA"?
        @: symbolic_parse_vector_second(open, first)
    symbolic_parse_collection_error(first, separator, "expected comma in vector")

symbolic_parse_vector_second(open:SymbolicToken, first:SymbolicParseResult):
    second: symbolic_parse_relation(symbolic_state_advance(first.next))
    close: symbolic_state_current(second.next)
    close.kind = "RBRACKET"?
        @: symbolic_parse_result(
            symbolic_vector_node(first.ast, second.ast, open.location),
            symbolic_state_advance(second.next)
        )
    symbolic_parse_collection_error(second, close, "expected closing ]")

symbolic_parse_identifier(state:SymbolicParseState, identifier:SymbolicToken):
    next: symbolic_state_advance(state)
    current: symbolic_state_current(next)
    current.kind??
        "LPAREN" => symbolic_parse_call(identifier, next)
        symbolic_parse_result(
            symbolic_variable(identifier.text, identifier.location),
            next
        )

symbolic_parse_call(identifier:SymbolicToken, state:SymbolicParseState):
    symbolic_parse_call_items(
        identifier,
        symbolic_state_advance(state),
        vkf_list_empty()
    )

symbolic_parse_call_items(
    identifier:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_call(identifier.text, items, identifier.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_call_item(identifier, state, items)

symbolic_parse_call_item(
    identifier:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_call_items(
            identifier,
            symbolic_state_advance(item.next),
            next_items
        )
        "RPAREN" => symbolic_parse_result(
            symbolic_call(identifier.text, next_items, identifier.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or )")

symbolic_parse_primary_error(
    state:SymbolicParseState,
    current:SymbolicToken
):
    issue: symbolic_diagnostic(
        "expected-expression",
        "expected number, variable, or parenthesized expression",
        current.location
    )
    symbolic_parse_result(
        symbolic_error_node(current.location),
        symbolic_state_with_diagnostic(state, issue)
    )

symbolic_parse_parenthesized(state:SymbolicParseState):
    open: symbolic_state_current(state)
    next: symbolic_state_advance(state)
    current: symbolic_state_current(next)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(vkf_list_empty(), open.location),
            symbolic_state_advance(next)
        )
        symbolic_parse_parenthesized_inner(open, next)

symbolic_parse_parenthesized_inner(
    open:SymbolicToken,
    state:SymbolicParseState
):
    inner: symbolic_parse_relation(state)
    close: symbolic_state_current(inner.next)
    close.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_group(inner.ast, open.location),
            symbolic_state_advance(inner.next)
        )
        "COMMA" => symbolic_parse_tuple_items(
            open,
            symbolic_state_advance(inner.next),
            [inner.ast]
        )
        symbolic_parse_parenthesized_error(inner, open)

symbolic_parse_tuple_items(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(items, open.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_tuple_item(open, state, items)

symbolic_parse_tuple_item(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_tuple_items(
            open,
            symbolic_state_advance(item.next),
            next_items
        )
        "RPAREN" => symbolic_parse_result(
            symbolic_tuple(next_items, open.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or )")

symbolic_parse_set(state:SymbolicParseState):
    open: symbolic_state_current(state)
    symbolic_parse_set_items(
        open,
        symbolic_state_advance(state),
        vkf_list_empty()
    )

symbolic_parse_set_items(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    current: symbolic_state_current(state)
    current.kind??
        "RBRACE" => symbolic_parse_result(
            symbolic_multiset(items, open.location),
            symbolic_state_advance(state)
        )
        symbolic_parse_set_item(open, state, items)

symbolic_parse_set_item(
    open:SymbolicToken,
    state:SymbolicParseState,
    items:any
):
    item: symbolic_parse_relation(state)
    next_items: items & [item.ast]
    current: symbolic_state_current(item.next)
    current.kind??
        "COMMA" => symbolic_parse_set_items(
            open,
            symbolic_state_advance(item.next),
            next_items
        )
        "RBRACE" => symbolic_parse_result(
            symbolic_multiset(next_items, open.location),
            symbolic_state_advance(item.next)
        )
        symbolic_parse_collection_error(item, current, "expected comma or }")

symbolic_parse_collection_error(
    parsed:SymbolicParseResult,
    current:SymbolicToken,
    message:str
):
    issue: symbolic_diagnostic(
        "expected-collection-separator",
        message,
        current.location
    )
    symbolic_parse_result(
        parsed.ast,
        symbolic_state_with_diagnostic(parsed.next, issue)
    )

symbolic_parse_parenthesized_error(
    inner:SymbolicParseResult,
    open:SymbolicToken
):
    issue: symbolic_diagnostic(
        "expected-close-parenthesis",
        "expected closing parenthesis",
        open.location
    )
    symbolic_parse_result(
        inner.ast,
        symbolic_state_with_diagnostic(inner.next, issue)
    )

symbolic_parse_unary(state:SymbolicParseState):
    current: symbolic_state_current(state)
    current.kind??
        "PLUS" => symbolic_parse_unary(symbolic_state_advance(state))
        "MINUS" => symbolic_parse_unary_operand(state)
        symbolic_parse_primary(state)

symbolic_parse_unary_operand(state:SymbolicParseState):
    operator: symbolic_state_current(state)
    operand: symbolic_parse_unary(symbolic_state_advance(state))
    symbolic_parse_result(
        symbolic_unary("-", operand.ast, operator.location),
        operand.next
    )

symbolic_parse_power(state:SymbolicParseState):
    left: symbolic_parse_unary(state)
    current: symbolic_state_current(left.next)
    current.kind??
        "CARET" => symbolic_parse_power_right(left, current)
        left

symbolic_parse_power_right(left:SymbolicParseResult, operator:SymbolicToken):
    right: symbolic_parse_power(symbolic_state_advance(left.next))
    symbolic_parse_result(
        symbolic_binary("^", left.ast, right.ast, operator.location),
        right.next
    )

symbolic_parse_multiplicative(state:SymbolicParseState):
    left: symbolic_parse_power(state)
    symbolic_parse_multiplicative_tail(left)

symbolic_parse_multiplicative_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind??
        "STAR" => symbolic_parse_multiplicative_right(left, current, "*")
        "SLASH" => symbolic_parse_multiplicative_right(left, current, "/")
        "IDENT" => symbolic_parse_implicit_multiplicative(left, current)
        left

symbolic_parse_implicit_multiplicative(
    left:SymbolicParseResult,
    rightToken:SymbolicToken
):
    right: symbolic_parse_power(left.next)
    combined: symbolic_parse_result(
        symbolic_implicit_multiplication(
            left.ast,
            right.ast,
            rightToken.location
        ),
        right.next
    )
    symbolic_parse_multiplicative_tail(combined)

symbolic_parse_multiplicative_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_power(symbolic_state_advance(left.next))
    combined: symbolic_parse_result(
        symbolic_binary(op, left.ast, right.ast, operator.location),
        right.next
    )
    symbolic_parse_multiplicative_tail(combined)

symbolic_parse_additive(state:SymbolicParseState):
    left: symbolic_parse_multiplicative(state)
    symbolic_parse_additive_tail(left)

symbolic_parse_additive_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind??
        "PLUS" => symbolic_parse_additive_right(left, current, "+")
        "MINUS" => symbolic_parse_additive_right(left, current, "-")
        left

symbolic_parse_additive_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_multiplicative(symbolic_state_advance(left.next))
    combined: symbolic_parse_result(
        symbolic_binary(op, left.ast, right.ast, operator.location),
        right.next
    )
    symbolic_parse_additive_tail(combined)

symbolic_parse_range(state:SymbolicParseState):
    left: symbolic_parse_additive(state)
    current: symbolic_state_current(left.next)
    current.kind = "RANGE"?
        @: symbolic_parse_range_right(left, current)
    left

symbolic_parse_range_right(left:SymbolicParseResult, operator:SymbolicToken):
    right: symbolic_parse_additive(symbolic_state_advance(left.next))
    symbolic_parse_result(
        symbolic_range(left.ast, right.ast, operator.location),
        right.next
    )

symbolic_parse_relation(state:SymbolicParseState):
    left: symbolic_parse_and(state)
    symbolic_parse_or_tail(left)

symbolic_parse_or_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind = "OR"?
        right: symbolic_parse_and(symbolic_state_advance(left.next))
        combined: symbolic_parse_result(
            symbolic_binary(
                "or",
                symbolic_logical_relation_operand(left.ast),
                symbolic_logical_relation_operand(right.ast),
                current.location
            ),
            right.next
        )
        @: symbolic_parse_or_tail(combined)
    left

symbolic_parse_and(state:SymbolicParseState):
    left: symbolic_parse_relation_chain(state)
    symbolic_parse_and_tail(left)

symbolic_parse_and_tail(left:SymbolicParseResult):
    current: symbolic_state_current(left.next)
    current.kind = "AND"?
        right: symbolic_parse_relation_chain(symbolic_state_advance(left.next))
        combined: symbolic_parse_result(
            symbolic_binary(
                "and",
                symbolic_logical_relation_operand(left.ast),
                symbolic_logical_relation_operand(right.ast),
                current.location
            ),
            right.next
        )
        @: symbolic_parse_and_tail(combined)
    left

symbolic_logical_relation_operand(ast:any):
    ast.kind = "definition" /\ vkf_list_length(ast.parameters) = 0?
        @: symbolic_binary(
            "=",
            symbolic_variable(ast.name, ast.location),
            ast.value,
            ast.location
        )
    ast

symbolic_parse_relation_chain(state:SymbolicParseState):
    left: symbolic_parse_range(state)
    current: symbolic_state_current(left.next)
    current.kind??
        "EQ" => symbolic_parse_relation_right(left, current, "=")
        "LT" => symbolic_parse_relation_right(left, current, "<")
        "GT" => symbolic_parse_relation_right(left, current, ">")
        "LE" => symbolic_parse_relation_right(left, current, "<=")
        "GE" => symbolic_parse_relation_right(left, current, ">=")
        left

symbolic_parse_relation_right(
    left:SymbolicParseResult,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_range(symbolic_state_advance(left.next))
    combined: symbolic_parse_result(
        symbolic_relation_node(left.ast, op, right.ast, operator.location),
        right.next
    )
    symbolic_parse_relation_tail(combined, right.ast)

symbolic_parse_relation_tail(combined:SymbolicParseResult, middle:any):
    current: symbolic_state_current(combined.next)
    current.kind??
        "EQ" => symbolic_parse_relation_tail_right(combined, middle, current, "=")
        "LT" => symbolic_parse_relation_tail_right(combined, middle, current, "<")
        "GT" => symbolic_parse_relation_tail_right(combined, middle, current, ">")
        "LE" => symbolic_parse_relation_tail_right(combined, middle, current, "<=")
        "GE" => symbolic_parse_relation_tail_right(combined, middle, current, ">=")
        combined

symbolic_parse_relation_tail_right(
    combined:SymbolicParseResult,
    middle:any,
    operator:SymbolicToken,
    op:str
):
    right: symbolic_parse_range(symbolic_state_advance(combined.next))
    relation: symbolic_relation_node(middle, op, right.ast, operator.location)
    joined: symbolic_parse_result(
        symbolic_binary("and", combined.ast, relation, operator.location),
        right.next
    )
    symbolic_parse_relation_tail(joined, right.ast)

symbolic_relation_node(left:any, op:str, right:any, location:SymbolicLocation):
    op = "="?
        left.kind??
            "call" => symbolic_definition(
                left.name,
                left.args,
                right,
                location
            )
            "variable" => symbolic_variable_relation(left, right, location)
            symbolic_binary(op, left, right, location)
    symbolic_binary(op, left, right, location)

symbolic_variable_relation(left:any, right:any, location:SymbolicLocation):
    left.name = "x" \/ left.name = "y" \/ left.name = "z" \/ left.name = "r" \/ left.name = "phi" \/ left.name = "t" \/ left.name = "n" \/ left.name = "N"?
        @: symbolic_binary("=", left, right, location)
    symbolic_definition(left.name, vkf_list_empty(), right, location)

symbolic_parse_tokens(lexed:SymbolicLexResult):
    state: symbolic_parse_state(lexed.tokens, 0, lexed.diagnostics)
    parsed: symbolic_parse_relation(state)
    current: symbolic_state_current(parsed.next)
    current.kind??
        "EOF" => parsed
        symbolic_parse_trailing_error(parsed, current)

symbolic_parse_trailing_error(
    parsed:SymbolicParseResult,
    current:SymbolicToken
):
    issue: symbolic_diagnostic(
        "unexpected-token",
        "expected end of expression",
        current.location
    )
    symbolic_parse_result(
        parsed.ast,
        symbolic_state_with_diagnostic(parsed.next, issue)
    )

symbolic_latex(node:any):
    symbolic_latex_at(node, 0)

symbolic_latex_at(node:any, parentPrecedence:num):
    own_precedence: symbolic_precedence(node)
    rendered: symbolic_latex_unwrapped(node, own_precedence)
    own_precedence < parentPrecedence?
        @: "\\left(" & rendered & "\\right)"
    rendered

symbolic_precedence(node:any):
    node.kind??
        "definition" => 1
        "binary" => symbolic_binary_precedence(node.op)
        "unary" => 5
        "group" => 6
        6

symbolic_binary_precedence(op:str):
    op??
        "or" => 0
        "and" => 1
        "=" => 1
        "<" => 1
        ">" => 1
        "<=" => 1
        ">=" => 1
        "+" => 2
        "-" => 2
        "*" => 3
        "/" => 3
        "^" => 4
        0

symbolic_latex_unwrapped(node:any, precedence:num):
    node.kind??
        "number" => node.text
        "variable" => symbolic_variable_latex(node.name)
        "unary" => "-" & symbolic_latex_at(node.operand, precedence)
        "group" => "\\left(" & symbolic_latex(node.expression) & "\\right)"
        "binary" => symbolic_binary_latex(node, precedence)
        "call" => symbolic_call_latex(node)
        "vector" => "\\begin{pmatrix}" & symbolic_latex(node.x) & "\\\\" & symbolic_latex(node.y) & "\\end{pmatrix}"
        "range" => symbolic_latex(node.start) & ".." & symbolic_latex(node.end)
        "tuple" => "\\left(" & symbolic_latex_items(node.items, 0) & "\\right)"
        "multiset" => "\\left\\{" & symbolic_latex_items(node.items, 0) & "\\right\\}"
        "definition" => symbolic_definition_latex(node)
        "\\operatorname{error}"

symbolic_latex_items(items:any, index:num):
    index >= vkf_list_length(items)?
        @: ""
    tail: symbolic_latex_items(items, index + 1)
    tail = ""?
        @: symbolic_latex(items.(index))
    symbolic_latex(items.(index)) & ", " & tail

symbolic_call_latex(node:any):
    node.name??
        "sqrt" => "\\sqrt{" & symbolic_latex(node.args.(0)) & "}"
        "abs" => "\\left|" & symbolic_latex(node.args.(0)) & "\\right|"
        "vector" => "\\begin{pmatrix}" & symbolic_latex(node.args.(0)) & "\\\\" & symbolic_latex(node.args.(1)) & "\\end{pmatrix}"
        "complex" => symbolic_latex(node.args.(0)) & " + " & symbolic_latex(node.args.(1)) & "i"
        "sum" => symbolic_range_template_latex("\\sum", "sum", node.args)
        "product" => symbolic_range_template_latex("\\prod", "product", node.args)
        "integrate" => symbolic_integral_template_latex(node.args)
        "integral" => symbolic_integral_template_latex(node.args)
        "integ" => symbolic_integral_template_latex(node.args)
        symbolic_function_application_latex(node.name) & "\\left(" & symbolic_latex_items(node.args, 0) & "\\right)"

symbolic_range_template_latex(operator:str, name:str, args:any):
    vkf_list_length(args) = 4?
        @: operator & "_{" & symbolic_latex(args.(1)) & "=" & symbolic_latex(args.(2)) & "}^{" & symbolic_template_bound_latex(args.(3)) & "} " & symbolic_latex(args.(0))
    symbolic_function_application_latex(name) & "\\left(" & symbolic_latex_items(args, 0) & "\\right)"

symbolic_integral_template_latex(args:any):
    vkf_list_length(args) = 4?
        @: "\\int_{" & symbolic_latex(args.(2)) & "}^{" & symbolic_template_bound_latex(args.(3)) & "} " & symbolic_latex(args.(0)) & "\\,d" & symbolic_latex(args.(1))
    symbolic_function_application_latex("integrate") & "\\left(" & symbolic_latex_items(args, 0) & "\\right)"

symbolic_template_bound_latex(node:any):
    node.kind = "variable" /\ node.name = "inf"?
        @: "\\infty"
    symbolic_latex(node)

symbolic_function_latex(name:str):
    symbolic_document_source_end(name, 0)??
        1 => name
        "\\operatorname{" & name & "}"

symbolic_function_application_latex(name:str):
    symbolic_document_source_end(name, 0)??
        1 => name
        symbolic_function_latex(name) & "\\!"

symbolic_definition_latex(node:any):
    vkf_list_length(node.parameters) = 0?
        @: symbolic_variable_latex(node.name) & " = " & symbolic_latex(node.value)
    symbolic_function_application_latex(node.name) & "\\left(" & symbolic_latex_items(node.parameters, 0) & "\\right) = " & symbolic_latex(node.value)

symbolic_variable_latex(name:str):
    name??
        "alpha" => "\\alpha"
        "beta" => "\\beta"
        "gamma" => "\\gamma"
        "delta" => "\\delta"
        "epsilon" => "\\epsilon"
        "zeta" => "\\zeta"
        "eta" => "\\eta"
        "theta" => "\\theta"
        "iota" => "\\iota"
        "kappa" => "\\kappa"
        "lambda" => "\\lambda"
        "mu" => "\\mu"
        "nu" => "\\nu"
        "xi" => "\\xi"
        "omicron" => "o"
        "pi" => "\\pi"
        "rho" => "\\rho"
        "sigma" => "\\sigma"
        "tau" => "\\tau"
        "upsilon" => "\\upsilon"
        "phi" => "\\phi"
        "chi" => "\\chi"
        "psi" => "\\psi"
        "omega" => "\\omega"
        "Alpha" => "\\mathrm{A}"
        "Beta" => "\\mathrm{B}"
        "Gamma" => "\\Gamma"
        "Delta" => "\\Delta"
        "Epsilon" => "\\mathrm{E}"
        "Zeta" => "\\mathrm{Z}"
        "Eta" => "\\mathrm{H}"
        "Theta" => "\\Theta"
        "Iota" => "\\mathrm{I}"
        "Kappa" => "\\mathrm{K}"
        "Lambda" => "\\Lambda"
        "Mu" => "\\mathrm{M}"
        "Nu" => "\\mathrm{N}"
        "Xi" => "\\Xi"
        "Omicron" => "\\mathrm{O}"
        "Pi" => "\\Pi"
        "Rho" => "\\mathrm{P}"
        "Sigma" => "\\Sigma"
        "Tau" => "\\mathrm{T}"
        "Upsilon" => "\\Upsilon"
        "Phi" => "\\Phi"
        "Chi" => "\\mathrm{X}"
        "Psi" => "\\Psi"
        "Omega" => "\\Omega"
        "i" => "i"
        name

symbolic_greek_identifier(name:str):
    name??
        "alpha" => true
        "beta" => true
        "gamma" => true
        "delta" => true
        "epsilon" => true
        "zeta" => true
        "eta" => true
        "theta" => true
        "iota" => true
        "kappa" => true
        "lambda" => true
        "mu" => true
        "nu" => true
        "xi" => true
        "omicron" => true
        "pi" => true
        "rho" => true
        "sigma" => true
        "tau" => true
        "upsilon" => true
        "phi" => true
        "chi" => true
        "psi" => true
        "omega" => true
        "Alpha" => true
        "Beta" => true
        "Gamma" => true
        "Delta" => true
        "Epsilon" => true
        "Zeta" => true
        "Eta" => true
        "Theta" => true
        "Iota" => true
        "Kappa" => true
        "Lambda" => true
        "Mu" => true
        "Nu" => true
        "Xi" => true
        "Omicron" => true
        "Pi" => true
        "Rho" => true
        "Sigma" => true
        "Tau" => true
        "Upsilon" => true
        "Phi" => true
        "Chi" => true
        "Psi" => true
        "Omega" => true
        false

symbolic_binary_latex(node:any, precedence:num):
    node.op??
        "or" => symbolic_latex_at(node.left, precedence) & " \\lor " & symbolic_latex_at(node.right, precedence)
        "and" => symbolic_latex_at(node.left, precedence) & " \\land " & symbolic_latex_at(node.right, precedence)
        "+" => symbolic_latex_at(node.left, precedence) & " + " & symbolic_latex_at(node.right, precedence)
        "-" => symbolic_latex_at(node.left, precedence) & " - " & symbolic_latex_at(node.right, precedence + 1)
        "*" => symbolic_multiplication_latex(node, precedence)
        "/" => "\\frac{" & symbolic_latex(node.left) & "}{" & symbolic_latex(node.right) & "}"
        "^" => symbolic_power_latex(node)
        "=" => symbolic_latex(node.left) & " = " & symbolic_latex(node.right)
        "<" => symbolic_latex(node.left) & " < " & symbolic_latex(node.right)
        ">" => symbolic_latex(node.left) & " > " & symbolic_latex(node.right)
        "<=" => symbolic_latex(node.left) & " \\le " & symbolic_latex(node.right)
        ">=" => symbolic_latex(node.left) & " \\ge " & symbolic_latex(node.right)
        "\\operatorname{error}"

symbolic_power_latex(node:any):
    exponent: symbolic_power_exponent_latex(node.right)
    "{" & symbolic_power_base_latex(node.left) & "}^{" & exponent & "}"

symbolic_power_base_latex(node:any):
    node.kind = "group"?
        @: symbolic_latex(node)
    node.kind = "binary" \/ node.kind = "unary"?
        @: "\\left(" & symbolic_latex(node) & "\\right)"
    symbolic_latex(node)

symbolic_power_exponent_latex(node:any):
    node.kind = "group"?
        @: symbolic_grouped_power_exponent_latex(node.expression)
    node.kind = "range"?
        @: "\\left(" & symbolic_latex(node) & "\\right)"
    symbolic_latex(node)

symbolic_grouped_power_exponent_latex(node:any):
    node.kind = "range"?
        @: "\\left(" & symbolic_latex(node) & "\\right)"
    symbolic_latex(node)

symbolic_multiplication_latex(node:any, precedence:num):
    node.implicit = true?
        @: symbolic_latex_at(node.left, precedence) & symbolic_latex_at(node.right, precedence)
    symbolic_latex_at(node.left, precedence) & " \\cdot " & symbolic_latex_at(node.right, precedence)

symbolic_evaluation(x:num, y:num, z:num, t:num, context:any):
    dx: x - context.originX
    dy: y - context.originY
    determinant: context.basisXX * context.basisYY - context.basisXY * context.basisYX
    local_x: (dx * context.basisYY - dy * context.basisYX) / determinant
    local_y: (dy * context.basisXX - dx * context.basisXY) / determinant
    (x: local_x, y: local_y, z: z, t: t, context: context)

symbolic_local_evaluation(x:num, y:num, z:num, t:num, context:any):
    (x: x, y: y, z: z, t: t, context: context)

symbolic_evaluate(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    node.kind??
        "number" => node.value
        "variable" => symbolic_variable_value(
            node.name,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "unary" => symbolic_negate_value(
            symbolic_evaluate(
                node.operand,
                evaluation,
                workspace,
                parameterNames,
                parameterValues
            ),
            symbolic_value_kind_for_context(node.operand, evaluation.context)
        )
        "group" => symbolic_evaluate(
            node.expression,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "binary" => symbolic_binary_value(
            node,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "call" => symbolic_call_value(
            node,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "vector" => symbolic_vector(
            symbolic_evaluate(node.x, evaluation, workspace, parameterNames, parameterValues),
            symbolic_evaluate(node.y, evaluation, workspace, parameterNames, parameterValues)
        )
        "range" => symbolic_range_values(
            symbolic_evaluate(node.start, evaluation, workspace, parameterNames, parameterValues),
            symbolic_evaluate(node.end, evaluation, workspace, parameterNames, parameterValues)
        )
        "tuple" => symbolic_evaluate_items(
            node.items,
            0,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        "multiset" => symbolic_evaluate_items(
            node.items,
            0,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
        null

symbolic_range_values(start:num, end:num):
    start <= end?
        @: symbolic_range_values_ascending(start, end)
    symbolic_range_values_descending(start, end)

symbolic_range_values_ascending(current:num, end:num):
    current > end?
        @: vkf_list_empty()
    vkf_list_single(current) & symbolic_range_values_ascending(current + 1, end)

symbolic_range_values_descending(current:num, end:num):
    current < end?
        @: vkf_list_empty()
    vkf_list_single(current) & symbolic_range_values_descending(current - 1, end)

symbolic_evaluate_items(
    items:any,
    index:num,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    index >= vkf_list_length(items)?
        @: vkf_list_empty()
    vkf_list_single(
        symbolic_evaluate(
            items.(index),
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )
    ) & symbolic_evaluate_items(
        items,
        index + 1,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )

symbolic_parameter_value(names:any, values:any, index:num, name:str):
    index >= vkf_list_length(names)?
        @: null
    names.(index) = name?
        @: values.(index)
    symbolic_parameter_value(names, values, index + 1, name)

symbolic_variable_value(
    name:str,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    parameterValue: symbolic_parameter_value(parameterNames, parameterValues, 0, name)
    parameterValue != null?
        @: parameterValue
    name??
        "x" => evaluation.x
        "y" => evaluation.y
        "z" => symbolic_z_value(evaluation)
        "t" => evaluation.t
        "n" => symbolic_context_index(evaluation.context)
        "N" => symbolic_context_count(evaluation.context)
        "r" => vkf_math_sqrt(evaluation.x * evaluation.x + evaluation.y * evaluation.y)
        "phi" => symbolic_atan2(evaluation.y, evaluation.x)
        "pi" => 3.141592653589793
        "i" => symbolic_complex(0, 1)
        symbolic_free_variable_value(
            name,
            evaluation,
            workspace,
            parameterNames,
            parameterValues
        )

symbolic_free_variable_value(
    name:str,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    value: symbolic_parameter_value(parameterNames, parameterValues, 0, name)
    value != null?
        @: value
    definition: symbolic_find_definition(workspace, 0, name)
    definition != null /\ vkf_list_length(definition.parameters) = 0?
        @: symbolic_evaluate(
            definition.value,
            evaluation,
            workspace,
            vkf_list_empty(),
            vkf_list_empty()
        )
    evaluation.t

symbolic_context_index(context:any):
    context.n = null?
        @: 0
    context.n

symbolic_context_count(context:any):
    context.N = null?
        @: 1
    context.N

symbolic_owned_context(context:any):
    (
        kind: context.kind,
        dimension: symbolic_context_dimension(context),
        originX: context.originX,
        originY: context.originY,
        basisXX: context.basisXX,
        basisXY: context.basisXY,
        basisYX: context.basisYX,
        basisYY: context.basisYY,
        n: symbolic_context_index(context),
        N: symbolic_context_count(context)
    )

symbolic_z_value(evaluation:SymbolicEvaluation):
    symbolic_context_dimension(evaluation.context) = 2?
        @: symbolic_complex(evaluation.x, evaluation.y)
    evaluation.z

symbolic_call_value(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    args: symbolic_evaluate_items(
        node.args,
        0,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    node.name??
        "sqrt" => vkf_math_sqrt(args.(0))
        "sin" => vkf_math_sin(args.(0))
        "cos" => vkf_math_cos(args.(0))
        "tan" => vkf_math_tan(args.(0))
        "abs" => vkf_math_abs(args.(0))
        "atan2" => symbolic_atan2(args.(0), args.(1))
        "vector" => symbolic_vector(args.(0), args.(1))
        "complex" => symbolic_complex(args.(0), args.(1))
        symbolic_user_call(node.name, args, evaluation, workspace)

symbolic_atan2(y:num, x:num):
    x > 0?
        @: symbolic_atan(y / x)
    x < 0 /\ y >= 0?
        @: symbolic_atan(y / x) + 3.141592653589793
    x < 0 /\ y < 0?
        @: symbolic_atan(y / x) - 3.141592653589793
    y > 0?
        @: 1.5707963267948966
    y < 0?
        @: -1.5707963267948966
    y - y

symbolic_atan(value:num):
    value > 1?
        @: 1.5707963267948966 - symbolic_atan(1 / value)
    value < -1?
        @: -1.5707963267948966 - symbolic_atan(1 / value)
    value / (1 + 0.28 * value * value)

symbolic_user_call(
    name:str,
    args:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace
):
    definition: symbolic_find_definition(workspace, 0, name)
    definition = null?
        @: null
    symbolic_evaluate(
        definition.value,
        evaluation,
        workspace,
        symbolic_parameter_names(definition.parameters, 0),
        args
    )

symbolic_parameter_names(parameters:any, index:num):
    index >= vkf_list_length(parameters)?
        @: vkf_list_empty()
    vkf_list_single(parameters.(index).name) & symbolic_parameter_names(
        parameters,
        index + 1
    )

symbolic_find_definition(workspace:SymbolicWorkspace, index:num, name:str):
    index >= vkf_list_length(workspace)?
        @: null
    program: workspace.(vkf_list_length(workspace) - index - 1)
    program.ast.kind??
        "definition" => symbolic_definition_or_next(
            workspace,
            index,
            name,
            program.ast
        )
        symbolic_find_definition(workspace, index + 1, name)

symbolic_definition_or_next(
    workspace:SymbolicWorkspace,
    index:num,
    name:str,
    definition:any
):
    definition.name = name?
        @: definition
    symbolic_find_definition(workspace, index + 1, name)

symbolic_negate_value(value:any, kind:str):
    kind??
        "complex" => symbolic_complex(0 - value.real, 0 - value.imaginary)
        "vector" => symbolic_vector(0 - value.x, 0 - value.y)
        0 - value

symbolic_binary_value(
    node:any,
    evaluation:SymbolicEvaluation,
    workspace:SymbolicWorkspace,
    parameterNames:any,
    parameterValues:any
):
    left: symbolic_evaluate(
        node.left,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    right: symbolic_evaluate(
        node.right,
        evaluation,
        workspace,
        parameterNames,
        parameterValues
    )
    left_kind: symbolic_value_kind_for_context(node.left, evaluation.context)
    right_kind: symbolic_value_kind_for_context(node.right, evaluation.context)
    value_kind: symbolic_binary_value_kind(left_kind, right_kind)
    value_kind??
        "complex" => symbolic_complex_binary(
            node.op,
            symbolic_as_complex(left, left_kind),
            symbolic_as_complex(right, right_kind)
        )
        "vector" => symbolic_vector_binary(
            node.op,
            left,
            right,
            left_kind,
            right_kind
        )
        symbolic_scalar_binary(node.op, left, right)

symbolic_scalar_binary(op:str, left:any, right:any):
    op??
        "+" => left + right
        "-" => left - right
        "*" => left * right
        "/" => left / right
        "^" => symbolic_real_power(left, right)
        "=" => left = right
        "<" => left < right
        ">" => left > right
        "<=" => left <= right
        ">=" => left >= right
        "and" => left /\ right
        "or" => left \/ right
        null

symbolic_real_power(base:num, exponent:num):
    symbolic_is_integer(exponent)?
        @: symbolic_integer_power(base, exponent)
    base < 0?
        @: null
    base = 0 /\ exponent > 0?
        @: base
    base = 0?
        @: null
    symbolic_exponential(exponent * symbolic_natural_log(base))

symbolic_is_integer(value:num):
    value = 0?
        @: true
    value > 0 /\ value < 1?
        @: false
    value < 0 /\ value > -1?
        @: false
    value > 0?
        @: symbolic_is_integer(value - 1)
    symbolic_is_integer(value + 1)

symbolic_integer_power(base:num, exponent:num):
    exponent = 0?
        @: 1
    exponent < 0?
        @: 1 / symbolic_integer_power(base, 0 - exponent)
    symbolic_integer_power_positive(base, exponent, 1)

symbolic_integer_power_positive(base:num, exponent:num, result:num):
    exponent = 0?
        @: result
    symbolic_integer_power_positive(base, exponent - 1, result * base)

symbolic_natural_log(value:num):
    value <= 0?
        @: null
    normalized: symbolic_log_normalize(value, 0)
    y: (normalized.value - 1) / (normalized.value + 1)
    result: 2 * symbolic_log_series(y, y * y, 1, 12) + normalized.scale * 0.6931471805599453
    result

symbolic_log_normalize(value:num, scale:num):
    value >= 2?
        @: symbolic_log_normalize(value / 2, scale + 1)
    value < 1?
        @: symbolic_log_normalize(value * 2, scale - 1)
    normalized: (value: value, scale: scale)
    normalized

symbolic_log_series(term:num, square:num, denominator:num, remaining:num):
    remaining = 1?
        @: term / denominator
    term / denominator + symbolic_log_series(
        term * square,
        square,
        denominator + 2,
        remaining - 1
    )

symbolic_exponential(value:num):
    reduced: symbolic_exp_reduce(value, 0)
    series: symbolic_exp_series(reduced.value, 1, 1, 1, 24)
    symbolic_exp_scale(series, reduced.scale)

symbolic_exp_reduce(value:num, scale:num):
    value > 0.6931471805599453?
        @: symbolic_exp_reduce(value - 0.6931471805599453, scale + 1)
    value < -0.6931471805599453?
        @: symbolic_exp_reduce(value + 0.6931471805599453, scale - 1)
    reduced: (value: value, scale: scale)
    reduced

symbolic_exp_series(
    value:num,
    term:num,
    sum:num,
    denominator:num,
    remaining:num
):
    remaining = 0?
        @: sum
    next: term * value / denominator
    symbolic_exp_series(
        value,
        next,
        sum + next,
        denominator + 1,
        remaining - 1
    )

symbolic_exp_scale(value:num, scale:num):
    scale = 0?
        @: value
    scale > 0?
        @: symbolic_exp_scale(value * 2, scale - 1)
    symbolic_exp_scale(value / 2, scale + 1)

symbolic_as_complex(value:any, kind:str):
    kind = "complex"?
        @: value
    symbolic_complex(value, 0)

symbolic_complex_binary(op:str, left:any, right:any):
    op??
        "+" => symbolic_complex(
            left.real + right.real,
            left.imaginary + right.imaginary
        )
        "-" => symbolic_complex(
            left.real - right.real,
            left.imaginary - right.imaginary
        )
        "*" => symbolic_complex(
            left.real * right.real - left.imaginary * right.imaginary,
            left.real * right.imaginary + left.imaginary * right.real
