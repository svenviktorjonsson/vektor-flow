# VKF-owned target-independent validation for the bounded numeric machine-IR slice.

typed: .typed_ir
mir: .machine_ir

machine_ir_numeric_stack_depth(depth:num, kind:str, argument_count:num=0, result_count:num=0) -> num:
    required: 0
    produced: 0
    kind = "call"?
        .required: argument_count
        .produced: result_count
    kind = "system_cpu_count"?
        .produced: 1
    kind = "load_local"?
        .produced: 1
    kind = "push_f64"?
        .produced: 1
    (kind = "add_f64" \/ kind = "subtract_f64" \/ kind = "multiply_f64" \/ kind = "divide_f64" \/ kind = "remainder_f64" \/ kind = "ordered_less_f64" \/ kind = "ordered_greater_f64")?
        .required: 2
        .produced: 1
    kind = "store_local"?
        .required: 1
    kind = "jump_if_false"?
        .required: 1
    kind = "return_f64"?
        .required: 1
    (kind = "call" \/ kind = "system_cpu_count" \/ kind = "load_local" \/ kind = "push_f64" \/ kind = "add_f64" \/ kind = "subtract_f64" \/ kind = "multiply_f64" \/ kind = "divide_f64" \/ kind = "remainder_f64" \/ kind = "ordered_less_f64" \/ kind = "ordered_greater_f64" \/ kind = "store_local" \/ kind = "label" \/ kind = "jump" \/ kind = "jump_if_false" \/ kind = "return_f64")?! "machine IR stack validation encountered an unsupported opcode"
    (depth >= required)?! "machine IR stack underflow"
    depth - required + produced

machine_ir_tagged_statement_stack_maximum(
    first_kind:str,
    second_kind:str,
    third_kind:str,
    fourth_kind:str
) -> num:
    depth: 0
    maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, first_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, second_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, third_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, fourth_kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?! "machine IR statement leaves an imbalanced stack"
    maximum

machine_ir_nested_addition_stack_maximum(
    first_kind:str,
    second_kind:str,
    third_kind:str,
    fourth_kind:str,
    fifth_kind:str,
    sixth_kind:str
) -> num:
    depth: 0
    maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, first_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, second_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, third_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, fourth_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, fifth_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, sixth_kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?! "nested Machine IR statement leaves an imbalanced stack"
    maximum

machine_ir_dependency_chain_stack_maximum(
    first_kind:str,
    second_kind:str,
    third_kind:str,
    fourth_kind:str,
    fifth_kind:str,
    sixth_kind:str,
    seventh_kind:str,
    eighth_kind:str
) -> num:
    depth: 0
    maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, first_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, second_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, third_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, fourth_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, fifth_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, sixth_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, seventh_kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, eighth_kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?! "dependency Machine IR statement leaves an imbalanced stack"
    maximum

machine_ir_numeric_opcode_code(kind:str) -> num:
    code: 0
    (kind = "system_cpu_count" \/ kind = "load_local" \/ kind = "push_f64")?
        .code: 1
    (kind = "add_f64" \/ kind = "subtract_f64" \/ kind = "multiply_f64" \/
        kind = "divide_f64" \/ kind = "remainder_f64" \/ kind = "ordered_less_f64" \/
        kind = "ordered_greater_f64")?
        .code: 2
    (kind = "store_local" \/ kind = "jump_if_false" \/ kind = "return_f64")?
        .code: 3
    (kind = "label" \/ kind = "jump")?
        .code: 4
    (code != 0)?! "numeric opcode tape encountered an unsupported opcode"
    code

machine_ir_numeric_opcode_depth(depth:num, code:num) -> num:
    (code >= 1 /\ code <= 4)?! "numeric opcode tape encountered an unknown code"
    required: 0
    produced: 0
    code = 1?
        .produced: 1
    code = 2?
        .required: 2
        .produced: 1
    code = 3?
        .required: 1
    (depth >= required)?! "numeric opcode tape stack underflow"
    depth - required + produced

machine_ir_numeric_opcode_tape_stack_maximum(codes:[num]) -> num:
    depth: 0
    maximum: 0
    index: 0
    (index < codes.length())?>
        .depth: machine_ir_numeric_opcode_depth(depth, codes.(index))
        depth > maximum?
            .maximum: depth
        .index+: 1
    (depth = 0)?! "numeric opcode tape leaves an imbalanced stack"
    maximum

machine_ir_numeric_parameter_multiply_stack_maxima(function_name:str, parameter_name:str, factor:num) -> [num:3]:
    function: typed.typed_numeric_parameter_multiply_function(function_name, parameter_name, factor)
    module: mir.mir_lower_numeric_parameter_multiply_function_module(function)
    (module.entry.instructions.2.kind = "return_f64")?!
    (module.functions.0.instructions.1.kind = "return_f64")?!
    (module.functions.1.instructions.3.kind = "return_f64")?!
    [num:3] maxima: [0, 0, 0]
    depth: 0
    maximum: 0

    .depth: machine_ir_numeric_stack_depth(
        depth,
        module.entry.instructions.0.kind,
        module.entry.instructions.0.argument_count,
        module.entry.instructions.0.result_count
    )
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(
        depth,
        module.entry.instructions.1.kind,
        module.entry.instructions.1.argument_count,
        module.entry.instructions.1.result_count
    )
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.entry.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.0: maximum

    .depth: 0
    .maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.1.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.1: maximum

    .depth: 0
    .maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.1.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.3.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.2: maximum

    maxima

machine_ir_numeric_positive_conditional_stack_maxima(
    function_name:str,
    parameter_name:str
) -> [num:3]:
    # This is the exact fixed conditional tracer. General branch-join stack
    # validation remains outside this partial Stage-1 kernel.
    application: typed.typed_numeric_positive_conditional_application(
        function_name,
        parameter_name
    )
    module: mir.mir_lower_numeric_positive_conditional_typed_module(application)
    (module.entry.instructions.2.kind = "return_f64")?!
    (module.functions.0.instructions.1.kind = "return_f64")?!
    (module.functions.1.instructions.3.kind = "jump_if_false")?!
    (module.functions.1.instructions.5.kind = "return_f64")?!
    (module.functions.1.instructions.6.kind = "label")?!
    (module.functions.1.instructions.8.kind = "return_f64")?!
    (module.functions.1.instructions.3.label = module.functions.1.instructions.6.label)?!
    [num:3] maxima: [0, 0, 0]
    depth: 0
    maximum: 0

    .depth: machine_ir_numeric_stack_depth(
        depth,
        module.entry.instructions.0.kind,
        module.entry.instructions.0.argument_count,
        module.entry.instructions.0.result_count
    )
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(
        depth,
        module.entry.instructions.1.kind,
        module.entry.instructions.1.argument_count,
        module.entry.instructions.1.result_count
    )
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.entry.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.0: maximum

    .depth: 0
    .maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.1.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.1: maximum

    .depth: 0
    .maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.1.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.3.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.4.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.5.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.6.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.7.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.1.instructions.8.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.2: maximum

    maxima

machine_ir_numeric_count_to_loop_stack_maxima(
    function_name:str,
    parameter_name:str,
    local_name:str,
    entry_value:num
) -> [num:2]:
    application: typed.typed_numeric_count_to_loop_application(
        function_name,
        parameter_name,
        local_name,
        entry_value
    )
    module: mir.mir_lower_numeric_count_to_loop_typed_module(application)
    (module.entry.instructions.2.kind = "return_f64")?!
    (module.functions.0.instructions.2.kind = "label")?!
    (module.functions.0.instructions.11.kind = "jump")?!
    (module.functions.0.instructions.2.label = module.functions.0.instructions.11.label)?!
    (module.functions.0.instructions.6.kind = "jump_if_false")?!
    (module.functions.0.instructions.12.kind = "label")?!
    (module.functions.0.instructions.6.label = module.functions.0.instructions.12.label)?!
    (module.functions.0.instructions.14.kind = "return_f64")?!
    [num:2] maxima: [0, 0]
    depth: 0
    maximum: 0

    .depth: machine_ir_numeric_stack_depth(depth, module.entry.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(
        depth,
        module.entry.instructions.1.kind,
        module.entry.instructions.1.argument_count,
        module.entry.instructions.1.result_count
    )
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.entry.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.0: maximum

    .depth: 0
    .maximum: 0
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.0.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.1.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.2.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.3.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.4.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.5.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.6.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.7.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.8.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.9.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.10.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.11.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.12.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.13.kind)
    depth > maximum?
        .maximum: depth
    .depth: machine_ir_numeric_stack_depth(depth, module.functions.0.instructions.14.kind)
    depth > maximum?
        .maximum: depth
    (depth = 0)?!
    maxima.1: maximum

    maxima
