# Synchronous child-process execution. `run` passes an exact argument vector
# without invoking a shell. `shell` is the explicit unsafe platform-shell
# boundary: never build its command from untrusted text.

run(program:str, args:any) -> (code:int,out:str,err:str):
    process.run_native(program, args)

shell(command:str) -> (code:int,out:str,err:str):
    process.shell_native(command)
