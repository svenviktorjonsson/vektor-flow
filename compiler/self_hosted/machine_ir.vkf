mir_assemble_tagged_resolved_module(
    function_name:str,
    parameter_name:str,
    operator_kind:str,
    value:num,
    callee:str,
    argument_callee:str
) -> ConcreteTaggedMachineModule:
    (callee = function_name)?! "concrete Machine IR call target does not match function"
    (argument_callee = "cpu_count")?! "concrete Machine IR argument target is unsupported"
    [str] empty_strings: []
    [bit] empty_bits: []
    [num] empty_numbers: []
    [ConcreteTaggedMachineInstruction] entry_instructions: []
    .entry_instructions: entry_instructions & [
        _mir_concrete_tagged_instruction("call", symbol:"cpu_count", argument_count:0, result_count:1, provided_parameter_mask:0),
        _mir_concrete_tagged_instruction("call", symbol:callee, argument_count:1, result_count:1, provided_parameter_mask:1),
        _mir_concrete_tagged_instruction("return_f64")
    ]
    entry: _mir_concrete_tagged_function(
        "\$entry", empty_strings, empty_bits, false,
        entry_instructions, 1
    )
    [ConcreteTaggedMachineInstruction] cpu_instructions: []
    .cpu_instructions: cpu_instructions & [
        _mir_concrete_tagged_instruction("system_cpu_count"),
        _mir_concrete_tagged_instruction("return_f64")
    ]
    cpu_function: _mir_concrete_tagged_function(
        "cpu_count", empty_strings, empty_bits, true,
        cpu_instructions, 1
    )
    [str] numeric_parameters: []
    .numeric_parameters: numeric_parameters & [parameter_name]
    [bit] numeric_parameter_classes: []
    .numeric_parameter_classes: numeric_parameter_classes & [true]
    [ConcreteTaggedMachineInstruction] numeric_instructions: []
    .numeric_instructions: numeric_instructions & [
        _mir_concrete_tagged_instruction("load_local", index:0),
        _mir_concrete_tagged_instruction("push_f64", value:value),
        _mir_concrete_tagged_instruction("multiply_f64"),
        _mir_concrete_tagged_instruction("return_f64")
    ]
    numeric_function: _mir_concrete_tagged_function(
        function_name, numeric_parameters, numeric_parameter_classes, true,
        numeric_instructions, 2
    )
    [ConcreteTaggedMachineFunction] functions: []
    .functions: functions & [cpu_function, numeric_function]
    (
        schema:"vektorflow.machine_ir",
        version:4,
        output_kind:"f64",
        output_count:1,
        outputs:empty_strings,
        output_tokens:empty_strings,
        string_data:empty_numbers,
        entry:entry,
        functions:functions
    )

mir_tagged_resolved_module_matches(
    module:ConcreteTaggedMachineModule,
