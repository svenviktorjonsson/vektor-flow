# Self-hosted VKF machine IR contract.
#
# Target-neutral stack IR between canonical typed IR and platform encoders.
# Stage 0 currently executes this contract in native C++; Stage 1 will execute
# the same construction and lowering rules from VKF source.

# Private little-endian IEEE-754 bytes; never serialize through decimal text.
_bootstrap_f64_bytes(value:num):
    [num] bytes: []
    result: (valid:false, bytes:bytes)
    value != value?
        @: result
    fraction: 0
    exponent: 0
    negative: value < 0 \/ (value = 0 /\ 1 / value < 0)
    normalized: value
    negative? .normalized: -normalized
    power: 0
    (normalized > 0 /\ normalized / 2 = normalized)?
        .exponent: 2047
        .normalized: 0
    normalized > 0?
        (normalized >= 2)?>
            .normalized/: 2
            .power+: 1
        (normalized < 1 /\ power > -1022)?>
            .normalized*: 2
            .power-: 1
        normalized >= 1?
            .exponent: power + 1023
            .normalized-: 1
        .fraction: normalized * 4503599627370496
    index: 0
    (index < 6)?>
        result.bytes: result.bytes & [fraction % 256]
        .fraction: fraction // 256
        .index+: 1
    sign: 0
    negative? .sign: 128
    result.bytes: result.bytes & [fraction + (exponent % 16) * 16, exponent // 16 + sign]
    result.valid: true
    result

# Private byte words for already range-checked x64 immediates/displacements.
_bootstrap_x64_word(value:num) -> [num]:
    word: value
    word < 0? .word+: 4294967296
    [word % 256, (word // 256) % 256, (word // 65536) % 256, (word // 16777216) % 256]

# Private rel32 fixup over an already emitted four-byte placeholder.
_bootstrap_x64_patch_relative(bytes:[num], reference:num, target:num) -> [num]:
    word: _bootstrap_x64_word(target - reference - 4)
    index: 0
    (index < 4)?>
        bytes.(reference + index): word.(index)
        .index+: 1
    bytes

# Private function layout and call relocation over already encoded x64 bodies.
_bootstrap_x64_compose_function_bytes(
    input:[num], lengths:[num], relocation_functions:[num],
    relocation_offsets:[num], target_functions:[num]
):
    [num] bytes: []
    [num] positions: []
    [num] references: []
    result: (valid:false, positions:positions, bytes:bytes)
    (lengths.length() = 0 \/
        relocation_functions.length() != relocation_offsets.length() \/
        relocation_functions.length() != target_functions.length())?
        @: result
    index: 0
    total: 0
    length: 0
    (index < lengths.length())?>
        .length: lengths.(index)
        (length < 1 \/ length % 1 != 0 \/ total + length > input.length())?
            @: result
        result.positions: result.positions & [total]
        .total+: length
        .index+: 1
    total != input.length()?
        @: result
    .index: 0
    value: 0
    (index < input.length())?>
        .value: input.(index)
        (value < 0 \/ value > 255 \/ value % 1 != 0)?
            @: result
        result.bytes: result.bytes & [value]
        .index+: 1
    .index: 0
    owner: 0
    target: 0
    offset: 0
    reference: 0
    displacement: 0
    prior: 0
    duplicate: false
    (index < relocation_functions.length())?>
        .owner: relocation_functions.(index)
        .target: target_functions.(index)
        .offset: relocation_offsets.(index)
        (owner < 0 \/ owner >= lengths.length() \/ owner % 1 != 0 \/
            target < 0 \/ target >= lengths.length() \/ target % 1 != 0 \/
            offset < 1 \/ offset % 1 != 0 \/ offset + 3 >= lengths.(owner))?
            @: result
        .reference: result.positions.(owner) + offset
        .duplicate: false
        .prior: 0
        (prior < references.length())?>
            references.(prior) = reference? .duplicate: true
            .prior+: 1
        duplicate?
            @: result
        (result.bytes.(reference - 1) != 232 \/ result.bytes.(reference) != 0 \/
            result.bytes.(reference + 1) != 0 \/ result.bytes.(reference + 2) != 0 \/
            result.bytes.(reference + 3) != 0)?
            @: result
        .displacement: result.positions.(target) - reference - 4
        (displacement < -2147483648 \/ displacement > 2147483647)?
            @: result
        result.bytes: _bootstrap_x64_patch_relative(
            result.bytes, reference, result.positions.(target)
        )
        .references: references & [reference]
        .index+: 1
    result.valid: true
    result

# Private shared frame: no scratch, errors, parameter mask or owned locals.
_bootstrap_x64_frame(local_count:num, maximum:num, windows:bit):
    result: (valid:false, context:0, xmm_slot:0, gpr_slot:0, frame_bytes:0)
    (local_count < 0 \/ local_count % 1 != 0 \/ maximum < 1 \/ maximum % 1 != 0)?
        @: result
    saved_xmm: 0
    shadow: 0
    windows?
        .saved_xmm: 4
        .shadow: 32
    result.context: local_count + maximum
    result.xmm_slot: result.context + 1
    result.gpr_slot: result.xmm_slot + saved_xmm
    result.frame_bytes: (((result.gpr_slot + 6) * 8 + shadow + 15) // 16) * 16
    result.frame_bytes > 2147483647?
        @: result
    result.valid: true
    result

# Caller supplies a validated private frame.
_bootstrap_x64_prologue(frame_bytes:num, xmm_slot:num, gpr_slot:num, windows:bit) -> [num]:
    [num] bytes: []
    .bytes: bytes & [85, 72, 137, 229]
    frame_bytes <= 4096?
        .bytes: bytes & [72, 129, 236] & _bootstrap_x64_word(frame_bytes)
    frame_bytes > 4096?
        .bytes: bytes & [184] & _bootstrap_x64_word(frame_bytes // 4096)
        .bytes: bytes & [72, 129, 236] & _bootstrap_x64_word(4096)
        # Native page loop is 19 bytes from stack decrement through rel32.
        .bytes: bytes & [246, 4, 36, 0, 255, 200, 15, 133] & _bootstrap_x64_word(-19)
        frame_bytes % 4096 != 0?
            .bytes: bytes & [72, 129, 236] & _bootstrap_x64_word(frame_bytes % 4096)
    windows?
        .bytes: bytes & [243, 15, 127, 181] & _bootstrap_x64_word(-(xmm_slot + 1) * 8)
        .bytes: bytes & [243, 15, 127, 189] & _bootstrap_x64_word(-(xmm_slot + 3) * 8)
    saves: [72, 137, 157, 72, 137, 181, 72, 137, 189, 76, 137, 173, 76, 137, 181, 76, 137, 189]
    index: 0
    (index < 6)?>
        .bytes: bytes & [saves.(index * 3), saves.(index * 3 + 1), saves.(index * 3 + 2)]
        .bytes: bytes & _bootstrap_x64_word(-(gpr_slot + index + 1) * 8)
        .index+: 1
    bytes

# Partial, non-executable entry prefix: no scratch, errors, parameters or owners.
_bootstrap_x64_entry_prefix(local_count:num, maximum:num, value:num, windows:bit):
    [num] bytes: []
    result: (valid:false, bytes:bytes)
    frame: _bootstrap_x64_frame(local_count, maximum, windows)
    ~frame.valid?
        @: result
    literal: _bootstrap_f64_bytes(value)
    ~literal.valid?
        @: result
    result.bytes: _bootstrap_x64_prologue(frame.frame_bytes, frame.xmm_slot, frame.gpr_slot, windows)
    result.bytes: result.bytes & [76, 137, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    windows?
        result.bytes: result.bytes & [73, 137, 204]
    ~windows?
        result.bytes: result.bytes & [73, 137, 252]
    result.bytes: result.bytes & [72, 184] & literal.bytes & [102, 72, 15, 110, 192, 242, 15, 17, 133]
    result.bytes: result.bytes & _bootstrap_x64_word(-(local_count + 1) * 8)
    result.valid: true
    result

_bootstrap_x64_epilogue(xmm_slot:num, gpr_slot:num, windows:bit) -> [num]:
    [num] bytes: []
    windows?
        .bytes: bytes & [243, 15, 111, 181] & _bootstrap_x64_word(-(xmm_slot + 1) * 8)
        .bytes: bytes & [243, 15, 111, 189] & _bootstrap_x64_word(-(xmm_slot + 3) * 8)
    restores: [72, 139, 157, 72, 139, 181, 72, 139, 189, 76, 139, 173, 76, 139, 181, 76, 139, 189]
    index: 0
    (index < 6)?>
        .bytes: bytes & [restores.(index * 3), restores.(index * 3 + 1), restores.(index * 3 + 2)]
        .bytes: bytes & _bootstrap_x64_word(-(gpr_slot + index + 1) * 8)
        .index+: 1
    bytes & [201, 195]

# Private executable entry for a validated source call with empty string
# literals. Opcode slice: 1 push empty string, 2 call record constructor,
# 3 return numeric success. The call remains a symbolic rel32 relocation.
_bootstrap_x64_empty_string_record_entry(
    opcodes:[num], operands:[num], result_count:num, maximum:num, windows:bit
):
    [num] bytes: []
    result: (valid:false, bytes:bytes, relocation_offset:0)
    (opcodes.length() != 11 \/ operands.length() != 11 \/
        result_count != 18 \/ maximum != 18 \/ ~windows)?
        @: result
    index: 0
    (index < 9)?>
        (opcodes.(index) != 1 \/ operands.(index) != 0)?
            @: result
        .index+: 1
    (opcodes.9 != 2 \/ operands.9 != 18 \/ opcodes.10 != 3 \/ operands.10 != 1)?
        @: result
    local_count: result_count
    frame: _bootstrap_x64_frame(local_count, maximum, windows)
    ~frame.valid?
        @: result
    .bytes: _bootstrap_x64_prologue(frame.frame_bytes, frame.xmm_slot, frame.gpr_slot, windows)
    .bytes: bytes & [76, 137, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    .bytes: bytes & [73, 137, 204]
    .index: 0
    (index < local_count)?>
        .bytes: bytes & [72, 199, 133] & _bootstrap_x64_word(-(index + 1) * 8)
        .bytes: bytes & [0, 0, 0, 0]
        .index+: 1
    .index: 0
    pointer_slot: 0
    length_slot: 0
    (index < 9)?>
        .pointer_slot: local_count + index * 2
        .length_slot: pointer_slot + 1
        .bytes: bytes & [73, 139, 68, 36, 56, 102, 72, 15, 110, 192]
        .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(pointer_slot + 1) * 8)
        .bytes: bytes & [72, 184, 0, 0, 0, 0, 0, 0, 0, 0, 102, 72, 15, 110, 192]
        .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(length_slot + 1) * 8)
        .index+: 1
    .bytes: bytes & [76, 141, 149] & _bootstrap_x64_word(-(local_count + 1) * 8)
    .bytes: bytes & [77, 137, 211, 232]
    result.relocation_offset: bytes.length()
    .bytes: bytes & [0, 0, 0, 0]
    # Native initializes owned locals before storing aggregate call results.
    .index: 0
    length_local: 0
    pointer_local: 0
    (index < 9)?>
        .length_local: index * 2 + 1
        .pointer_local: index * 2
        .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(length_local + 1) * 8)
        .bytes: bytes & [242, 72, 15, 44, 192, 72, 133, 192, 15, 137, 19, 0, 0, 0]
        .bytes: bytes & [72, 139, 133] & _bootstrap_x64_word(-(pointer_local + 1) * 8)
        .bytes: bytes & [72, 131, 232, 8, 72, 137, 193, 65, 255, 84, 36, 72]
        .bytes: bytes & [72, 199, 133] & _bootstrap_x64_word(-(length_local + 1) * 8)
        .bytes: bytes & [0, 0, 0, 0]
        .index+: 1
    .index: result_count
    (index > 0)?>
        .index-: 1
        .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(local_count + index + 1) * 8)
        .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(index + 1) * 8)
    literal: _bootstrap_f64_bytes(1)
    ~literal.valid?
        @: result
    .bytes: bytes & [72, 184] & literal.bytes & [102, 72, 15, 110, 192]
    .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(local_count + 1) * 8)
    .index: 0
    (index < 9)?>
        .length_local: index * 2 + 1
        .pointer_local: index * 2
        .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(length_local + 1) * 8)
        .bytes: bytes & [242, 72, 15, 44, 192, 72, 133, 192, 15, 137, 19, 0, 0, 0]
        .bytes: bytes & [72, 139, 133] & _bootstrap_x64_word(-(pointer_local + 1) * 8)
        .bytes: bytes & [72, 131, 232, 8, 72, 137, 193, 65, 255, 84, 36, 72]
        .bytes: bytes & [72, 199, 133] & _bootstrap_x64_word(-(length_local + 1) * 8)
        .bytes: bytes & [0, 0, 0, 0]
        .index+: 1
    .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(local_count + 1) * 8)
    .bytes: bytes & [76, 139, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    .bytes: bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
    result.valid: true
    result.bytes: bytes
    result

# Private runner entry for a source-produced compiler function accepting one
# borrowed list and returning `(owned_list, count)`. The list contains empty
# string cells; only its structural length is observed by this bounded seam.
_bootstrap_x64_string_list_count_entry(
    element_count:num, result_count:num, windows:bit
):
    [num] bytes: []
    result: (valid:false, bytes:bytes, relocation_offset:0, second_relocation_offset:0)
    (element_count < 1 \/ element_count > 16383 \/ element_count % 1 != 0 \/
        result_count != 2 \/ ~windows)?
        @: result
    cell_count: element_count * 2
    allocation_size: cell_count * 8 + 16
    frame: _bootstrap_x64_frame(0, 4, windows)
    ~frame.valid?
        @: result
    .bytes: _bootstrap_x64_prologue(frame.frame_bytes, frame.xmm_slot, frame.gpr_slot, windows)
    .bytes: bytes & [76, 137, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    .bytes: bytes & [73, 137, 204, 185] & _bootstrap_x64_word(allocation_size)
    .bytes: bytes & [65, 255, 84, 36, 64, 72, 133, 192, 15, 133]
    allocated_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, allocated_reference, bytes.length())
    .bytes: bytes & [72, 199, 0] & _bootstrap_x64_word(cell_count)
    .bytes: bytes & [72, 199, 64, 8] & _bootstrap_x64_word(cell_count)
    .bytes: bytes & [73, 137, 195, 72, 141, 120, 16, 72, 49, 192, 185]
    .bytes: bytes & _bootstrap_x64_word(cell_count)
    .bytes: bytes & [243, 72, 171, 76, 137, 157, 248, 255, 255, 255]
    .bytes: bytes & [76, 141, 149, 248, 255, 255, 255]
    .bytes: bytes & [76, 141, 157, 240, 255, 255, 255, 232]
    result.relocation_offset: bytes.length()
    .bytes: bytes & [0, 0, 0, 0]
    # Prove the first owned vector result has the expected list representation.
    .bytes: bytes & [72, 139, 133, 240, 255, 255, 255, 72, 133, 192, 15, 133]
    first_non_null_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, first_non_null_reference, bytes.length())
    .bytes: bytes & [72, 129, 56] & _bootstrap_x64_word(cell_count) & [15, 132]
    first_count_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, first_count_reference, bytes.length())
    .bytes: bytes & [72, 129, 120, 8] & _bootstrap_x64_word(cell_count) & [15, 132]
    first_capacity_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, first_capacity_reference, bytes.length())
    # Replace the borrowed input with the first owned result and reenter the
    # same source-produced compiler function. Preserve the first clone because
    # the second result context overwrites its pointer slot.
    .bytes: bytes & [72, 137, 133, 224, 255, 255, 255]
    .bytes: bytes & [72, 139, 141, 248, 255, 255, 255, 65, 255, 84, 36, 72]
    .bytes: bytes & [72, 139, 133, 224, 255, 255, 255]
    .bytes: bytes & [72, 137, 133, 248, 255, 255, 255]
    .bytes: bytes & [76, 141, 149, 248, 255, 255, 255]
    .bytes: bytes & [76, 141, 157, 240, 255, 255, 255, 232]
    result.second_relocation_offset: bytes.length()
    .bytes: bytes & [0, 0, 0, 0]
    # Prove the second owned vector result before releasing both generations.
    .bytes: bytes & [72, 139, 133, 240, 255, 255, 255, 72, 133, 192, 15, 133]
    second_non_null_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, second_non_null_reference, bytes.length())
    .bytes: bytes & [72, 129, 56] & _bootstrap_x64_word(cell_count) & [15, 132]
    second_count_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, second_count_reference, bytes.length())
    .bytes: bytes & [72, 129, 120, 8] & _bootstrap_x64_word(cell_count) & [15, 132]
    second_capacity_reference: bytes.length()
    .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
    .bytes: _bootstrap_x64_patch_relative(bytes, second_capacity_reference, bytes.length())
    # Free second and first returned clones; preserve count in its result slot.
    .bytes: bytes & [72, 139, 141, 240, 255, 255, 255, 65, 255, 84, 36, 72]
    .bytes: bytes & [72, 139, 141, 224, 255, 255, 255, 65, 255, 84, 36, 72]
    .bytes: bytes & [242, 15, 16, 133, 232, 255, 255, 255]
    .bytes: bytes & [76, 139, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    .bytes: bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
    result.valid: true
    result.bytes: bytes
    result

# Complete scalar-constant entry bytes, still without an executable container.
_bootstrap_x64_entry_constant(local_count:num, maximum:num, value:num, windows:bit):
    result: _bootstrap_x64_entry_prefix(local_count, maximum, value, windows)
    ~result.valid?
        @: result
    frame: _bootstrap_x64_frame(local_count, maximum, windows)
    result.bytes: result.bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(local_count + 1) * 8)
    result.bytes: result.bytes & [76, 139, 165] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    result.bytes: result.bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
    result

# Non-entry numeric/owned-list results from validated borrowed-vector parameters.
# Count is required: native integer/register-cache tiers then remain ineligible.
_bootstrap_x64_borrowed_scalar_function(opcodes:[num], operands:[num], parameter_count:num, maximum:num, windows:bit):
    [num] bytes: []
    [num] types: []
    result: (valid:false, bytes:bytes)
    (opcodes.length() = 0 \/ opcodes.length() != operands.length() \/ parameter_count < 1)?
        @: result
    frame: _bootstrap_x64_frame(parameter_count, maximum, windows)
    ~frame.valid?
        @: result
    .bytes: _bootstrap_x64_prologue(frame.frame_bytes, frame.xmm_slot, frame.gpr_slot, windows)
    .bytes: bytes & [76, 137, 157] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    index: 0
    (index < parameter_count)?>
        .bytes: bytes & [242, 65, 15, 16, 130] & _bootstrap_x64_word(-index * 8)
        .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(index + 1) * 8)
        .index+: 1
    .index: 0
    depth: 0
    saw_count: false
    returned: false
    code: 0
    operand: 0
    field: 0
    (index < opcodes.length())?>
        .code: opcodes.(index)
        .operand: operands.(index)
        (code != 1 /\ code != 2 /\ code != 3 /\ code != 4 /\ code != 5 /\ code != 6 /\ code != 7 /\ code != 8)?
            @: result
        code = 1?
            literal: _bootstrap_f64_bytes(operand)
            ~literal.valid?
                @: result
            .bytes: bytes & [72, 184] & literal.bytes & [102, 72, 15, 110, 192]
            .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(parameter_count + depth + 1) * 8)
            depth = types.length()? .types: types & [1]
            types.(depth): 1
            .depth+: 1
        code = 2?
            (operand < 0 \/ operand >= parameter_count \/ operand % 1 != 0)?
                @: result
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(operand + 1) * 8)
            .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(parameter_count + depth + 1) * 8)
            depth = types.length()? .types: types & [3]
            types.(depth): 3
            .depth+: 1
        code = 3?
            (depth < 1 \/ operand != 0)?
                @: result
            types.(depth - 1) != 3?
                @: result
            .bytes: bytes & [72, 139, 133] & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            .bytes: bytes & [72, 139, 8, 242, 72, 15, 42, 193, 242, 15, 17, 133]
            .bytes: bytes & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            types.(depth - 1): 1
            .saw_count: true
        (code = 4 \/ code = 5)?
            (depth < 2 \/ operand != 0)?
                @: result
            (types.(depth - 2) != 1 \/ types.(depth - 1) != 1)?
                @: result
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            .bytes: bytes & [242, 15, 16, 141] & _bootstrap_x64_word(-(parameter_count + depth - 1) * 8)
            arithmetic: 94
            code = 5? .arithmetic: 88
            .bytes: bytes & [242, 15, arithmetic, 200, 102, 15, 40, 193]
            .depth-: 1
            .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(parameter_count + depth) * 8)
        code = 6?
            (depth < 1 \/ operand != 0 \/ types.(depth - 1) != 3)?
                @: result
            # Borrowed list pointer must exist before its allocation size is read.
            .bytes: bytes & [72, 139, 133] & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            .bytes: bytes & [72, 133, 192, 15, 133]
            source_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
            .bytes: _bootstrap_x64_patch_relative(bytes, source_reference, bytes.length())
            .bytes: bytes & [72, 139, 0, 72, 193, 224, 3, 72, 131, 192, 16]
            windows? .bytes: bytes & [72, 137, 193]
            ~windows? .bytes: bytes & [72, 137, 199]
            .bytes: bytes & [65, 255, 84, 36, 64, 72, 133, 192, 15, 133]
            allocated_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
            .bytes: _bootstrap_x64_patch_relative(bytes, allocated_reference, bytes.length())
            .bytes: bytes & [73, 137, 195, 76, 139, 149]
            .bytes: bytes & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            .bytes: bytes & [73, 139, 10, 73, 137, 11, 73, 137, 75, 8, 72, 133, 201, 15, 132]
            empty_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 73, 131, 194, 16, 73, 131, 195, 16]
            copy: bytes.length()
            .bytes: bytes & [242, 65, 15, 16, 2, 242, 65, 15, 17, 3,
                73, 131, 194, 8, 73, 131, 195, 8, 72, 255, 201, 15, 133]
            repeat_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0]
            .bytes: _bootstrap_x64_patch_relative(bytes, repeat_reference, copy)
            .bytes: _bootstrap_x64_patch_relative(bytes, empty_reference, bytes.length())
            .bytes: bytes & [72, 137, 133] & _bootstrap_x64_word(-(parameter_count + depth) * 8)
            types.(depth - 1): 2
        code = 7?
            # Native selects a separate host-AVX2 return path at eight cells.
            (operand < 2 \/ operand >= 8 \/ operand % 1 != 0 \/ depth != operand \/ index + 1 != opcodes.length())?
                @: result
            .field: 0
            (field < operand)?>
                (types.(field) != 1 /\ types.(field) != 2)?
                    @: result
                .field+: 1
            .bytes: bytes & [76, 139, 157] & _bootstrap_x64_word(-(frame.context + 1) * 8)
            .field: 0
            (field < operand)?>
                .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(parameter_count + field + 1) * 8)
                .bytes: bytes & [242, 65, 15, 17, 131] & _bootstrap_x64_word(-field * 8)
                .field+: 1
            .bytes: bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
            .depth: 0
            .returned: true
        code = 8?
            (depth != 1 \/ index + 1 != opcodes.length() \/ operand != 0)?
                @: result
            types.0 != 1?
                @: result
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(parameter_count + 1) * 8)
            .bytes: bytes & [76, 139, 157] & _bootstrap_x64_word(-(frame.context + 1) * 8)
            .bytes: bytes & [242, 65, 15, 17, 131] & _bootstrap_x64_word(0)
            .bytes: bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
            .depth: 0
            .returned: true
        depth > maximum?
            @: result
        .index+: 1
    ~(returned /\ saw_count)?
        @: result
    result.valid: true
    result.bytes: bytes
    result

# Non-entry owned-string records from validated borrowed-string parameters.
_bootstrap_x64_borrowed_string_record_function(
    opcodes:[num], operands:[num], parameter_count:num, maximum:num, windows:bit, avx2:bit
):
    [num] bytes: []
    [num] types: []
    [num] origins: []
    result: (valid:false, bytes:bytes)
    (opcodes.length() = 0 \/ opcodes.length() != operands.length() \/
        parameter_count < 1 \/ parameter_count % 1 != 0)?
        @: result
    cell_count: parameter_count * 2
    frame: _bootstrap_x64_frame(cell_count, maximum, windows)
    ~frame.valid?
        @: result
    .bytes: _bootstrap_x64_prologue(frame.frame_bytes, frame.xmm_slot, frame.gpr_slot, windows)
    .bytes: bytes & [76, 137, 157] & _bootstrap_x64_word(-(frame.context + 1) * 8)
    index: 0
    (index < cell_count)?>
        .bytes: bytes & [242, 65, 15, 16, 130] & _bootstrap_x64_word(-index * 8)
        .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(index + 1) * 8)
        .index+: 1
    .index: 0
    depth: 0
    code: 0
    operand: 0
    returned: false
    saw_clone: false
    field: 0
    return_blocks: 0
    return_copy: 0
    return_repeat_reference: 0
    (index < opcodes.length())?>
        .code: opcodes.(index)
        .operand: operands.(index)
        (code != 2 /\ code != 7 /\ code != 9)?
            @: result
        code = 2?
            (operand < 0 \/ operand >= cell_count \/ operand % 1 != 0)?
                @: result
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(operand + 1) * 8)
            .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(cell_count + depth + 1) * 8)
            depth = types.length()?
                .types: types & [0]
                .origins: origins & [0]
            types.(depth): 4
            operand % 2 = 1? types.(depth): 5
            origins.(depth): operand
            .depth+: 1
        code = 9?
            (operand != 0 \/ depth < 2 \/ types.(depth - 2) != 4 \/
                types.(depth - 1) != 5 \/ origins.(depth - 1) != origins.(depth - 2) + 1)?
                @: result
            first: depth - 2
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(cell_count + first + 2) * 8)
            .bytes: bytes & [242, 72, 15, 44, 200, 72, 133, 201, 15, 137]
            decoded_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 72, 247, 217, 72, 255, 201]
            .bytes: _bootstrap_x64_patch_relative(bytes, decoded_reference, bytes.length())
            .bytes: bytes & [72, 137, 200, 72, 131, 192, 9, 15, 131]
            size_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
            .bytes: _bootstrap_x64_patch_relative(bytes, size_reference, bytes.length())
            windows? .bytes: bytes & [72, 137, 193]
            ~windows? .bytes: bytes & [72, 137, 199]
            .bytes: bytes & [65, 255, 84, 36, 64, 72, 133, 192, 15, 133]
            allocated_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 65, 255, 84, 36, 80, 204]
            .bytes: _bootstrap_x64_patch_relative(bytes, allocated_reference, bytes.length())
            .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(cell_count + first + 2) * 8)
            .bytes: bytes & [242, 72, 15, 44, 200, 72, 133, 201, 15, 137]
            length_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0, 72, 247, 217, 72, 255, 201]
            .bytes: _bootstrap_x64_patch_relative(bytes, length_reference, bytes.length())
            .bytes: bytes & [72, 137, 8, 76, 141, 88, 8, 76, 139, 149]
            .bytes: bytes & _bootstrap_x64_word(-(cell_count + first + 1) * 8)
            .bytes: bytes & [73, 137, 200, 72, 133, 201, 15, 132]
            empty_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0]
            copy: bytes.length()
            .bytes: bytes & [65, 138, 18, 65, 136, 19, 73, 255, 194,
                73, 255, 195, 72, 255, 201, 15, 133]
            repeat_reference: bytes.length()
            .bytes: bytes & [0, 0, 0, 0]
            .bytes: _bootstrap_x64_patch_relative(bytes, repeat_reference, copy)
            .bytes: _bootstrap_x64_patch_relative(bytes, empty_reference, bytes.length())
            .bytes: bytes & [65, 198, 3, 0, 72, 131, 192, 8, 72, 137, 133]
            .bytes: bytes & _bootstrap_x64_word(-(cell_count + first + 1) * 8)
            .bytes: bytes & [73, 141, 72, 1, 72, 247, 217, 242, 72, 15, 42, 193]
            .bytes: bytes & [242, 15, 17, 133] & _bootstrap_x64_word(-(cell_count + first + 2) * 8)
            types.(first): 6
            types.(first + 1): 7
            .saw_clone: true
        code = 7?
            (operand < 2 \/ operand % 1 != 0 \/
                depth != operand \/ index + 1 != opcodes.length())?
                @: result
            .field: 0
            (field < operand)?>
                (field + 1 >= operand \/ types.(field) != 6 \/ types.(field + 1) != 7)?
                    @: result
                .field+: 2
            .bytes: bytes & [76, 139, 157] & _bootstrap_x64_word(-(frame.context + 1) * 8)
            (operand >= 8 /\ avx2)?
                .bytes: bytes & [72, 141, 133] & _bootstrap_x64_word(-(cell_count + 1) * 8)
                .bytes: bytes & [76, 137, 218]
                .return_blocks: operand // 4
                .bytes: bytes & [72, 131, 232, 24, 72, 131, 234, 24, 185]
                .bytes: bytes & _bootstrap_x64_word(return_blocks)
                .return_copy: bytes.length()
                .bytes: bytes & [197, 253, 16, 0, 197, 253, 17, 2,
                    72, 131, 232, 32, 72, 131, 234, 32, 255, 201, 15, 133]
                .return_repeat_reference: bytes.length()
                .bytes: bytes & [0, 0, 0, 0]
                .bytes: _bootstrap_x64_patch_relative(bytes, return_repeat_reference, return_copy)
                .bytes: bytes & [197, 248, 119]
                .field: return_blocks * 4
            (operand < 8 \/ ~avx2)?
                .field: 0
            (field < operand)?>
                .bytes: bytes & [242, 15, 16, 133] & _bootstrap_x64_word(-(cell_count + field + 1) * 8)
                .bytes: bytes & [242, 65, 15, 17, 131] & _bootstrap_x64_word(-field * 8)
                .field+: 1
            .bytes: bytes & _bootstrap_x64_epilogue(frame.xmm_slot, frame.gpr_slot, windows)
            .depth: 0
            .returned: true
        depth > maximum?
            @: result
        .index+: 1
    ~(returned /\ saw_clone)?
        @: result
    result.valid: true
    result.bytes: bytes
    result

# Private scalar expression fragment over validated parser/type facts.
# Private opcodes: 1 push_f64, 2 load_local, 3 count_f64_list (borrowed),
# 4 divide_f64, 5 add_f64. Public opcode/schema bytes are fixed.
_bootstrap_vector_stride(source:str, rows:[num], start:num, stop:num) -> num:
    token: 0
    (token < rows.length() / 6 /\ rows.(token * 6 + 1) < start)?>
        .token+: 1
    (token + 2 >= rows.length() / 6 \/ rows.(token * 6) != 22 \/
        rows.(token * 6 + 1) != start \/ rows.((token + 1) * 6) != 1 \/
        rows.((token + 2) * 6) != 23 \/ rows.((token + 2) * 6 + 2) != stop)?
        @: 0
    str name: vkf_utf8_slice(source, rows.((token + 1) * 6 + 1), rows.((token + 1) * 6 + 2))
    name = "str"?
        @: 2
    (name = "num" \/ name = "int" \/ name = "bit")?
        @: 1
    0

# Native folds adjacent push/push/add repeatedly, retaining pre-fold max_stack.
_bootstrap_fold_additions(opcodes:[num], operands:[num]):
    [num] codes: []
    [num] values: []
    [num] result_codes: []
    [num] result_values: []
    result: (valid:false, opcodes:result_codes, operands:result_values)
    opcodes.length() != operands.length()?
        @: result
    index: 0
    active: 0
    (index < opcodes.length())?>
        active = codes.length()?
            .codes: codes & [opcodes.(index)]
            .values: values & [operands.(index)]
        active < codes.length()?
            codes.(active): opcodes.(index)
            values.(active): operands.(index)
        .active+: 1
        (active >= 3 /\ codes.(active - 3) = 1 /\
            codes.(active - 2) = 1 /\ codes.(active - 1) = 5)?>
            values.(active - 3): values.(active - 3) + values.(active - 2)
            .active-: 2
        .index+: 1
    .index: 0
    (index < active)?>
        result.opcodes: result.opcodes & [codes.(index)]
        result.operands: result.operands & [values.(index)]
        .index+: 1
    result.valid: true
    result

_bootstrap_lower_expression(
    source:str, rows:[num], nodes:[num], types:[num], parameters:[num],
    type_starts:[num], type_stops:[num]
):
    [num] opcodes: []
    [num] operands: []
    [num] strides: []
    fragment: (valid:false, error_index:0, opcodes:opcodes, operands:operands, max_stack:0)
    (nodes.length() = 0 \/ nodes.length() % 5 != 0 \/
        types.length() != nodes.length() / 5 \/ parameters.length() != types.length() \/
        type_starts.length() != type_stops.length())?
        @: fragment
    (types.(types.length() - 1) != 1 /\ types.(types.length() - 1) != 2)?
        @: fragment
    index: 0
    depth: 0
    kind: 0
    left: 0
    right: 0
    parameter: 0
    stride: 0
    (index < types.length())?>
        fragment.error_index: nodes.(index * 5 + 1)
        .kind: nodes.(index * 5)
        .stride: 0
        (kind < 1 \/ kind > 6 \/ kind % 1 != 0)?
            @: fragment
        kind = 1?
            .parameter: parameters.(index)
            (types.(index) != 3 \/ parameter < 0 \/ parameter % 1 != 0 \/ parameter >= type_starts.length())?
                @: fragment
            .stride: _bootstrap_vector_stride(source, rows, type_starts.(parameter), type_stops.(parameter))
            stride = 0?
                @: fragment
            fragment.opcodes: fragment.opcodes & [2]
            fragment.operands: fragment.operands & [parameter]
            .depth+: 1
        kind = 2?
            (types.(index) != 1 /\ types.(index) != 2)?
                @: fragment
            fragment.opcodes: fragment.opcodes & [1]
            fragment.operands: fragment.operands & [nodes.(index * 5 + 4)]
            .depth+: 1
        (kind = 3 \/ kind = 4 \/ kind = 5 \/ kind = 6)?
            .left: nodes.(index * 5 + 2)
            (left < 0 \/ left >= index \/ left % 1 != 0)?
                @: fragment
        kind = 3?
            (types.(index) != 4 \/ types.(left) != 3)?
                @: fragment
            .stride: strides.(left)
        kind = 4?
            (types.(index) != 1 \/ types.(left) != 4 \/ nodes.(index * 5 + 4) != 0 \/ depth < 1)?
                @: fragment
            fragment.opcodes: fragment.opcodes & [3]
            fragment.operands: fragment.operands & [0]
            strides.(left) > 1?
                fragment.opcodes: fragment.opcodes & [1, 4]
                fragment.operands: fragment.operands & [strides.(left), 0]
                depth + 1 > fragment.max_stack?
                    fragment.max_stack: depth + 1
        kind = 6?
            types.(index) != types.(left)?
                @: fragment
            .stride: strides.(left)
        kind = 5?
            .right: nodes.(index * 5 + 3)
            (right < 0 \/ right >= index \/ right % 1 != 0 \/ depth < 2)?
                @: fragment
            ((types.(left) != 1 /\ types.(left) != 2) \/
                (types.(right) != 1 /\ types.(right) != 2) \/
                (types.(index) != 1 /\ types.(index) != 2))?
                @: fragment
            fragment.opcodes: fragment.opcodes & [5]
            fragment.operands: fragment.operands & [0]
            .depth-: 1
        depth > fragment.max_stack?
            fragment.max_stack: depth
        .strides: strides & [stride]
        .index+: 1
    fragment.valid: depth = 1
    ~fragment.valid?
        @: fragment
    folded: _bootstrap_fold_additions(fragment.opcodes, fragment.operands)
    fragment.valid: folded.valid
    fragment.opcodes: folded.opcodes
    fragment.operands: folded.operands
    fragment

_bootstrap_lower_owned_result(
    source:str, rows:[num], nodes:[num], types:[num], parameters:[num],
    type_starts:[num], type_stops:[num]
):
    fragment: _bootstrap_lower_expression(source, rows, nodes, types, parameters, type_starts, type_stops)
    (types.length() = 0 \/ types.length() != nodes.length() / 5 \/
        parameters.length() != types.length() \/ type_starts.length() != type_stops.length())?
        @: fragment
    root: types.length() - 1
    local: 0
    prior: 0
    (types.(root) != 3 /\ types.(root) != 5)?
        @: fragment
    child: 0
    (nodes.(root * 5) = 6)?>
        .child: nodes.(root * 5 + 2)
        (child < 0 \/ child >= root \/ child % 1 != 0)?
            @: fragment
        .root: child
    fragment.error_index: nodes.(root * 5 + 1)
    (nodes.(root * 5) != 1 \/ (types.(root) != 3 /\ types.(root) != 5))?
        @: fragment
    parameter: parameters.(root)
    (parameter < 0 \/ parameter % 1 != 0 \/ parameter >= type_starts.length())?
        @: fragment
    types.(root) = 3?
        _bootstrap_vector_stride(source, rows, type_starts.(parameter), type_stops.(parameter)) = 0?
            @: fragment
        fragment.opcodes: fragment.opcodes & [2, 6]
        fragment.operands: fragment.operands & [parameter, 0]
        fragment.max_stack: 1
    types.(root) = 5?
        .local: 0
        .prior: 0
        (prior < parameter)?>
            .local+: 1
            vkf_utf8_slice(source, type_starts.(prior), type_stops.(prior)) = "str"?
                .local+: 1
            .prior+: 1
        fragment.opcodes: fragment.opcodes & [2, 2, 9]
        fragment.operands: fragment.operands & [local, local + 1, 0]
        fragment.max_stack: 2
    fragment.valid: true
    fragment

MachineInstruction: (
    kind:str,
    value:any,
    index:num,
    byte_count:num,
    argument_count:num,
    provided_parameter_mask:num,
    uses_parameter_mask:bit,
    result_count:num,
    label:num,
    owns_input:bit,
    owns_left:bit,
    owns_right:bit,
    may_error:bit,
    error_type_mask:num,
    has_error_handler:bit,
    error_value_local:num,
    error_type_local:num,
    error_message_offset:num,
    handler_error_value_local:num,
    handler_error_type_local:num,
    symbol:str
)

MachineFunction: (
    name:str,
    parameters:any,
    locals:any,
    owned_f64_list_locals:any,
    owned_string_locals:any,
    parameter_mask_local:any,
    may_error:bit,
    instructions:any,
    max_stack:num
)

MachineModule: (
    schema:str,
    version:num,
    output_kind:str,
    output_count:num,
    outputs:any,
    output_tokens:any,
    string_data:any,
    entry:MachineFunction,
    functions:any
)
ConcreteTaggedMachineInstruction: (
    kind:str,
    index:num,
    value:num,
    symbol:str,
    argument_count:num,
    result_count:num,
    provided_parameter_mask:num,
    uses_parameter_mask:bit,
    may_error:bit,
    has_error_handler:bit,
    error_label:num,
    error_value_local:num,
    error_type_local:num
)
ConcreteTaggedMachineFunction: (
    name:str,
    parameters:[str],
    parameter_is_numeric_scalar:[bit],
    result_is_numeric_scalar:bit,
    result_is_dynamic_f64_list:bit,
    locals:[str],
    local_classes:[str],
    owned_f64_list_locals:[num],
    owned_string_locals:[num],
    may_error:bit,
    instructions:[ConcreteTaggedMachineInstruction],
    max_stack:num
)
ConcreteTaggedMachineModule: (
    schema:str,
    version:num,
    output_kind:str,
    output_count:num,
    outputs:[str],
    output_tokens:[str],
    string_data:[num],
    entry:ConcreteTaggedMachineFunction,
    functions:[ConcreteTaggedMachineFunction]
)

TaggedMachineModule: (source:str, statements:[num], count:int)
TaggedMachineInstruction: (kind:str, index:num, value:num)
TaggedMachineInstructions: [TaggedMachineInstruction:4]
TaggedNestedMachineInstructions: [TaggedMachineInstruction:6]
TaggedDependencyMachineInstructions: [TaggedMachineInstruction:8]
TaggedScalarMachineInstructions: (
    instructions:[TaggedMachineInstruction:4],
    instruction_count:int,
    max_stack:num
)
TaggedResolvedCallInstruction: (
    kind:str,
    symbol:str,
    argument_count:int,
    result_count:int
)
TaggedResolvedCallInstructions: (
    instructions:[TaggedResolvedCallInstruction:3],
    instruction_count:int,
    max_stack:num
)
TaggedMachineStatement: (
    name:str,
    instructions:TaggedMachineInstructions,
    max_stack:num
)
TaggedNestedMachineStatement: (
    name:str,
    instructions:TaggedNestedMachineInstructions,
    max_stack:num
)
TaggedDependencyMachineStatement: (
    name:str,
    instructions:TaggedDependencyMachineInstructions,
    max_stack:num
)
TaggedDynamicMachineStatement: (
    name:str,
    opcodes:[num],
    values:[num],
    max_stack:num
)

NumericFunctionConstInput: (kind:str, value:num, type:str)
NumericFunctionLoadInput: (kind:str, name:str, type:str)
NumericFunctionMultiplyInput: (kind:str, left:NumericFunctionLoadInput, left_type:str, op:str, right:NumericFunctionConstInput, right_type:str, type:str)
NumericFunctionStatementInput: (expr:NumericFunctionMultiplyInput, kind:str)
NumericFunctionBlockInput: (body:[NumericFunctionStatementInput:1], kind:str)
NumericFunctionParameterInput: (default:any, kind:str, name:str, type:str, variadic_named:bit, variadic_positional:bit)
NumericFunctionSignatureInput: (kind:str, params:[str:1], return_type:str, type:str)
NumericFunctionInput: (body:NumericFunctionBlockInput, kind:str, name:str, params:[NumericFunctionParameterInput:1], representation_type:str, return_type:str, signature:NumericFunctionSignatureInput, type:str)

mir_simple(kind:str):
    (kind: kind,)

mir_multiply_f64():
    mir_simple("multiply_f64")

mir_return_f64():
    mir_simple("return_f64")

mir_push_f64(value:num):
    (kind: "push_f64", value: value)

mir_push_string(index:num, byte_count:num):
    (kind: "push_string", index: index, byte_count: byte_count)

mir_local(kind:str, index:num):
    (kind: kind, index: index)

mir_load_local(index:num):
    mir_local("load_local", index)

mir_call(symbol:str, argument_count:num, result_count:num, provided_parameter_mask:num=0, uses_parameter_mask:bit=false, may_error:bit=false, has_error_handler:bit=false, error_label:num=0, error_value_local:num=0, error_type_local:num=0):
    (kind: "call", symbol: symbol, argument_count: argument_count, result_count: result_count, provided_parameter_mask: provided_parameter_mask, uses_parameter_mask: uses_parameter_mask, may_error: may_error, has_error_handler: has_error_handler, error_label: error_label, error_value_local: error_value_local, error_type_local: error_type_local)

mir_reduce(kind:str, argument_count:num):
    (kind: kind, argument_count: argument_count)

mir_dynamic_list_consumer(kind:str, owns_input:bit):
    (kind: kind, owns_input: owns_input)

mir_branch(kind:str, label:num):
    (kind: kind, label: label)

mir_function(name:str, parameters:any, locals:any, instructions:any, max_stack:num):
    (
        name: name,
        parameters: parameters,
        locals: locals,
        owned_f64_list_locals: [],
        owned_string_locals: [],
        parameter_mask_local: null,
        may_error: false,
        instructions: instructions,
        max_stack: max_stack
    )

mir_module(entry:MachineFunction, functions:any, output_kind:str, string_data:any, output_count:num=0, outputs:any=[], output_tokens:any=[]):
    (
        schema: "vektorflow.machine_ir",
        version: 4,
        output_kind: output_kind,
        output_count: output_count,
        outputs: outputs,
        output_tokens: output_tokens,
        string_data: string_data,
        entry: entry,
        functions: functions
    )

mir_tagged_module(
    source:str, statements:[num], count:int
) -> TaggedMachineModule:
    (source:source, statements:statements, count:count)

_mir_tagged_instruction(
    kind:str, index:num=0, value:num=0
) -> TaggedMachineInstruction:
    (kind:kind, index:index, value:value)

_mir_tagged_binary_kind(operator_code:num) -> str:
    operator_code??
        1 => "add_f64"
        3 => "subtract_f64"
        4 => "multiply_f64"
        5 => "divide_f64"
        6 => "remainder_f64"
        7 => "power_f64"
        8 => "floor_divide_f64"
        "unknown"

_mir_tagged_typed_binary_kind(operator_kind:str) -> str:
    operator_kind??
        "PLUS" => "add_f64"
        "MINUS" => "subtract_f64"
        "STAR" => "multiply_f64"
        "SLASH" => "divide_f64"
        "PERCENT" => "remainder_f64"
        "CARET" => "power_f64"
        "FLOORDIV" => "floor_divide_f64"
        "unknown"

_mir_tagged_scalar_constant(value:num) -> TaggedScalarMachineInstructions:
    (
        instructions:[
            _mir_tagged_instruction("push_f64", value:value),
            _mir_tagged_instruction("return_f64"),
            _mir_tagged_instruction("unused"),
            _mir_tagged_instruction("unused")
        ],
        instruction_count:2,
        max_stack:1
    )

_mir_tagged_scalar_binary(
    operator_kind:str, value:num
) -> TaggedScalarMachineInstructions:
    (
        instructions:[
            _mir_tagged_instruction("load_local", 0),
            _mir_tagged_instruction("push_f64", value:value),
            _mir_tagged_instruction(
                _mir_tagged_typed_binary_kind(operator_kind)
            ),
            _mir_tagged_instruction("return_f64")
        ],
        instruction_count:4,
        max_stack:2
    )

mir_lower_tagged_scalar_expression(
    expression_kind:str, left_name:str, operator_kind:str,
    value:num, expression_type:str
) -> TaggedScalarMachineInstructions:
    (expression_type = "num")?! "tagged scalar expression must have num type"
    expression_kind = "const"?
        @: _mir_tagged_scalar_constant(value)
    expression_kind = "binary_op"?
        (left_name != "")?! "tagged binary expression has no left identifier"
        @: _mir_tagged_scalar_binary(operator_kind, value)
    false?! "tagged scalar expression kind is unsupported"
    _mir_tagged_scalar_constant(value)

_mir_tagged_resolved_call_instruction(
    kind:str, symbol:str, argument_count:int, result_count:int
) -> TaggedResolvedCallInstruction:
    (
        kind:kind,
        symbol:symbol,
        argument_count:argument_count,
        result_count:result_count
    )

mir_lower_tagged_resolved_call(
    callee:str, callee_type:str,
    argument_callee:str, argument_type:str,
    result_type:str
) -> TaggedResolvedCallInstructions:
    (callee != "")?! "resolved call target is empty"
    (callee_type = "fn(num)->num")?! "resolved call target type is unsupported"
    (argument_callee = "cpu_count" /\ argument_type = "int")?! "resolved call argument is unsupported"
    (result_type = "num")?! "resolved call result type is unsupported"
    (
        instructions:[
            _mir_tagged_resolved_call_instruction("call", argument_callee, 0, 1),
            _mir_tagged_resolved_call_instruction("call", callee, 1, 1),
            _mir_tagged_resolved_call_instruction("return_f64", "", 0, 1)
        ],
        instruction_count:3,
        max_stack:1
    )

mir_tagged_module_statement(
    module:TaggedMachineModule, index:int
) -> TaggedMachineStatement:
    offset: index * 8
    (
        name:vkf_utf8_slice(
            module.source,
            module.statements.(offset),
            module.statements.(offset + 1)
        ),
        instructions:[
            _mir_tagged_instruction("load_local", 0),
            _mir_tagged_instruction(
                "push_f64", value:module.statements.(offset + 3)
            ),
            _mir_tagged_instruction(
                _mir_tagged_binary_kind(module.statements.(offset + 2))
            ),
            _mir_tagged_instruction("return_f64")
        ],
        max_stack:2
    )

mir_lower_empty_typed_module(module:any):
    bit matches: module.kind = "typed_module" /\ module.body.length() = 0
    matches?! "empty typed module does not match MachineModule lowering"
    (
        entry: (
            instructions: [(kind:"return_values", result_count:0)],
            local_classes: [],
            locals: [],
            max_stack: 0,
            may_error: false,
            name: "\$entry",
            owned_f64_list_locals: [],
            owned_string_locals: [],
            parameter_is_numeric_scalar: [],
            parameter_mask_local: null,
            parameters: [],
            result_is_dynamic_f64_list: false,
            result_is_numeric_scalar: false
        ),
        functions: [],
        output_count: 0,
        output_kind: "none",
        output_tokens: [],
        outputs: [],
        schema: "vektorflow.machine_ir",
        string_bytes: 77,
        version: 23
    )

mir_scalar_binding_typed_module_matches(module:any) -> bit:
    binding: module.body.0
    statement: module.body.1
    output: statement.expr
    loaded: output.args.0
    (module.kind = "typed_module" /\ module.body.length() = 2 /\
        binding.kind = "store_binding" /\ binding.type = "int" /\
        binding.update = false /\ binding.value.kind = "const" /\
        binding.value.type = "int" /\ statement.kind = "expr_stmt" /\
        output.kind = "call" /\ output.callee.kind = "stdlib_function" /\
        output.callee.full_name = "io.print" /\
        output.callee.module = "io" /\ output.callee.name = "print" /\
        output.arg_types.0 = "int" /\ loaded.kind = "load" /\
        loaded.name = binding.name /\ loaded.type = "int")

mir_lower_scalar_binding_typed_module(module:any):
    binding: module.body.0
    statement: module.body.1
    output: statement.expr
    loaded: output.args.0
    module.kind
    binding.kind
    binding.value.kind
    statement.kind
    output.kind
    output.callee.kind
    loaded.kind
    mir_scalar_binding_typed_module_matches(module)?!
    (
        entry: (
            instructions: [
                mir_push_f64(binding.value.value),
                mir_local("store_local", 0),
                mir_push_f64(binding.value.value),
                mir_return_f64()
            ],
            local_classes: ["i64"],
            locals: [binding.name],
            max_stack: 1,
            may_error: false,
            name: "\$entry",
            owned_f64_list_locals: [],
            owned_string_locals: [],
            parameter_is_numeric_scalar: [],
            parameter_mask_local: null,
            parameters: [],
            result_is_dynamic_f64_list: false,
            result_is_numeric_scalar: false
        ),
        functions: [],
        output_count: 1,
        output_kind: "f64",
        output_tokens: [],
        outputs: [],
        schema: "vektorflow.machine_ir",
        string_bytes: 77,
        version: 23
    )

_mir_tagged_module_functions(
    module:TaggedMachineModule,
    index:int,
    entry_index:int,
    validated_max_stack:num
) -> [MachineFunction]:
    index >= module.count?
        @: []
    index = entry_index?
        @: _mir_tagged_module_functions(
            module, index + 1, entry_index, validated_max_stack
        )
    statement: mir_tagged_module_statement(module, index)
    [mir_function(
        statement.name,
        ["num"],
        [],
        statement.instructions,
        validated_max_stack
    )] & _mir_tagged_module_functions(
        module, index + 1, entry_index, validated_max_stack
    )

mir_assemble_tagged_statement_module(
    module:TaggedMachineModule,
    index:int,
    validated_max_stack:num
) -> MachineModule:
    statement: mir_tagged_module_statement(module, index)
    entry: mir_function(
        statement.name,
        ["num"],
        [],
        statement.instructions,
        validated_max_stack
    )
    (
        schema:"vektorflow.machine_ir",
        version:4,
        output_kind:"none",
        output_count:0,
        outputs:[],
        output_tokens:[],
        string_data:[],
        entry:entry,
        functions:_mir_tagged_module_functions(
            module, 0, index, validated_max_stack
        )
    )

mir_tagged_closed_statement(
    module:TaggedMachineModule,
    binding_index:int,
    expression_index:int
) -> TaggedMachineStatement:
    binding_offset: binding_index * 8
    expression_offset: expression_index * 8
    (module.statements.(binding_offset + 2) = 2)?! "closed Machine IR binding row is not a binding"
    (module.statements.(expression_offset + 2) = 1)?! "closed Machine IR expression row is not an addition"
    (vkf_utf8_slice(
        module.source,
        module.statements.(binding_offset),
        module.statements.(binding_offset + 1)
    ) = vkf_utf8_slice(
        module.source,
        module.statements.(expression_offset),
        module.statements.(expression_offset + 1)
    ))?! "closed Machine IR expression does not match its binding"
    (
        name:"\$entry",
        instructions:[
            _mir_tagged_instruction(
                "push_f64", value:module.statements.(binding_offset + 3)
            ),
            _mir_tagged_instruction(
                "push_f64", value:module.statements.(expression_offset + 3)
            ),
            _mir_tagged_instruction("add_f64"),
            _mir_tagged_instruction("return_f64")
        ],
        max_stack:2
    )

mir_tagged_closed_statement_from_previous_binding(
    module:TaggedMachineModule,
    expression_index:int
) -> TaggedMachineStatement:
    (expression_index > 0)?! "closed Machine IR expression has no preceding binding"
    (expression_index < module.count)?! "closed Machine IR expression index is out of range"
    mir_tagged_closed_statement(module, expression_index - 1, expression_index)

mir_tagged_closed_statement_from_prior_binding(
    module:TaggedMachineModule,
    expression_index:int
) -> TaggedMachineStatement:
    (expression_index > 0)?! "closed Machine IR expression has no prior binding"
    (expression_index < module.count)?! "closed Machine IR expression index is out of range"
    expression_offset: expression_index * 8
    binding_index: expression_index - 1
    found: false
    (binding_index >= 0 /\ ~found)?>
        binding_offset: binding_index * 8
        matches: (
            module.statements.(binding_offset + 2) = 2 /\
            vkf_utf8_slice(
                module.source,
                module.statements.(binding_offset),
                module.statements.(binding_offset + 1)
            ) = vkf_utf8_slice(
                module.source,
                module.statements.(expression_offset),
                module.statements.(expression_offset + 1)
            )
        )
        matches?
            .found: true
        ~matches?
            .binding_index: binding_index - 1
    found?! "closed Machine IR expression has no matching prior binding"
    mir_tagged_closed_statement(module, binding_index, expression_index)

