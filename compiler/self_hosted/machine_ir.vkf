        values:instruction_values,
        max_stack:3
    )

mir_tagged_dynamic_addition(
    values:[num]
) -> TaggedDynamicMachineStatement:
    (values.length() >= 2)?! "dynamic addition Machine IR needs at least two operands"
    [num] opcodes: [1]
    [num] instruction_values: [values.0]
    index: 1
    (index < values.length())?>
        .opcodes: opcodes & [1, 2]
        .instruction_values: instruction_values & [values.(index), 0]
        .index+: 1
    final_opcodes: opcodes & [3]
    final_values: instruction_values & [0]
    (
        name:"\$entry",
        opcodes:final_opcodes,
        values:final_values,
        max_stack:2
    )

mir_tagged_dynamic_mixed_arithmetic(
    operators:[num], values:[num]
) -> TaggedDynamicMachineStatement:
    (values.length() = operators.length() + 1)?! "dynamic mixed arithmetic Machine IR has imbalanced operands"
    [num] opcodes: [1]
    [num] instruction_values: [values.0]
    index: 0
    first_power_count: 0
    (index < operators.length() /\ operators.(index) = 11)?>
        .opcodes: opcodes & [1]
        .instruction_values: instruction_values & [values.(index + 1)]
        .first_power_count+: 1
        .index+: 1
    emitted_power: 0
    (emitted_power < first_power_count)?>
        .opcodes: opcodes & [9]
        .instruction_values: instruction_values & [0]
        .emitted_power+: 1
    maximum: first_power_count + 1
    depth: 1
    pending_low: 0
    chain_power_count: 0
    (index < operators.length())?>
        operator_kind: operators.(index)
        .chain_power_count: 0
        (operator_kind = 2 \/ operator_kind = 7 \/ operator_kind = 9 \/ operator_kind = 10 \/ operator_kind = 12 \/ operator_kind = 20)?! "dynamic mixed arithmetic Machine IR has an unknown operator"
        (operator_kind = 2 \/ operator_kind = 20)?
            pending_low != 0?
                .opcodes: opcodes & [pending_low]
                .instruction_values: instruction_values & [0]
                .depth-: 1
        .index+: 1
        .opcodes: opcodes & [1]
        .instruction_values: instruction_values & [values.(index)]
        (index < operators.length() /\ operators.(index) = 11)?>
            .opcodes: opcodes & [1]
            .instruction_values: instruction_values & [values.(index + 1)]
            .chain_power_count+: 1
            .index+: 1
        depth + chain_power_count + 1 > maximum?
            .maximum: depth + chain_power_count + 1
        .emitted_power: 0
        (emitted_power < chain_power_count)?>
            .opcodes: opcodes & [9]
            .instruction_values: instruction_values & [0]
            .emitted_power+: 1
        .depth+: 1
        (operator_kind = 2 \/ operator_kind = 20)?
            operator_kind = 2?
                .pending_low: 2
            operator_kind = 20?
                .pending_low: 6
        (operator_kind = 7 \/ operator_kind = 9 \/ operator_kind = 10 \/ operator_kind = 12)?
            operator_kind = 12?
                .opcodes: opcodes & [4]
            operator_kind = 7?
                .opcodes: opcodes & [5]
            operator_kind = 9?
                .opcodes: opcodes & [7]
            operator_kind = 10?
                .opcodes: opcodes & [8]
            .instruction_values: instruction_values & [0]
            .depth-: 1
    pending_low != 0?
        .opcodes: opcodes & [pending_low]
        .instruction_values: instruction_values & [0]
        .depth-: 1
    (depth = 1)?! "dynamic mixed arithmetic Machine IR has an imbalanced result"
    (
        name:"\$entry",
        opcodes:opcodes & [3],
        values:instruction_values & [0],
        max_stack:maximum
    )

_mir_dynamic_arithmetic_operator_opcode(token_kind:num) -> num:
    token_kind = 2?
        @: 2
    token_kind = 7?
        @: 5
    token_kind = 9?
        @: 7
    token_kind = 10?
        @: 8
    token_kind = 11?
        @: 9
    token_kind = 12?
        @: 4
    token_kind = 21?
        @: 10
    (token_kind = 20)?! "dynamic grouped arithmetic Machine IR has an unknown operator"
    6

_mir_dynamic_arithmetic_operator_precedence(token_kind:num) -> num:
    token_kind = 21?
        @: 4
    token_kind = 11?
        @: 3
    (token_kind = 7 \/ token_kind = 9 \/ token_kind = 10 \/ token_kind = 12)?
        @: 2
    (token_kind = 2 \/ token_kind = 20)?! "dynamic grouped arithmetic Machine IR has an unknown precedence"
    1

mir_tagged_dynamic_grouped_arithmetic(
    tokens:[num], values:[num]
) -> TaggedDynamicMachineStatement:
    (tokens.length() = values.length())?! "dynamic grouped arithmetic Machine IR has imbalanced tapes"
    [num] opcodes: []
    [num] instruction_values: []
    [num] operator_stack: [0:tokens.length()]
    operator_count: 0
    index: 0
    token_kind: 0
    top_kind: 0
    current_precedence: 0
    top_precedence: 0
    popping: false
    should_pop: false
    found_open: false
    (index < tokens.length())?>
        .token_kind: tokens.(index)
        (token_kind = 1 \/ token_kind = 3)?
            .opcodes: opcodes & [1]
            .instruction_values: instruction_values & [values.(index)]
        token_kind = 13?
            operator_stack.(operator_count): token_kind
            .operator_count+: 1
        token_kind = 14?
            .found_open: false
            (operator_count > 0 /\ ~found_open)?>
                .operator_count-: 1
                .top_kind: operator_stack.(operator_count)
                top_kind = 13?
                    .found_open: true
                top_kind != 13?
                    .opcodes: opcodes & [_mir_dynamic_arithmetic_operator_opcode(top_kind)]
                    .instruction_values: instruction_values & [0]
            found_open?! "dynamic grouped arithmetic Machine IR has an unmatched closing parenthesis"
        (token_kind = 2 \/ token_kind = 7 \/ token_kind = 9 \/
            token_kind = 10 \/ token_kind = 11 \/ token_kind = 12 \/
            token_kind = 20 \/ token_kind = 21)?
            .current_precedence: _mir_dynamic_arithmetic_operator_precedence(token_kind)
            .popping: token_kind != 21
            (operator_count > 0 /\ popping)?>
                .top_kind: operator_stack.(operator_count - 1)
                top_kind = 13?
                    .popping: false
                top_kind != 13?
                    .top_precedence: _mir_dynamic_arithmetic_operator_precedence(top_kind)
                    .should_pop: top_precedence > current_precedence \/ (top_precedence = current_precedence /\ token_kind != 11)
                    should_pop?
                        .operator_count-: 1
                        .opcodes: opcodes & [_mir_dynamic_arithmetic_operator_opcode(top_kind)]
                        .instruction_values: instruction_values & [0]
                    ~should_pop?
                        .popping: false
            operator_stack.(operator_count): token_kind
            .operator_count+: 1
        .index+: 1
    operator_count > 0?>
        .operator_count-: 1
        .top_kind: operator_stack.(operator_count)
        (top_kind != 13)?! "dynamic grouped arithmetic Machine IR has an unmatched opening parenthesis"
        .opcodes: opcodes & [_mir_dynamic_arithmetic_operator_opcode(top_kind)]
        .instruction_values: instruction_values & [0]
    (
        name:"\$entry",
        opcodes:opcodes & [3],
        values:instruction_values & [0],
        max_stack:0
    )

mir_dynamic_opcode_kind(code:num) -> str:
    code = 1?
        @: "push_f64"
    code = 2?
        @: "add_f64"
    (code = 3)?! "dynamic dependency instruction has an unknown opcode"
    "return_f64"

mir_assemble_closed_dynamic_dependency_module(
    statement:TaggedDynamicMachineStatement,
    validated_max_stack:num
) -> MachineModule:
    (validated_max_stack = statement.max_stack)?! "dynamic dependency Machine IR stack maximum does not match validation"
    [TaggedMachineInstruction:8] instructions: [
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.0), value:statement.values.0),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.1), value:statement.values.1),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.2), value:statement.values.2),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.3), value:statement.values.3),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.4), value:statement.values.4),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.5), value:statement.values.5),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.6), value:statement.values.6),
        _mir_tagged_instruction(mir_dynamic_opcode_kind(statement.opcodes.7), value:statement.values.7)
    ]
    entry: (
        name:statement.name,
        parameters:[],
        locals:[],
        owned_f64_list_locals:[],
        owned_string_locals:[],
        parameter_mask_local:null,
        may_error:false,
        instructions:instructions,
        max_stack:validated_max_stack
    )
    (
        schema:"vektorflow.machine_ir",
        version:4,
        output_kind:"f64",
        output_count:1,
        outputs:[],
        output_tokens:[],
        string_data:[],
        entry:entry,
        functions:[]
    )

