        parameter_mask_local: null,
        parameters: [parameter_name],
        result_is_dynamic_f64_list: false,
        result_is_numeric_scalar: true
    )

mir_numeric_count_to_loop_typed_module_matches(application:any) -> bit:
    function: application.body.0
    entry: application.body.1
    print_call: entry.expr
    function_call: print_call.args.0
    entry_value: function_call.args.0
    (_mir_numeric_count_to_loop_cardinalities_match(application) /\
        application.kind = "typed_module" /\
        mir_numeric_count_to_loop_function_matches(function) /\
        entry.kind = "expr_stmt" /\
        print_call.kind = "call" /\
        print_call.callee.kind = "stdlib_function" /\
        print_call.callee.full_name = "io.print" /\
        print_call.callee.module = "io" /\
        print_call.callee.name = "print" /\
        print_call.callee.type = "fn(any)->any" /\
        print_call.callee_type = "fn(any)->any" /\
        print_call.arg_types.0 = "num" /\
        print_call.type = "any" /\
        function_call.kind = "call" /\
        function_call.callee.kind = "load" /\
        function_call.callee.name = function.name /\
        function_call.callee.type = "fn(num)->num" /\
        function_call.callee_type = "fn(num)->num" /\
        function_call.arg_types.0 = "num" /\
        function_call.specialization_arg_types.0 = "num" /\
        function_call.type = "num" /\
        entry_value.kind = "const" /\
        entry_value.type = "num")

mir_lower_numeric_count_to_loop_typed_module(application:any):
    # Private layout projections are effect-free and bounded to the exact
    # typed count-to loop envelope consumed by this Stage takeover tracer.
    function: application.body.0
    entry: application.body.1
    initial_store: application.body.0.body.body.0
    loop_statement: application.body.0.body.body.1
    increment_store: application.body.0.body.body.1.body.body.0
    final_return: application.body.0.body.body.2
    condition: application.body.0.body.body.1.condition
    increment: application.body.0.body.body.1.body.body.0.value
    print_call: application.body.1.expr
    function_call: application.body.1.expr.args.0
    entry_value: application.body.1.expr.args.0.args.0
    application.kind
    function.kind
    function.signature.kind
    function.signature.params.0
    function.params.0.kind
    initial_store.kind
    initial_store.value.kind
    loop_statement.kind
    loop_statement.body.kind
    condition.kind
    condition.left.kind
    condition.right.kind
    increment_store.kind
    increment.kind
    increment.left.kind
    increment.right.kind
    entry.kind
    print_call.kind
    print_call.callee.kind
    function_call.kind
    function_call.callee.kind
    entry_value.kind
    _mir_numeric_count_to_loop_cardinalities_match(application)?! "typed count-to loop application does not match MachineModule lowering"
    (function.body.body.2.kind = "return")?! "typed count-to loop application does not match MachineModule lowering"
    mir_numeric_count_to_loop_typed_module_matches(application)?! "typed count-to loop application does not match MachineModule lowering"
    (
        entry: _mir_numeric_count_to_loop_entry(
            function.name,
            entry_value.value
        ),
        functions: [_mir_numeric_count_to_loop_function(
            function.name,
            function.params.0.name,
            initial_store.name,
            initial_store.value.value,
            increment.right.value,
            entry_value.value
        )],
        output_count: 1,
        output_kind: "f64",
        output_tokens: [],
        outputs: [],
        schema: "vektorflow.machine_ir",
        string_bytes: 77,
        version: 23
    )

