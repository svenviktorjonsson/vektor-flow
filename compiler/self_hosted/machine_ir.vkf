) -> bit:
    numeric_function: module.functions.(1)
    numeric_parameter: numeric_function.parameters.(0)
    first_instruction: numeric_function.instructions.(0)
    second_instruction: numeric_function.instructions.(1)
    third_instruction: numeric_function.instructions.(2)
    fourth_instruction: numeric_function.instructions.(3)
    (module.entry.name = "\$entry" /\
        module.entry.instructions.(0).symbol = "cpu_count" /\
        module.entry.instructions.(1).symbol = function_name /\
        numeric_function.name = function_name /\
        numeric_parameter = parameter_name /\
        first_instruction.kind = "load_local" /\
        second_instruction.value = value /\
        third_instruction.kind = "multiply_f64" /\
        fourth_instruction.kind = "return_f64")

