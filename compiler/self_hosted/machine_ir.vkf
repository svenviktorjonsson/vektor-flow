# Self-hosted VKF machine IR contract.
#
# Target-neutral stack IR between canonical typed IR and platform encoders.
# Stage 0 currently executes this contract in native C++; Stage 1 will execute
# the same construction and lowering rules from VKF source.

MachineInstruction: (
    kind:str,
    value:any,
    index:num,
    byte_count:num,
    argument_count:num,
    provided_parameter_mask:num,
    uses_parameter_mask:bit,
    result_count:num,
    label:num,
    owns_input:bit,
    owns_left:bit,
    owns_right:bit,
    may_error:bit,
    error_type_mask:num,
    has_error_handler:bit,
    error_value_local:num,
    error_type_local:num,
    error_message_offset:num,
    handler_error_value_local:num,
    handler_error_type_local:num,
    symbol:str
)

MachineFunction: (
    name:str,
    parameters:any,
    locals:any,
    owned_f64_list_locals:any,
    owned_string_locals:any,
    parameter_mask_local:any,
    may_error:bit,
    instructions:any,
    max_stack:num
)

MachineModule: (
    schema:str,
    version:num,
    output_kind:str,
    output_count:num,
    outputs:any,
    output_tokens:any,
    string_data:any,
    entry:MachineFunction,
    functions:any
)

NumericFunctionConstInput: (kind:str, value:num, type:str)
NumericFunctionLoadInput: (kind:str, name:str, type:str)
NumericFunctionMultiplyInput: (kind:str, left:NumericFunctionLoadInput, left_type:str, op:str, right:NumericFunctionConstInput, right_type:str, type:str)
NumericFunctionStatementInput: (expr:NumericFunctionMultiplyInput, kind:str)
NumericFunctionBlockInput: (body:[NumericFunctionStatementInput:1], kind:str)
NumericFunctionParameterInput: (default:any, kind:str, name:str, type:str, variadic_named:bit, variadic_positional:bit)
NumericFunctionSignatureInput: (kind:str, params:[str:1], return_type:str, type:str)
NumericFunctionInput: (body:NumericFunctionBlockInput, kind:str, name:str, params:[NumericFunctionParameterInput:1], representation_type:str, return_type:str, signature:NumericFunctionSignatureInput, type:str)

mir_simple(kind:str):
    (kind: kind,)

mir_multiply_f64():
    mir_simple("multiply_f64")

mir_return_f64():
    mir_simple("return_f64")

mir_push_f64(value:num):
    (kind: "push_f64", value: value)

mir_push_string(index:num, byte_count:num):
    (kind: "push_string", index: index, byte_count: byte_count)

mir_local(kind:str, index:num):
    (kind: kind, index: index)

mir_load_local(index:num):
    mir_local("load_local", index)

mir_call(symbol:str, argument_count:num, result_count:num, provided_parameter_mask:num=0, uses_parameter_mask:bit=false, may_error:bit=false, has_error_handler:bit=false, error_label:num=0, error_value_local:num=0, error_type_local:num=0):
    (kind: "call", symbol: symbol, argument_count: argument_count, result_count: result_count, provided_parameter_mask: provided_parameter_mask, uses_parameter_mask: uses_parameter_mask, may_error: may_error, has_error_handler: has_error_handler, error_label: error_label, error_value_local: error_value_local, error_type_local: error_type_local)

mir_reduce(kind:str, argument_count:num):
    (kind: kind, argument_count: argument_count)

mir_dynamic_list_consumer(kind:str, owns_input:bit):
    (kind: kind, owns_input: owns_input)

mir_branch(kind:str, label:num):
    (kind: kind, label: label)

mir_function(name:str, parameters:any, locals:any, instructions:any, max_stack:num):
    (
        name: name,
        parameters: parameters,
        locals: locals,
        owned_f64_list_locals: [],
        owned_string_locals: [],
        parameter_mask_local: null,
        may_error: false,
        instructions: instructions,
        max_stack: max_stack
    )

mir_module(entry:MachineFunction, functions:any, output_kind:str, string_data:any, output_count:num=0, outputs:any=[], output_tokens:any=[]):
    (
        schema: "vektorflow.machine_ir",
        version: 4,
        output_kind: output_kind,
        output_count: output_count,
        outputs: outputs,
        output_tokens: output_tokens,
        string_data: string_data,
        entry: entry,
        functions: functions
    )

mir_numeric_parameter_multiply_instructions(right_value:num):
    [
        mir_load_local(0),
        mir_push_f64(right_value),
        mir_multiply_f64(),
        mir_return_f64()
    ]

mir_numeric_parameter_multiply_function_matches(function:NumericFunctionInput) -> bit:
    (function.kind = "function" /\
        function.params.0.kind = "param" /\
        function.body.kind = "block" /\
        function.body.body.0.kind = "expr_stmt" /\
        function.body.body.0.expr.kind = "binary_op" /\
        function.body.body.0.expr.op = "STAR")

_mir_call_no_handler(symbol:str, argument_count:num, result_count:num, provided_parameter_mask:num):
    (
        argument_count: argument_count,
        has_error_handler: false,
        kind: "call",
        may_error: false,
        provided_parameter_mask: provided_parameter_mask,
        result_count: result_count,
        symbol: symbol,
        uses_parameter_mask: false
    )

_mir_numeric_entry(function_name:str):
    (
        instructions: [
            _mir_call_no_handler("cpu_count", 0, 1, 0),
            _mir_call_no_handler(function_name, 1, 1, 1),
            mir_return_f64()
        ],
        local_classes: [],
        locals: [],
        max_stack: 1,
        may_error: false,
        name: "\$entry",
        owned_f64_list_locals: [],
        owned_string_locals: [],
        parameter_is_numeric_scalar: [],
        parameter_mask_local: null,
        parameters: [],
        result_is_dynamic_f64_list: false,
        result_is_numeric_scalar: false
    )

_mir_numeric_cpu_count_function():
    (
        instructions: [mir_simple("system_cpu_count"), mir_return_f64()],
        local_classes: [],
        locals: [],
        max_stack: 1,
        may_error: false,
        name: "cpu_count",
        owned_f64_list_locals: [],
        owned_string_locals: [],
        parameter_is_numeric_scalar: [],
        parameter_mask_local: null,
        parameters: [],
        result_is_dynamic_f64_list: false,
        result_is_numeric_scalar: true
    )

_mir_numeric_parameter_multiply_function(function:NumericFunctionInput):
    (
        instructions: mir_numeric_parameter_multiply_instructions(
            function.body.body.0.expr.right.value
        ),
        local_classes: ["f64"],
        locals: [function.params.0.name],
        max_stack: 2,
        may_error: false,
        name: function.name,
        owned_f64_list_locals: [],
        owned_string_locals: [],
        parameter_is_numeric_scalar: [true],
        parameter_mask_local: null,
        parameters: [function.params.0.name],
        result_is_dynamic_f64_list: false,
        result_is_numeric_scalar: true
    )

mir_lower_numeric_parameter_multiply_function_module(function:any):
    mir_numeric_parameter_multiply_function_matches(function)?!
    (
        entry: _mir_numeric_entry(function.name),
        functions: [
            _mir_numeric_cpu_count_function(),
            _mir_numeric_parameter_multiply_function(function)
        ],
        output_count: 1,
        output_kind: "f64",
        output_tokens: [],
        outputs: [],
        schema: "vektorflow.machine_ir",
        string_bytes: 77,
        version: 23
    )

mir_numeric_parameter_multiply_typed_module_matches(application:any) -> bit:
    function: application.body.0
    entry: application.body.1
    print_call: entry.expr
    function_call: print_call.args.0
    host_call: function_call.args.0
    (application.kind = "typed_module" /\
        mir_numeric_parameter_multiply_function_matches(function) /\
        entry.kind = "expr_stmt" /\
        print_call.kind = "call" /\
        print_call.callee.kind = "stdlib_function" /\
        print_call.callee.full_name = "io.print" /\
        print_call.callee.module = "io" /\
        print_call.callee.name = "print" /\
        print_call.callee.type = "fn(any)->any" /\
        print_call.callee_type = "fn(any)->any" /\
        print_call.arg_types.0 = "num" /\
        print_call.type = "any" /\
        function_call.kind = "call" /\
        function_call.callee.kind = "load" /\
        function_call.callee.name = function.name /\
        function_call.callee.type = "fn(num)->num" /\
        function_call.callee_type = "fn(num)->num" /\
        function_call.arg_types.0 = "num" /\
        function_call.specialization_arg_types.0 = "num" /\
        function_call.type = "num" /\
        host_call.kind = "call" /\
        host_call.callee.kind = "load" /\
        host_call.callee.name = "cpu_count" /\
        host_call.callee.type = "fn()->int" /\
        host_call.callee_type = "fn()->int" /\
        host_call.type = "num")

mir_lower_numeric_parameter_multiply_typed_module(application:any):
    # These effect-free projections give the private direct-call ABI the exact
    # application layout that the matcher consumes before validation runs.
    function: application.body.0
    entry: application.body.1
    print_call: entry.expr
    function_call: print_call.args.0
    host_call: function_call.args.0
    application.kind
    function.kind
    entry.kind
    print_call.kind
    print_call.callee.kind
    print_call.callee.full_name
    print_call.callee.module
    print_call.callee.name
    print_call.callee.type
    print_call.callee_type
    print_call.arg_types.0
    print_call.type
    function_call.kind
    function_call.callee.kind
    function_call.callee.name
    function_call.callee.type
    function_call.callee_type
    function_call.arg_types.0
    function_call.specialization_arg_types.0
    function_call.type
    host_call.kind
    host_call.callee.kind
    host_call.callee.name
    host_call.callee.type
    host_call.callee_type
    host_call.type
    mir_numeric_parameter_multiply_typed_module_matches(application)?! "typed numeric application does not match MachineModule lowering"
    mir_lower_numeric_parameter_multiply_function_module(application.body.0)

