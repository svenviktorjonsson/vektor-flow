machine_ir_capability:
    schema: "vektorflow.machine_ir"
    version: 1
    ownership: [
        "typed IR lowers once into target-neutral machine IR",
        "platform encoders consume machine IR instead of typed IR JSON",
        "control-flow labels preserve short-circuit semantics",
        "assert_truthy preserves its condition and aborts only when falsy",
        "default arguments evaluate in callee order and can read earlier parameters",
        "runtime calls use a versioned runtime ABI",
        "Windows Linux and macOS share opcode semantics"
    ]
    current_value_classes: ["f64", "i64", "bit", "address", "aggregate"]
    direct_layout_slices: ["fixed vector", "numeric record", "owned-or-borrowed UTF-8 string", "owned dynamic numeric list"]
    direct_container_algorithms: ["UTF-8 string comparison", "bulk constant numeric-list initialization", "dynamic index", "dynamic concatenation", "stat.sum", "stat.mean", "stat.count"]
    ownership_model: [
        "fresh dynamic list values own malloc storage",
        "owned strings encode ownership in signed length and keep byte length in an allocation header",
        "aggregate resource leaves are recursively cloned released and transferred",
        "string loads clone before escaping and string concatenation transfers unique ownership",
        "function parameters borrow dynamic lists",
        "borrowed values clone when ownership must escape",
        "function results transfer unique dynamic-list ownership",
        "fresh call arguments release immediately after borrowed calls",
        "temporary consumers release owned inputs",
        "local rebinding and function exit release owned storage",
        "bounds failures propagate typed IndexError values without reading invalid memory",
        "runtime validation instructions carry their concrete error type mask",
        "catch dispatch selects the most-specific runtime error type before broader types"
    ]
    next_layout_slices: ["dynamic list growth", "heterogeneous dynamic collection"]
    :
