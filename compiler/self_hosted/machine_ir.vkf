mir_tagged_dynamic_two_derived_bindings(
    values:[num:4]
) -> TaggedDynamicMachineStatement:
    [num] opcodes: [1, 1, 2, 1, 2, 1, 2, 3]
    [num] instruction_values: [
        values.0, values.1, 0, values.2, 0, values.3, 0, 0
    ]
    (
        name:"\$entry",
