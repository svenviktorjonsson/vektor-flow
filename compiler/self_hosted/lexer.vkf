# Self-hosted VKF lexer seed.
#
# This file is compiler source, not runtime example code. Old parser compiles it
# during bootstrap only. Target: replace old Python lexer with VKF-owned lexer.

Token: (kind:str, value:any, line:num, column:num)
LexResult: (tokens:any, errors:any)
ScannerState: (name:str, token_kind:str, starts:any, stops:any, emits:bit)
TaggedTokenValue: (tag:str, text:str, number:num)
TaggedParserToken: (kind:str, value:TaggedTokenValue, location:any)
TaggedTokenTape: (source:str, rows:[num], count:int)

token(kind:str, value:any, line:num, column:num):
    (kind: kind, value: value, line: line, column: column)

StringCursor(source:str):
    bit at_eof: vkf_string_eof(source, 0)
    (source: source, position: 0, line: 1, column: 1,
     eof: at_eof)

CursorSlice: (start:StringCursor, stop:StringCursor, text:str)

_string_cursor_peek(cursor:StringCursor) -> str:
    vkf_string_peek_scalar(cursor.source, cursor.position)

_string_cursor_advance(cursor:StringCursor) -> StringCursor:
    int next_position: vkf_utf8_advance(cursor.source, cursor.position)
    bit next_eof: vkf_string_eof(cursor.source, next_position)
    cursor.peek() = "\n"?
        @: (source:cursor.source, position:next_position,
            line:cursor.line + 1, column:1, eof:next_eof)
    (source:cursor.source, position:next_position,
     line:cursor.line, column:cursor.column + 1, eof:next_eof)

_string_cursor_slice(cursor:StringCursor, start:int, stop:int) -> str:
    vkf_utf8_slice(cursor.source, start, stop)

_lexer_peek(cursor:StringCursor) -> str:
    cursor.peek()

_lexer_advance(cursor:StringCursor) -> StringCursor:
    cursor.advance()

_lexer_slice(cursor:StringCursor, start:int, stop:int) -> str:
    cursor.slice(start, stop)

consume_while(cursor:StringCursor, predicate_name:str):
    consume_while_primitive(cursor, predicate_name)

is_digit(ch:str):
    ch >= "0" /\ ch <= "9"

is_lower(ch:str):
    ch >= "a" /\ ch <= "z"

is_upper(ch:str):
    ch >= "A" /\ ch <= "Z"

is_alpha(ch:str):
    is_lower(ch) \/ is_upper(ch) \/ ch = "_"

is_ident_continue(ch:str):
    is_alpha(ch) \/ is_digit(ch)

is_whitespace(ch:str):
    ch = " " \/ ch = "\t"

is_newline(ch:str):
    ch = "\n"

is_comment_start(ch:str):
    ch = "#"

is_identifier_start(ch:str):
    is_alpha(ch)

is_number_start(ch:str):
    is_digit(ch)

is_number_continue(ch:str):
    is_digit(ch) \/ ch = "." \/ ch = "e" \/ ch = "E" \/ ch = "+" \/ ch = "-"

_lexer_cursor_at(cursor:StringCursor, target:int) -> StringCursor:
    cursor.position >= target?
        (cursor.position = target)?! "identifier start splits a UTF-8 scalar"
        @: cursor
    cursor.eof?
        false?! "identifier start is outside the source"
    _lexer_cursor_at(cursor.advance(), target)

_lexer_scan_identifier(
    cursor:StringCursor,
    start:int,
    line:int,
    column:int
) -> Token:
    cursor.eof?
        @: token("IDENT", cursor.slice(start, cursor.position), line, column)
    is_ident_continue(cursor.peek())?
        @: _lexer_scan_identifier(cursor.advance(), start, line, column)
    token("IDENT", cursor.slice(start, cursor.position), line, column)

identifier_token(source:str, start:int) -> Token:
    cursor: _lexer_cursor_at(StringCursor(source), start)
    cursor.eof?
        false?! "identifier start is outside the source"
    is_identifier_start(cursor.peek())?! "identifier token must start with a letter or underscore"
    _lexer_scan_identifier(cursor, start, cursor.line, cursor.column)

_lexer_skip_layout(cursor:StringCursor) -> StringCursor:
    cursor.eof?
        @: cursor
    (is_whitespace(cursor.peek()) \/ is_newline(cursor.peek()))?
        @: _lexer_skip_layout(cursor.advance())
    cursor

_lexer_skip_identifier(cursor:StringCursor) -> StringCursor:
    cursor.eof?
        @: cursor
    is_ident_continue(cursor.peek())?
        @: _lexer_skip_identifier(cursor.advance())
    cursor

identifier_pair(source:str):
    first_start: _lexer_skip_layout(StringCursor(source))
    first: identifier_token(source, first_start.position)
    after_first: _lexer_skip_identifier(first_start)
    second_start: _lexer_skip_layout(after_first)
    second: identifier_token(source, second_start.position)
    (first:first, second:second)

_lexer_digit_value(ch:str) -> num:
    ch = "0"?
        @: 0
    ch = "1"?
        @: 1
    ch = "2"?
        @: 2
    ch = "3"?
        @: 3
    ch = "4"?
        @: 4
    ch = "5"?
        @: 5
    ch = "6"?
        @: 6
    ch = "7"?
        @: 7
    ch = "8"?
        @: 8
    (ch = "9")?! "number digit expected"
    9

_lexer_scan_number(
    cursor:StringCursor,
    start:int,
    line:int,
    column:int,
    value:num,
    scale:num,
    fractional:bit
) -> Token:
    cursor.eof?
        @: token("NUMBER", value, line, column)
    ch: cursor.peek()
    is_digit(ch)?
        digit: _lexer_digit_value(ch)
        fractional?
            @: _lexer_scan_number(
                cursor.advance(), start, line, column,
                value + digit / scale, scale * 10, true
            )
        @: _lexer_scan_number(
            cursor.advance(), start, line, column,
            value * 10 + digit, scale, false
        )
    (ch = "." /\ ~fractional)?
        @: _lexer_scan_number(
            cursor.advance(), start, line, column,
            value, 10, true
        )
    token("NUMBER", value, line, column)

number_token(source:str, start:int) -> Token:
    cursor: _lexer_cursor_at(StringCursor(source), start)
    cursor.eof?
        false?! "number start is outside the source"
    is_digit(cursor.peek())?! "number token must start with a digit"
    _lexer_scan_number(cursor, start, cursor.line, cursor.column, 0, 10, false)

_lexer_skip_number(cursor:StringCursor) -> StringCursor:
    cursor.eof?
        @: cursor
    (is_digit(cursor.peek()) \/ cursor.peek() = ".")?
        @: _lexer_skip_number(cursor.advance())
    cursor

identifier_number_tokens(source:str):
    first_start: _lexer_skip_layout(StringCursor(source))
    first: identifier_token(source, first_start.position)
    second_start: _lexer_skip_layout(_lexer_skip_identifier(first_start))
    second: number_token(source, second_start.position)
    third_start: _lexer_skip_layout(_lexer_skip_number(second_start))
    third: identifier_token(source, third_start.position)
    fourth_start: _lexer_skip_layout(_lexer_skip_identifier(third_start))
    fourth: number_token(source, fourth_start.position)
    (first:first, second:second, third:third, fourth:fourth)

plus_token(source:str, start:int) -> Token:
    cursor: _lexer_cursor_at(StringCursor(source), start)
    cursor.eof?
        false?! "plus start is outside the source"
    (cursor.peek() = "+")?! "plus token must contain +"
    token("PLUS", null, cursor.line, cursor.column)

identifier_plus_tokens(source:str):
    first_start: _lexer_skip_layout(StringCursor(source))
    first: identifier_token(source, first_start.position)
    operator_start: _lexer_skip_identifier(first_start)
    operator: plus_token(source, operator_start.position)
    third_start: _lexer_skip_layout(operator_start.advance())
    third: identifier_token(source, third_start.position)
    (first:first, operator:operator, third:third)

identifier_plus_stream(source:str):
    first_start: _lexer_skip_layout(StringCursor(source))
    first: identifier_token(source, first_start.position)
    operator_start: _lexer_skip_identifier(first_start)
    operator: plus_token(source, operator_start.position)
    third_start: _lexer_skip_layout(operator_start.advance())
    third: identifier_token(source, third_start.position)
    stream_end: _lexer_skip_identifier(third_start)
    stream_end.eof?! "bounded identifier-plus stream must end after the third token"
    newline: token("NEWLINE", null, stream_end.line, stream_end.column)
    eof: token("EOF", null, stream_end.line, stream_end.column)
    (first:first, operator:operator, third:third, newline:newline, eof:eof)

bounded_lex(source:str):
    stream: identifier_plus_stream(source)
    tokens: [stream.first, stream.operator, stream.third, stream.newline, stream.eof]
    (tokens:tokens, errors:[])

_lexer_stream_token(kind:str, line:num, column:num):
    (
        kind:kind,
        value:null,
        location:(file:"<self-hosted>", line:line, column:column)
    )

bounded_parser_structure_stream(source:str):
    result: bounded_lex(source)
    tokens: [
        _lexer_stream_token(result.tokens.(0).kind, result.tokens.(0).line, result.tokens.(0).column),
        _lexer_stream_token(result.tokens.(1).kind, result.tokens.(1).line, result.tokens.(1).column),
        _lexer_stream_token(result.tokens.(2).kind, result.tokens.(2).line, result.tokens.(2).column),
        _lexer_stream_token(result.tokens.(3).kind, result.tokens.(3).line, result.tokens.(3).column),
        _lexer_stream_token(result.tokens.(4).kind, result.tokens.(4).line, result.tokens.(4).column)
    ]
    (schema:"vektorflow.token_stream", version:1, tokens:tokens)

_tagged_parser_value(tag:str, text:str, number:num) -> TaggedTokenValue:
    (tag:tag, text:text, number:number)

_tagged_parser_token(
    kind:str, value:TaggedTokenValue, line:num, column:num
) -> TaggedParserToken:
    (
        kind:kind,
        value:value,
        location:(file:"<self-hosted>", line:line, column:column)
    )

bounded_parser_tagged_stream(source:str):
    result: identifier_number_tokens(source)
    tokens: [
        _tagged_parser_token(
            result.first.kind,
            _tagged_parser_value("text", result.first.value, 0),
            result.first.line,
            result.first.column
        ),
        _tagged_parser_token(
            result.second.kind,
            _tagged_parser_value("number", "", result.second.value),
            result.second.line,
            result.second.column
        ),
        _tagged_parser_token(
            result.third.kind,
            _tagged_parser_value("text", result.third.value, 0),
            result.third.line,
            result.third.column
        ),
        _tagged_parser_token(
            result.fourth.kind,
            _tagged_parser_value("number", "", result.fourth.value),
            result.fourth.line,
            result.fourth.column
        )
    ]
    (schema:"vektorflow.token_stream", version:1, tokens:tokens)

identifier_plus_number_stream(source:str):
    first_start: _lexer_skip_layout(StringCursor(source))
    first: identifier_token(source, first_start.position)
    operator_start: _lexer_skip_identifier(first_start)
    operator: plus_token(source, operator_start.position)
    third_start: _lexer_skip_layout(operator_start.advance())
    third: number_token(source, third_start.position)
    stream_end: _lexer_skip_number(third_start)
    stream_end.eof?! "bounded identifier-plus-number stream must end after the number"
    newline: token("NEWLINE", null, stream_end.line, stream_end.column)
    eof: token("EOF", null, stream_end.line, stream_end.column)
    (first:first, operator:operator, third:third, newline:newline, eof:eof)

bounded_parser_expression_stream(source:str):
    result: identifier_plus_number_stream(source)
    tokens: [
        _tagged_parser_token(
            result.first.kind,
            _tagged_parser_value("text", result.first.value, 0),
            result.first.line,
            result.first.column
        ),
        _tagged_parser_token(
            result.operator.kind,
            _tagged_parser_value("null", "", 0),
            result.operator.line,
            result.operator.column
        ),
        _tagged_parser_token(
            result.third.kind,
            _tagged_parser_value("number", "", result.third.value),
            result.third.line,
            result.third.column
        ),
        _tagged_parser_token(
            result.newline.kind,
            _tagged_parser_value("null", "", 0),
            result.newline.line,
            result.newline.column
        ),
        _tagged_parser_token(
            result.eof.kind,
            _tagged_parser_value("null", "", 0),
            result.eof.line,
            result.eof.column
        )
    ]
    (schema:"vektorflow.token_stream", version:1, tokens:tokens)

two_identifier_plus_number_stream(source:str):
    first_left_start: _lexer_skip_layout(StringCursor(source))
    first_left: identifier_token(source, first_left_start.position)
    first_operator_start: _lexer_skip_identifier(first_left_start)
    first_operator: plus_token(source, first_operator_start.position)
    first_right_start: _lexer_skip_layout(first_operator_start.advance())
    first_right: number_token(source, first_right_start.position)
    separator_start: _lexer_skip_number(first_right_start)
    is_newline(separator_start.peek())?! "two-expression stream requires a newline separator"
    separator: token("NEWLINE", null, separator_start.line, separator_start.column)
    second_left_start: _lexer_skip_layout(separator_start)
    second_left: identifier_token(source, second_left_start.position)
    second_operator_start: _lexer_skip_identifier(second_left_start)
    second_operator: plus_token(source, second_operator_start.position)
    second_right_start: _lexer_skip_layout(second_operator_start.advance())
    second_right: number_token(source, second_right_start.position)
    stream_end: _lexer_skip_number(second_right_start)
    stream_end.eof?! "bounded two-expression stream must end after the second number"
    newline: token("NEWLINE", null, stream_end.line, stream_end.column)
    eof: token("EOF", null, stream_end.line, stream_end.column)
    (
        first_left:first_left,
        first_operator:first_operator,
        first_right:first_right,
        separator:separator,
        second_left:second_left,
        second_operator:second_operator,
        second_right:second_right,
        newline:newline,
        eof:eof
    )

bounded_two_expression_stream(source:str):
    result: two_identifier_plus_number_stream(source)
    tokens: [
        _tagged_parser_token(
            result.first_left.kind,
            _tagged_parser_value("text", result.first_left.value, 0),
            result.first_left.line,
            result.first_left.column
        ),
        _tagged_parser_token(
            result.first_operator.kind,
            _tagged_parser_value("null", "", 0),
            result.first_operator.line,
            result.first_operator.column
        ),
        _tagged_parser_token(
            result.first_right.kind,
            _tagged_parser_value("number", "", result.first_right.value),
            result.first_right.line,
            result.first_right.column
        ),
        _tagged_parser_token(
            result.separator.kind,
            _tagged_parser_value("null", "", 0),
            result.separator.line,
            result.separator.column
        ),
        _tagged_parser_token(
            result.second_left.kind,
            _tagged_parser_value("text", result.second_left.value, 0),
            result.second_left.line,
            result.second_left.column
        ),
        _tagged_parser_token(
            result.second_operator.kind,
            _tagged_parser_value("null", "", 0),
            result.second_operator.line,
            result.second_operator.column
        ),
        _tagged_parser_token(
            result.second_right.kind,
            _tagged_parser_value("number", "", result.second_right.value),
            result.second_right.line,
            result.second_right.column
        ),
        _tagged_parser_token(
            result.newline.kind,
            _tagged_parser_value("null", "", 0),
            result.newline.line,
            result.newline.column
        ),
        _tagged_parser_token(
            result.eof.kind,
            _tagged_parser_value("null", "", 0),
            result.eof.line,
            result.eof.column
        )
    ]
    (schema:"vektorflow.token_stream", version:1, tokens:tokens)

tagged_token_tape(source:str) -> TaggedTokenTape:
    [num] rows: []
    (source:source, rows:rows, count:0)

_append_tagged_token(
    tape:TaggedTokenTape,
    kind_code:int,
    start:int,
    stop:int,
    value:num,
    line:num,
    column:num
) -> TaggedTokenTape:
    [num] row: [kind_code, start, stop, value, line, column]
    (source:tape.source, rows:tape.rows & row, count:tape.count + 1)

_scan_tagged_statement_tokens(
    cursor:StringCursor, tape:TaggedTokenTape, expected:int
) -> TaggedTokenTape:
    cursor.eof?
        final_tape: tape
        (expected = 3)?
            .final_tape: _append_tagged_token(
                final_tape, 4, cursor.position, cursor.position,
                0, cursor.line, cursor.column
            )
        @: _append_tagged_token(
            final_tape, 5, cursor.position, cursor.position,
            0, cursor.line, cursor.column
        )
    is_whitespace(cursor.peek())?
        @: _scan_tagged_statement_tokens(cursor.advance(), tape, expected)
    is_newline(cursor.peek())?
        newline_tape: tape
        (expected = 3)?
            .newline_tape: _append_tagged_token(
                newline_tape, 4, cursor.position, cursor.position,
                0, cursor.line, cursor.column
            )
            @: _scan_tagged_statement_tokens(
                cursor.advance(), newline_tape, 0
            )
        @: _scan_tagged_statement_tokens(cursor.advance(), tape, expected)
    (expected = 0)?
        is_identifier_start(cursor.peek())?! "identifier token expected"
        identifier_stop: _lexer_skip_identifier(cursor)
        next_tape: _append_tagged_token(
            tape, 1, cursor.position, identifier_stop.position,
            0, cursor.line, cursor.column
        )
        @: _scan_tagged_statement_tokens(identifier_stop, next_tape, 1)
    (expected = 1)?
        (cursor.peek() = "+")?! "plus token expected"
        operator_stop: cursor.advance()
        next_tape: _append_tagged_token(
            tape, 2, cursor.position, operator_stop.position,
            0, cursor.line, cursor.column
        )
        @: _scan_tagged_statement_tokens(operator_stop, next_tape, 2)
    (expected = 2)?
        is_number_start(cursor.peek())?! "number token expected"
        number: number_token(cursor.source, cursor.position)
        number_stop: _lexer_skip_number(cursor)
        next_tape: _append_tagged_token(
            tape, 3, cursor.position, number_stop.position,
            number.value, cursor.line, cursor.column
        )
        @: _scan_tagged_statement_tokens(number_stop, next_tape, 3)
    false?! "newline or EOF expected after expression"
    tape

tagged_statement_token_tape(source:str) -> TaggedTokenTape:
    _scan_tagged_statement_tokens(StringCursor(source), tagged_token_tape(source), 0)

scanner_state(name:str, token_kind:str, starts:any, stops:any, emits:bit):
    (name: name, token_kind: token_kind, starts: starts, stops: stops, emits: emits)

scan_whitespace_state:
    scanner_state(
        "scan_whitespace",
        "WHITESPACE",
        ["space", "tab", "newline"],
        ["non-whitespace"],
        false
    )

scan_comment_state:
    scanner_state(
        "scan_comment",
        "COMMENT",
        ["#"],
        ["newline", "eof"],
        false
    )

scan_identifier_state:
    scanner_state(
        "scan_identifier",
        "IDENT",
        ["alpha", "_"],
        ["not alpha", "not digit", "not _"],
        true
    )

scan_number_state:
    scanner_state(
        "scan_number",
        "NUMBER",
        ["digit"],
        ["not digit", "not dot", "not exponent"],
        true
    )

scanner_state_catalog:
    whitespace: scan_whitespace_state
    comments: scan_comment_state
    identifiers: scan_identifier_state
    numbers: scan_number_state
    :

identifier_number_parity_fixture:
    name: "identifier_number_parity_minimal"
    source: "alpha 123 beta45 6.7"
    expected_tokens: ["IDENT:alpha", "NUMBER:123", "IDENT:beta45", "NUMBER:6.7", "EOF"]
    notes: [
        "StringCursor owns scalar-safe position, peek, advance, slice, and EOF",
        "token stream should match old Python lexer for identifier and number tokens"
    ]
    :

token_kind_catalog:
    literals: ["NUMBER", "STRING", "STRING_RAW", "IDENT", "TRUE", "FALSE", "NULL"]
    operators: ["PLUS", "MINUS", "STAR", "SLASH", "FLOORDIV", "CARET", "PERCENT", "AMPERSAND"]
    relations: ["EQ", "EXACT_EQ", "NEQ", "STRUCT_NEQ", "LT", "LE", "GT", "GE"]
    punctuation: ["COLON", "EMIT", "PIPE", "BAR", "DOT", "RANGE", "ELLIPSIS", "ARROW", "FAT_ARROW", "COMMA", "SEMICOLON"]
    control: ["AT", "AT_COLON", "AT_EMIT", "AT_GT", "AT_BAR", "AT_BANG"]
    brackets: ["LPAREN", "RPAREN", "LBRACKET", "RBRACKET", "LBRACE", "RBRACE"]
    structural: ["NEWLINE", "INDENT", "DEDENT", "EOF"]
    :

lexer_capability:
    name: "self_hosted_lexer_seed"
    handles: [
        "token data model",
        "cursor data model",
        "cursor helper shapes",
        "public StringCursor source constructor",
        "UTF-8 scalar-safe peek advance and slice",
        "byte position and EOF update after each advance",
        "linked identifier token producer using StringCursor methods",
        "linked whitespace-skipping identifier pair producer",
        "linked identifier and decimal number token stream producer",
        "linked plus operator token stream producer",
        "bounded linked token stream with NEWLINE and EOF",
        "bounded linked LexResult token container",
        "versioned linked token structure envelope for parser cursor handoff",
        "tagged text and number token values for homogeneous parser transport",
        "bounded identifier-plus-number tagged expression stream",
        "character class helpers",
        "token kind catalog",
        "scan_whitespace",
        "scan_comment",
        "scan_identifier",
        "scan_number",
        "native cursor smoke emits IDENT NUMBER NEWLINE INDENT DEDENT EOF token records",
        "native cursor smoke skips spaces tabs comments and blank lines",
        "native cursor smoke emits operator and punctuation token records",
        "native cursor smoke emits decoded STRING and STRING_RAW token records",
        "native cursor smoke emits versioned token stream json payloads",
        "native lexer contract artifact lexes curated fixtures without Python lexer fallback"
    ]
    missing: [
        "consume_while_primitive loop support",
        "predicate dispatch by name",
        "full VKF indent stack implementation",
        "full VKF string scan implementation",
        "full VKF operator scan implementation",
        "full VKF token stream json implementation"
    ]
    language_pressure: [
        "first-class predicate functions would replace predicate_name strings"
    ]
    percent: 96
    :
