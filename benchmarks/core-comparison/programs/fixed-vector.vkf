advance(v:[num:4]) -> [num:4]:
    [
        v.0 * 1.0000001 + v.1 * 0.000001,
        v.1 * 0.9999999 - v.2 * 0.000001,
        v.2 * 1.0000002 + v.3 * 0.000001,
        v.3 * 0.9999998 - v.0 * 0.000001
    ]

run(n:num) -> num:
    i: 0
    v: [1, 2, 3, 4]
    i < n?>
        .v: advance(v)
        .i: i + 1
    v.0 + v.1 + v.2 + v.3

:: run({{COUNT}})
