red: frame.add(
    id:"red_emitter",
    p_t:red_p,
    c_tc:red_c,
    s_t:source_size,
    t:t,
    t_mode:"repeat",
    s_mode:data,
    emission:[24.0, 0.18, 0.07],
    casts_shadow:true)

green: frame.add(
    id:"green_emitter",
    p_t:green_p,
    c_tc:green_c,
    s_t:source_size,
    t:t,
    t_mode:"repeat",
    s_mode:data,
    emission:[0.07, 24.0, 0.18],
    casts_shadow:true)

view: frame.push()
frame.load("ui/main.html")

capture_button: Button(id:"capture-frame")
(event: capture_button.events.get())??>
    ButtonClicked =>
        image: frame.capture()
        write_to_clipboard(image)
