: .ui.display

"""VKF-only chess visual entrypoint.

The retained board is authored directly through the current Display/Frame
contract. Rules, state, event reduction, and bot modules remain under `lib/`.
"""

display: Display(dim:2)
board: display.add_frame(pos:[0.04, 0.06], size:[0.72, 0.84])
board.set_geom_options(background:[0.012, 0.014, 0.018, 1.0], unified_renderer:true)
board.add_camera(pos:[6.8, -7.6, 8.2], target:[0.0, 0.0, 0.2], up:[0.0, 0.0, 1.0], fov:46.0)
