: .ui.display

display: Display(dim:2)
plot: display.add_frame(pos:[0.04, 0.08], size:[0.67, 0.82])
plot.set_geom_options(background:[0.012, 0.02, 0.04, 1.0])

trend: plot.add(
    x:[[-1.0, 1.0], [-1.0, 1.0]],
    y:[[-0.18, 0.46], [0.14, 0.82]],
    z:[[0.0, 0.0], [0.0, 0.0]],
    id:"trend",
    color:[0.18, 0.78, 0.96, 1.0]
)

reference: plot.add(
    x:[[-1.0, 1.0], [-1.0, 1.0]],
    y:[[0.0, 0.0], [0.04, 0.04]],
    z:[[0.0, 0.0], [0.0, 0.0]],
    id:"reference",
    color:[0.92, 0.68, 0.24, 0.72],
    alpha:0.72,
    transparent:true
)

card: display.add_frame(pos:[0.74, 0.08], size:[0.22, 0.82])
card.load("ui/main.html")
