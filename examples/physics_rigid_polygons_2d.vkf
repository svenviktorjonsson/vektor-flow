# Arbitrary 2D rigid polygon collision proof.
#
# This is intentionally only VKF source. The native VKF scene compiler validates
# and triangulates each contour set (including holes), computes mass/inertia, and
# packages the GPU contact solver into the one generated executable.

native_scene: (
  frame_id: "rigid_polygon_physics",
  title: "Generalized P impulses — polygon friction matrix",
  rect: [0.04, 0.04, 0.92, 0.90],
  body_layout: (
    type: "grid",
    rows: 2,
    cols: 12,
    row_heights: "max-content minmax(0, 1fr)"
  ),
  body: [
    (
      id: "physics_toggle",
      type: "button",
      label: "Stop",
      running_label: "Stop",
      paused_label: "Start",
      physics_action: "toggle",
      physics_target: "rigid_polygon_physics",
      grid: [0, 0, 1, 2],
      align: "left"
    ),
    (
      id: "physics_reset",
      type: "button",
      label: "Reset",
      physics_action: "reset",
      physics_target: "rigid_polygon_physics",
      grid: [0, 2, 1, 2],
      align: "left"
    ),
    (
      id: "time_scale_label",
      type: "label",
      text: "Time speed",
      grid: [0, 4, 1, 2],
      align: "right"
    ),
    (
      id: "physics_time_scale",
      type: "slider",
      min: 0.05,
      max: 2.0,
      step: 0.05,
      value: 1.0,
      physics_action: "time_scale",
      physics_target: "rigid_polygon_physics",
      grid: [0, 6, 1, 6],
      align: "stretch"
    ),
    (
      id: "simulation_view",
      type: "plot_panel",
      grid: [1, 0, 1, 12],
      align: "stretch"
    )
  ],
  background: [0.012, 0.018, 0.030, 1.0],
  camera: (
    pos: [0.0, 0.0, 12.0],
    target: [0.0, 0.0, 0.0],
    up: [0.0, 1.0, 0.0],
    projection: "orthographic",
    ortho_scale: 8.8,
    controls_mode: "orbit"
  ),
  lights: [
    (
      id: "key",
      kind: "point",
      pos: [-2.5, -3.0, 8.0],
      color: [1.0, 0.94, 0.82, 1.0],
      intensity: 42.0,
      range: 30.0,
      show_marker: false
    )
  ],
  timing: (fps: 60, duration_seconds: 1000000.0, boundary: "clamp"),
  rigid_world_2d: (
    width: 12.0,
    height: 8.0,
    gravity: [0.0, -5.5],
    solver_iterations: 12,
    position_correction: 1.0,
    penetration_slop: 0.0,
    linear_angular_damping: 0.0001,
    restitution_threshold: 0.5,
    step_dt: 0.0083333333,
    max_substeps: 8
  ),
  rigid_bodies_2d: [
    (
      id: "square_ring_with_real_hole",
      contours: [
        [[-1.35, -1.15], [1.35, -1.15], [1.35, 1.15], [-1.35, 1.15]],
        [[-0.72, -0.58], [-0.72, 0.58], [0.72, 0.58], [0.72, -0.58]]
      ],
      position: [0.0, -0.75],
      static: true,
      mass: "inf",
      density: 2.0,
      e_n: 0.94,
      e_t: 0.80,
      mu_s: 0.18,
      mu_d: 0.08,
      mu_r: 0.008,
      color: [0.24, 0.72, 0.96, 1.0]
    ),
    (
      id: "body_inside_hole",
      contours: [
        [[0.0, 0.38], [0.34, 0.0], [0.0, -0.38], [-0.34, 0.0]]
      ],
      position: [0.0, -0.68],
      velocity: [1.4, 0.2],
      angular_velocity: 2.2,
      density: 0.9,
      e_n: 0.96,
      e_t: 0.80,
      mu_s: 0.14,
      mu_d: 0.06,
      mu_r: 0.005,
      color: [1.0, 0.76, 0.20, 1.0]
    ),
    (
      id: "concave_l",
      contours: [
        [[-0.72, -0.62], [0.70, -0.62], [0.70, -0.16], [-0.18, -0.16], [-0.18, 0.72], [-0.72, 0.72]]
      ],
      position: [-3.7, 2.15],
      angle: 0.28,
      velocity: [2.0, -0.25],
      angular_velocity: -1.4,
      density: 1.2,
      e_n: 0.92,
      e_t: 0.80,
      mu_s: 0.18,
      mu_d: 0.08,
      mu_r: 0.008,
      color: [1.0, 0.34, 0.28, 1.0]
    ),
    (
      id: "concave_u",
      contours: [
        [[-0.82, -0.70], [0.82, -0.70], [0.82, 0.72], [0.32, 0.72], [0.32, -0.14], [-0.32, -0.14], [-0.32, 0.72], [-0.82, 0.72]]
      ],
      position: [3.65, 2.20],
      angle: -0.34,
      velocity: [-2.1, -0.35],
      angular_velocity: 1.1,
      density: 1.0,
      e_n: 0.90,
      e_t: 0.80,
      mu_s: 0.20,
      mu_d: 0.09,
      mu_r: 0.009,
      color: [0.42, 0.92, 0.48, 1.0]
    ),
    (
      id: "irregular_pentagon",
      contours: [
        [[-0.68, -0.46], [0.22, -0.70], [0.76, -0.05], [0.38, 0.70], [-0.56, 0.54]]
      ],
      position: [-2.15, 3.0],
      velocity: [1.15, -0.4],
      angular_velocity: 0.8,
      density: 1.45,
      e_n: 0.94,
      e_t: 0.80,
      mu_s: 0.16,
      mu_d: 0.07,
      mu_r: 0.006,
      color: [0.74, 0.44, 1.0, 1.0]
    ),
    (
      id: "thin_triangle",
      contours: [
        [[-0.78, -0.30], [0.82, -0.24], [-0.18, 0.58]]
      ],
      position: [2.20, 3.10],
      velocity: [-1.25, -0.55],
      angular_velocity: -2.0,
      density: 0.8,
      e_n: 0.96,
      e_t: 0.80,
      mu_s: 0.12,
      mu_d: 0.05,
      mu_r: 0.004,
      color: [1.0, 0.56, 0.16, 1.0]
    )
  ]
)
