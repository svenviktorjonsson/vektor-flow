:.math
m: .math

square_root() -> bit:
    (math.sqrt(81) == 9)?!

zero_sine() -> bit:
    (math.sin(0) == 0)?!

zero_cosine() -> bit:
    (math.cos(0) == 1)?!

zero_exponential() -> bit:
    (math.exp(0) == 1)?!

quarter_turn_tangent() -> bit:
    value: tan(pi / 4)
    (value > 0.999999 /\ value < 1.000001)?!

natural_logarithm_of_e() -> bit:
    value: ln(e)
    (value > 0.999999 /\ value < 1.000001)?!

source_owned_trig_and_hyperbolic_functions() -> bit:
    (sec(0) = 1 /\ csc(pi / 2) > 0.999999 /\ cot(pi / 4) > 0.999999 /\
     sinh(0) = 0 /\ cosh(0) = 1 /\ tanh(0) = 0)?!

source_owned_logarithm_functions() -> bit:
    (lg(1000) > 2.999999 /\ lg(1000) < 3.000001 /\
     lg2(8) > 2.999999 /\ lg2(8) < 3.000001 /\ log(256, 2) = 8)?!

source_owned_inverse_hyperbolic_functions() -> bit:
    (asinh(0) = 0 /\ acosh(1) = 0 /\ atanh(0) = 0)?!

source_owned_inverse_trigonometric_functions() -> bit:
    (atan(1) > 0.785397 /\ atan(1) < 0.785399 /\
     asin(1) > 1.570795 /\ asin(1) < 1.570797 /\
     acos(-1) > 3.141591 /\ acos(-1) < 3.141594 /\
     atan2(1, -1) > 2.356193 /\ atan2(1, -1) < 2.356196 /\
     acot(1) > 0.785397 /\ asec(1) = 0 /\ acsc(1) > 1.570795)?!

source_owned_special_functions() -> bit:
    (gamma(5) > 23.99999 /\ gamma(5) < 24.00001 /\
     gamma(0.5) > 1.77245 /\ gamma(0.5) < 1.77246 /\
     gamma(-0.5) > -3.54492 /\ gamma(-0.5) < -3.54490 /\
     erf(0) = 0 /\ erf(1) > 0.84270 /\ erf(1) < 0.84271 /\
     erf(-1) > -0.84271 /\ erf(-1) < -0.84270)?!

absolute_value() -> bit:
    (math.abs(-3.5) == 3.5 /\ math.abs(2) == 2)?!

constants_are_available() -> bit:
    (math.e > 2.718 /\ math.pi > 3.14 /\ math.tau > 6.28)?!

spilled_constants_and_functions_are_available() -> bit:
    (sqrt(81) == 9 /\ e > 2.718 /\ pi > 3.14 /\ tau > 6.28)?!

aliased_source_owned_math_is_available() -> bit:
    (m.tan(m.pi / 4) > 0.999999 /\ m.gamma(5) > 23.99999 /\ m.erf(1) > 0.84270)?!

lifted_sine_preserves_fixed_vector_shape() -> bit:
    values: sin([0, pi / 2, pi])
    (values.0 = 0 /\ values.1 > 0.999999 /\ values.2 < 0.000001)?!

primitive_math_broadcasts_only_over_vectors() -> bit:
    roots: sqrt([1.0, 4.0, 9.0])
    exponentials: exp([0.0, 1.0])
    (roots.0 = 1 /\ roots.1 = 2 /\ roots.2 = 3 /\
     exponentials.0 = 1 /\ exponentials.1 > 2.71828 /\ exponentials.1 < 2.71829)?!

source_math_broadcasts_only_over_vectors() -> bit:
    values: tan([0.0, pi / 4])
    (values.0 = 0 /\ values.1 > 0.999999 /\ values.1 < 1.000001)?!

multi_argument_math_broadcasts_vectors_and_scalars() -> bit:
    angles: atan2([1.0, 0.0], [0.0, -1.0])
    logs: log([10.0, 100.0], 10)
    (angles.0 > 1.570795 /\ angles.0 < 1.570797 /\
     angles.1 > 3.141591 /\ angles.1 < 3.141594 /\
     logs.0 > 0.999999 /\ logs.0 < 1.000001 /\
     logs.1 > 1.999999 /\ logs.1 < 2.000001)?!

aliased_math_lifting_preserves_nested_vector_shape() -> bit:
    result: m.tanh([[0.0, 1.0], [0.0, 1.0]])
    first: result.0
    second: result.1
    (first.0 = 0 /\ first.1 > 0.76159 /\ first.1 < 0.76160 /\
     second.0 = 0 /\ second.1 > 0.76159 /\ second.1 < 0.76160)?!
