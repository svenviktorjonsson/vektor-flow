default_arguments_are_used(x: num=3, y: num=4) -> bit:
    (x + y = 7)?!

_weighted(x: num, y: num, z: num=0) -> num:
    x * 100 + y * 10 + z

_default_must_not_run(x: num=(0)?!) -> num:
    x

named_arguments_bind_by_name() -> bit:
    (_weighted(y: 4, x: 3, z: 5) = 345)?!

defaults_use_earlier_parameters(x: num=2, y: num=x + 1, z: num=y + 1) -> bit:
    (x + y + z = 9)?!

positional_and_named_arguments_mix() -> bit:
    (_weighted(3, z: 5, y: 4) = 345)?!

provided_argument_skips_default() -> bit:
    (_default_must_not_run(1) = 1)?!

_default_text(value: str="hel" & "lo") -> str:
    value & "!"

string_defaults_are_owned() -> bit:
    (_default_text() == "hello!" /\ _default_text("wor" & "ld") == "world!")?!

_default_values(values: [num]=collections.list(2, 4, 6)) -> num:
    stat.sum(values)

list_defaults_are_owned() -> bit:
    (_default_values() = 12 /\ _default_values(collections.list(1, 3, 5)) = 9)?!

_sum_rest(head: num, ...rest:num) -> num:
    head + stat.sum(rest)

variadic_numeric_arguments_pack_list() -> bit:
    (_sum_rest(1, 2, 3, 4) = 10 /\ _sum_rest(5) = 5)?!

variadic_spread_expands_numeric_list() -> bit:
    [num] values: collections.list(2, 3, 4)
    (_sum_rest(1, :values) = 10)?!

_volume(x, y, z):
    x * y * z

fixed_vector_spread_binds_positional_parameters() -> bit:
    values: [2, 3, 4]
    (_volume(:values) == 24)?!

_point_sum(x, y):
    x + y

fixed_record_spread_binds_by_field_name() -> bit:
    point: (y: 4, x: 3)
    (_point_sum(:point) == 7)?!

_capture_named(x, :::named):
    (named.flag, named.mode)

variadic_named_arguments_capture_record() -> bit:
    captured: _capture_named(1, flag:true, mode:"fast")
    (captured.0 /\ captured.1 == "fast")?!

_factorial(n: num) -> num:
    n <= 1?
        @: 1
    n * _factorial(n - 1)

recursive_call_returns_value() -> bit:
    (_factorial(6) = 720)?!
