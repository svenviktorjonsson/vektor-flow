switch_loop_continue_and_break() -> bit:
    k: 0
    k??>
        0 =>
            k: k + 1
            @>
        1 =>
            k: k + 1
            @>
        2 =>
            k: k + 1
            @>
        3 => @|
    (k == 3)?!

conditional_expression_false_returns_null() -> bit:
    result: (false? 99)
    (result == null)?!
