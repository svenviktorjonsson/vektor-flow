_render_bag(bag:{num}) -> str:
    "$bag"

_merge_bags(left:{num}, right:{num}) -> {num}:
    left + right

numeric_multiset_literal_normalizes_duplicate_and_zero_counts() -> bit:
    (_render_bag({1:2, 1:5, 2:0}) == "{1:7}")?!

numeric_multiset_union_and_concat_add_counts() -> bit:
    left: {1:1, 2:2}
    right: {2:1, 3:1}
    (_render_bag(left + right) == "{1:1, 2:3, 3:1}")?!
    (_render_bag(left & right) == "{1:1, 2:3, 3:1}")?!

numeric_multiset_difference_removes_nonpositive_counts() -> bit:
    (_render_bag({1:4, 2:2} - {1:2, 2:3}) == "{1:2}")?!

numeric_multiset_count_division_and_remainder_match_keys() -> bit:
    left: {1:5, 2:2, 3:7}
    right: {1:2, 2:2}
    (_render_bag(left // right) == "{1:2, 2:1}")?!
    (_render_bag(left % right) == "{1:1}")?!

numeric_multiset_scalar_count_operations() -> bit:
    (_render_bag({1:2, 2:1} + 1) == "{1:3, 2:2}")?!
    (_render_bag(1 + {1:2, 2:1}) == "{1:3, 2:2}")?!
    (_render_bag({1:2, 2:1} - 2) == "{}")?!
    (_render_bag({1:5, 2:2} // 2) == "{1:2, 2:1}")?!

numeric_multiset_function_arguments_and_results_own_storage() -> bit:
    merged: _merge_bags({1:1}, {2:2})
    (_render_bag(merged) == "{1:1, 2:2}")?!

numeric_multiset_nested_record_interpolation() -> bit:
    state: (bag:{1:2, 3:1}, total:3)
    ("$state" == "(bag:{1:2, 3:1}, total:3)")?!
