errors: .errors

conditional_effect() -> bit:
    value: 0
    1 < 2?
        .value: 7
    (value == 7)?!

loop_accumulates() -> bit:
    i: 0
    total: 0
    i < 5?>
        .total: total + i
        .i: i + 1
    (total == 10)?!

inner_assertion_returns_truth() -> bit:
    (6 * 7 == 42)?!

function_call_preserves_assertion_value() -> bit:
    inner_assertion_returns_truth()?!

_choose(x: num) -> num:
    x > 0?
        @: 7
    3

explicit_return_exits_function() -> bit:
    (_choose(1) = 7 /\ _choose(0) = 3)?!

_classify(value: num) -> num:
    value??
        1 => @: 10
        2 => @: 20
        @: 30

match_selects_first_equal_arm() -> bit:
    (_classify(1) = 10 /\ _classify(2) = 20 /\ _classify(9) = 30)?!

match_arm_updates_local() -> bit:
    value: 2
    result: 0
    value??
        1 => .result: 10
        2 => .result: 20
        .result: 30
    (result == 20)?!

_classify_text(value: str) -> num:
    value??
        "left" => @: 1
        "right" => @: 2
        @: 0

string_match_compares_content() -> bit:
    (_classify_text("left") = 1 /\ _classify_text("right") = 2 /\ _classify_text("none") = 0)?!

_classify_expression(value: num) -> num:
    value??
        1 => 10
        2 => 20
        30

match_expression_returns_selected_value() -> bit:
    (_classify_expression(1) = 10 /\ _classify_expression(2) = 20 /\ _classify_expression(9) = 30)?!

_word_for(value: num) -> str:
    value??
        1 => "le" & "ft"
        "right"

string_match_expression_owns_result() -> bit:
    (_word_for(1) == "left" /\ _word_for(9) == "right")?!

_rank_value_over_type(value: int) -> num:
    value??
        int => 20
        3 => 10
        30

match_exact_value_beats_type() -> bit:
    (_rank_value_over_type(3) = 10 /\ _rank_value_over_type(4) = 20)?!

_rank_specific_type(value: int) -> num:
    value??
        any => 30
        num => 20
        int => 10

match_more_specific_type_wins() -> bit:
    (_rank_specific_type(4) = 10)?!

_rank_union_and_intersection(value: int) -> num:
    value??
        int|str => 20
        num&int => 10
        30

match_intersection_beats_union() -> bit:
    (_rank_union_and_intersection(4) = 10)?!

_match_union(value: int) -> num:
    value??
        int|str => 10
        20

match_union_accepts_member_type() -> bit:
    (_match_union(4) = 10)?!

catch_selects_assertion_error_type() -> bit:
    caught: 0
    ((1 == 2)?! "expected failure")!?
        errors.Error => .caught: 1
        errors.AssertionError => .caught: 2
    (caught == 2)?!

catch_does_nothing_without_error() -> bit:
    caught: 0
    ((1 == 1)?!)!?
        errors.AssertionError => .caught: 1
    (caught == 0)?!

_raise_assertion() -> bit:
    (1 == 2)?!

_forward_assertion() -> bit:
    _raise_assertion()

catch_selects_propagated_error_type() -> bit:
    caught: 0
    _forward_assertion()!?
        errors.Error => .caught: 1
        errors.AssertionError => .caught: 2
    (caught == 2)?!

_raise_message() -> bit:
    (1 == 2)?! "propagated assertion"

catch_binds_propagated_error_message() -> bit:
    message: ""
    _raise_message()!?
        errors.AssertionError => .message: $.message
    (message == "propagated assertion")?!

_raise_dynamic_assertion(value:num) -> bit:
    message: "bad $value"
    false?! message

dynamic_assertion_message_survives_catch() -> bit:
    message: ""
    _raise_dynamic_assertion(7)!?
        errors.AssertionError => .message: $.message
    (message == "bad 7")?!

_raise_after_owned_values() -> bit:
    text: "owned " & "temporary"
    values: collections.list(1, 2, 3)
    _raise_message()

error_unwind_releases_owned_values() -> bit:
    message: ""
    _raise_after_owned_values()!?
        errors.AssertionError => .message: $.message
    (message == "propagated assertion")?!

_raise_index_error() -> num:
    [num] values: [1, 2]
    values.(5)

catch_selects_index_error_type() -> bit:
    caught: 0
    _raise_index_error()!?
        errors.Error => .caught: 1
        errors.IndexError => .caught: 2
    (caught == 2)?!

catch_binds_index_error_message() -> bit:
    message: ""
    _raise_index_error()!?
        errors.IndexError => .message: $.message
    (message == "list index out of range")?!

_rethrow_index_error() -> num:
    _raise_index_error()!?
        errors.AssertionError => 0
    0

unmatched_catch_preserves_runtime_error_type() -> bit:
    caught: 0
    _rethrow_index_error()!?
        errors.Error => .caught: 1
        errors.IndexError => .caught: 2
    (caught == 2)?!

integer_cast_accepts_integer_valued_num() -> bit:
    (int(7.0) == 7)?!

_raise_invalid_integer_cast() -> int:
    int(1.5)

integer_cast_error_is_caught_by_type() -> bit:
    caught: 0
    _raise_invalid_integer_cast()!?
        errors.Error => .caught: 1
        errors.ValueError => .caught: 2
    (caught == 2)?!
