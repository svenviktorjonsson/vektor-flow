block_expression_returns_last_row() -> bit:
    message:
        name: "Ada"
        name
    (message == "Ada")?!

block_local_shadow_does_not_escape() -> bit:
    value: 3
    nested:
        value: 4
        value + 1
    ((value == 3) /\ (nested == 5))?!

block_expression_owns_string_result() -> bit:
    message:
        left: "hel" & "lo"
        left & " world"
    (message == "hello world")?!

scope_identity_returns_fields() -> bit:
    point:
        x: 3
        y: 4
        :
    ((point.x == 3) /\ (point.y == 4))?!

scope_identity_includes_outer_bindings() -> bit:
    outer: 3
    snapshot:
        inner: 7
        :
    ((snapshot.outer == 3) /\ (snapshot.inner == 7))?!

scope_identity_keeps_literal_container_shape() -> bit:
    metadata:
        labels: ["left", "right"]
        :
    (metadata.labels.1 == "right")?!

_sum_inferred_pair(pair:any) -> num:
    pair.0 + pair.1

any_parameter_infers_fixed_index_shape() -> bit:
    (_sum_inferred_pair([2, 3]) = 5)?!

_make_inferred_pair() -> any:
    [2, 3]

any_result_infers_fixed_container_shape() -> bit:
    pair: _make_inferred_pair()
    (pair.1 == 3)?!

_sum_inferred_matrix_cross(matrix:any) -> num:
    matrix.(0, 1) + matrix.(1, 0)

any_parameter_infers_nested_fixed_shape() -> bit:
    (_sum_inferred_matrix_cross([[1, 2], [3, 4]]) = 5)?!

_forward_inferred_pair(pair:any) -> num:
    _sum_inferred_pair(pair)

any_parameter_inference_propagates_through_calls() -> bit:
    (_forward_inferred_pair([2, 3]) = 5)?!

_sum_inferred_record_pair(value:any) -> num:
    _sum_inferred_pair(value.pair)

any_record_field_inference_propagates_call_shape() -> bit:
    (_sum_inferred_record_pair((pair: [2, 3])) = 5)?!

_read_inferred_x(value:any) -> num:
    value.x

_read_inferred_y(value:any) -> num:
    value.y

_sum_forwarded_record_fields(value:any) -> num:
    _read_inferred_x(value) + _read_inferred_y(value)

any_record_inference_merges_forwarded_fields() -> bit:
    (_sum_forwarded_record_fields((x: 2, y: 3)) = 5)?!

_sum_velocity_alias(value:any) -> num:
    velocity: value.velocity
    _sum_inferred_pair(velocity)

local_projection_alias_propagates_shape() -> bit:
    (_sum_velocity_alias((velocity: [2, 3],)) = 5)?!

_read_open_x(value:any) -> num:
    value.x

open_record_ignores_unused_field_layout() -> bit:
    (_read_open_x((x: 2, mass: 3)) + _read_open_x((x: 3, mass: "infinite")) = 5)?!
