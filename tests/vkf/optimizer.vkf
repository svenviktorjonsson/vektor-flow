_optimizer_affine_step(value:[num:4]) -> [num:4]:
    [
        value.0 * 1.0000001 + value.1 * 0.000001,
        value.1 * 0.9999999 - value.2 * 0.000001,
        value.2 * 1.0000002 + value.3 * 0.000001,
        value.3 * 0.9999998 - value.0 * 0.000001
    ]

_optimizer_affine_run(count:num) -> num:
    index: 0
    value: [1, 2, 3, 4]
    index < count?>
        .value: _optimizer_affine_step(value)
        .index: index + 1
    value.0 + value.1 + value.2 + value.3

affine_vector_loop_preserves_numeric_result() -> bit:
    result: _optimizer_affine_run(75000)
    ((result - 10.099567298080487) < 0.0000000001 /\
     (result - 10.099567298080487) > -0.0000000001)?!

OptimizerState : (x:num, y:num, vx:num, vy:num)

_optimizer_second_order_step(state:OptimizerState) -> OptimizerState:
    (
        x: state.x + state.vx,
        y: state.y + state.vy,
        vx: state.vx * 0.999999 + state.y * 0.000001,
        vy: state.vy * 0.999998 - state.x * 0.000001
    )

_optimizer_second_order_run(count:num) -> num:
    index: 0
    state: (x:1, y:2, vx:0.01, vy:0.02)
    index < count?>
        .state: _optimizer_second_order_step(state)
        .index: index + 1
    state.x + state.y + state.vx + state.vy

second_order_loop_preserves_numeric_result() -> bit:
    expected: -2.0473715203632542 * 1000000000000 * 100000000000
    ratio: _optimizer_second_order_run(75000) / expected
    ((ratio - 1) < 0.000000000001 /\
     (ratio - 1) > -0.000000000001)?!

_optimizer_scalar_recurrence_advance(value:num, index:num) -> num:
    next: value * 1.00000011920929 + index * 0.0000001
    next > 1000?
        @: next - 999.5
    next

_optimizer_scalar_recurrence_run(count:num) -> num:
    index: 0
    value: 1
    index < count?>
        .value: _optimizer_scalar_recurrence_advance(value, index)
        .index: index + 1
    value

scalar_recurrence_loop_preserves_branch_and_rounding() -> bit:
    result: _optimizer_scalar_recurrence_run(20000)
    ((result - 21.017288693559877) < 0.000000000000001 /\
     (result - 21.017288693559877) > -0.000000000000001)?!
