fixed_vector_sum() -> bit:
    [num:4] values: [1, 2, 3, 4]
    (stat.sum(values) = 10)?!

fixed_vector_mean() -> bit:
    [num:4] values: [2, 4, 6, 8]
    (stat.mean(values) = 5)?!

fixed_vector_count() -> bit:
    [num:3] values: [2, 4, 6]
    (stat.count(values) = 3)?!

fixed_vector_population_std() -> bit:
    [num:8] values: [2, 4, 4, 4, 5, 5, 7, 9]
    (stat.std(values) = 2)?!

fixed_vector_sample_std() -> bit:
    [num:3] values: [-2, 0, 2]
    (stat.std(values, ddof:1) = 2)?!

fixed_vector_population_variance() -> bit:
    [num:8] values: [2, 4, 4, 4, 5, 5, 7, 9]
    (stat.variance(values) = 4)?!

fixed_vector_sample_variance() -> bit:
    [num:3] values: [-2, 0, 2]
    (stat.variance(values, ddof:1) = 4)?!

fixed_vector_range() -> bit:
    [num:5] values: [-2, 0, 3, 5, 1]
    (stat.range(values) = 7)?!

fixed_vector_indexing() -> bit:
    [num:3] values: [5, 8, 13]
    (values.(2) = 13)?!

fixed_vector_update() -> bit:
    [num:3] values: [5, 8, 13]
    values.(1): 21
    (values.(1) = 21)?!

_sum_fixed_vector(values:[num:4]) -> num:
    index: 0
    total: 0
    index < 4?>
        .total: total + values.(index)
        .index: index + 1
    total

fixed_vector_runtime_indexing() -> bit:
    (_sum_fixed_vector([1, 2, 3, 4]) = 10)?!

_build_numeric_list(limit:num) -> [num]:
    index: 0
    values: []
    index < limit?>
        .values: values & [index]
        .index: index + 1
    values

dynamic_list_builder_grows_from_empty() -> bit:
    values: _build_numeric_list(512)
    (values.0 = 0 /\ values.255 = 255 /\ values.511 = 511)?!

_copy_vector(values: [num:3]) -> [num:3]:
    values

fixed_vector_argument_and_result_keep_shape() -> bit:
    [num:3] copied: _copy_vector([2, 5, 7])
    (stat.sum(copied) = 14)?!

_rank_fixed_vector(value: [num:4]) -> num:
    value??
        [any:4] => 20
        [num:4] => 10
        30

fixed_vector_match_prefers_exact_shape() -> bit:
    (_rank_fixed_vector([2, 5, 7, 9]) = 10)?!

_join_shapes(x:[num:n], y:[num:m]) -> [num:n+m]:
    x & y

compile_time_shapes_compose_on_concat() -> bit:
    [num:5] joined: _join_shapes([1, 2], [3, 4, 5])
    (joined.(0) = 1 /\ joined.(4) = 5 /\ stat.count(joined) = 5)?!

fixed_vector_concat_preserves_elements() -> bit:
    joined: [1, 2] & [3, 4]
    (joined.0 == 1 /\ joined.3 == 4)?!

axis_broadcast_builds_outer_product() -> bit:
    a: [1, 2] -> i
    b: [10, 20] -> j
    outer: a * b
    (outer.(0, 0) = 10 /\ outer.(0, 1) = 20 /\
     outer.(1, 0) = 20 /\ outer.(1, 1) = 40)?!

_dynamic_single_index_update(values:[num:3], index:num) -> [num:3]:
    values.(index): 9
    values

runtime_index_updates_fixed_vector() -> bit:
    [num:3] expected: [1, 9, 3]
    (_dynamic_single_index_update([1, 2, 3], 1) == expected)?!

dynamic_nested_vector_update_replaces_one_row() -> bit:
    values: [[1, 2, 3], [4, 5, 6]]
    index: 1
    values.(index): values.(index) + [10, 20, 30]
    (values == [[1, 2, 3], [14, 25, 36]])?!

two_dimensional_index_get_and_update() -> bit:
    matrix: [[1, 2, 3], [4, 5, 6]]
    row: 1
    column: 2
    selected: matrix.(row, column)
    matrix.(row, column): 9
    (selected = 6 /\ matrix.(1, 2) = 9)?!

three_dimensional_index_get_and_update() -> bit:
    tensor: [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    layer: 1
    row: 0
    column: 1
    selected: tensor.(layer, row, column)
    tensor.(layer, row, column): 9
    (selected = 6 /\ tensor.(1, 0, 1) = 9)?!

vector_index_distributes_multidimensional_fetches() -> bit:
    tensor: [
        [[0, 1], [2, 3]],
        [[10, 11], [12, 13]],
        [[20, 21], [22, 23]],
        [[30, 31], [32, 33]]
    ]
    selected: tensor.([1, 2, 3], 1, 0)
    selected = [12, 22, 32]

nested_vector_index_preserves_its_multivec_shape() -> bit:
    tensor: [
        [[0, 1], [2, 3]],
        [[10, 11], [12, 13]],
        [[20, 21], [22, 23]],
        [[30, 31], [32, 33]]
    ]
    selected: tensor.([[0, 1], [2, 3]], 1, 0)
    selected = [[2, 12], [22, 32]]

matching_vector_indices_zip_like_function_arguments() -> bit:
    tensor: [
        [[0, 1], [2, 3]],
        [[10, 11], [12, 13]],
        [[20, 21], [22, 23]],
        [[30, 31], [32, 33]]
    ]
    selected: tensor.([0, 1, 2], [0, 1, 0], 1)
    selected = [1, 13, 21]

distributed_vector_indices_update_matching_values() -> bit:
    tensor: [
        [[0, 1], [2, 3]],
        [[10, 11], [12, 13]],
        [[20, 21], [22, 23]],
        [[30, 31], [32, 33]]
    ]
    tensor.([0, 2], [1, 0], 1): [90, 80]
    tensor.(0, 1, 1) = 90 /\ tensor.(2, 0, 1) = 80

spilled_index_vector_binds_each_dimension() -> bit:
    tensor: [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    coordinates: [1, 0, 1]
    tensor.(:coordinates) = 6

spilled_index_vector_updates_one_coordinate() -> bit:
    tensor: [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
    coordinates: [1, 0, 1]
    tensor.(:coordinates): 9
    tensor.(1, 0, 1) = 9

SpilledVectorSystem: (positions:[[num:3]:2], velocities:[[num:3]:2], masses:[num:2])

_advance_spilled_vector_system(system:SpilledVectorSystem) -> SpilledVectorSystem:
    :system
    i: 1
    velocities.(i) +: positions.(i) * masses.(i)
    (positions:positions, velocities:velocities, masses:masses)

record_spill_preserves_nested_vector_layout() -> bit:
    system: _advance_spilled_vector_system((
        positions:[[1, 2, 3], [4, 5, 6]],
        velocities:[[0, 0, 0], [10, 20, 30]],
        masses:[2, 3]
    ))
    row: system.velocities.1
    (row.0 = 22 /\ row.1 = 35 /\ row.2 = 48)?!

_fractional_fixed_vector_index(index:num) -> num:
    [num:3] values: [1, 2, 3]
    values.(index)

fractional_num_index_remains_an_error() -> bit:
    caught: 0
    _fractional_fixed_vector_index(1.5)!?
        errors.IndexError => .caught: 1
    (caught == 1)?!

_generic_index_read(values:[num:n], index:int) -> num:
    values.(index)

_generic_index_update(values:[num:n], index:int, value:num) -> [num:n]:
    values.(index): value
    values

symbolic_shape_functions_specialize_for_fixed_and_dynamic_vectors() -> bit:
    [num] dynamic: collections.list(1, 2, 3)
    [num] changed: _generic_index_update(dynamic, 1, 9)
    fixed: _generic_index_update([4, 5, 6], 2, 8)
    (_generic_index_read(dynamic, 2) = 3 /\ changed.1 = 9 /\
     _generic_index_read(fixed, 0) = 4 /\ fixed.2 = 8)?!
