_render_text_bag(bag:{str}) -> str:
    "$bag"

_merge_text_bags(left:{str}, right:{str}) -> {str}:
    left + right

string_multiset_literal_normalizes_duplicate_and_zero_counts() -> bit:
    (_render_text_bag({"a":2, "a":3, "b":0}) == "{a:5}")?!

string_multiset_operations_preserve_keys() -> bit:
    merged: _merge_text_bags({"a":2, "b":1}, {"a":1, "c":2})
    (_render_text_bag(merged) == "{a:3, b:1, c:2}")?!
    (_render_text_bag(merged - {"a":2, "b":1}) == "{a:1, c:2}")?!
    (_render_text_bag(merged // {"a":2, "c":2}) == "{a:1, c:1}")?!
    (_render_text_bag(merged % {"a":2, "c":2}) == "{a:1}")?!

string_multiset_scalar_count_operations() -> bit:
    (_render_text_bag({"a":2, "b":1} + 1) == "{a:3, b:2}")?!
    (_render_text_bag({"a":2, "b":1} - 2) == "{}")?!
    (_render_text_bag({"a":5, "b":2} // 2) == "{a:2, b:1}")?!
