string_pipe_maps_unicode_characters() -> bit:
    result: "ab" >> $ & $
    (result == "aabb")?!

string_pipe_decodes_and_encodes_utf8() -> bit:
    result: "åA" >> $ & $
    (result == "ååAA")?!

string_pipe_decodes_four_byte_utf8() -> bit:
    result: "😀" >>
        $ > chr(65535)?
            @: "A"
        "B"
    (result == "A")?!

string_pipe_encodes_four_byte_utf8() -> bit:
    result: "x" >> chr(128512)
    (result == "😀")?!
