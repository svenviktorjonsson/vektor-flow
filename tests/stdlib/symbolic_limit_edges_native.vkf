:.symbolic

test tiny_nonzero_numerator_is_not_misclassified_as_zero() -> bit:
    x: R
    expression: (x + 0.0000000000001) / x
    right: limit(_symbolic_clone(expression), _symbolic_clone(x), 0, "right")
    left: limit(expression, x, 0, "left")
    same(right, _symbolic_clone(inf)) /\ same(left, -_symbolic_clone(inf))

test removable_singularity_order_is_not_capped_at_sixteen() -> bit:
    x: R
    value: limit(x^20 / x^20, x, 0)
    same(value, constant(1))
