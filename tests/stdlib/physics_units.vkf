physics: .physics
:.physics.units
:.math

test si_prefixes_reveal_one_length_dimension() -> bit:
    distance: 2km
    same: 2000m
    distance = same

test quantity_literal_allows_one_space() -> bit:
    compact: 2km
    spaced: 2 km
    compact = spaced

test si_prefixes_are_synthesized_from_base_units() -> bit:
    small: 3mm
    same: 0.003m
    small = same

test si_has_all_seven_base_dimensions() -> bit:
    (1m / 1m = 1) /\ (1kg / 1kg = 1) /\ (1s / 1s = 1) /\
    (1A / 1A = 1) /\ (1K / 1K = 1) /\ (1mol / 1mol = 1) /\
    (1cd / 1cd = 1)

test coherent_derived_units_share_dimensions() -> bit:
    (1N = 1kg * 1m / 1s^2) /\
    (1Pa = 1N / 1m^2) /\
    (1J = 1N * 1m) /\
    (1W = 1J / 1s)

test full_si_prefix_range_is_synthesized() -> bit:
    (abs(1Qm / 1Rm - 1000) < 0.000001) /\
    (abs(1rm / 1qm - 1000) < 0.000001)
