:.symbolic

test symbolic_scalar_arithmetic_works_on_both_sides() -> bit:
    x: R
    expression: (2 + x) + (x + 3) + (5 - x) + (x - 1) + (3 * x) + (x * 4)
    (evaluate(expression, [2]) = 27)?!

test symbolic_division_works_on_both_sides() -> bit:
    x: R
    (evaluate(8 / x + x / 2, [2]) = 5)?!

test symbolic_powers_and_unary_negation_evaluate_together() -> bit:
    x: R
    (evaluate(2^x + x^3 + -x, [2]) = 10)?!
