Token: (kind:str, value:str, line:num, column:num)

StringCursor(source:str):
    bit at_eof: vkf_string_eof(source, 0)
    (source:source, position:0, line:1, column:1, eof:at_eof)

_string_cursor_peek(cursor:StringCursor) -> str:
    vkf_string_peek_scalar(cursor.source, cursor.position)

_string_cursor_advance(cursor:StringCursor) -> StringCursor:
    vkf_cursor_advance_scalar(cursor)

_string_cursor_slice(cursor:StringCursor, start:num, stop:num) -> str:
    vkf_utf8_slice(cursor.source, start, stop)

is_identifier_continue(ch:str) -> bit:
    (ch >= "a" /\ ch <= "z") \/ (ch >= "A" /\ ch <= "Z") \/ (ch >= "0" /\ ch <= "9") \/ ch = "_"

scan_identifier(cursor:StringCursor, start:num) -> Token:
    cursor.eof?
        @: (kind:"IDENT", value:cursor.slice(start, cursor.position),
            line:1, column:1)
    is_identifier_continue(cursor.peek())?
        @: scan_identifier(cursor.advance(), start)
    (kind:"IDENT", value:cursor.slice(start, cursor.position),
     line:1, column:1)

source: "alpha "
observed: scan_identifier(StringCursor(source), 0)
:: observed.kind
:: observed.value
:: observed.line
:: observed.column
