{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vkf: run current file",
      "type": "shell",
      "command": "vkf",
      "args": ["${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "vkf: test current file",
      "type": "shell",
      "command": "vkf",
      "args": ["-t", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
